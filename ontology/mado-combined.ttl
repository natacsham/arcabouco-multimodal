<https://w3id.org/mado#OP-PAD-RETORNO-HAPTICO-RUIDO> <https://w3id.org/mado#contratoOperacionalSerializado> "{\"action\": \"Examinar um sinal tátil para avisar sobre a orientação quando o áudio é prejudicado, mantendo o significado na mensagem recuperável.\", \"applicability_witness\": {\"all\": [{\"field\": \"modalidades\", \"ids\": [\"MOD-AUDIO\"]}, {\"field\": \"barreiras\", \"ids\": [\"BAR-AUDIO-PODE-PERDER-EFETIVIDADE-COM-RUIDO-04E2CCE\"]}, {\"field\": \"tarefas\", \"ids\": [\"TAR-NAVEGAR-E-ORIENTAR-SE\", \"TAR-ACOMPANHAR-ORIENTACAO-317CD64\"]}], \"rationale\": \"Exige orientação sonora situada e sua barreira própria; a coincidência com retomada ou feedback genéricos não autoriza transferência.\"}, \"claim_support\": [{\"claim_id\": \"CLM-K40-C-K40-02\", \"claim_scope_limit\": [\"Registra sugestões de participantes, não eficácia demonstrada de toda combinação áudio-háptica.\"], \"criterion_id\": \"CA88\", \"justification\": \"A sugestão registrada de retorno háptico apoia sinalizar perceptivelmente a disponibilidade da orientação (CA88, item WCAG preservado AT88). A vibração não substitui o conteúdo da mensagem nem prova seu entendimento.\", \"knowledge_id\": \"K40\", \"origin_ids\": [\"ORI-0414\"], \"semantic_pair_review\": {\"claim_excerpt_ids\": [\"TD-RC3-REF-05\"], \"limit\": \"Conferência semântica do registro preservado; não nova consulta do original nem autorização do enunciado histórico inteiro.\", \"origin_excerpt_ids\": [\"TD-ORI-0414\"], \"original_document_rechecked\": false, \"scope\": \"SCOPED_ANALYTICAL_APPLICATION\", \"status\": \"CONFERIDO_NO_REGISTRO\"}}], \"claim_support_audit\": {\"previous_claim_support\": [{\"claim_id\": \"CLM-K40-C-K40-02\", \"claim_scope_limit\": [\"Registra sugestões de participantes, não eficácia demonstrada de toda combinação áudio-háptica.\"], \"criterion_id\": \"CA84\", \"justification\": \"A sinalização precisa estar vinculada ao momento em que a orientação é necessária.\", \"knowledge_id\": \"K40\", \"origin_ids\": [\"ORI-0398\", \"ORI-0399\", \"ORI-0400\"]}, {\"claim_id\": \"CLM-K40-C-K40-02\", \"claim_scope_limit\": [\"Registra sugestões de participantes, não eficácia demonstrada de toda combinação áudio-háptica.\"], \"criterion_id\": \"CA88\", \"justification\": \"O retorno da ação precisa ser percebido sem exigir mudança de foco.\", \"knowledge_id\": \"K40\", \"origin_ids\": [\"ORI-0414\", \"ORI-0415\", \"ORI-0416\"]}], \"reason\": \"Pares anteriores preservados para auditoria; a identidade do conhecimento não autoriza associar toda afirmação a todos os critérios.\", \"status\": \"HISTORICAL_BINDINGS_NOT_OPERATIONAL_SUPPORT\"}, \"condition_phases\": [{\"id\": \"OP-PAD-RETORNO-HAPTICO-RUIDO:verify_information\", \"label\": \"Depois de preparar, conferir com a pessoa se a informação necessária à tarefa permanece disponível e compreensível.\", \"phase\": \"verification\"}], \"conditions\": [], \"function_ids\": [\"FUN-FEEDBACK-PERCEPTIVEL\", \"FUN-MANTER-INFORMACAO-RECUPERAVEL\"], \"grounded_claim_ids\": [\"CLM-K40-C-K40-02\"], \"historical_action_preserved\": true, \"historical_conditions\": [\"Identificar a informação essencial na tarefa e conferir as condições de percepção, ação e mediação com os participantes.\"], \"historical_function_ids\": [\"FUN-FEEDBACK-PERCEPTIVEL\"], \"id\": \"OP-PAD-RETORNO-HAPTICO-RUIDO\", \"independent_support_allowed\": false, \"input_requirements\": [{\"meaning_unit\": \"INFORMACAO_ESSENCIAL_DA_TAREFA\", \"operator\": \"ANY_IN_GROUP\", \"representation_id\": \"MOD-AUDIO\", \"required\": true}], \"integration_gaps\": [], \"limits\": [\"Sugestão documentada de participantes; percepção e significado do sinal dependem de teste situado, sem eficácia universal.\", \"As ações do padrão histórico não incluídas neste contrato não foram autorizadas pela migração.\", \"Saída de áudio operante não comprova retenção da orientação nem controle de repetição; a recuperação da mesma mensagem exige confirmação situada própria.\"], \"output_spec\": [{\"meaning