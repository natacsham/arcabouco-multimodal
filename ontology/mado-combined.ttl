<https://w3id.org/mado#OP-PAD-ORIENTACAO-AUDIO-RECUPERAVEL> <https://w3id.org/mado#contratoOperacionalSerializado> "{\"action\": \"Manter a orientação sonora necessária recuperável e verificar como a pessoa pode solicitar sua repetição.\", \"applicability_witness\": {\"all\": [{\"field\": \"modalidades\", \"ids\": [\"MOD-AUDIO\"]}, {\"field\": \"barreiras\", \"ids\": [\"BAR-AUDIO-PODE-PERDER-EFETIVIDADE-COM-RUIDO-04E2CCE\", \"BAR-EFEMERIDADE-DO-FEEDBACK-AUDITIVO-611AFB8\"]}, {\"field\": \"tarefas\", \"ids\": [\"TAR-NAVEGAR-E-ORIENTAR-SE\", \"TAR-ACOMPANHAR-ORIENTACAO-317CD64\"]}], \"rationale\": \"Exige orientação sonora situada e sua barreira própria; a coincidência com retomada ou feedback genéricos não autoriza transferência.\"}, \"claim_support\": [{\"claim_id\": \"CLM-K40-C-K40-01\", \"claim_scope_limit\": [\"Sustenta permitir retomada da mensagem. O intervalo observado não é transferido como valor universal.\"], \"criterion_id\": \"CA84\", \"justification\": \"A recuperação da orientação necessária no ponto da tarefa é aplicação delimitada de ajuda contextual (CA84, item WCAG preservado AT84). Não corresponde a transmissão de áudio ao vivo nem afirma alternativa textual.\", \"knowledge_id\": \"K40\", \"origin_ids\": [\"ORI-0398\"], \"semantic_pair_review\": {\"claim_excerpt_ids\": [\"TD-EV02\"], \"limit\": \"Conferência semântica do registro preservado; não nova consulta do original nem autorização do enunciado histórico inteiro.\", \"origin_excerpt_ids\": [\"TD-ORI-0398\"], \"original_document_rechecked\": false, \"scope\": \"SCOPED_ANALYTICAL_APPLICATION\", \"status\": \"CONFERIDO_NO_REGISTRO\"}}], \"claim_support_audit\": {\"previous_claim_support\": [{\"claim_id\": \"CLM-K40-C-K40-01\", \"claim_scope_limit\": [\"Sustenta permitir retomada da mensagem. O intervalo observado não é transferido como valor universal.\"], \"criterion_id\": \"CA23\", \"justification\": \"Quando a informação auditiva é essencial, uma forma textual equivalente deve estar disponível