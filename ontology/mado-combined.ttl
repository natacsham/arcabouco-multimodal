<https://w3id.org/mado#OP-PAD-JOGO-CONSOLIDACAO-FEEDBACK> <https://w3id.org/mado#contratoOperacionalSerializado> "{\"action\": \"Se uma atividade interativa já foi escolhida, tornar a resposta e o estado da ação acessíveis e permitir conferência.\", \"claim_support\": [{\"claim_id\": \"CLM-K28-SCOPED-1\", \"claim_scope_limit\": [\"Oferece precedente de revisão e confirmação numa tarefa de mensagens; sua transferência para autoria de recurso digital exige justificar a equivalência funcional, não copiar a interface.\", \"A transferência mantém somente esta parcela; o enunciado candidato completo continua pendente.\"], \"criterion_id\": \"CA88\", \"justification\": \"O precedente registrado de confirmação e feedback em mensagens é aplicado à exposição perceptível do estado da ação (CA88, item WCAG preservado AT88). Não fundamenta jogo ou aprendizagem.\", \"knowledge_id\": \"K28\", \"origin_ids\": [\"ORI-0414\"], \"semantic_pair_review\": {\"claim_excerpt_ids\": [\"TD-EV29\"], \"limit\": \"Conferência semântica do registro preservado; não nova consulta do original nem autorização do enunciado histórico inteiro.\", \"origin_excerpt_ids\": [\"TD-ORI-0414\"], \"original_document_rechecked\": false, \"scope\": \"SCOPED_ANALYTICAL_APPLICATION\", \"status\": \"CONFERIDO_NO_REGISTRO\"}}], \"claim_support_audit\": {\"previous_claim_support\": [{\"claim_id\": \"CLM-K28-SCOPED-1\", \"claim_scope_limit\": [\"Oferece precedente de revisão e confirmação numa tarefa de mensagens; sua transferência para autoria de recurso digital exige justificar a equivalência funcional, não copiar a interface.\", \"A transferência mantém somente esta parcela; o enunciado candidato completo continua pendente.\"], \"criterion_id\": \"CA84\", \"justification\": \"Ajuda deve estar ligada à ação atual.\", \"knowledge_id\": \"K28\", \"origin_ids\": [\"ORI-0398\", \"ORI-0399\", \"ORI-0400\"]}, {\"claim_id\": \"CLM-K28-SCOPED-1\", \"claim_scope_limit\": [\"Oferece precedente de revisão e confirmação numa tarefa de mensagens; sua transferência para autoria de recurso digital exige justificar a equivalência funcional, não copiar a interface.\", \"A transferência mantém somente esta parcela; o enunciado candidato completo continua pendente.\"], \"criterion_id\": \"CA88\", \"justification\": \"Resultado e nova tentativa exigem feedback perceptível e recuperável.\", \"knowledge_id\": \"K28\", \"origin_ids\": [\"ORI-0414\", \"ORI-0415\", \"ORI-0416\"]}], \"reason\": \"Pares anteriores preservados para auditoria; a identidade do conhecimento não autoriza associar toda afirmação a todos os critérios.\", \"status\": \"HISTORICAL_BINDINGS_NOT_OPERATIONAL_SUPPORT\"}, \"condition_phases\": [{\"id\": \"OP-PAD-JOGO-CONSOLIDACAO-FEEDBACK:verify_information\", \"label\": \"Depois de preparar, conferir com a pessoa se a informação necessária à tarefa permanece disponível e compreensível.\", \"phase\": \"verification\"}], \"conditions\": [], \"function_ids\": [\"FUN-FEEDBACK-PERCEPTIVEL\", \"FUN-PERMITIR-REVISAO\"], \"grounded_claim_ids\": [\"CLM-K28-SCOPED-1\"], \"historical_action_preserved\": true, \"historical_conditions\": [\"Identificar a informação essencial na tarefa e conferir as condições de percepção, ação e mediação com os participantes.\"], \"historical_function_ids\": [\"FUN-CONSOLIDAR-COM-FEEDBACK\", \"FUN-FEEDBACK-PERCEPTIVEL\", \"FUN-ACOMPANHAR-RESULTADO\"], \"id\": \"OP-PAD-JOGO-CONSOLIDACAO-FEEDBACK\", \"independent_support_allowed\": true, \"input_requirements\": [{\"meaning_unit\": \"INFORMACAO_ESSENCIAL_DA_TAREFA\", \"operator\": \"ANY_IN_GROUP\", \"representation_id\": \"MOD-JOGO-INTERATIVO\", \"required\": true}], \"integration_gaps\": [\"Este contrato não fundamenta, sozinho, uma relação entre modalidades; pode fornecer uma operação parcial.\"], \"limits\": [\"Não seleciona jogo, mecânica ou ordenação de eventos nem afirma consolidação da aprendizagem; K37 permanece sem elegibilidade.\", \"As ações do padrão histórico não incluídas neste contrato não foram autorizadas pela migração.\"], \"output_spec\": [{\"meaning_unit\": \"INFORMACAO_ESSENCIAL_DA_TAREFA\", \"representation_id\": \"MOD-TEXTO\", \"required\": true}], \"rc2_audit\": {\"date\": \"2026-10-21\", \"historical_statement_promoted\": false, \"result\": \"SCOPED_OPERATION_REVIEW\", \"scoped_claim_ids\": [\"CLM-K28-SCOPED-1\"]}, \"relations\": [], \"representation_ids\": [\"MOD-JOGO-INTERATIVO\", \"MOD-TEXTO\"], \"resource_requirements\": {\"all\": [\"REC-PLATAFORMA-JOGO-QUIZ\"], \"any\": [], \"capability_check_required\": true, \"historical_operator_role_id\": \"PAPEL-PROFESSORA\", \"operator_role_id\": null}, \"role_requirements\": {\"all\": [], \"responsibility\": \"Confirmar quem executa e quem prepara a ação; papéis do exemplo histórico não são exigência geral.\", \"subject_role_ids\": [\"PAPEL-PESSOA-APOIADA\", \"PAPEL-ESTUDANTE\"]}, \"schema_version\": \"1.5.0-rc2\", \"transfer_scope\": {\"allow_new_task_with_functional_witness\": true, \"function_witness_required\": true, \"historical_task_ids\": [\"TAR-PRODUZIR-CONTEUDO-MULTIMODAL\"], \"requires_existing_representation\": true, \"task_ids\": []}}" .
<https://w3id.org/mado#OP-PAD-ORGANIZAR-CONTEUDO-PERSISTENTE> <https://w3id.org/mado#contratoOperacionalSerializado> "{\"action\": \"Preparar instruções consultáveis, com a ordem das ações e relações explícitas, para localizar e retomar o ponto necessário.\", \"analytical_application_ids\": [\"APP-ART-TRF-04-ORGANIZAR-RETOMAR\"], \"claim_support\": [{\"claim_id\": \"CLM-K38-C-K38-02\", \"claim_scope_limit\": [\"Apoia relacionar formatos a funções de organização. A proposição de uma unidade persistente e revisável é reconstrução posterior, não citação da persona.\"], \"criterion_id\": null, \"justification\": \"Parcela delimitada mobilizada nesta aplicação analítica.\", \"knowledge_id\": \"K38\", \"origin_ids\": [], \"semantic_pair_review\": {\"claim_excerpt_ids\": [\"TD-EV34\"], \"limit\": \"Conferência desta aplicação; mantém o estado documental específico de cada premissa.\", \"origin_excerpt_ids\": [], \"original_document_rechecked\": false, \"scope\": \"CONTEXTUAL_CONTRIBUTION_ONLY\", \"status\": \"CONFERIDO_NO_REGISTRO\"}}, {\"claim_id\": \"CLM-K43-C-K43-02\", \"claim_scope_limit\": [\"Apoia não equiparar mais formatos a melhor interação. O registro é uma síntese de persona; não foi conferido nesta revisão como trecho literal do PDF.\"], \"criterion_id\": null, \"justification\": \"Parcela delimitada mobilizada nesta aplicação analítica.\", \"knowledge_id\": \"K43\", \"origin_ids\": [], \"semantic_pair_review\": {\"claim_excerpt_ids\": [\"TD-EV36\"], \"limit\": \"Conferência desta aplicação; mantém o estado documental específico de cada premissa.\", \"origin_excerpt_ids\": [], \"original_document_rechecked\": false, \"scope\": \"CONTEXTUAL_CONTRIBUTION_ONLY\", \"status\": \"CONFERIDO_NO_REGISTRO\"}}, {\"claim_id\": \"CLM-K38-MMI-NAV\", \"claim_scope_limit\": [\"MMI é uma Note sobre requisitos das especificações; não certifica aplicações nem prescreve um recurso didático.\"], \"criterion_id\": \"CA02\", \"justification\": \"Parcela delimitada mobilizada nesta ap