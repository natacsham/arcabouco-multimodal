\", \"PAPEL-MEDIADOR\", \"PAPEL-PROFESSORA\"], \"rc2_audit\": {\"date\": \"2026-10-21\", \"historical_statement_promoted\": false, \"result\": \"SCOPED_OPERATION_REVIEW\", \"scoped_claim_ids\": [\"CLM-K38-C-K38-02\", \"CLM-K43-C-K43-02\", \"CLM-K38-MMI-NAV\", \"CLM-K42-C-K42-02\"]}, \"relations\": [], \"representation_ids\": [\"MOD-TEXTO\", \"MOD-IMAGEM\"], \"requires_facts\": [{\"id\": \"CanReadText\", \"label\": \"A pessoa consegue acompanhar instruções escritas nesta tarefa?\"}], \"resource_requirements\": {\"all\": [], \"any\": [[\"REC-EDITOR-MULTIMIDIA\"]], \"capability_check_required\": false, \"historical_operator_role_id\": \"PAPEL-PROFESSORA\", \"operator_role_id\": null}, \"role_requirements\": {\"all\": [], \"responsibility\": \"Confirmar quem executa e quem prepara a ação; papéis do exemplo histórico não são exigência geral.\", \"subject_role_ids\": [\"PAPEL-PESSOA-APOIADA\", \"PAPEL-ESTUDANTE\"]}, \"schema_version\": \"1.5.0-rc2\", \"selected_representation_ids\": [\"MOD-TEXTO\"], \"transfer_scope\": {\"allow_new_task_with_functional_witness\": true, \"function_witness_required\": true, \"historical_task_ids\": [\"TAR-ORGANIZAR-CONTEUDO-DIGITAL\", \"TAR-PRODUZIR-CONTEUDO-MULTIMODAL\"], \"requires_existing_representation\": false, \"task_ids\": []}}" .
