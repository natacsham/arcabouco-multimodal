<rdf:Description rdf:about="https://w3id.org/mado#CLM-K34-LEGACY">
<rdf:type rdf:resource="https://w3id.org/mado#AfirmacaoOperacionalDocumentada" />
<rdf:type rdf:resource="https://w3id.org/mado/catalogue#Record" />
<ns4:afirmacaoDoConhecimento rdf:resource="https://w3id.org/mado#K34" />
<ns4:elegibilidadeOperacional>DOCUMENTED_OPERATIONAL_CLAIM</ns4:elegibilidadeOperacional>
<ns4:enunciado xml:lang="pt-BR">Uma decisão multimodal situada deve relacionar características funcionais, capacidades observadas, tarefa, barreira, modalidades, recursos e ambiente, sem converter o diagnóstico em prescrição automática.</ns4:enunciado>
