<ns6:field-description>Representação gráfica autoral; não implica capacidade de produção ou percepção.</ns6:field-description>
<ns6:field-direction>INPUT_OR_OUTPUT</ns6:field-direction>
<ns6:field-kind>VISUAL_REPRESENTATION</ns6:field-kind>
