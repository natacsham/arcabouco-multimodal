<ns4:restricao xml:lang="pt-BR">Mobilidade</ns4:restricao>
<ns4:restricao xml:lang="pt-BR">controle físico</ns4:restricao>
<ns4:restricao xml:lang="pt-BR">fone de ouvido</ns4:restricao>
<ns4:restricao xml:lang="pt-BR">segurança/continuidade</ns4:restricao>
