<rdf:Description rdf:about="https://w3id.org/mado#K17">
<rdf:type rdf:resource="https://w3id.org/mado#ConhecimentoMultimodalArticulado" />
<rdf:type rdf:resource="https://w3id.org/mado/catalogue#Record" />
<ns1:label xml:lang="pt-BR">Na preparação de conteúdo educacional, multimodalidade útil exige organizar a função de texto, imagem, vídeo, banners e elementos interativos para apoiar foco, compreensão e mediação pedagógica, e não apenas multiplicar formatos.</ns1:label>
<ns4:aplicavelABarreira rdf:resource="https://w3id.org/mado#BAR-REPETICAO-PREJUDICA-VINCULO" />
<ns4:aplicavelABarreira rdf:resource="https://w3id.org/mado#BAR-TRANSICAO-E-CONTRADICAO-DIFICIL" />
