<ns7:criterion rdf:resource="https://w3id.org/mado/experimental/v2#CriterionReview" />
<ns7:justification>A revisão textual é admitida somente se a apresentação for perceptível e houver controle de correção e conclusão.</ns7:justification>
<ns7:knowledge rdf:resource="https://w3id.org/mado/experimental/v2#KReview" />
<ns7:status>CURATED_FOR_PILOT</ns7:status>
</rdf:Description>
