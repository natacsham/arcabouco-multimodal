<ns4:enunciado xml:lang="pt-BR">Em uma produção digital colaborativa, preservar o protagonismo exige distribuir funções complementares: a pessoa apoiada mantém autoria sobre o conhecimento; a professora enquadra o objetivo, o tempo e a acessibilidade; e os colegas pesquisam, organizam e testam a compreensão sem substituir essa autoria.</ns4:enunciado>
<ns4:escopoDaAfirmacao xml:lang="pt-BR">{"allow_new_task_with_functional_witness": true, "empirical_effect_authorized": false, "forbidden_inferences": ["DIAGNOSIS_TO_CAPABILITY", "GROUP_TO_MEMBER", "RESOURCE_TO_OPERATION", "DOCUMENTATION_TO_EMPIRICAL_EFFECT", "UNKNOWN_TO_ABSENT"], "function_ids": ["FUN-PRESERVAR-PROTAGONISMO", "FUN-COORDENAR-AUTORIA"], "task_ids": ["TAR-CONSTRUIR-RECURSO-DIGITAL-HISTORIA"], "transfer_rule": "FUNCTIONAL_WITNESS_AND_SITUATED_CONDITIONS_REQUIRED"}</ns4:escopoDaAfirmacao>
