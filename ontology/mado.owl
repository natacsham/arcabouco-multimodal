<ns6:field-conhecimento_ids rdf:resource="https://w3id.org/mado/catalogue#node-db7c48a4abb4373360aa8cc7" />
<ns6:field-emag>-</ns6:field-emag>
<ns6:field-enunciado_base_anterior>Proibir conteúdo com flashes superiores a 3 eventos por segundo</ns6:field-enunciado_base_anterior>
<ns6:field-funcao_decisoria />
<ns6:field-id>CA48</ns6:field-id>
<ns6:field-itens_mmi_relacionados rdf:resource="https://w3id.org/mado/catalogue#node-eafb7d1789e5c89d2a6543a5" />
<ns6:field-justificativa_fundamentacao />
<ns6:field-justificativa_mesclagem>No Quiz, animações de confete e “cartões deslizando” são substituídas quando o aluno ativa “Reduzir movimento” (o AVA também detecta a preferência do SO). O feedback usa fade discreto + ícone estático e um earcon curto; no mobile, há vibração breve. O aluno pode dizer “sem animações” (comando de voz) ou acionar pelo switch. A janela de Libras e a legenda permanecem estáveis, sem deslocamentos na tela.</ns6:field-justificativa_mesclagem>
<ns6:field-justificativa_relacao_mmi rdf:resource="https://w3id.org/mado/catalogue#NullValue" />
<ns6:field-mobile>X</ns6:field-mobile>
<ns6:field-motora>-</ns6:field-motora>
<ns6:field-observacao rdf:resource="https://w3id.org/mado/catalogue#NullValue" />
<ns6:field-origem_mmi_no_catalogo>SIM</ns6:field-origem_mmi_no_catalogo>
<ns6:field-status_fundamentacao>SEM_LIGACAO_A_CONHECIMENTO_ARTICULADO_CONFIRMADA</ns6:field-status_fundamentacao>
<ns6:field-status_relacao_mmi>RELACAO_SEM_JUSTIFICATIVA_EXPLICITA</ns6:field-status_relacao_mmi>
<ns6:field-tipo_relacao_mmi>Não registrado</ns6:field-tipo_relacao_mmi>
<ns6:field-verificacao_enunciado>COINCIDE</ns6:field-verificacao_enunciado>
