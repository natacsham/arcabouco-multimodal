<ns4:condicaoDaAplicacaoAnalitica xml:lang="pt-BR">Há conteúdo visual relevante que precisa ser representado por outra via.</ns4:condicaoDaAplicacaoAnalitica>
<ns4:contribuicaoDaAfirmacao rdf:resource="https://w3id.org/mado#C-K38-01" />
