<rdf:Description rdf:about="https://w3id.org/mado#K28">
<rdf:type rdf:resource="https://w3id.org/mado#ConhecimentoMultimodalArticulado" />
<rdf:type rdf:resource="https://w3id.org/mado/catalogue#Record" />
<ns1:label xml:lang="pt-BR">Em formulários e comunicação digital, acessibilidade depende de uma sequência operacional compreensível: rótulos/instruções, foco e teclado, identificação de erros, confirmação e feedback de status precisam funcionar de forma coordenada.</ns1:label>
<ns4:aplicavelAAmbiente rdf:resource="https://w3id.org/mado#AMB-CONTEXTO-DIGITAL-DE-APRENDIZAGEM-42D27F5" />
<ns4:aplicavelABarreira rdf:resource="https://w3id.org/mado#BAR-ROTULOS-FOCO-ERRO-STATUS-INADEQUADOS-219BE43" />
<ns4:aplicavelACaracteristicaRelevanteDaPessoa rdf:resource="https://w3id.org/mado#CAR-PERFIS-FUNCIONAIS-DIVERSOS" />
<ns4:aplicavelAModalidade rdf:resource="https://w3id.org/mado#MOD-TECLADO" />
<ns4:aplicavelARecursoDisponivel rdf:resource="https://w3id.org/mado#REC-TEXTO-TECLADO-FOCO-FEEDBACK-STATUS-97D641F" />
<ns4:aplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-EXECUTAR-TAREFAS-NO-AVA-7BEF3BD" />
<ns4:aplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-PREENCHER-ENVIAR-MENSAGEM-0C1FB87" />
<ns4:articulacao xml:lang="pt-BR">A análise da tela de mensagens parte de critérios essenciais violados e estrutura o formulário redesenhado com rótulos, navegação lógica, foco visível, erros, confirmação e status acessível. A decisão não é um item isolado, mas a coordenação de estados e respostas ao longo da tarefa.</ns4:articulacao>
<ns4:articuladoSobPerspectiva rdf:resource="https://w3id.org/mado#P02" />
<ns4:classificacaoOperacional>OPERACIONALIZAVEL</ns4:classificacaoOperacional>
<ns4:condicoesDeAplicabilidadeDoConhecimento rdf:resource="https://w3id.org/mado/catalogue#node-403db657404c043fecc336de" />
<ns4:contribuiParaFuncaoDecisoria rdf:resource="https://w3id.org/mado#FUN-ACOMPANHAR-RESULTADO" />
<ns4:contribuiParaFuncaoDecisoria rdf:resource="https://w3id.org/mado#FUN-CONSOLIDAR-COM-FEEDBACK" />
<ns4:derivadoDe rdf:resource="https://w3id.org/mado#F08" />
<ns4:enunciado xml:lang="pt-BR">Em formulários e comunicação digital, acessibilidade depende de uma sequência operacional compreensível: rótulos/instruções, foco e teclado, identificação de erros, confirmação e feedback de status precisam funcionar de forma coordenada.</ns4:enunciado>
<ns4:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">K28</ns4:identificador>
<ns4:natureza>RECONSTRUÇÃO ANALÍTICA FORTEMENTE SUSTENTADA</ns4:natureza>
<ns4:origemDaEstruturacaoSemantica xml:lang="pt-BR">Relações derivadas de contextos e decisões documentados; complementações RC3 foram estabelecidas somente quando o enunciado, a articulação e os trechos sustentavam a aplicabilidade.</ns4:origemDaEstruturacaoSemantica>
