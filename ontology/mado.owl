<ns7:capability rdf:resource="https://w3id.org/mado/experimental/v2#CaptureKeyboard" />
<ns7:criterion rdf:resource="https://w3id.org/mado/experimental/v2#CriterionInput" />
<ns7:justification>A escrita oferece outra entrada para o mesmo estado de rascunho, sem exigir fala.</ns7:justification>
<ns7:knowledge rdf:resource="https://w3id.org/mado/experimental/v2#KInput" />
<ns7:status>CURATED_FOR_PILOT</ns7:status>
</rdf:Description>
