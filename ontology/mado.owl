<ns6:field-decisao_id>D-TESTE-RC4-TRANSFERENCIA</ns6:field-decisao_id>
<ns6:field-estado_disponibilidade>CONDICIONAL_A_CONFIRMACAO</ns6:field-estado_disponibilidade>
<ns6:field-funcao>consolidar relações e tornar dúvidas observáveis sem transformar acerto em objetivo isolado</ns6:field-funcao>
<ns6:field-funcao_decisoria_ids rdf:resource="https://w3id.org/mado/catalogue#node-8fdb38bedd0a21631f771066" />
<ns6:field-id>CFG-RC4-05</ns6:field-id>
<ns6:field-limite>O jogo não é indicado quando aumenta pressão, competição ou carga sem acrescentar compreensão.</ns6:field-limite>
<ns6:field-modalidade_id>MOD-JOGO-INTERATIVO</ns6:field-modalidade_id>
<ns6:field-origem_criterio_ids rdf:resource="https://w3id.org/mado/catalogue#node-a68bc622944fd09a17bebf3f" />
<ns6:field-papel_modal_id>PAPEL-COMPLEMENTAR</ns6:field-papel_modal_id>
<ns6:field-papel_responsavel_id>PAPEL-PROFESSORA</ns6:field-papel_responsavel_id>
<ns6:field-significado_funcional>Uma relação já construída precisa ser testada e discutida com feedback explicativo.</ns6:field-significado_funcional>
<ns6:field-status>CONFIGURACAO_MATURA_RC4</ns6:field-status>
<ns6:order-criterion_support rdf:resource="https://w3id.org/mado/catalogue#node-92593ec4232f4b33042cb2c1" />
