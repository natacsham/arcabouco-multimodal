<ns1:label xml:lang="pt-BR">Áudio-apenas e vídeo-apenas pré-gravados devem ter alternativa em texto e, para vídeo, audiodescrição.</ns1:label>
<ns4:condicoesDeAplicabilidadeDoConhecimento rdf:resource="https://w3id.org/mado/catalogue#node-369de07967c618b5d3fa36f7" />
