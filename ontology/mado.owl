<ns6:field-enunciado_base_anterior>Reflow sem rolagem em duas dimensões e sem bloquear zoom (exceto quando bidimensional for essencial)</ns6:field-enunciado_base_anterior>
<ns6:field-funcao_decisoria />
<ns6:field-id>CA34</ns6:field-id>
<ns6:field-itens_mmi_relacionados rdf:resource="https://w3id.org/mado/catalogue#node-0c52f46e84a6e764821519ca" />
<ns6:field-justificativa_fundamentacao />
<ns6:field-justificativa_mesclagem>Eliminar a rolagem em duas dimensões na leitura reduz movimentos finos e trocas de eixo (benefício motor), preserva a linha de leitura e diminui esforço de rastreamento (benefício cognitivo) e permite ampliação sem perda de conteúdo (benefício visual). Quando o layout bidimensional é essencial (p.ex., tabelas/diagramas), oferece-se modo específico sem comprometer a compreensão. Aplica-se a Web e Mobile.</ns6:field-justificativa_mesclagem>
<ns6:field-justificativa_relacao_mmi rdf:resource="https://w3id.org/mado/catalogue#NullValue" />
<ns6:field-mobile>X</ns6:field-mobile>
<ns6:field-motora>-</ns6:field-motora>
<ns6:field-observacao rdf:resource="https://w3id.org/mado/catalogue#NullValue" />
<ns6:field-origem_mmi_no_catalogo>SIM</ns6:field-origem_mmi_no_catalogo>
<ns6:field-status_fundamentacao>SEM_LIGACAO_A_CONHECIMENTO_ARTICULADO_CONFIRMADA</ns6:field-status_fundamentacao>
<ns6:field-status_relacao_mmi>RELACAO_SEM_JUSTIFICATIVA_EXPLICITA</ns6:field-status_relacao_mmi>
<ns6:field-tipo_relacao_mmi>Não registrado</ns6:field-tipo_relacao_mmi>
<ns6:field-verificacao_enunciado>COINCIDE</ns6:field-verificacao_enunciado>
<ns6:field-visual>X</ns6:field-visual>
<ns6:field-wcag_2_2>X</ns6:field-wcag_2_2>
<ns6:field-web>X</ns6:field-web>
<ns6:identifier>CA34</ns6:identifier>
</rdf:Description>
