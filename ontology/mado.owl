<ns7:capability rdf:resource="https://w3id.org/mado/experimental/v2#CaptureSpeech" />
<ns7:criterion rdf:resource="https://w3id.org/mado/experimental/v2#CriterionInput" />
<ns7:justification>A fala é candidata para a produção do rascunho somente com operação e reconhecimento confirmados.</ns7:justification>
<ns7:knowledge rdf:resource="https://w3id.org/mado/experimental/v2#KInput" />
<ns7:status>CURATED_FOR_PILOT</ns7:status>
</rdf:Description>
<rdf:Description rdf:about="https://w3id.org/mado/experimental/v2#GroundTextReview">
