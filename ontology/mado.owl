<ns4:elegibilidadeOperacional>PROPOSED_OPERATIONALIZATION</ns4:elegibilidadeOperacional>
<ns4:enunciado xml:lang="pt-BR">Vídeo acrescenta valor a um recurso de aprendizagem quando representa mudança, processo, contraste temporal ou perspectiva que fala e imagem estática não expressem suficientemente; deve ser curto, introduzido por uma pergunta e acompanhado de controles, legendas, audiodescrição ou alternativa textual conforme o conteúdo.</ns4:enunciado>
<ns4:escopoDaAfirmacao xml:lang="pt-BR">{"allow_new_task_with_functional_witness": true, "empirical_effect_authorized": false, "forbidden_inferences": ["DIAGNOSIS_TO_CAPABILITY", "GROUP_TO_MEMBER", "RESOURCE_TO_OPERATION", "DOCUMENTATION_TO_EMPIRICAL_EFFECT", "UNKNOWN_TO_ABSENT"], "function_ids": ["FUN-CONTEXTUALIZAR-MUDANCA", "FUN-PRESERVAR-ACESSO"], "task_ids": ["TAR-CONSTRUIR-RECURSO-DIGITAL-HISTORIA"], "transfer_rule": "FUNCTIONAL_WITNESS_AND_SITUATED_CONDITIONS_REQUIRED"}</ns4:escopoDaAfirmacao>
