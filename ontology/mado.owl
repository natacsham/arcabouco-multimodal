<ns1:label xml:lang="pt-BR">O conteúdo textual deve utilizar uma linguagem clara e simples ou, para textos complexos, fornecer uma versão alternativa ou conteúdo suplementar que seja mais fácil de compreender.</ns1:label>
<ns4:condicoesDeAplicabilidadeDoConhecimento rdf:resource="https://w3id.org/mado/catalogue#node-0b93d87e8f75e797bd434818" />
