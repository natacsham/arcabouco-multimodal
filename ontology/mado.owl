<rdf:Description rdf:about="https://w3id.org/mado/experimental/v2#GroundAudioReview">
<rdf:type rdf:resource="https://w3id.org/mado/experimental/v2#GroundingApplication" />
<ns7:articulation rdf:resource="https://w3id.org/mado/experimental/v2#ArtAudioReview" />
<ns7:capability rdf:resource="https://w3id.org/mado/experimental/v2#ReviewSpeech" />
<ns7:criterion rdf:resource="https://w3id.org/mado/experimental/v2#CriterionReview" />
<ns7:justification>A saída falada é admitida para revisar o mesmo rascunho somente quando escuta, ambiente, reprodução e correção foram confirmados. Não se conclui acessibilidade de qualquer mídia por mera leitura literal.</ns7:justification>
<ns7:knowledge rdf:resource="https://w3id.org/mado/experimental/v2#KAudioReview" />
<ns7:status>CURATED_FOR_PILOT</ns7:status>
</rdf:Description>
<rdf:Description rdf:about="https://w3id.org/mado/experimental/v2#GroundKeyboard">
<rdf:type rdf:resource="https://w3id.org/mado/experimental/v2#GroundingApplication" />
