<rdf:type rdf:resource="https://w3id.org/mado/catalogue#Record" />
<ns6:alias-Rastreabilidade_do_racioc_nio-6cdaa994ce96 rdf:resource="https://w3id.org/mado/catalogue#field-Rastreabilidade_do_racioc_nio-6cdaa994ce96" />
<ns6:alias-artefato_origem rdf:resource="https://w3id.org/mado/catalogue#field-artefato_origem" />
<ns6:alias-conhecimento_reutilizavel rdf:resource="https://w3id.org/mado/catalogue#field-conhecimento_reutilizavel" />
<ns6:alias-contribuicao_multimodal rdf:resource="https://w3id.org/mado/catalogue#field-contribuicao_multimodal" />
<ns6:alias-estudos_fundamento rdf:resource="https://w3id.org/mado/catalogue#field-estudos_fundamento" />
<ns6:alias-evidencia_fundamentacao rdf:resource="https://w3id.org/mado/catalogue#field-evidencia_fundamentacao" />
<ns6:alias-id_persona rdf:resource="https://w3id.org/mado/catalogue#field-id_persona" />
<ns6:alias-nome rdf:resource="https://w3id.org/mado/catalogue#field-nome" />
<ns6:alias-ontology_id rdf:resource="https://w3id.org/mado/catalogue#field-ontology_id" />
<ns6:alias-papel rdf:resource="https://w3id.org/mado/catalogue#field-papel" />
<ns6:alias-perfil_contexto_resumido rdf:resource="https://w3id.org/mado/catalogue#field-perfil_contexto_resumido" />
<ns6:alias-tipo_registro rdf:resource="https://w3id.org/mado/catalogue#field-tipo_registro" />
<ns6:field-Rastreabilidade_do_racioc_nio-6cdaa994ce96>E04/teste de conformidade + análise de perfis → problemas de conteúdo/acessibilidade web e necessidade de apoio externo → síntese de persona sobre organização de múltiplos formatos para compreensão, sem confundir multimodalidade com multiplicação de estímulos (K19).</ns6:field-Rastreabilidade_do_racioc_nio-6cdaa994ce96>
<ns6:field-artefato_origem>A01</ns6:field-artefato_origem>
<ns6:field-conhecimento_reutilizavel>Multimodalidade precisa apoiar compreensão e foco, e não apenas multiplicar formatos.</ns6:field-conhecimento_reutilizavel>
<ns6:field-contribuicao_multimodal>Texto + imagem + vídeo + propagandas + apoio oral; necessidade de reduzir competição e dispersão.</ns6:field-contribuicao_multimodal>
<ns6:field-estudos_fundamento>E04</ns6:field-estudos_fundamento>
<ns6:field-evidencia_fundamentacao>Teste de Conformidade da WABlind + dados de perfis mencionados no artefato.</ns6:field-evidencia_fundamentacao>
<ns6:field-id_persona>P03</ns6:field-id_persona>
<ns6:field-nome>Lidiane Costa</ns6:field-nome>
<ns6:field-ontology_id>PER-LIDIANE</ns6:field-ontology_id>
<ns6:field-papel>Estudante Universitária</ns6:field-papel>
<ns6:field-perfil_contexto_resumido>Dificuldade de aprendizagem; busca conteúdo pelo smartphone; sobrecarga informacional e apoio oral.</ns6:field-perfil_contexto_resumido>
<ns6:field-tipo_registro>ARTEFATO_DE_SINTESE</ns6:field-tipo_registro>
</rdf:Description>
