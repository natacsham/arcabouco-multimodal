<rdf:Description rdf:about="https://w3id.org/mado#K23">
<rdf:type rdf:resource="https://w3id.org/mado#ConhecimentoMultimodalArticulado" />
<rdf:type rdf:resource="https://w3id.org/mado/catalogue#Record" />
<ns1:label xml:lang="pt-BR">Diretrizes e normas de diferentes origens podem ser transformadas em Critérios de Acessibilidade mais operacionais quando itens funcionalmente semelhantes são agrupados, regras complementares são fundidas e a linguagem é padronizada, preservando a proveniência.</ns1:label>
<ns4:articulacao xml:lang="pt-BR">O estudo reúne 476 itens de cinco fontes e aplica três regras explícitas: similaridade funcional, complementaridade e padronização semântica. O resultado são 88 Critérios de Acessibilidade categorizados por ambiente, origem e relação com perfis funcionais. A planilha de origem preserva cada item consolidado.</ns4:articulacao>
<ns4:articuladoSobPerspectiva rdf:resource="https://w3id.org/mado#P01" />
<ns4:classificacaoOperacional>DESCRITIVO_METODOLOGICO</ns4:classificacaoOperacional>
<ns4:condicoesDeAplicabilidadeDoConhecimento rdf:resource="https://w3id.org/mado/catalogue#node-9f419806ff4ad44716f7b46a" />
<ns4:derivadoDe rdf:resource="https://w3id.org/mado#F08" />
<ns4:enunciado xml:lang="pt-BR">Diretrizes e normas de diferentes origens podem ser transformadas em Critérios de Acessibilidade mais operacionais quando itens funcionalmente semelhantes são agrupados, regras complementares são fundidas e a linguagem é padronizada, preservando a proveniência.</ns4:enunciado>
<ns4:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">K23</ns4:identificador>
<ns4:natureza>EXPLÍCITO NA FONTE</ns4:natureza>
