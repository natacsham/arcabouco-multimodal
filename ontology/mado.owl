<ns6:field-enunciado_base_anterior>Animações e autoatualizações devem permitir pausar, parar, ocultar ou controlar a frequência</ns6:field-enunciado_base_anterior>
<ns6:field-funcao_decisoria />
<ns6:field-id>CA42</ns6:field-id>
<ns6:field-itens_mmi_relacionados rdf:resource="https://w3id.org/mado/catalogue#node-3c81561949b51cc4df11b790" />
<ns6:field-justificativa_fundamentacao />
<ns6:field-justificativa_mesclagem>Conteúdo que se move ou atualiza sozinho competem pela atenção, atrapalham leitura e exigem precisão motora para “perseguir” elementos. Oferecer pausar/parar/ocultar ou regular a frequência reduz distração (cognitiva), melhora a percepção para baixa visão (visual) e evita ações rápidas/precisas (motora). Exceções só se aplicam quando o movimento/atualização é essencial à atividade.</ns6:field-justificativa_mesclagem>
<ns6:field-justificativa_relacao_mmi rdf:resource="https://w3id.org/mado/catalogue#NullValue" />
<ns6:field-mobile>X</ns6:field-mobile>
<ns6:field-motora rdf:resource="https://w3id.org/mado/catalogue#NullValue" />
<ns6:field-observacao rdf:resource="https://w3id.org/mado/catalogue#NullValue" />
<ns6:field-origem_mmi_no_catalogo>SIM</ns6:field-origem_mmi_no_catalogo>
<ns6:field-status_fundamentacao>SEM_LIGACAO_A_CONHECIMENTO_ARTICULADO_CONFIRMADA</ns6:field-status_fundamentacao>
<ns6:field-status_relacao_mmi>RELACAO_SEM_JUSTIFICATIVA_EXPLICITA</ns6:field-status_relacao_mmi>
<ns6:field-tipo_relacao_mmi>Não registrado</ns6:field-tipo_relacao_mmi>
<ns6:field-verificacao_enunciado>COINCIDE</ns6:field-verificacao_enunciado>
<ns6:field-visual>X</ns6:field-visual>
<ns6:field-wcag_2_2>X</ns6:field-wcag_2_2>
<ns6:field-web>X</ns6:field-web>
<ns6:identifier>CA42</ns6:identifier>
</rdf:Description>
