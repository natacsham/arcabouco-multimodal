<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
<ns5:prefLabel xml:lang="pt-BR">A informação visual não está disponível ou não é suficiente para a tarefa.</ns5:prefLabel>
<ns4:contratoOperacionalSerializado>{"claim_ids": ["CLM-K42-TD-ORI-0001", "CLM-K10-SCOPED-1"], "eligibility": "DOCUMENTED_OPERATIONAL_CLAIM", "forbidden_inferences": ["DIAGNOSIS_TO_CAPABILITY", "GROUP_TO_MEMBER", "RESOURCE_TO_OPERATION", "DOCUMENTATION_TO_EMPIRICAL_EFFECT", "UNKNOWN_TO_ABSENT"], "inference_limit": "Recupera requisitos de acesso à informação visual; não afirma ausência total de visão, domínio de leitura, uso de leitor de tela nem percepção de áudio.", "kind": "DESIGN_REQUIREMENT_ONLY", "pending_items": [], "required_information_components": ["VISUAL"], "requires_confirmation": true, "schema_version": "1.5.0-rc1", "source_ids_with_no_linked_excerpt": [], "source_review_scope": "EXISTING_RECORD_NOT_NEW_ORIGINAL_REVIEW", "subject_scope": "SITUATED_SUBJECT", "support": [{"document_url": "https://www.w3.org/TR/2023/REC-WCAG22-20231005/#non-text-content", "excerpt_id": "TD-ORI-0001", "locator": "1.1.1 — Non-text Content", "original_document_rechecked_in_this_migration": false, "review_status": "CONFERIDO_NA_SECAO_ORIGINAL", "source_id": "FN-WCAG", "support_scope": "Alternativas textuais devem cumprir a finalidade do conteúdo não textual; controles, mídia e testes possuem condições e exceções próprias."}, {"document_url": null, "excerpt_id": "TD-EV12", "locator": "8075-10281-1-PB.pdf · 1", "original_document_rechecked_in_this_migration": false, "review_status": "CONFERIDA_NO_REGISTRO", "source_id": "F03", "support_scope": "O registro da WABlind distingue a síntese pelo leitor de tela da compreensão de elementos insuficientemente representados."}], "trigger_kind": "FUNCTIONAL_OBSERVATION_OR_REPORTED_ACCESS_CONDITION"}</ns4:contratoOperacionalSerializado>
