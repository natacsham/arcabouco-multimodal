<ns6:field-conteudo_reutilizado_ou_refinado>A avaliação das personas e suas quatro oportunidades de melhoria tornam-se requisitos de refinamento/contextualização antes do redesign.</ns6:field-conteudo_reutilizado_ou_refinado>
<ns6:field-destino>D11 / E06</ns6:field-destino>
<ns6:field-id>R20</ns6:field-id>
<ns6:field-limite rdf:resource="https://w3id.org/mado/catalogue#NullValue" />
<ns6:field-origem>EV39; EV40</ns6:field-origem>
<ns6:field-rastreabilidade>EV39 mostra os limites representacionais; EV40 explicita quatro melhorias e EV41/EV42 mostram sua aplicação a Camila.</ns6:field-rastreabilidade>
<ns6:field-registro_documental>EV39; EV40; EV41; EV42</ns6:field-registro_documental>
<ns6:field-status>Explícito</ns6:field-status>
<ns6:field-tipo>Validação → contextualização decisória</ns6:field-tipo>
</rdf:Description>
