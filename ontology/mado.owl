<ns6:field-action>selecionar ou produzir cada imagem e desenho com o estudante, registrar o que ela demonstra e acrescentar descrição textual ou oral equivalente ao ponto usado na atividade</ns6:field-action>
<ns6:field-active_in_rc3 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns6:field-active_in_rc3>
<ns6:field-active_in_rc4 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns6:field-active_in_rc4>
<ns6:field-alternative>Usar desenho em papel, objeto ou explicação oral e registrar a mesma relação em texto curto.</ns6:field-alternative>
<ns6:field-criterion_ids rdf:resource="https://w3id.org/mado/catalogue#node-f6fe1e201f48a591e337dbe3" />
<ns6:field-function>representar relações, sequência ou perspectiva e preservar seu significado em descrição</ns6:field-function>
<ns6:field-functional_meaning>A representação visual precisa explicitar a relação que acrescenta ao conteúdo e manter alternativa equivalente.</ns6:field-functional_meaning>
<ns6:field-id>PAD-REPRESENTACAO-VISUAL-EXPLICADA</ns6:field-id>
