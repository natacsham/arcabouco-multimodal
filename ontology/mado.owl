<ns4:configuracaoSustentadaPorConhecimento rdf:resource="https://w3id.org/mado#K37" />
<ns4:configuracaoSustentadaPorConhecimento rdf:resource="https://w3id.org/mado#K43" />
<ns4:configuracaoSustentadaPorConhecimento rdf:resource="https://w3id.org/mado#K44" />
<ns4:configuracaoUsaOrigemDoCriterio rdf:resource="https://w3id.org/mado#ORI-0362" />
<ns4:configuracaoUsaOrigemDoCriterio rdf:resource="https://w3id.org/mado#ORI-0363" />
<ns4:configuracaoUsaOrigemDoCriterio rdf:resource="https://w3id.org/mado#ORI-0364" />
