<ns4:enunciado xml:lang="pt-BR">O requisito 1.3.1 da WCAG 2.2 exige que informações, estrutura e relações possam ser identificadas por software ou estejam disponíveis em texto.</ns4:enunciado>
<ns4:escopoDaAfirmacao xml:lang="pt-BR">{"allow_new_task_with_functional_witness": true, "empirical_effect_authorized": false, "forbidden_inferences": ["DIAGNOSIS_TO_CAPABILITY", "GROUP_TO_MEMBER", "RESOURCE_TO_OPERATION", "DOCUMENTATION_TO_EMPIRICAL_EFFECT", "UNKNOWN_TO_ABSENT"], "function_ids": ["FUN-ORGANIZAR-CONTEUDO", "FUN-PRESERVAR-SIGNIFICADO-ENTRE-MODOS"], "task_ids": ["TAR-PRODUZIR-CONTEUDO-MULTIMODAL", "TAR-ORGANIZAR-CONTEUDO-DIGITAL", "TAR-ACESSAR-COMPREENDER-CONTEUDO-DIGITAL", "TAR-COMUNICAR-E-EXPRESSAR"], "transfer_rule": "FUNCTIONAL_WITNESS_AND_SITUATED_CONDITIONS_REQUIRED"}</ns4:escopoDaAfirmacao>
