<ns4:configuracaoUsaOrigemDoCriterio rdf:resource="https://w3id.org/mado#ORI-0012" />
<ns4:configuracaoUsaOrigemDoCriterio rdf:resource="https://w3id.org/mado#ORI-0013" />
