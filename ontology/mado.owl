<ns4:enunciado xml:lang="pt-BR">O registro da persona Marcia relaciona texto, imagem, vídeo e elementos interativos à organização do conteúdo e à mediação docente.</ns4:enunciado>
<ns4:escopoDaAfirmacao xml:lang="pt-BR">{"allow_new_task_with_functional_witness": true, "empirical_effect_authorized": false, "forbidden_inferences": ["DIAGNOSIS_TO_CAPABILITY", "GROUP_TO_MEMBER", "RESOURCE_TO_OPERATION", "DOCUMENTATION_TO_EMPIRICAL_EFFECT", "UNKNOWN_TO_ABSENT"], "function_ids": ["FUN-ORGANIZAR-CONTEUDO"], "task_ids": ["TAR-COMUNICAR-CONTEUDO-1545B38", "TAR-MICROEXPLICACAO-CURRICULAR", "TAR-APRESENTAR-CONTEUDO-DIFERENTES-ESPACOS"], "transfer_rule": "FUNCTIONAL_WITNESS_AND_SITUATED_CONDITIONS_REQUIRED"}</ns4:escopoDaAfirmacao>
