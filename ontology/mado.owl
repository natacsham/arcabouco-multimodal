<ns6:field-itens_mmi_relacionados rdf:resource="https://w3id.org/mado/catalogue#node-7f542e471938055bc9b4b470" />
<ns6:field-justificativa_fundamentacao />
<ns6:field-justificativa_mesclagem>Falar em plano de fundo adjacente especifica a área real que circunda o texto, evitando ambiguidade. As razões mínimas (4,5:1; 3:1 para texto grande) preservam legibilidade para baixa visão e reduzem sobrecarga cognitiva em Web e Mobile.</ns6:field-justificativa_mesclagem>
<ns6:field-justificativa_relacao_mmi rdf:resource="https://w3id.org/mado/catalogue#NullValue" />
<ns6:field-mobile>X</ns6:field-mobile>
<ns6:field-motora>-</ns6:field-motora>
<ns6:field-observacao rdf:resource="https://w3id.org/mado/catalogue#NullValue" />
