<rdf:type rdf:resource="https://w3id.org/mado/catalogue#Record" />
<ns1:label xml:lang="pt-BR">Quando a entrada padrão de uma tecnologia assistiva é incompatível com o movimento funcional disponível, uma entrada alternativa pode ser projetada a partir do movimento residual efetivamente realizável.</ns1:label>
<ns4:aplicavelAAmbiente rdf:resource="https://w3id.org/mado#AMB-TECNOLOGIA-ASSISTIVA-EM-COMPUTADOR-PESSOAL-C82A2AF" />
<ns4:aplicavelABarreira rdf:resource="https://w3id.org/mado#BAR-TECLADO-CONVENCIONAL-INVIAVEL-C78982F" />
<ns4:aplicavelACaracteristicaRelevanteDaPessoa rdf:resource="https://w3id.org/mado#CAR-ENTRADA-CONVENCIONAL-DIFICIL" />
<ns4:aplicavelACaracteristicaRelevanteDaPessoa rdf:resource="https://w3id.org/mado#CAR-MOVIMENTO-RESIDUAL-DEDOS" />
<ns4:aplicavelARecursoDisponivel rdf:resource="https://w3id.org/mado#REC-MPD-SENSOR-ACAT-WEBCAM-7A85EC2" />
<ns4:aplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-OPERAR-COMUNICAR-SE-NO-ACAT-3FBCF86" />
<ns4:articulacao xml:lang="pt-BR">A participante não conseguia usar teclado convencional, tinha poucos movimentos nos dedos e baixa visão. O processo de design selecionou um dispositivo capaz de detectar movimentos/vibrações leves e o integrou ao ACAT como substituto da navegação pelo teclado.</ns4:articulacao>
<ns4:articuladoSobPerspectiva rdf:resource="https://w3id.org/mado#P02" />
<ns4:classificacaoOperacional>OPERACIONALIZAVEL</ns4:classificacaoOperacional>
<ns4:condicoesDeAplicabilidadeDoConhecimento rdf:resource="https://w3id.org/mado/catalogue#node-89cfe1438a5f1efd12d367ab" />
<ns4:derivadoDe rdf:resource="https://w3id.org/mado#F05" />
