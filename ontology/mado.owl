<ns1:label xml:lang="pt">Permitir conferência e correção antes da conclusão</ns1:label>
<ns7:justification>Escolha de projeto entre alternativas da diretriz AAA; não é exigência universal de revisão visual nem declaração de conformidade.</ns7:justification>
<ns7:locator>3.3.6 (AAA), alternativa de revisão, confirmação e correção</ns7:locator>
<ns7:source rdf:resource="https://w3id.org/mado/experimental/v2#SourceReview" />
</rdf:Description>
