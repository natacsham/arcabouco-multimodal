<ns4:contratoOperacionalSerializado>{"action": "Para vídeo já pertinente à tarefa, preparar as alternativas de acesso correspondentes ao conteúdo sonoro e visual relevante.", "applicability_witness": {"any": [{"field": "recursos_digitais", "ids": ["RED-VIDEO", "RED-VIDEO-HISTORICO", "RED-VIDEO-CURTO-HISTORIA"]}, {"field": "modalidades", "ids": ["MOD-VIDEO"]}], "rationale": "A adaptação depende da existência ou proposta explícita desta representação/material; função nominal isolada não basta."}, "claim_support": [{"claim_id": "CLM-K36-C-K36-01", "claim_scope_limit": ["Sustenta cuidados de acesso ao vídeo. Não fundamenta por si só duração curta, pergunta inicial ou seleção por contraste temporal."], "criterion_id": null, "justification": "Parcela contextual documentada; não constitui fundamento deste critério.", "knowledge_id": "K36", "origin_ids": [], "semantic_pair_review": {"claim_excerpt_ids": ["TD-EV27"], "limit": "Conferência semântica do registro preservado; não nova consulta do original nem autorização do enunciado histórico inteiro.", "origin_excerpt_ids": [], "original_document_rechecked": false, "scope": "CONTEXTUAL_CONTRIBUTION_ONLY", "status": "CONFERIDO_NO_REGISTRO"}}, {"claim_id": "CLM-K42-TD-ORI-0148", "claim_scope_limit": ["Somente o item e as condições documentadas; não extrapolar mídia gravada para transmissão ao vivo."], "criterion_id": "CA17", "justification": "A cláusula de legendas sustenta somente o acesso à informação sonora em mídia sincronizada pré-gravada.", "knowledge_id": "K42", "origin_ids": ["ORI-0148"], "semantic_pair_review": {"claim_excerpt_ids": ["TD-ORI-0148"], "limit": "Conferência semântica do registro preservado; não nova consulta do original nem autorização do enunciado histórico inteiro.", "origin_excerpt_ids": ["TD-ORI-0148"], "original_document_rechecked": false, "scope": "DIRECT_NORMATIVE_CLAUSE", "status": "CONFERIDO_NO_REGISTRO"}}, {"claim_id": "CLM-K42-TD-ORI-0090", "claim_scope_limit": ["Somente o item e as condições do