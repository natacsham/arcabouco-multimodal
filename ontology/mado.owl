<rdf:Description rdf:about="https://w3id.org/mado#CLM-K20-LEGACY">
<rdf:type rdf:resource="https://w3id.org/mado#AfirmacaoOperacionalDocumentada" />
<rdf:type rdf:resource="https://w3id.org/mado/catalogue#Record" />
<ns4:afirmacaoDoConhecimento rdf:resource="https://w3id.org/mado#K20" />
<ns4:elegibilidadeOperacional>PROPOSED_OPERATIONALIZATION</ns4:elegibilidadeOperacional>
<ns4:enunciado xml:lang="pt-BR">A adequação de uma modalidade também depende de conforto sensorial, ambiente e continuidade da tarefa; uma mesma saída pode ser útil em uma situação e inadequada em outra.</ns4:enunciado>
