<ns4:estadoDeDisponibilidadeDaConfiguracao>CONFIRMADO_DISPONIVEL</ns4:estadoDeDisponibilidadeDaConfiguracao>
<ns4:executadaPorPapel rdf:resource="https://w3id.org/mado#PAPEL-PROFESSORA" />
<ns4:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CFG-RC4-01</ns4:identificador>
<ns4:limiteDaConfiguracao xml:lang="pt-BR">A estrutura não deve transformar a participação em roteiro rígido nem substituir o conteúdo autoral.</ns4:limiteDaConfiguracao>
<ns4:origemDoRegistro>CONFIGURACAO_MATURA_RC4</ns4:origemDoRegistro>
<ns4:possuiAplicacaoDeCriterio rdf:resource="https://w3id.org/mado#APL-CFG-RC4-01-01" />
<ns4:possuiAplicacaoDeCriterio rdf:resource="https://w3id.org/mado#APL-CFG-RC4-01-02" />
<ns4:possuiAplicacaoDeCriterio rdf:resource="https://w3id.org/mado#APL-CFG-RC4-01-03" />
<ns4:significadoFuncional xml:lang="pt-BR">O conteúdo precisa persistir e ter sequência visível para ser retomado.</ns4:significadoFuncional>
<ns4:temAcaoOperacional xml:lang="pt-BR">criar blocos curtos com uma ideia central, autoria identificada, fonte ou exemplo e um ponto explícito de revisão antes de publicar</ns4:temAcaoOperacional>
<ns4:temFuncaoModal xml:lang="pt-BR">organizar unidades curtas, autoria, sequência e pontos de revisão</ns4:temFuncaoModal>
<ns4:temPapelModal rdf:resource="https://w3id.org/mado#PAPEL-PRINCIPAL" />
</rdf:Description>
<rdf:Description rdf:about="https://w3id.org/mado#CFG-RC4-02">
<rdf:type rdf:resource="https://w3id.org/mado#ConfiguracaoModalDaDecisao" />
<ns4:acompanhamentoDaConfiguracao xml:lang="pt-BR">Confirmar se o estudante reconhece seu conteúdo e consegue localizar o trecho que deseja revisar.</ns4:acompanhamentoDaConfiguracao>
<ns4:alternativaDaConfiguracao xml:lang="pt-BR">Registrar a contribuição por ditado, desenho comentado ou fala mediada com confirmação imediata.</ns4:alternativaDaConfiguracao>
<ns4:condicaoDaConfiguracao xml:lang="pt-BR">O estudante deve controlar o conteúdo e autorizar a versão final.</ns4:condicaoDaConfiguracao>
<ns4:configuraModalidade rdf:resource="https://w3id.org/mado#MOD-AUDIO" />
<ns4:configuraRecurso rdf:resource="https://w3id.org/mado#REC-CELULAR-CAMERA-MICROFONE" />
<ns4:configuraRecurso rdf:resource="https://w3id.org/mado#REC-MICROFONE" />
