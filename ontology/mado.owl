<ns6:field-enunciado>Para adequar conteúdo educacional às necessidades dos alunos sem depender apenas de tratamento automático, permitir que professores mediadores personalizem e marquem elementos relevantes.</ns6:field-enunciado>
<ns6:field-estudo_id>EST03</ns6:field-estudo_id>
<ns6:field-expressao_operacional rdf:resource="https://w3id.org/mado/catalogue#node-9badcfdeed4461e49adb9d79" />
<ns6:field-id>D08</ns6:field-id>
