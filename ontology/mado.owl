<ns6:field-criterio_ids rdf:resource="https://w3id.org/mado/catalogue#node-263789a5e87072e239955ba2" />
<ns6:field-decisao_id>D-TESTE-RC4-TRANSFERENCIA</ns6:field-decisao_id>
<ns6:field-estado_disponibilidade>CONFIRMADO_DISPONIVEL</ns6:field-estado_disponibilidade>
<ns6:field-funcao>coordenar momentos de autoria, perguntas, complementação e fechamento</ns6:field-funcao>
<ns6:field-funcao_decisoria_ids rdf:resource="https://w3id.org/mado/catalogue#node-4265ec31e373d4db9e0eaa12" />
<ns6:field-id>CFG-RC4-06</ns6:field-id>
<ns6:field-limite>O acordo não deve ser usado para silenciar, punir repetição ou atribuir toda regulação ao estudante.</ns6:field-limite>
<ns6:field-modalidade_id>MOD-FALA</ns6:field-modalidade_id>
<ns6:field-origem_criterio_ids rdf:resource="https://w3id.org/mado/catalogue#node-76f577dc3abb21d1ac372a22" />
