<rdf:Description rdf:about="https://w3id.org/mado/catalogue#node-bae9bbc769657f0f516d6df6">
<rdf:type rdf:resource="https://w3id.org/mado/catalogue#List" />
<ns6:item-1>expressão principal do conhecimento da pessoa</ns6:item-1>
<ns6:item-2>orientar sequência, objetivo e transições sem substituir a fala</ns6:item-2>
<ns6:item-3>preservar o significado visual em estrutura e descrição processáveis</ns6:item-3>
<ns6:item-4>manter uma forma persistente, editável e compatível com tecnologia assistiva</ns6:item-4>
<ns6:item-5>expressar o conhecimento prévio e relacioná-lo ao objetivo curricular</ns6:item-5>
<ns6:item-6>marcar a sequência, o objetivo e as transições sem substituir a explicação</ns6:item-6>
<ns6:item-7>ancorar relações cronológicas ou conceituais mencionadas na fala</ns6:item-7>
<ns6:item-8>externalizar relações e apoiar a preparação ou continuidade da explicação</ns6:item-8>
<ns6:item-9>mobilizar o interesse para uma tarefa curricular verificável</ns6:item-9>
</rdf:Description>
