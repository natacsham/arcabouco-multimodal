<ns4:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CFG-RC4-03</ns4:identificador>
<ns4:limiteDaConfiguracao xml:lang="pt-BR">Imagem decorativa ou não explicada não cumpre a função e deve ser retirada.</ns4:limiteDaConfiguracao>
<ns4:origemDoRegistro>CONFIGURACAO_MATURA_RC4</ns4:origemDoRegistro>
<ns4:possuiAplicacaoDeCriterio rdf:resource="https://w3id.org/mado#APL-CFG-RC4-03-01" />
<ns4:possuiAplicacaoDeCriterio rdf:resource="https://w3id.org/mado#APL-CFG-RC4-03-02" />
<ns4:possuiAplicacaoDeCriterio rdf:resource="https://w3id.org/mado#APL-CFG-RC4-03-03" />
<ns4:significadoFuncional xml:lang="pt-BR">A representação visual precisa explicitar a relação que acrescenta ao conteúdo e manter alternativa equivalente.</ns4:significadoFuncional>
<ns4:temAcaoOperacional xml:lang="pt-BR">selecionar ou produzir cada imagem e desenho com o estudante, registrar o que ela demonstra e acrescentar descrição textual ou oral equivalente ao ponto usado na atividade</ns4:temAcaoOperacional>
<ns4:temFuncaoModal xml:lang="pt-BR">representar relações, sequência ou perspectiva e preservar seu significado em descrição</ns4:temFuncaoModal>
<ns4:temPapelModal rdf:resource="https://w3id.org/mado#PAPEL-APOIO-ORGANIZACAO" />
</rdf:Description>
<rdf:Description rdf:about="https://w3id.org/mado#CFG-RC4-04">
<rdf:type rdf:resource="https://w3id.org/mado#ConfiguracaoModalDaDecisao" />
<ns4:acompanhamentoDaConfiguracao xml:lang="pt-BR">Após o trecho, pedir que os participantes indiquem qual relação nova o vídeo tornou compreensível.</ns4:acompanhamentoDaConfiguracao>
<ns4:alternativaDaConfiguracao xml:lang="pt-BR">Substituir por sequência de imagens descritas, desenho em etapas ou demonstração narrada.</ns4:alternativaDaConfiguracao>
<ns4:condicaoDaConfiguracao xml:lang="pt-BR">Selecionar vídeo apenas se ele acrescentar processo, mudança, contraste ou perspectiva ao objetivo.</ns4:condicaoDaConfiguracao>
<ns4:configuraModalidade rdf:resource="https://w3id.org/mado#MOD-VIDEO" />
<ns4:configuraRecurso rdf:resource="https://w3id.org/mado#REC-AUDIODESCRICAO" />
