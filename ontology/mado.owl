<ns4:configuracaoUsaOrigemDoCriterio rdf:resource="https://w3id.org/mado#ORI-0415" />
<ns4:configuracaoUsaOrigemDoCriterio rdf:resource="https://w3id.org/mado#ORI-0416" />
