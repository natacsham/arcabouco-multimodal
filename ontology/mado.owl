<ns6:field-kind>literal</ns6:field-kind>
<ns6:field-language>pt</ns6:field-language>
<ns6:field-object>Namespace experimental do compositor delimitado, reutilizado pela geração situada da MADO 1.5. Preserva o piloto e suas fontes sem substituir a ontologia principal nem afirmar validação humana. Namespace proposto; não pressupõe registro de resolução pública.</ns6:field-object>
<ns6:field-predicate>http://www.w3.org/2000/01/rdf-schema#comment</ns6:field-predicate>
<ns6:field-subject>https://w3id.org/mado/experimental/v2</ns6:field-subject>
</rdf:Description>
<rdf:Description rdf:about="https://w3id.org/mado/catalogue#node-b56af22697376baa0b782831">
<rdf:type rdf:resource="https://w3id.org/mado/catalogue#List" />
<ns6:item-1 xml:lang="pt-BR">Oferece precedente de revisão e confirmação numa tarefa de mensagens; sua transferência para autoria de recurso digital exige justificar a equivalência funcional, não copiar a interface.</ns6:item-1>
<ns6:item-2 xml:lang="pt-BR">A transferência mantém somente esta parcela; o enunciado candidato completo continua pendente.</ns6:item-2>
</rdf:Description>
