<ns4:contratoOperacionalSerializado>{"action": "Manter a orientação sonora necessária recuperável e verificar como a pessoa pode solicitar sua repetição.", "applicability_witness": {"all": [{"field": "modalidades", "ids": ["MOD-AUDIO"]}, {"field": "barreiras", "ids": ["BAR-AUDIO-PODE-PERDER-EFETIVIDADE-COM-RUIDO-04E2CCE", "BAR-EFEMERIDADE-DO-FEEDBACK-AUDITIVO-611AFB8"]}, {"field": "tarefas", "ids": ["TAR-NAVEGAR-E-ORIENTAR-SE", "TAR-ACOMPANHAR-ORIENTACAO-317CD64"]}], "rationale": "Exige orientação sonora situada e sua barreira própria; a coincidência com retomada ou feedback genéricos não autoriza transferência."}, "claim_support": [{"claim_id": "CLM-K40-C-K40-01", "claim_scope_limit": ["Sustenta permitir retomada da mensagem. O intervalo observado não é transferido como valor universal."], "criterion_id": "CA84", "justification": "A recuperação da orientação necessária no ponto da tarefa é aplicação delimitada de ajuda contextual (CA84, item WCAG preservado AT84). Não corresponde a transmissão de áudio ao vivo nem afirma alternativa textual.", "knowledge_id": "K40", "origin_ids": ["ORI-0398"], "semantic_pair_review": {"claim_excerpt_ids": ["TD-EV02"], "limit": "Conferência semântica do registro preservado; não nova consulta do original nem autorização do enunciado histórico inteiro.", "origin_excerpt_ids": ["TD-ORI-0398"], "original_document_rechecked": false, "scope": "SCOPED_ANALYTICAL_APPLICATION", "status": "CONFERIDO_NO_REGISTRO"}}], "claim_support_audit": {"previous_claim_support": [{"claim_id": "CLM-K40-C-K40-01", "claim_scope_limit": ["Sustenta permitir retomada da mensagem. O intervalo observado não é transferido como valor universal."], "criterion_id": "CA23", "justification": "Quando a informação auditiva é essencial, uma forma textual equivalente deve estar disponível quando aplicável.", "knowledge_id": "K40", "origin_ids": ["ORI-0170", "ORI-0171", "ORI-0172"]}, {"claim_id": "CLM-K40-C-K40-01", "claim_scope_limit": ["Sustenta permitir retomada da mensagem. O intervalo observado não é transferido como valor universal."], "criterion_id": "CA84", "justification": "A ajuda para repetir a orientação precisa estar disponível no ponto da tarefa.", "knowledge_id": "K40", "origin_ids": ["ORI-0398", "ORI-0399", "ORI-0400"]}, {"claim_id": "CLM-K40-C-K40-01", "claim_scope_limit": ["Sustenta permitir retomada da mensagem. O intervalo observado não é transferido como valor universal."], "criterion_id": "CA88", "justification": "A confirmação e o estado da ação precisam ser perceptíveis sem deslocar o foco.", "knowledge_id": "K40", "origin_ids": ["ORI-0414", "ORI-0415", "ORI-0416"]}], "reason": "Pares anteriores preservados para auditoria; a identidade do conhecimento não autoriza associar toda afirmação a todos os critérios.", "status": "HISTORICAL_BINDINGS_NOT_OPERATIONAL_SUPPORT"}, "condition_phases": [{"id": "OP-PAD-ORIENTACAO-AUDIO-RECUPERAVEL:verify_information", "label": "Depois de preparar, conferir com a pessoa se a informação necessária à tarefa permanece disponível e compreensível.", "phase": "verification"}], "conditions": [], "function_ids": ["FUN-MANTER-INFORMACAO-RECUPERAVEL", "FUN-PERMITIR-REVISAO"], "grounded_claim_ids": ["CLM-K40-C-K40-01"], "historical_action_preserved": true, "historical_conditions": ["Identificar a informação essencial na tarefa e conferir as condições de percepção, ação e mediação com os participantes."], "historical_function_ids": ["FUN-MANTER-INFORMACAO-RECUPERAVEL", "FUN-FEEDBACK-PERCEPTIVEL"], "id": "OP-PAD-ORIENTACAO-AUDIO-RECUPERAVEL", "independent_support_allowed": true, "input_requirements": [{"meaning_unit": "INFORMACAO_ESSENCIAL_DA_TAREFA", "operator": "ANY_IN_GROUP", "representation_id": "MOD-AUDIO", "required": true}], "integration_gaps": ["Este contrato não fundamenta, sozinho, uma relação entre modalidades; pode fornecer uma operação parcial."], "limits": ["Recuperabilidade não define duração universal nem comprova compreensão.", "As ações do padrão histórico não incluídas neste contrato não foram autorizadas pela migração."], "output_spec": [{"meaning_unit": "INFORMACAO_ESSENCIAL_DA_TAREFA", "representation_id": "MOD-AUDIO", "required": true}], "rc2_audit": {"date": "2026-10-21", "historical_statement_promoted": false, "result": "SCOPED_OPERATION_REVIEW", "scoped_claim_ids": ["CLM-K40-C-K40-01"]}, "relations": [], "representation_ids": ["MOD-AUDIO"], "requires_facts": [{"id": "AudioUsable", "label": "A pessoa consegue acessar a mensagem sonora neste ambiente?"}], "resource_requirements": {"all": ["REC-SAIDA-AUDIO"], "any": [], "capability_check_required": true, "historical_operator_role_id": "PAPEL-PESSOA-APOIADA", "operator_role_id": null}, "role_requirements": {"all": [], "responsibility": "Confirmar quem executa e quem prepara a ação; papéis do exemplo histórico não são exigência geral.", "subject_role_ids": ["PAPEL-PESSOA-APOIADA", "PAPEL-ESTUDANTE"]}, "schema_version": "1.5.0-rc2", "semantic_curation": {"claim_ids": ["CLM-K40-C-K40-01"], "disposition": "SCOPED_CONTRACT_WITH_SITUATED_GATES", "history": {"sha256": "1055471b927bfee58ae781360d5c9b3d4b4161f6d17c1b3ec066dcbda0fc4f36", "state_fields": {}}, "human_evaluation": false, "reason": "Contrato OP-PAD-ORIENTACAO-AUDIO-RECUPERAVEL: Manter a orientação sonora necessária recuperável e verificar como a pessoa pode solicitar sua repetição. Sua autorização limita-se aos apoios exatos; recursos, acesso e integração continuam sujeitos às verificações declaradas.", "review_date": "2026-10-25", "review_scope": "RECORDED_SCOPE_WITH_EXPLICIT_POINT_REVIEWS", "schema_version": "1.6.0-rc1", "whole_statement_promoted": false}, "transfer_scope": {"allow_new_task_with_functional_witness": false, "function_witness_required": true, "historical_task_ids": ["TAR-NAVEGAR-E-ORIENTAR-SE"], "requires_existing_representation": true, "task_ids": ["TAR-NAVEGAR-E-ORIENTAR-SE", "TAR-ACOMPANHAR-ORIENTACAO-317CD64"]}}</ns4:contratoOperacionalSerializado>
