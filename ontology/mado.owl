<rdf:type rdf:resource="https://w3id.org/mado#ConhecimentoMultimodalArticulado" />
<rdf:type rdf:resource="https://w3id.org/mado/catalogue#Record" />
<ns1:label xml:lang="pt-BR">Personas usadas para apoiar decisões de acessibilidade precisam explicitar tarefas, barreiras, ferramentas, contexto e limites das inferências sobre a pessoa, em vez de registrar características como traços estáveis e descontextualizados.</ns1:label>
<ns4:articulacao xml:lang="pt-BR">A validação das cinco personas mostra diferenças de clareza e comentários recorrentes sobre falta de detalhes de tarefas, sistemas, tecnologias, ambiente, produtividade e esforço. No estudo de 2025, esses aprendizados são consolidados em quatro oportunidades de melhoria e usados no refinamento posterior.</ns4:articulacao>
<ns4:articuladoSobPerspectiva rdf:resource="https://w3id.org/mado#P02" />
<ns4:classificacaoOperacional>OPERACIONALIZAVEL</ns4:classificacaoOperacional>
<ns4:condicoesDeAplicabilidadeDoConhecimento rdf:resource="https://w3id.org/mado/catalogue#node-1729c2bc6053b2c685bf285e" />
