<rdf:Description rdf:about="https://w3id.org/mado#K05">
<rdf:type rdf:resource="https://w3id.org/mado#ConhecimentoMultimodalArticulado" />
<rdf:type rdf:resource="https://w3id.org/mado/catalogue#Record" />
<ns1:label xml:lang="pt-BR">Quando diferentes fontes de feedback operam simultaneamente, a acessibilidade depende da coordenação e da prioridade entre mensagens para evitar sobreposição e perda de significado.</ns1:label>
<ns4:aplicavelAAmbiente rdf:resource="https://w3id.org/mado#AMB-USO-CONJUNTO-DE-APP-TALKBACK-4E44DB8" />
<ns4:aplicavelABarreira rdf:resource="https://w3id.org/mado#BAR-MENSAGENS-CONCORRENTES-472A703" />
<ns4:aplicavelACaracteristicaRelevanteDaPessoa rdf:resource="https://w3id.org/mado#CAR-INTERACAO-NAO-VISUAL" />
<ns4:aplicavelACaracteristicaRelevanteDaPessoa rdf:resource="https://w3id.org/mado#CAR-USA-LEITOR-TELA" />
<ns4:aplicavelARecursoDisponivel rdf:resource="https://w3id.org/mado#REC-COORDENACAO-TEMPORAL-DE-SAIDAS-AUDITIVAS-DD53EA8" />
<ns4:aplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-REGISTRAR-INFORMACAO-E898AEA" />
<ns4:articulacao xml:lang="pt-BR">No registro de informação georreferenciada, o sistema podia emitir simultaneamente confirmação, orientação e mensagens do TalkBack porque não havia priorização. A evidência transforma um problema de implementação em conhecimento sobre coordenação temporal de saídas multimodais.</ns4:articulacao>
<ns4:articuladoSobPerspectiva rdf:resource="https://w3id.org/mado#P02" />
<ns4:classificacaoOperacional>OPERACIONALIZAVEL</ns4:classificacaoOperacional>
<ns4:condicoesDeAplicabilidadeDoConhecimento rdf:resource="https://w3id.org/mado/catalogue#node-82ff9cd751002089d37b8f8e" />
<ns4:derivadoDe rdf:resource="https://w3id.org/mado#F01" />
<ns4:enunciado xml:lang="pt-BR">Quando diferentes fontes de feedback operam simultaneamente, a acessibilidade depende da coordenação e da prioridade entre mensagens para evitar sobreposição e perda de significado.</ns4:enunciado>
<ns4:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">K05</ns4:identificador>
