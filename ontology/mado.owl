<rdf:Description rdf:about="https://w3id.org/mado#K32">
<rdf:type rdf:resource="https://w3id.org/mado#ConhecimentoMultimodalArticulado" />
<rdf:type rdf:resource="https://w3id.org/mado/catalogue#Record" />
<ns1:label xml:lang="pt-BR">A decisão de apoio precisa considerar conjuntamente nível de compreensão, potencial observado, tempo, recursos, ambiente, pessoas disponíveis e uma alternativa de revisão quando a primeira configuração não produzir envolvimento.</ns1:label>
<ns4:aplicavelAAmbiente rdf:resource="https://w3id.org/mado#AMB-AUDITORIO" />
<ns4:aplicavelAAmbiente rdf:resource="https://w3id.org/mado#AMB-LABORATORIO-INFORMATICA" />
