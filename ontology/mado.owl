<ns1:label xml:lang="pt-BR">Quando um erro de entrada de dados é detectado, ele deve ser identificado em texto, descrevendo claramente qual é o problema e qual campo o contém.</ns1:label>
<ns4:condicoesDeAplicabilidadeDoConhecimento rdf:resource="https://w3id.org/mado/catalogue#node-7a8c18439fb30d9f72c02d2c" />
