<rdf:Description rdf:about="https://w3id.org/mado#CA-CARE-COMPLEMENTARITY">
<rdf:type rdf:resource="https://w3id.org/mado#CriterioDeDecisaoMultimodal" />
<rdf:type rdf:resource="https://w3id.org/mado/catalogue#Record" />
<ns4:dataDaConsultaDocumental>2026-10-25</ns4:dataDaConsultaDocumental>
<ns4:enunciado xml:lang="pt-BR">Classificar uma proposta como complementar somente quando o objetivo conjunto, a parcela necessária de cada modalidade e sua coordenação temporal estiverem explícitos; nenhuma modalidade isolada deve cumprir esse mesmo objetivo no escopo declarado.</ns4:enunciado>
<ns4:identificador>CA-CARE-COMPLEMENTARITY</ns4:identificador>
<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-CARE-COMPLEMENTARITY" />
