<ns6:field-status_fundamentacao>FUNDAMENTACAO_ANALITICA_HISTORICA_NAO_AUTORIZA_CONFIGURACAO_RC3</ns6:field-status_fundamentacao>
<ns6:field-status_relacao_mmi>JUSTIFICATIVA_DOCUMENTADA</ns6:field-status_relacao_mmi>
<ns6:field-tipo_relacao_mmi>Apoio</ns6:field-tipo_relacao_mmi>
<ns6:field-verificacao_enunciado>COINCIDE</ns6:field-verificacao_enunciado>
<ns6:field-visual>X</ns6:field-visual>
<ns6:field-wcag_2_2>X</ns6:field-wcag_2_2>
<ns6:field-web>X</ns6:field-web>
<ns6:identifier>CA10</ns6:identifier>
</rdf:Description>
