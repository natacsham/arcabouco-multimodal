<ns6:field-conteudo_reutilizado_ou_refinado>Os 88 Critérios de Acessibilidade deixam de ser inventário e passam a fundamentar decisões específicas de conteúdo e comunicação no SIGAA.</ns6:field-conteudo_reutilizado_ou_refinado>
<ns6:field-destino>D11; D12; D13; D14; D15; D16; D17; D18</ns6:field-destino>
<ns6:field-id>R21</ns6:field-id>
<ns6:field-limite rdf:resource="https://w3id.org/mado/catalogue#NullValue" />
<ns6:field-origem>A06 / K23</ns6:field-origem>
<ns6:field-rastreabilidade>Os critérios citados em EV27–EV30 rastreiam cada melhoria às fontes consolidadas, enquanto 13_Origem_Criterios preserva a proveniência item a item.</ns6:field-rastreabilidade>
<ns6:field-registro_documental>EV27; EV28; EV29; EV30</ns6:field-registro_documental>
<ns6:field-status>Explícito</ns6:field-status>
<ns6:field-tipo>Critérios consolidados → decisões/redesign</ns6:field-tipo>
</rdf:Description>
