<ns4:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">K26</ns4:identificador>
<ns4:natureza>RECONSTRUÇÃO ANALÍTICA FORTEMENTE SUSTENTADA</ns4:natureza>
