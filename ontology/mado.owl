<rdf:Description rdf:about="https://w3id.org/mado/catalogue#node-02d4b7dd66d14b2bf0642024">
<rdf:type rdf:resource="https://w3id.org/mado/catalogue#Record" />
<ns6:alias-kind rdf:resource="https://w3id.org/mado/catalogue#field-kind" />
<ns6:alias-object rdf:resource="https://w3id.org/mado/catalogue#field-object" />
