<ns4:configuracaoUsaOrigemDoCriterio rdf:resource="https://w3id.org/mado#ORI-0400" />
<ns4:configuracaoUsaOrigemDoCriterio rdf:resource="https://w3id.org/mado#ORI-0414" />
<ns4:configuracaoUsaOrigemDoCriterio rdf:resource="https://w3id.org/mado#ORI-0415" />
<ns4:configuracaoUsaOrigemDoCriterio rdf:resource="https://w3id.org/mado#ORI-0416" />
<ns4:cumpreFuncaoDecisoria rdf:resource="https://w3id.org/mado#FUN-ACOMPANHAR-RESULTADO" />
<ns4:cumpreFuncaoDecisoria rdf:resource="https://w3id.org/mado#FUN-CONSOLIDAR-COM-FEEDBACK" />
<ns4:cumpreFuncaoDecisoria rdf:resource="https://w3id.org/mado#FUN-FEEDBACK-PERCEPTIVEL" />
<ns4:estadoDeDisponibilidadeDaConfiguracao>CONDICIONAL_A_CONFIRMACAO</ns4:estadoDeDisponibilidadeDaConfiguracao>
<ns4:executadaPorPapel rdf:resource="https://w3id.org/mado#PAPEL-PROFESSORA" />
<ns4:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CFG-RC4-05</ns4:identificador>
<ns4:limiteDaConfiguracao xml:lang="pt-BR">O jogo não é indicado quando aumenta pressão, competição ou carga sem acrescentar compreensão.</ns4:limiteDaConfiguracao>
<ns4:origemDoRegistro>CONFIGURACAO_MATURA_RC4</ns4:origemDoRegistro>
<ns4:possuiAplicacaoDeCriterio rdf:resource="https://w3id.org/mado#APL-CFG-RC4-05-01" />
<ns4:possuiAplicacaoDeCriterio rdf:resource="https://w3id.org/mado#APL-CFG-RC4-05-02" />
<ns4:possuiAplicacaoDeCriterio rdf:resource="https://w3id.org/mado#APL-CFG-RC4-05-03" />
<ns4:significadoFuncional xml:lang="pt-BR">Uma relação já construída precisa ser testada e discutida com feedback explicativo.</ns4:significadoFuncional>
<ns4:temAcaoOperacional xml:lang="pt-BR">criar poucas situações de ordenar, relacionar ou comparar; após cada resposta, oferecer feedback explicativo, permitir nova tentativa e discutir divergências com a turma</ns4:temAcaoOperacional>
<ns4:temFuncaoModal xml:lang="pt-BR">consolidar relações e tornar dúvidas observáveis sem transformar acerto em objetivo isolado</ns4:temFuncaoModal>
<ns4:temPapelModal rdf:resource="https://w3id.org/mado#PAPEL-COMPLEMENTAR" />
</rdf:Description>
<rdf:Description rdf:about="https://w3id.org/mado#CFG-RC4-06">
<rdf:type rdf:resource="https://w3id.org/mado#ConfiguracaoModalDaDecisao" />
<ns4:acompanhamentoDaConfiguracao xml:lang="pt-BR">Observar se o estudante mantém autoria, se a professora mantém a condução e se os colegas conseguem contribuir sem ruptura do vínculo.</ns4:acompanhamentoDaConfiguracao>
<ns4:alternativaDaConfiguracao xml:lang="pt-BR">Usar cartões de turno ou uma pauta visual simples, mantendo espaço para contribuição não prevista.</ns4:alternativaDaConfiguracao>
<ns4:condicaoDaConfiguracao xml:lang="pt-BR">Negociar sinais e papéis antes da atividade e permitir ajustes sem exposição pública.</ns4:condicaoDaConfiguracao>
<ns4:configuraModalidade rdf:resource="https://w3id.org/mado#MOD-FALA" />
