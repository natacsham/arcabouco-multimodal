<rdf:Description rdf:about="https://w3id.org/mado#CA88">
<rdf:type rdf:resource="https://w3id.org/mado#CriterioDeDecisaoMultimodal" />
<rdf:type rdf:resource="https://w3id.org/mado/catalogue#Record" />
<ns1:label xml:lang="pt-BR">Mensagens de status e feedbacks de ações devem ser comunicados programaticamente de forma que possam ser percebidos por tecnologias assistivas sem roubar o foco do usuário.</ns1:label>
<ns4:condicoesDeAplicabilidadeDoConhecimento rdf:resource="https://w3id.org/mado/catalogue#node-7be560326fb12d433e777a37" />
<ns4:criterioAplicavelAModalidade rdf:resource="https://w3id.org/mado#MOD-AUDIO" />
<ns4:criterioAplicavelAModalidade rdf:resource="https://w3id.org/mado#MOD-TECLADO" />
<ns4:criterioAplicavelAModalidade rdf:resource="https://w3id.org/mado#MOD-TEXTO" />
<ns4:criterioAplicavelAModalidade rdf:resource="https://w3id.org/mado#MOD-VOZ" />
<ns4:criterioAplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-ACOMPANHAR-ORIENTACAO-317CD64" />
<ns4:criterioAplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-CONSTRUIR-RECURSO-DIGITAL-HISTORIA" />
<ns4:criterioAplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-ENVIAR-LER-MENSAGEM-INTERAGIR-COM-MENSAGENS-4C0CACA" />
<ns4:criterioAplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-EXECUTAR-TAREFAS-NO-AVA-7BEF3BD" />
<ns4:criterioAplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-PREENCHER-ENVIAR-MENSAGEM-0C1FB87" />
<ns4:criterioAplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-REVISAR-PUBLICAR-RECURSO" />
<ns4:criterioAplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-SEGUIR-ROTA-3D861F4" />
<ns4:enunciado xml:lang="pt-BR">Mensagens de status e feedbacks de ações devem ser comunicados programaticamente de forma que possam ser percebidos por tecnologias assistivas sem roubar o foco do usuário.</ns4:enunciado>
<ns4:funcaoDecisoria xml:lang="pt-BR">fornecer orientação principal e reapresentável</ns4:funcaoDecisoria>
<ns4:funcaoDecisoria xml:lang="pt-BR">manter uma forma persistente, editável e compatível com tecnologia assistiva</ns4:funcaoDecisoria>
<ns4:funcaoDecisoria xml:lang="pt-BR">oferecer expressão e acesso alternativos ao texto digitado</ns4:funcaoDecisoria>
<ns4:funcaoDecisoria xml:lang="pt-BR">preservar operação, foco, correção e confirmação</ns4:funcaoDecisoria>
<ns4:fundamentadoPor rdf:resource="https://w3id.org/mado#K02" />
<ns4:fundamentadoPor rdf:resource="https://w3id.org/mado#K04" />
<ns4:fundamentadoPor rdf:resource="https://w3id.org/mado#K05" />
<ns4:fundamentadoPor rdf:resource="https://w3id.org/mado#K07" />
<ns4:fundamentadoPor rdf:resource="https://w3id.org/mado#K18" />
<ns4:fundamentadoPor rdf:resource="https://w3id.org/mado#K25" />
<ns4:fundamentadoPor rdf:resource="https://w3id.org/mado#K26" />
<ns4:fundamentadoPor rdf:resource="https://w3id.org/mado#K28" />
<ns4:fundamentadoPor rdf:resource="https://w3id.org/mado#K29" />
<ns4:fundamentadoPor rdf:resource="https://w3id.org/mado#K32" />
<ns4:fundamentadoPor rdf:resource="https://w3id.org/mado#K33" />
<ns4:fundamentadoPor rdf:resource="https://w3id.org/mado#K37" />
<ns4:fundamentadoPor rdf:resource="https://w3id.org/mado#K38" />
<ns4:identificador>CA88</ns4:identificador>
<ns4:justificativaDeFundamentacao xml:lang="pt-BR">Comunicar estado e feedback sem interromper indevidamente a tarefa. Em versão anterior, a ligação foi reconstruída analiticamente porque o critério participa de uma configuração modalidade–função–recurso–responsável fundamentada por esses conhecimentos; não se atribui essa formalização retrospectiva às publicações originais. Na RC2, a ligação ao conhecimento articulado foi conferida para o cenário de transferência e permanece limitada às condições registradas.</ns4:justificativaDeFundamentacao>
<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0414" />
<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0415" />
<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0416" />
<ns4:statusDaRelacao>RELACAO_SEM_JUSTIFICATIVA_EXPLICITA</ns4:statusDaRelacao>
