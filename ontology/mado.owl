<ns6:field-estado_disponibilidade>CONFIRMADO_DISPONIVEL</ns6:field-estado_disponibilidade>
<ns6:field-funcao>preservar a voz da pessoa em trechos curtos, identificáveis e revisáveis</ns6:field-funcao>
<ns6:field-funcao_decisoria_ids rdf:resource="https://w3id.org/mado/catalogue#node-10e0f1a9ccad6b4ff99a0891" />
<ns6:field-id>CFG-RC4-02</ns6:field-id>
<ns6:field-limite>Áudio não deve ser obrigatório e precisa de alternativa para quem não o percebe ou não pode reproduzi-lo.</ns6:field-limite>
<ns6:field-modalidade_id>MOD-AUDIO</ns6:field-modalidade_id>
<ns6:field-origem_criterio_ids rdf:resource="https://w3id.org/mado/catalogue#node-e0fff3f6d87a2356d241e76c" />
