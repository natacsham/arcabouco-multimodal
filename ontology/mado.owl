<ns4:contratoOperacionalSerializado>{"action": "Identificar a informação e as relações relevantes no conteúdo, estruturar sua representação textual e conferir a alternativa com a pessoa.", "analytical_application_ids": ["APP-ART-TRF-04-CONTEUDO-WEB-EQUIVALENTE"], "applicability_witness": {"any": [{"field": "recursos_digitais", "ids": ["RED-CONTEUDO-WEB", "RED-PAGINA-WEB"]}], "rationale": "A adaptação depende da existência ou proposta explícita desta representação/material; função nominal isolada não basta."}, "claim_support": [{"claim_id": "CLM-K38-C-K38-01", "claim_scope_limit": ["Contribui com a preservação do conteúdo e a mediação; não contém, isoladamente, a estrutura completa de unidade revisável, autoria e publicação proposta em K38."], "criterion_id": null, "justification": "Parcela delimitada mobilizada nesta aplicação analítica.", "knowledge_id": "K38", "origin_ids": [], "semantic_pair_review": {"claim_excerpt_ids": ["TD-EV13"], "limit": "Conferência desta aplicação; mantém o estado documental específico de cada premissa.", "origin_excerpt_ids": [], "original_document_rechecked": false, "scope": "CONTEXTUAL_CONTRIBUTION_ONLY", "status": "CONFERIDO_NO_REGISTRO"}}, {"claim_id": "CLM-K42-C-K42-01", "claim_scope_limit": ["Contribui com a necessidade de representação adequada, não apenas conversão técnica para áudio."], "criterion_id": null, "justification": "Parcela delimitada mobilizada nesta aplicação analítica.", "knowledge_id": "K42", "origin_ids": [], "semantic_pair_review": {"claim_excerpt_ids": ["TD-EV12"], "limit": "Conferência desta aplicação; mantém o estado documental específico de cada premissa.", "origin_excerpt_ids": [], "original_document_rechecked": false, "scope": "CONTEXTUAL_CONTRIBUTION_ONLY", "status": "CONFERIDO_NO_REGISTRO"}}, {"claim_id": "CLM-K42-TD-ORI-0001", "claim_scope_limit": ["Somente o item e as condições documentadas; não extrapolar mídia gravada para transmissão ao vivo."], "criterion_id": "CA01", "justification": "Parcela delim