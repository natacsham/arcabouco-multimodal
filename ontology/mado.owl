<ns4:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CFG-RC4-02</ns4:identificador>
<ns4:limiteDaConfiguracao xml:lang="pt-BR">Áudio não deve ser obrigatório e precisa de alternativa para quem não o percebe ou não pode reproduzi-lo.</ns4:limiteDaConfiguracao>
<ns4:origemDoRegistro>CONFIGURACAO_MATURA_RC4</ns4:origemDoRegistro>
<ns4:possuiAplicacaoDeCriterio rdf:resource="https://w3id.org/mado#APL-CFG-RC4-02-01" />
<ns4:possuiAplicacaoDeCriterio rdf:resource="https://w3id.org/mado#APL-CFG-RC4-02-02" />
<ns4:possuiAplicacaoDeCriterio rdf:resource="https://w3id.org/mado#APL-CFG-RC4-02-03" />
<ns4:significadoFuncional xml:lang="pt-BR">A forma oral preserva autoria, mas precisa persistir para revisão.</ns4:significadoFuncional>
<ns4:temAcaoOperacional xml:lang="pt-BR">registrar a explicação em trechos curtos de áudio, associar uma síntese textual editável e permitir que o estudante aprove ou refaça cada trecho</ns4:temAcaoOperacional>
<ns4:temFuncaoModal xml:lang="pt-BR">preservar a voz da pessoa em trechos curtos, identificáveis e revisáveis</ns4:temFuncaoModal>
<ns4:temPapelModal rdf:resource="https://w3id.org/mado#PAPEL-AUTORIA-PRINCIPAL" />
</rdf:Description>
<rdf:Description rdf:about="https://w3id.org/mado#CFG-RC4-03">
<rdf:type rdf:resource="https://w3id.org/mado#ConfiguracaoModalDaDecisao" />
<ns4:acompanhamentoDaConfiguracao xml:lang="pt-BR">Perguntar a um colega o que a imagem demonstra e comparar a resposta com a intenção do estudante.</ns4:acompanhamentoDaConfiguracao>
<ns4:alternativaDaConfiguracao xml:lang="pt-BR">Usar desenho em papel, objeto ou explicação oral e registrar a mesma relação em texto curto.</ns4:alternativaDaConfiguracao>
<ns4:condicaoDaConfiguracao xml:lang="pt-BR">Alinhar previamente com o estudante quais imagens representam corretamente sua explicação.</ns4:condicaoDaConfiguracao>
<ns4:configuraModalidade rdf:resource="https://w3id.org/mado#MOD-IMAGEM" />
<ns4:configuraRecurso rdf:resource="https://w3id.org/mado#REC-CAMERA" />
