<ns4:derivadoDe rdf:resource="https://w3id.org/mado#F08" />
<ns4:enunciado xml:lang="pt-BR">A seleção de modalidades deve considerar conjuntamente a tarefa, as condições funcionais observadas, a proficiência com o recurso, o ambiente e a tecnologia disponível.</ns4:enunciado>
<ns4:estadoDeRevisaoDaFundamentacao>PARCIAL</ns4:estadoDeRevisaoDaFundamentacao>
