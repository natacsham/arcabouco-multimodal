<rdf:Description rdf:about="https://w3id.org/mado#K21">
<rdf:type rdf:resource="https://w3id.org/mado#ConhecimentoMultimodalArticulado" />
<rdf:type rdf:resource="https://w3id.org/mado/catalogue#Record" />
<ns1:label xml:lang="pt-BR">Em interação assistiva, modalidade, ambiente físico, desempenho do dispositivo e tarefa são interdependentes; voz pode ampliar autonomia e, ao mesmo tempo, perder eficiência em ruído ou sob sobrecarga técnica.</ns1:label>
<ns4:aplicavelACaracteristicaRelevanteDaPessoa rdf:resource="https://w3id.org/mado#CAR-ENTRADA-CONVENCIONAL-DIFICIL" />
<ns4:aplicavelACaracteristicaRelevanteDaPessoa rdf:resource="https://w3id.org/mado#CAR-MOVIMENTO-RESIDUAL-DEDOS" />
<ns4:aplicavelAModalidade rdf:resource="https://w3id.org/mado#MOD-AUDIO" />
<ns4:aplicavelAModalidade rdf:resource="https://w3id.org/mado#MOD-VOZ" />
<ns4:aplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-AUTENTICAR-SELECIONAR-DESTINO-A098E60" />
<ns4:aplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-SEGUIR-ROTA-3D861F4" />
<ns4:articulacao xml:lang="pt-BR">João é fundamentado no ACAT/MPD e no RotaColab. O perfil reorganiza resultados sobre voz, sensores/atuadores, mobilidade, arquitetura e desempenho como um padrão situado de decisão, em que nenhuma modalidade é adequada isoladamente de contexto e viabilidade.</ns4:articulacao>
<ns4:articuladoSobPerspectiva rdf:resource="https://w3id.org/mado#P02" />
<ns4:classificacaoOperacional>OPERACIONALIZAVEL</ns4:classificacaoOperacional>
<ns4:condicoesDeAplicabilidadeDoConhecimento rdf:resource="https://w3id.org/mado/catalogue#node-543f17981725a9dfd69ddb86" />
<ns4:derivadoDe rdf:resource="https://w3id.org/mado#F06" />
<ns4:enunciado xml:lang="pt-BR">Em interação assistiva, modalidade, ambiente físico, desempenho do dispositivo e tarefa são interdependentes; voz pode ampliar autonomia e, ao mesmo tempo, perder eficiência em ruído ou sob sobrecarga técnica.</ns4:enunciado>
<ns4:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">K21</ns4:identificador>
<ns4:natureza>RECONSTRUÇÃO ANALÍTICA FORTEMENTE SUSTENTADA</ns4:natureza>
