<ns1:label xml:lang="pt-BR">Uma decisão multimodal situada deve relacionar características funcionais, capacidades observadas, tarefa, barreira, modalidades, recursos e ambiente, sem converter o diagnóstico em prescrição automática.</ns1:label>
<ns4:aplicavelAAmbiente rdf:resource="https://w3id.org/mado#AMB-AUDITORIO" />
<ns4:aplicavelAAmbiente rdf:resource="https://w3id.org/mado#AMB-LABORATORIO-INFORMATICA" />
