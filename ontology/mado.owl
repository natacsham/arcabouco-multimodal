<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
<ns1:comment xml:lang="pt">Vínculo curado reutilizável. Distingue-se da aplicação situada de critério produzida em uma execução.</ns1:comment>
<ns1:label xml:lang="pt">Fundamento de uma capacidade</ns1:label>
</rdf:Description>
