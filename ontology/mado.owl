<ns4:contratoOperacionalSerializado>{"action": "Identificar a informação e as relações relevantes no conteúdo, estruturar sua representação textual e conferir a alternativa com a pessoa.", "analytical_application_ids": ["APP-ART-TRF-04-CONTEUDO-WEB-EQUIVALENTE"], "applicability_witness": {"any": [{"field": "recursos_digitais", "ids": ["RED-CONTEUDO-WEB", "RED-PAGINA-WEB"]}], "rationale": "A adaptação depende da existência ou proposta explícita desta representação/material; função nominal isolada não basta."}, "claim_support": [{"claim_id": "CLM-K38-C-K38-01", "claim_scope_limit": ["Contribui com a preservação do conteúdo e a mediação; não contém, isoladamente, a estrutura completa de unidade revisável, autoria e publicação proposta em K38."], "criterion_id": null, "justification": "Parcela delimitada mobilizada nesta aplicação analítica.", "knowledge_id": "K38", "origin_ids": [], "semantic_pair_review": {"claim_excerpt_ids": ["TD-EV13"], "limit": "Conferência desta aplicação; mantém o estado documental específico de cada premissa.", "origin_excerpt_ids": [], "original_document_rechecked": false, "scope": "CONTEXTUAL_CONTRIBUTION_ONLY", "status": "CONFERIDO_NO_REGISTRO"}}, {"claim_id": "CLM-K42-C-K42-01", "claim_scope_limit": ["Contribui com a necessidade de representação adequada, não apenas conversão técnica para áudio."], "criterion_id": null, "justification": "Parcela delimitada mobilizada nesta aplicação analítica.", "knowledge_id": "K42", "origin_ids": [], "semantic_pair_review": {"claim_excerpt_ids": ["TD-EV12"], "limit": "Conferência desta aplicação; mantém o estado documental específico de cada premissa.", "origin_excerpt_ids": [], "original_document_rechecked": false, "scope": "CONTEXTUAL_CONTRIBUTION_ONLY", "status": "CONFERIDO_NO_REGISTRO"}}, {"claim_id": "CLM-K42-TD-ORI-0001", "claim_scope_limit": ["Somente o item e as condições documentadas; não extrapolar mídia gravada para transmissão ao vivo."], "criterion_id": "CA01", "justification": "Parcela delimitada mobilizada nesta aplicação analítica.", "knowledge_id": "K42", "origin_ids": ["ORI-0001"], "semantic_pair_review": {"claim_excerpt_ids": ["TD-ORI-0001"], "limit": "Conferência desta aplicação; mantém o estado documental específico de cada premissa.", "origin_excerpt_ids": ["TD-ORI-0001"], "original_document_rechecked": false, "scope": "SCOPED_ANALYTICAL_APPLICATION", "status": "CONFERIDO_NO_REGISTRO"}}, {"claim_id": "CLM-K42-C-K42-02", "claim_scope_limit": ["Conferência do requisito 1.3.1 na Recommendation de 2023-10-05, em 2026-10-11. Apoia preservar relações essenciais; não determina sozinho uma tradução única nem comprova a adequação de toda configuração."], "criterion_id": "CA02", "justification": "Parcela delimitada mobilizada nesta aplicação analítica.", "knowledge_id": "K42", "origin_ids": ["ORI-0014"], "semantic_pair_review": {"claim_excerpt_ids": ["TD-ORI-0014"], "limit": "Conferência desta aplicação; mantém o estado documental específico de cada premissa.", "origin_excerpt_ids": ["TD-ORI-0014"], "original_document_rechecked": false, "scope": "SCOPED_ANALYTICAL_APPLICATION", "status": "CONFERIDO_NO_REGISTRO"}}, {"claim_id": "CLM-K38-MMI-NAV", "claim_scope_limit": ["MMI é uma Note sobre requisitos das especificações; não certifica aplicações nem prescreve um recurso didático."], "criterion_id": "CA02", "justification": "Parcela delimitada mobilizada nesta aplicação analítica.", "knowledge_id": "K38", "origin_ids": ["ORI-0012"], "semantic_pair_review": {"claim_excerpt_ids": ["TD-ORI-0012"], "limit": "Conferência desta aplicação; mantém o estado documental específico de cada premissa.", "origin_excerpt_ids": ["TD-ORI-0012"], "original_document_rechecked": false, "scope": "SCOPED_ANALYTICAL_APPLICATION", "status": "CONFERIDO_NO_REGISTRO"}}], "claim_support_audit": {"previous_claim_support": [{"claim_id": "CLM-K42-TD-ORI-0001", "claim_scope_limit": ["Somente o item e as condições documentadas; não extrapolar mídia gravada para transmissão ao vivo."], "crit