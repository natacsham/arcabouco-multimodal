<ns4:criterioAplicavelARecurso rdf:resource="https://w3id.org/mado#RED-VIDEO-CURTO-HISTORIA" />
<ns4:criterioAplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-CONSTRUIR-RECURSO-DIGITAL-HISTORIA" />
<ns4:criterioAplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-CONSUMIR-MIDIA-MATERIAL-A2D1D3F" />
<ns4:criterioAplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-EXPLICAR-CONTEUDO-HISTORIA" />
<ns4:criterioAplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-REVISAR-PUBLICAR-RECURSO" />
<ns4:enunciado xml:lang="pt-BR">Áudio-apenas e vídeo-apenas pré-gravados devem ter alternativa em texto e, para vídeo, audiodescrição.</ns4:enunciado>
<ns4:funcaoDecisoria xml:lang="pt-BR">introduzir ou confirmar uma relação que fala e imagem estática não expressem adequadamente</ns4:funcaoDecisoria>
<ns4:funcaoDecisoria xml:lang="pt-BR">preservar conteúdo audiovisual por modalidades equivalentes</ns4:funcaoDecisoria>
