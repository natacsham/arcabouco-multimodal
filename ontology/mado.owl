laim_id": "CLM-K34-LEGACY", "claim_scope_limit": ["Aplicar somente após caracterizar a interação concreta; diagnóstico isolado exige suspensão."], "criterion_id": "CA74", "justification": "Acordos precisam ser claros e compreensíveis.", "knowledge_id": "K34", "origin_ids": ["ORI-0362", "ORI-0363", "ORI-0364"]}], "reason": "Pares anteriores preservados para auditoria; a identidade do conhecimento não autoriza associar toda afirmação a todos os critérios.", "status": "HISTORICAL_BINDINGS_NOT_OPERATIONAL_SUPPORT"}, "condition_phases": [{"id": "OP-PAD-PAPEIS-TURNOS-AUTORIA:verify_information", "label": "Depois de preparar, conferir com a pessoa se a informação necessária à tarefa permanece disponível e compreensível.", "phase": "verification"}], "conditions": [], "function_ids": ["FUN-CARACTERIZAR-CONDICOES"], "grounded_claim_ids": ["CLM-K35-C-K35-01", "CLM-K34-LEGACY"], "historical_action_preserved": true, "historical_conditions": ["Identificar a informação essencial na tarefa e conferir as condições de percepção, ação e mediação com os participantes."], "historical_function_ids": ["FUN-PRESERVAR-PROTAGONISMO", "FUN-COORDENAR-AUTORIA", "FUN-REDUZIR-SOBRECARGA"], "id": "OP-PAD-PAPEIS-TURNOS-AUTORIA", "independent_support_allowed": true, "input_requirements": [{"meaning_unit": "INFORMACAO_ESSENCIAL_DA_TAREFA", "operator": "ANY_IN_GROUP", "representation_id": "MOD-FALA", "required": true}], "integration_gaps": ["Este contrato não fundamenta, sozinho, uma relação entre modalidades; pode fornecer uma operação parcial."], "limits": ["Não autoriza uma divisão fixa de papéis, regras de turno ou resultado de autoria; estes itens do padrão histórico permanecem a fundamentar.", "As ações do padrão histórico não incluídas neste contrato não foram autorizadas pela migração.", "A caracterização tem apoio documental, mas não há aplicação de critério suficientemente sustentada por estas parcelas; esta operação permanece somente na auditoria até curadoria específica."], "output_spec": 