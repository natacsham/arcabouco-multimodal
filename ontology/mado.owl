<ns4:condicaoDaAplicacaoAnalitica xml:lang="pt-BR">Vídeo pré-gravado pertinente à tarefa; não transmissão ao vivo.</ns4:condicaoDaAplicacaoAnalitica>
<ns4:contribuicaoDaAfirmacao rdf:resource="https://w3id.org/mado#C-K36-01" />
<ns4:contribuicaoDaAfirmacao rdf:resource="https://w3id.org/mado#C-K38-MMI-NAV" />
<ns4:contribuicaoDaAfirmacao rdf:resource="https://w3id.org/mado#C-K42-WCAG-0090" />
