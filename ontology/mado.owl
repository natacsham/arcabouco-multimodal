<rdf:Description rdf:about="https://w3id.org/mado#CA68">
<rdf:type rdf:resource="https://w3id.org/mado#CriterioDeDecisaoMultimodal" />
<rdf:type rdf:resource="https://w3id.org/mado/catalogue#Record" />
<ns1:label xml:lang="pt-BR">A interface não deve restringir ou desabilitar modalidades de entrada disponíveis na plataforma (como teclado, mouse, toque ou voz), a menos que a restrição seja essencial para a segurança ou funcionamento da aplicação.</ns1:label>
<ns4:condicoesDeAplicabilidadeDoConhecimento rdf:resource="https://w3id.org/mado/catalogue#node-c895e94ea7773b5bb1dd8cda" />
<ns4:criterioAplicavelABarreira rdf:resource="https://w3id.org/mado#BAR-AUDIO-PODE-PERDER-EFETIVIDADE-COM-RUIDO-04E2CCE" />
<ns4:criterioAplicavelABarreira rdf:resource="https://w3id.org/mado#BAR-DIGITACAO-SELECAO-CONVENCIONAL-DIFICIL-30CB86A" />
<ns4:criterioAplicavelAModalidade rdf:resource="https://w3id.org/mado#MOD-AUDIO" />
<ns4:criterioAplicavelAModalidade rdf:resource="https://w3id.org/mado#MOD-HAPTICO" />
<ns4:criterioAplicavelAModalidade rdf:resource="https://w3id.org/mado#MOD-VOZ" />
<ns4:criterioAplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-AUTENTICAR-SELECIONAR-DESTINO-A098E60" />
<ns4:criterioAplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-ENVIAR-LER-MENSAGEM-INTERAGIR-COM-MENSAGENS-4C0CACA" />
<ns4:criterioAplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-SEGUIR-ROTA-3D861F4" />
<ns4:criterioAplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-SELECIONAR-DESTINO-2780D83" />
<ns4:enunciado xml:lang="pt-BR">A interface não deve restringir ou desabilitar modalidades de entrada disponíveis na plataforma (como teclado, mouse, toque ou voz), a menos que a restrição seja essencial para a segurança ou funcionamento da aplicação.</ns4:enunciado>
<ns4:funcaoDecisoria xml:lang="pt-BR">manter orientação perceptível quando o áudio é afetado pelo ambiente</ns4:funcaoDecisoria>
<ns4:funcaoDecisoria xml:lang="pt-BR">oferecer alternativa à digitação ou seleção visual</ns4:funcaoDecisoria>
<ns4:funcaoDecisoria xml:lang="pt-BR">oferecer expressão e acesso alternativos ao texto digitado</ns4:funcaoDecisoria>
<ns4:fundamentadoPor rdf:resource="https://w3id.org/mado#K01" />
<ns4:fundamentadoPor rdf:resource="https://w3id.org/mado#K03" />
<ns4:fundamentadoPor rdf:resource="https://w3id.org/mado#K07" />
<ns4:fundamentadoPor rdf:resource="https://w3id.org/mado#K18" />
