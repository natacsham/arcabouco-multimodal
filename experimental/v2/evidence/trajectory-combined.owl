  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mado/experimental/v2#ReviewText">
    <rdf:type rdf:resource="https://w3id.org/mado/experimental/v2#Capability"/>
    <rdfs:label xml:lang="pt">Conferir pelo texto visual</rdfs:label>
    <v2:provides rdf:resource="https://w3id.org/mado/experimental/v2#Review"/>
    <v2:mode rdf:resource="https://w3id.org/mado/experimental/v2#VisualText"/>
    <v2:inputType rdf:resource="https://w3id.org/mado/experimental/v2#TextDraft"/>
    <v2:outputType rdf:resource="https://w3id.org/mado/experimental/v2#ReviewedText"/>
    <v2:requiresResource rdf:resource="https://w3id.org/mado/experimental/v2#EditableText"/>
    <v2:requiresResource rdf:resource="https://w3id.org/mado/experimental/v2#Display"/>
    <v2:requiresFact rdf:resource="https://w3id.org/mado/experimental/v2#ContentAvailable"/>
    <v2:requiresFact rdf:resource="https://w3id.org/mado/experimental/v2#CanReviewVisualText"/>
