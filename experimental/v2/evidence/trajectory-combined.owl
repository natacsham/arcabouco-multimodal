  <rdf:Description rdf:about="https://w3id.org/mado#CA38">
    <rdf:type rdf:resource="https://w3id.org/mado#CriterioDeDecisaoMultimodal"/>
    <rdfs:label xml:lang="pt">Toda funcionalidade deve ser operável por teclado (sem exigir tempo preciso)</rdfs:label>
    <v2:source rdf:resource="https://w3id.org/mado/experimental/v2#SourceKeyboard"/>
    <v2:locator>WCAG 2.2, 2.1.1; origem legada ORI-0238 preservada</v2:locator>
    <v2:justification>CA38 fundamenta a rota de teclado; K41 fornece condições situadas de sua admissibilidade. Não fundamenta voz, revisão ou envio da contribuição.</v2:justification>
    <v2:legacyCollection>criteria</v2:legacyCollection>
    <v2:legacyRecordId>CA38</v2:legacyRecordId>
    <v2:legacyRecordHash>404e90232edaa58d020cf9e7cf42f11fdd3820fc83263160dcfb2c9002da31d2</v2:legacyRecordHash>
    <v2:legacyRecordJSON>{"aag":"-","abnt_17060_mobile":"-","abnt_17225_web":"X","aplicabilidade":{"modalidades":["MOD-TECLADO"],"tarefas":["TAR-PREENCHER-ENVIAR-MENSAGEM-0C1FB87","TAR-EXECUTAR-TAREFAS-NO-AVA-7BEF3BD"]},"auditiva":"-","codigo_trabalho":"AT38","cognitiva":"X","condicoes_ativacao_ids":[],"condicoes_impeditivas_ids":[],"conhecimento_ids":["K25","K28","K29"],"emag":"X","enunciado":"Toda funcionalidade deve ser operável por teclado (sem exigir tempo preciso)","enunciado_base_anterior":"Toda funcionalidade deve ser operável por teclado (sem exigir tempo preciso)","funcao_decisoria":["preservar operação, foco, correção e confirmação"],"id":"CA38","itens_mmi_relacionados":["AT116","AT187","AT201","AT204","AT225","AT233"],"justificativa_fundamentacao":"Em versão anterior, a ligação foi reconstruída analiticamente porque o critério participa de uma configuração modalidade–função–recurso–responsável fundamentada por esses conhecimentos; não se atribui essa formalização retrospectiva às publicações originais.","justificativa_mesclagem":"Operar tudo por teclado elimina dependência de ponteiro e gestos finos (benefício motor), permite navegação coesa com leitor de tela (benefício visual) e reduz confusão com interações imprevisíveis (benefício cognitivo). A norma proíbe exigir pressões em tempos específicos; exceções valem apenas quando a função depende do traçado (p.ex., desenho livre), caso em que informa-se a limitação e, quando possível, oferece-se modo alternativo.","justificativa_relacao_mmi":null,"mobile":"v","motora":"X","observacao":null,"origem_mmi_no_catalogo":"SIM","status_fundamentacao":"FUNDAMENTACAO_ANALITICA_HISTORICA_NAO_AUTORIZA_CONFIGURACAO_RC3","status_relacao_mmi":"RELACAO_SEM_JUSTIFICATIVA_EXPLICITA","tipo_relacao_mmi":"Não registrado","verificacao_enunciado":"COINCIDE","visual":"X","wcag_2_2":"X","web":"X"}</v2:legacyRecordJSON>
  </rdf:Description>
