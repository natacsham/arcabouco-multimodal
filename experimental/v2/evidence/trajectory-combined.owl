  <rdf:Description rdf:about="https://w3id.org/mado/experimental/v2#TrajectoryGroundKeyboard">
    <rdf:type rdf:resource="https://w3id.org/mado/experimental/v2#GroundingApplication"/>
    <v2:capability rdf:resource="https://w3id.org/mado/experimental/v2#CaptureKeyboard"/>
    <v2:justification>CA38 fundamenta a rota de teclado; K41 fornece condições situadas de sua admissibilidade. Não fundamenta voz, revisão ou envio da contribuição.</v2:justification>
