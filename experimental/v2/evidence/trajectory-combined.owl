  <rdf:Description rdf:about="https://w3id.org/mado#K28">
    <rdf:type rdf:resource="https://w3id.org/mado#ConhecimentoMultimodalArticulado"/>
    <rdfs:label xml:lang="pt">Em formulários e comunicação digital, acessibilidade depende de uma sequência operacional compreensível: rótulos/instruções, foco e teclado, identificação de erros, confirmação e feedback de status precisam funcionar de forma coordenada.</rdfs:label>
    <v2:epistemicStatus>PARTIAL_LEGACY</v2:epistemicStatus>
    <v2:legacyReviewStatus>CANDIDATO_RECONSTRUIDO_A_REVISAR</v2:legacyReviewStatus>
    <v2:legacyFoundationStatus>NOT_REVIEWED_IN_PILOT</v2:legacyFoundationStatus>
    <v2:legacyCollection>knowledge</v2:legacyCollection>
    <v2:legacyRecordId>K28</v2:legacyRecordId>
    <v2:legacyRecordHash>cd3969cba23e667432f0283622fdd85c306ba856639a7c880df164be2e26331f</v2:legacyRecordHash>
    <v2:legacyRecordJSON>{"aplicabilidade":{"ambientes":["AMB-CONTEXTO-DIGITAL-DE-APRENDIZAGEM-42D27F5"],"barreiras":["BAR-ROTULOS-FOCO-ERRO-STATUS-INADEQUADOS-219BE43"],"caracteristicas_pessoa":["CAR-PERFIS-FUNCIONAIS-DIVERSOS"],"modalidades":["MOD-TECLADO"],"recursos_disponiveis":["REC-TEXTO-TECLADO-FOCO-FEEDBACK-STATUS-97D641F"],"tarefas":["TAR-PREENCHER-ENVIAR-MENSAGEM-0C1FB87","TAR-EXECUTAR-TAREFAS-NO-AVA-7BEF3BD"]},"articulacao":"A análise da tela de mensagens parte de critérios essenciais violados e estrutura o formulário redesenhado com rótulos, navegação lógica, foco visível, erros, confirmação e status acessível. A decisão não é um item isolado, mas a coordenação de estados e respostas ao longo da tarefa.","classificacao_operacional":"OPERACIONALIZAVEL","condicoes_documentadas":["Formulário","rótulos","teclado","foco","erros","confirmação","status","critérios"],"condicoes_impeditivas_ids":[],"condicoes_necessarias_ids":[],"enunciado":"Em formulários e comunicação digital, acessibilidade depende de uma sequência operacional compreensível: rótulos/instruções, foco e teclado, identificação de erros, confirmação e feedback de status precisam funcionar de forma coordenada.","escopo_caracteristicas_pessoa":"ESPECIFICO_PARA_CARACTERISTICAS_DOCUMENTADAS","estudo_id":"EST07","fonte_ids":["F08"],"funcao_decisoria_ids":["FUN-CONSOLIDAR-COM-FEEDBACK","FUN-ACOMPANHAR-RESULTADO"],"id":"K28","limite":null,"limite_transferencia":"Aplicar somente quando as condições contextuais registradas forem satisfeitas.","natureza":"RECONSTRUÇÃO ANALÍTICA FORTEMENTE SUSTENTADA","origem_estruturacao_semantica":"Relações derivadas de contextos e decisões documentados; complementações RC3 foram estabelecidas somente quando o enunciado, a articulação e os trechos sustentavam a aplicabilidade.","papel_no_cenario":"CONHECIMENTO_CANDIDATO","perspectiva_ids":["P02"],"status_revisao":"CANDIDATO_RECONSTRUIDO_A_REVISAR","trecho_ids":["TD-EV29","TD-EV30"]}</v2:legacyRecordJSON>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mado/experimental/v2#CaptureKeyboard">
    <rdf:type rdf:resource="https://w3id.org/mado/experimental/v2#Capability"/>
    <rdfs:label xml:lang="pt">Registrar por escrita</rdfs:label>
    <v2:provides rdf:resource="https://w3id.org/mado/experimental/v2#Expression"/>
    <v2:mode rdf:resource="https://w3id.org/mado/experimental/v2#WrittenEntry"/>
    <v2:inputType rdf:resource="https://w3id.org/mado/experimental/v2#ContributionContent"/>
