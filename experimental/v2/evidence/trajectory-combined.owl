    <v2:legacyRecordJSON>{"aplicabilidade":{"ambientes":["AMB-CONTEXTO-DIGITAL-DE-APRENDIZAGEM-42D27F5"],"barreiras":["BAR-DEPENDENCIA-DE-UMA-FORMA-UNICA-DE-INTERACAO-RECU-2416DFC","BAR-CANAL-EXCLUSIVAMENTE-TEXTUAL-587ACB3"],"caracteristicas_pessoa":["CAR-PERFIS-FUNCIONAIS-DIVERSOS"],"modalidades":["MOD-TEXTO","MOD-AUDIO","MOD-VOZ","MOD-TECLADO"],"necessidades":["NEC-COMUNICACAO-MULTIFORMATO","NEC-ENTRADA-ALTERNATIVA"],"recursos_disponiveis":["REC-TTS-VOZ-VISUAL-LIBRAS-TECNOLOGIAS-ASSISTIVAS-INT-910BEF5","REC-TEXTO-AUDIO-VIDEO-LIBRAS-84F838D"],"tarefas":["TAR-ENVIAR-LER-MENSAGEM-INTERAGIR-COM-MENSAGENS-4C0CACA","TAR-COMUNICAR-CONTEUDO-1545B38"]},"articulacao":"A tela de mensagens combina barra multimodal, anexos em diferentes mídias e compatibilidade com tecnologias assistivas. O estudo explicita benefícios para perfis visuais, auditivos, motores e cognitivos e preserva a necessidade de compatibilidade e critérios para cada recurso.","classificacao_operacional":"OPERACIONALIZAVEL","condicoes_documentadas":["Mensagens","TTS","voz","aparência","LIBRAS","tecnologias assistivas","Comunicação","texto","áudio","vídeo","anexos","critérios"],"condicoes_impeditivas_ids":[],"condicoes_necessarias_ids":[],"enunciado":"Comunicação em contextos digitais de aprendizagem pode ser ampliada quando a interface admite múltiplas formas de entrada, percepção e expressão, incluindo voz, leitura, LIBRAS e anexos de áudio/vídeo, desde que cada alternativa mantenha acessibilidade própria.","escopo_caracteristicas_pessoa":"ESPECIFICO_PARA_CARACTERISTICAS_DOCUMENTADAS","estudo_id":"EST07","fonte_ids":["F08"],"funcao_decisoria_ids":["FUN-PRESERVAR-ACESSO","FUN-EXPRESSAR-CONHECIMENTO"],"id":"K29","limite":null,"limite_transferencia":"Aplicar somente quando as condições contextuais registradas forem satisfeitas.","natureza":"RECONSTRUÇÃO ANALÍTICA FORTEMENTE SUSTENTADA","origem_estruturacao_semantica":"Relações derivadas de contextos e decisões documentados; complementações RC3 foram estabelecidas somente quando o enunciado, a articulação e os trechos sustentavam a aplicabilidade.","papel_no_cenario":"CONHECIMENTO_CANDIDATO","perspectiva_ids":["P02"],"status_revisao":"CANDIDATO_RECONSTRUIDO_A_REVISAR","trecho_ids":["TD-EV29","TD-EV30"]}</v2:legacyRecordJSON>
  </rdf:Description>
