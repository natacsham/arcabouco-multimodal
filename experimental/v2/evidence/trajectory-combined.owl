  <rdf:Description rdf:about="https://w3id.org/mado/experimental/v2#TrajectoryGroundTextReviewArticulation">
    <rdf:type rdf:resource="https://w3id.org/mado/experimental/v2#ArticulationSupport"/>
    <v2:produces rdf:resource="https://w3id.org/mado/experimental/v2#TrajectoryGroundTextReviewKnowledge"/>
    <v2:operation>Desdobrar o antecedente candidato K28 em uma etapa delimitada de revisão, em conjunto com a opção de prevenção de erros da WCAG e a independência entre entrada e apresentação.</v2:operation>
    <v2:addedUnderstanding>Produzir o rascunho e apresentá-lo não conclui a tarefa: é necessária uma apresentação que a pessoa possa conferir e um mecanismo de correção. Não se afirma que envio ou confirmação final já ocorreram.</v2:addedUnderstanding>
    <v2:status>CURATED_FOR_PILOT</v2:status>
    <v2:bindingStatus>PROPOSED_OPERATIONALIZATION</v2:bindingStatus>
  </rdf:Description>
