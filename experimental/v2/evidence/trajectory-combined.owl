  <rdf:Description rdf:about="https://w3id.org/mado/experimental/v2#TrajectoryGroundAudioReviewArticulation">
    <rdf:type rdf:resource="https://w3id.org/mado/experimental/v2#ArticulationSupport"/>
    <v2:produces rdf:resource="https://w3id.org/mado/experimental/v2#TrajectoryGroundAudioReviewKnowledge"/>
    <v2:operation>Relacionar os antecedentes candidatos de apresentação multiformato e coordenação operacional à descrição primária de TTS e à opção de revisão antes da conclusão.</v2:operation>
    <v2:addedUnderstanding>Uma revisão não precisa ser visual quando outra apresentação do mesmo rascunho permite conferir o significado e controlar a correção. Isso é proposta analítica assistida, não prova de compreensão ou equivalência para a pessoa.</v2:addedUnderstanding>
    <v2:status>CURATED_FOR_PILOT</v2:status>
    <v2:bindingStatus>PROPOSED_OPERATIONALIZATION</v2:bindingStatus>
  </rdf:Description>
