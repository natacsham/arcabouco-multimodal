    <v2:requiresFact rdf:resource="https://w3id.org/mado/experimental/v2#KeyboardFeedbackPerceptible"/>
    <v2:action>Registrar a contribuição por uma interface de teclado operável, mantendo um rascunho editável</v2:action>
    <v2:limitation>Teclado disponível não significa operável pela pessoa; a condição funcional precisa ser confirmada.</v2:limitation>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mado#K41">
    <rdf:type rdf:resource="https://w3id.org/mado#ConhecimentoMultimodalArticulado"/>
    <rdfs:label xml:lang="pt">Uma entrada alternativa somente apoia a tarefa quando o gesto ou movimento exigido é viável, o dispositivo e o sistema são compatíveis, o desempenho é suficiente e o usuário recebe confirmação perceptível.</rdfs:label>
    <v2:epistemicStatus>PARTIAL_LEGACY</v2:epistemicStatus>
    <v2:legacyReviewStatus>CONFERIDO_PARA_O_ESCOPO_RC3</v2:legacyReviewStatus>
    <v2:legacyFoundationStatus>PARCIAL</v2:legacyFoundationStatus>
    <v2:legacyCollection>knowledge</v2:legacyCollection>
    <v2:legacyRecordId>K41</v2:legacyRecordId>
    <v2:legacyRecordHash>d53b8401ee7d9f98d9aa9da1483fed45691b0a26681d2dc557bbd3cc29a6e470</v2:legacyRecordHash>
    <v2:legacyRecordJSON>{"aplicabilidade":{"barreiras":["BAR-RECURSO-INCOMPATIVEL-CAPACIDADE"],"caracteristicas_pessoa":["CAR-OPERACAO-NAO-CONVENCIONAL"],"necessidades":["NEC-ENTRADA-ALTERNATIVA"],"recursos_disponiveis":["REC-ENTRADA-VOZ","REC-TECLADO","REC-SENSORES"],"tarefas":["TAR-OPERAR-SISTEMA"]},"articulacao":"O estudo ACAT/MPD articula movimento residual, baixa visão, webcam, dispositivo de pressão e teclado em tela; o RotaColab mostra falhas quando gesto, touchscreen, rede ou retorno não correspondem às condições reais.","classificacao_operacional":"OPERACIONALIZAVEL","condicoes_documentadas":["TAR-OPERAR-SISTEMA","CAR-OPERACAO-NAO-CONVENCIONAL","BAR-RECURSO-INCOMPATIVEL-CAPACIDADE","NEC-ENTRADA-ALTERNATIVA","REC-ENTRADA-VOZ","REC-TECLADO","REC-SENSORES"],"condicoes_impeditivas_ids":[],"condicoes_necessarias_ids":[],"enunciado":"Uma entrada alternativa somente apoia a tarefa quando o gesto ou movimento exigido é viável, o dispositivo e o sistema são compatíveis, o desempenho é suficiente e o usuário recebe confirmação perceptível.","escopo_caracteristicas_pessoa":"FUNCIONAL_E_NAO_DIAGNOSTICO","estudo_id":null,"fonte_ids":["F01","F05"],"foundation_review_status":"PARCIAL","funcao_decisoria_ids":["FUN-SELECIONAR-MODO-POR-CONDICAO","FUN-FEEDBACK-PERCEPTIVEL"],"id":"K41","limite":"A viabilidade do mecanismo deve ser testada com o movimento, o dispositivo e a tarefa reais.","limite_transferencia":"A viabilidade do mecanismo deve ser testada com o movimento, o dispositivo e a tarefa reais.","natureza":"RECONSTRUCAO_ANALITICA_RASTREAVEL","origem_estruturacao_semantica":"Relação reconstruída pela autora entre trechos do corpus, condições funcionais, tarefa e função decisória; não é atribuída como formulação original às publicações.","papel_no_cenario":"PRODUTO_DE_ARTICULACAO_RC3","pending_foundation_items":["Conferir original e critérios de desempenho; os registros de uma configuração não asseguram viabilidade para outro contexto."],"perspectiva_ids":["P02"],"status_revisao":"CONFERIDO_PARA_O_ESCOPO_RC3","trecho_ids":["TD-RC3-REF-04","TD-RC3-REF-07"]}</v2:legacyRecordJSON>
  </rdf:Description>
