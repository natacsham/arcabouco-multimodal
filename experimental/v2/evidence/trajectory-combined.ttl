<https://w3id.org/mado#C-K41-01> <https://w3id.org/mado/experimental/v2#legacyRecordJSON> "{\"articulation_id\":\"ART-REF-05\",\"contribution_role\":\"AMBIENTE_E_APOIO\",\"excerpt_id\":\"TD-RC3-REF-04\",\"id\":\"C-K41-01\",\"justification\":\"Limita a entrada alternativa pela infraestrutura e pelo aprendizado da ação; não se confunde com incapacidade geral.\",\"knowledge_id\":\"K41\",\"nature\":\"PARAFRASE_DE_REGISTRO\",\"review_date\":\"2026-10-08\",\"reviewer\":\"Assistência computacional; conferência dos registros preservados da RC4, não revisão autoral ou leitura do original\",\"statement\":\"A extração descreve perda de sinal e necessidade de explicação e apoio para acionar informação de localização.\",\"verification_status\":\"CONFERIDA_NO_REGISTRO\"}" .
