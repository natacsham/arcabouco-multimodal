<https://w3id.org/mado#K29> <https://w3id.org/mado/experimental/v2#legacyRecordJSON> "{\"aplicabilidade\":{\"ambientes\":[\"AMB-CONTEXTO-DIGITAL-DE-APRENDIZAGEM-42D27F5\"],\"barreiras\":[\"BAR-DEPENDENCIA-DE-UMA-FORMA-UNICA-DE-INTERACAO-RECU-2416DFC\",\"BAR-CANAL-EXCLUSIVAMENTE-TEXTUAL-587ACB3\"],\"caracteristicas_pessoa\":[\"CAR-PERFIS-FUNCIONAIS-DIVERSOS\"],\"modalidades\":[\"MOD-TEXTO\",\"MOD-AUDIO\",\"MOD-VOZ\",\"MOD-TECLADO\"],\"necessidades\":[\"NEC-COMUNICACAO-MULTIFORMATO\",\"NEC-ENTRADA-ALTERNATIVA\"],\"recursos_disponiveis\":[\"REC-TTS-VOZ-VISUAL-LIBRAS-TECNOLOGIAS-ASSISTIVAS-INT-910BEF5\",\"REC-TEXTO-AUDIO-VIDEO-LIBRAS-84F838D\"],\"tarefas\":[\"TAR-ENVIAR-LER-MENSAGEM-INTERAGIR-COM-MENSAGENS-4C0CACA\",\"TAR-COMUNICAR-CONTEUDO-1545B38\"]},\"articulacao\":\"A tela de mensagens combina barra multimodal, anexos em diferentes mídias e compatibilidade com tecnologias assistivas. O estudo explicita benefícios para perfis visuais, auditivos, motores e cognitivos e preserva a necessidade de compatibilidade e critérios para cada recurso.\",\"claim_audit\":{\"complete_claim_requires_all_parts_supported\":true,\"historical_review_status\":\"CANDIDATO_RECONSTRUIDO_A_REVISAR\",\"historical_status_preserved\":true,\"schema_version\":\"1.5.0-rc1\",\"whole_statement_auto_promoted\":false},\"classificacao_operacional\":\"OPERACIONALIZAVEL\",\"condicoes_documentadas\":[\"Mensagens\",\"TTS\",\"voz\",\"aparência\",\"LIBRAS\",\"tecnologias assistivas\",\"Comunicação\",\"texto\",\"áudio\",\"vídeo\",\"anexos\",\"critérios\"],\"condicoes_impeditivas_ids\":[],\"condicoes_necessarias_ids\":[],\"enunciado\":\"Comunicação em contextos digitais de aprendizagem pode ser ampliada quando a interface admite múltiplas formas de entrada, percepção e expressão, incluindo voz, leitura, LIBRAS e anexos de áudio/vídeo, desde que cada alternativa mantenha acessibilidade própria.\",\"escopo_caracteristicas_pessoa\":\"ESPECIFICO_PARA_CARACTERISTICAS_DOCUMENTADAS\",\"estudo_id\":\"EST07\",\"fonte_i