<https://w3id.org/mado#K28> <https://w3id.org/mado/experimental/v2#legacyRecordId> "K28" .
<https://w3id.org/mado#K28> <https://w3id.org/mado/experimental/v2#legacyRecordJSON> "{\"aplicabilidade\":{\"ambientes\":[\"AMB-CONTEXTO-DIGITAL-DE-APRENDIZAGEM-42D27F5\"],\"barreiras\":[\"BAR-ROTULOS-FOCO-ERRO-STATUS-INADEQUADOS-219BE43\"],\"caracteristicas_pessoa\":[\"CAR-PERFIS-FUNCIONAIS-DIVERSOS\"],\"modalidades\":[\"MOD-TECLADO\"],\"recursos_disponiveis\":[\"REC-TEXTO-TECLADO-FOCO-FEEDBACK-STATUS-97D641F\"],\"tarefas\":[\"TAR-PREENCHER-ENVIAR-MENSAGEM-0C1FB87\",\"TAR-EXECUTAR-TAREFAS-NO-AVA-7BEF3BD\"]},\"articulacao\":\"A análise da tela de mensagens parte de critérios essenciais violados e estrutura o formulário redesenhado com rótulos, navegação lógica, foco visível, erros, confirmação e status acessível. A decisão não é um item isolado, mas a coordenação de estados e respostas ao longo da tarefa.\",\"claim_audit\":{\"complete_claim_requires_all_parts_supported\":true,\"historical_review_status\":\"CANDIDATO_RECONSTRUIDO_A_REVISAR\",\"historical_status_preserved\":true,\"schema_version\":\"1.5.0-rc1\",\"whole_statement_auto_promoted\":false},\"classificacao_operacional\":\"OPERACIONALIZAVEL\",\"condicoes_documentadas\":[\"Formulário\",\"rótulos\",\"teclado\",\"foco\",\"erros\",\"confirmação\",\"status\",\"critérios\"],\"condicoes_impeditivas_ids\":[],\"condicoes_necessarias_ids\":[],\"enunciado\":\"Em formulários e comunicação digital, acessibilidade depende de uma sequência operacional compreensível: rótulos/instruções, foco e teclado, identificação de erros, confirmação e feedback de status precisam funcionar de forma coordenada.\",\"escopo_caracteristicas_pessoa\":\"ESPECIFICO_PARA_CARACTERISTICAS_DOCUMENTADAS\",\"estudo_id\":\"EST07\",\"fonte_ids\":[\"F08\"],\"funcao_decisoria_ids\":[\"FUN-CONSOLIDAR-COM-FEEDBACK\",\"FUN-ACOMPANHAR-RESULTADO\"],\"id\":\"K28\",\"limite\":null,\"limite_transferencia\":\"Aplicar somente quando as condições contextuais registradas forem satisfeitas.\",\"natureza\":\"RECONSTRUÇÃO ANALÍTICA FORTEMENTE SUSTENTADA\",\"operation_claims\":[{\"contribution_ids\":[],\"eligibility\":\"PROPOSED_OPERATIONALIZATION\",\"epistemic_status\":\"PRESERVED_CANDIDATE_NOT_OPERATIONAL_SUPPORT\",\"excerpt_ids\":[\"TD-EV29\",\"TD-EV30\"],\"foundation_status\":\"PENDING\",\"function_ids\":[\"FUN-CONSOLIDAR-COM-FEEDBACK\",\"FUN-ACOMPANHAR-RESULTADO\"],\"id\":\"CLM-K28-LEGACY\",\"limits\":[\"Aplicar somente quando as condições contextuais registradas forem satisfeitas.\"],\"operationalization_status\":\"PROPOSED_FOR_SITUATED_VERIFICATION\",\"pending_items\":[],\"review_basis_ids\":[],\"review_provenance\":\"MIGRATION_OF_EXISTING_RECORDS_2026-10-13_NO_NEW_ORIGINAL_REVIEW\",\"scope\":{\"allow_new_task_with_functional_witness\":true,\"empirical_effect_authorized\":false,\"forbidden_inferences\":[\"DIAGNOSIS_TO_CAPABILITY\",\"GROUP_TO_MEMBER\",\"RESOURCE_TO_OPERATION\",\"DOCUMENTATION_TO_EMPIRICAL_EFFECT\",\"UNKNOWN_TO_ABSENT\"],\"function_ids\":[\"FUN-CONSOLIDAR-COM-FEEDBACK\",\"FUN-ACOMPANHAR-RESULTADO\"],\"task_ids\":[\"TAR-PREENCHER-ENVIAR-MENSAGEM-0C1FB87\",\"TAR-EXECUTAR-TAREFAS-NO-AVA-7BEF3BD\"],\"transfer_rule\":\"FUNCTIONAL_WITNESS_AND_SITUATED_CONDITIONS_REQUIRED\"},\"source_ids\":[\"F08\"],\"statement\":\"Em formulários e comunicação digital, acessibilidade depende de uma sequência operacional compreensível: rótulos/instruções, foco e teclado, identificação de erros, confirmação e feedback de status precisam funcionar de forma coordenada.\",\"status\":\"PROPOSED_OPERATIONALIZATION\",\"support\":[{\"document_url\":null,\"excerpt_id\":\"TD-EV29\",\"locator\":\"50-248883.pdf · 9\",\"original_document_rechecked_in_this_migration\":false,\"review_status\":\"EXISTING_RECORD_ONLY\",\"source_id\":\"F08\",\"support_scope\":\"Enunciado e localização preservados no registro; não houve nova leitura do original.\"},{\"document_url\":null,\"excerpt_id\":\"TD-EV30\",\"locator\":\"50-248883.pdf · 10\",\"original_document_rechecked_in_this_migration\":false,\"review_status\":\"EXISTING_RECORD_ONLY\",\"source_id\":\"F08\",\"support_scope\":\"Enunciado e localização preservados no registro; não houve nova leitura do original.\"}]},{\"contribution_ids\":[],\"eligibility\":\"DOCUMENTED_OPERATIONAL_CLAIM\",\"epistemic_status\":\"DOCUMENTED_SCOPED_DESIGN_PRECEDENT\",\"excerpt_ids\":[\"TD-EV29\"],\"foundation_status\":\"DOCUMENTED_IN_RECORDED_SCOPE\",\"function_ids\":[\"FUN-PERMITIR-REVISAO\",\"FUN-FEEDBACK-PERCEPTIVEL\"],\"id\":\"CLM-K28-SCOPED-1\",\"limits\":[\"Oferece precedente de revisão e confirmação numa tarefa de mensagens; sua transferência para autoria de recurso digital exige justificar a equivalência funcional, não copiar a interface.\",\"A transferência mantém somente esta parcela; o enunciado candidato completo continua pendente.\"],\"operationalization_status\":\"PROPOSED_FOR_SITUATED_VERIFICATION\",\"pending_items\":[],\"review_basis_ids\":[\"C-K38-03\"],\"review_provenance\":\"MIGRATION_OF_EXISTING_RECORDS_2026-10-13_NO_NEW_ORIGINAL_REVIEW\",\"scope\":{\"allow_new_task_with_functional_witness\":true,\"empirical_effect_authorized\":false,\"forbidden_inferences\":[\"DIAGNOSIS_TO_CAPABILITY\",\"GROUP_TO_MEMBER\",\"RESOURCE_TO_OPERATION\",\"DOCUMENTATION_TO_EMPIRICAL_EFFECT\",\"UNKNOWN_TO_ABSENT\"],\"function_ids\":[\"FUN-PERMITIR-REVISAO\",\"FUN-FEEDBACK-PERCEPTIVEL\"],\"task_ids\":[\"TAR-PREENCHER-ENVIAR-MENSAGEM-0C1FB87\",\"TAR-EXECUTAR-TAREFAS-NO-AVA-7BEF3BD\"],\"transfer_rule\":\"FUNCTIONAL_WITNESS_AND_SITUATED_CONDITIONS_REQUIRED\"},\"source_ids\":[\"F08\"],\"statement\":\"O registro de redesenho de mensagens reúne rótulos, instruções, identificação de erros, confirmação e feedback acessível.\",\"status\":\"SUPPORTED_IN_RECORDED_SCOPE\",\"support\":[{\"document_url\":null,\"excerpt_id\":\"TD-EV29\",\"locator\":\"50-248883.pdf · 9\",\"original_document_rechecked_in_this_migration\":false,\"review_status\":\"CONFERIDA_NO_REGISTRO\",\"source_id\":\"F08\",\"support_scope\":\"O registro de redesenho de mensagens reúne rótulos, instruções, identificação de erros, confirmação e