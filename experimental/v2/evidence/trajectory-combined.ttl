<https://w3id.org/mado#K41> <https://w3id.org/mado/experimental/v2#legacyRecordJSON> "{\"aplicabilidade\":{\"barreiras\":[\"BAR-RECURSO-INCOMPATIVEL-CAPACIDADE\"],\"caracteristicas_pessoa\":[\"CAR-OPERACAO-NAO-CONVENCIONAL\"],\"necessidades\":[\"NEC-ENTRADA-ALTERNATIVA\"],\"recursos_disponiveis\":[\"REC-ENTRADA-VOZ\",\"REC-TECLADO\",\"REC-SENSORES\"],\"tarefas\":[\"TAR-OPERAR-SISTEMA\"]},\"articulacao\":\"O estudo ACAT/MPD articula movimento residual, baixa visão, webcam, dispositivo de pressão e teclado em tela; o RotaColab mostra falhas quando gesto, touchscreen, rede ou retorno não correspondem às condições reais.\",\"claim_audit\":{\"complete_claim_requires_all_parts_supported\":true,\"historical_review_status\":\"CONFERIDO_PARA_O_ESCOPO_RC3\",\"historical_status_preserved\":true,\"schema_version\":\"1.5.0-rc1\",\"whole_statement_auto_promoted\":false},\"classificacao_operacional\":\"OPERACIONALIZAVEL\",\"condicoes_documentadas\":[\"TAR-OPERAR-SISTEMA\",\"CAR-OPERACAO-NAO-CONVENCIONAL\",\"BAR-RECURSO-INCOMPATIVEL-CAPACIDADE\",\"NEC-ENTRADA-ALTERNATIVA\",\"REC-ENTRADA-VOZ\",\"REC-TECLADO\",\"REC-SENSORES\"],\"condicoes_impeditivas_ids\":[],\"condicoes_necessarias_ids\":[],\"enunciado\":\"Uma entrada alternativa somente apoia a tarefa quando o gesto ou movimento exigido é viável, o dispositivo e o sistema são compatíveis, o desempenho é suficiente e o usuário recebe confirmação perceptível.\",\"escopo_caracteristicas_pessoa\":\"FUNCIONAL_E_NAO_DIAGNOSTICO\",\"estudo_id\":null,\"fonte_ids\":[\"F01\",\"F05\"],\"foundation_review_status\":\"PARCIAL\",\"funcao_decisoria_ids\":[\"FUN-SELECIONAR-MODO-POR-CONDICAO\",\"FUN-FEEDBACK-PERCEPTIVEL\"],\"id\":\"K41\",\"limite\":\"A viabilidade do mecanismo deve ser testada com o movimento, o dispositivo e a tarefa reais.\",\"limite_transferencia\":\"A viabilidade do mecanismo deve ser testada com o movimento, o dispositivo e a tarefa reais.\",\"natureza\":\"RECONSTRUCAO_ANALITICA_RASTREAVEL\",\"operation_claims\":[{\"contributi