PREFIX ex: <https://w3id.org/mado/execution#>
PREFIX mado: <https://w3id.org/mado#>
SELECT DISTINCT ?requisito ?participacao ?contexto ?funcao ?origem ?afirmacao ?condicao WHERE {
 VALUES ?execucao { <urn:mado:current-execution> }
 ?requisito a mado:FuncaoRequeridaSituada ; ex:forExecution ?execucao ; mado:noContexto ?contexto ; mado:requerFuncao ?funcao .
 OPTIONAL { ?requisito mado:paraParticipacao ?participacao }
 OPTIONAL { ?requisito ex:derivationOrigin ?origem }
 OPTIONAL { ?requisito ex:usesAssertion ?afirmacao }
 OPTIONAL { ?requisito mado:derivadaDaCondicao ?condicao }
} ORDER BY ?contexto ?participacao ?funcao ?afirmacao
