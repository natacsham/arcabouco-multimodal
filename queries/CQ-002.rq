PREFIX mado: <https://w3id.org/mado#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
# Each row is a concrete witness. The first eight columns retain the engine contract.
SELECT DISTINCT ?conhecimento ?enunciado ?modoRecuperacao ?articulacao
       ?tipoArticulacao ?nivelConfirmacao ?funcaoAcrescentada ?correspondencias
       ?entrada ?tarefaContexto ?tarefaConhecimento ?conceitoContexto ?predicado
WHERE {
  VALUES ?ctx { mado:CTX-TRANSFERENCIA-RECURSO-DIGITAL-01 }
  {
    ?conhecimento a mado:ConhecimentoMultimodalArticulado ; mado:enunciado ?enunciado .
    BIND(?conhecimento AS ?entrada)
    FILTER NOT EXISTS { ?conhecimento mado:statusDaRelacao "PRODUTO_DE_ARTICULACAO_RC2" }
    FILTER NOT EXISTS { ?conhecimento mado:statusDaRelacao "PRODUTO_DE_ARTICULACAO_RC3" }
    FILTER NOT EXISTS {
      ?conhecimento mado:impedidoPorElementoDoContexto ?impedimento .
      { ?ctx mado:apresentaBarreira ?impedimento } UNION { ?ctx mado:apresentaNecessidade ?impedimento }
    }
    BIND("DIRETA" AS ?modoRecuperacao)
  } UNION {
    ?articulacao a mado:ArticulacaoDocumentada ;
      mado:habilitadaParaDecisao true ;
      mado:articulaConhecimentoDeEntrada ?entrada ;
      mado:produzConhecimento ?conhecimento ;
      mado:tipoDeArticulacao ?tipoArticulacao ;
      mado:nivelDeConfirmacao ?nivelConfirmacao ;
      mado:articulacaoAcrescentaFuncao ?funcaoAcrescentada .
    ?conhecimento mado:enunciado ?enunciado .
    ?entrada a mado:ConhecimentoMultimodalArticulado .
    ?ctx mado:requerFuncaoDecisoria ?funcaoAcrescentada .
    FILTER(?nivelConfirmacao != "NAO_CONFIRMADA" && ?nivelConfirmacao != "BLOQUEADA")
    BIND("POR_ARTICULACAO" AS ?modoRecuperacao)
  }
  ?ctx mado:temTarefa ?tarefaContexto .
  ?tarefaContexto skos:broader* ?tarefaConhecimento .
  ?entrada mado:aplicavelATarefa ?tarefaConhecimento .
  {
    ?ctx mado:temParticipacao/mado:temCaracteristicaRelevante ?conceitoContexto .
    ?entrada mado:aplicavelACaracteristicaRelevanteDaPessoa ?conceitoContexto .
    BIND(mado:aplicavelACaracteristicaRelevanteDaPessoa AS ?predicado)
    BIND("caracteristica_funcional_situada" AS ?correspondencias)
  } UNION {
    ?ctx mado:apresentaBarreira ?conceitoContexto .
    ?entrada mado:aplicavelABarreira ?conceitoContexto .
    BIND(mado:aplicavelABarreira AS ?predicado)
    BIND("barreira" AS ?correspondencias)
  } UNION {
    ?ctx mado:apresentaNecessidade ?conceitoContexto .
    ?entrada mado:aplicavelANecessidade ?conceitoContexto .
    BIND(mado:aplicavelANecessidade AS ?predicado)
    BIND("necessidade" AS ?correspondencias)
  } UNION {
    ?entrada mado:classificacaoOperacional "PRINCIPIO_GERAL" .
    BIND(mado:classificacaoOperacional AS ?predicado)
    BIND("principio_geral_com_tarefa_compativel" AS ?correspondencias)
  }
}
ORDER BY ?modoRecuperacao ?conhecimento ?articulacao ?entrada ?tarefaContexto ?tarefaConhecimento ?predicado ?conceitoContexto ?funcaoAcrescentada
