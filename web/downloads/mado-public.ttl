mado:K15 a mado:ConhecimentoMultimodalArticulado ;
    rdfs:label "Quando a entrada padrão de uma tecnologia assistiva é incompatível com o movimento funcional disponível, uma entrada alternativa pode ser projetada a partir do movimento residual efetivamente realizável."@pt-BR ;
    mado:aplicavelAAmbiente mado:AMB-TECNOLOGIA-ASSISTIVA-EM-COMPUTADOR-PESSOAL-C82A2AF ;
    mado:aplicavelABarreira mado:BAR-TECLADO-CONVENCIONAL-INVIAVEL-C78982F ;
    mado:aplicavelACaracteristicaRelevanteDaPessoa mado:CAR-ENTRADA-CONVENCIONAL-DIFICIL,
        mado:CAR-MOVIMENTO-RESIDUAL-DEDOS ;
    mado:aplicavelARecursoDisponivel mado:REC-MPD-SENSOR-ACAT-WEBCAM-7A85EC2 ;
    mado:aplicavelATarefa mado:TAR-OPERAR-COMUNICAR-SE-NO-ACAT-3FBCF86 ;
    mado:articulacao "A participante não conseguia usar teclado convencional, tinha poucos movimentos nos dedos e baixa visão. O processo de design selecionou um dispositivo capaz de detectar movimentos/vibrações leves e o integrou ao ACAT como substituto da navegação pelo teclado."@pt-BR ;
    mado:articuladoSobPerspectiva mado:P02 ;
    mado:classificacaoOperacional "OPERACIONALIZAVEL" ;
    mado:derivadoDe mado:F05 ;
    mado:enunciado "Quando a entrada padrão de uma tecnologia assistiva é incompatível com o movimento funcional disponível, uma entrada alternativa pode ser projetada a partir do movimento residual efetivamente realizável."@pt-BR ;
    mado:identificador "K15"^^xsd:string ;
    mado:natureza "RECONSTRUÇÃO ANALÍTICA FORTEMENTE SUSTENTADA" ;
    mado:origemDaEstruturacaoSemantica "Relações derivadas de contextos e decisões documentados; complementações RC3 foram estabelecidas somente quando o enunciado, a articulação e os trechos sustentavam a aplicabilidade."@pt-BR ;
    mado:restricao "ACAT"@pt-BR,
        "MPD"@pt-BR,
        "Movimento residual dos dedos"@pt-BR,
        "arquitetura/desempenho"@pt-BR,
        "baixa visão"@pt-BR,
        "quadriplegia"@pt-BR,
        "webcam"@pt-BR ;
    mado:statusDaRelacao "CONHECIMENTO_CANDIDATO" ;
    mado:sustentadoPorTrecho mado:TD-EV21,
        mado:TD-EV24 .

mado:K16 a mado:ConhecimentoMultimodalArticulado ;
    rdfs:label "Uma estratégia multimodal assistiva só é reutilizável se a combinação de recursos também for tecnicamente viável na arquitetura em que será executada."@pt-BR ;
    mado:aplicavelAAmbiente mado:AMB-TECNOLOGIA-ASSISTIVA-EM-COMPUTADOR-PESSOAL-C82A2AF ;
    mado:aplicavelABarreira mado:BAR-TECLADO-CONVENCIONAL-INVIAVEL-C78982F ;
    mado:aplicavelACaracteristicaRelevanteDaPessoa mado:CAR-ENTRADA-CONVENCIONAL-DIFICIL,
        mado:CAR-MOVIMENTO-RESIDUAL-DEDOS ;
    mado:aplicavelARecursoDisponivel mado:REC-MPD-SENSOR-ACAT-WEBCAM-7A85EC2 ;
    mado:aplicavelATarefa mado:TAR-OPERAR-COMUNICAR-SE-NO-ACAT-3FBCF86 ;
    mado:articulacao "O estudo testa ACAT, MPD, webcam e teclado em diferentes combinações e configurações de CPU. Os resultados mostram que a incorporação do MPD não acrescentou aumento significativo de demanda em relação ao padrão analisado e motivou refinamentos de hardware. Assim, viabilidade técnica passa a integrar o raciocínio de seleção da estratégia."@pt-BR ;
    mado:articuladoSobPerspectiva mado:P02 ;
    mado:classificacaoOperacional "OPERACIONALIZAVEL" ;
    mado:derivadoDe mado:F05 ;
    mado:enunciado "Uma estratégia multimodal assistiva só é reutilizável se a combinação de recursos também for tecnicamente viável na arquitetura em que será executada."@pt-BR ;
    mado:identificador "K16"^^xsd:string ;
    mado:natureza "RECONSTRUÇÃO ANALÍTICA FORTEMENTE SUSTENTADA" ;
    mado:origemDaEstruturacaoSemantica "Relações derivadas de contextos e decisões documentados; complementações RC3 foram estabelecidas somente quando o enunciado, a articulação e os trechos sustentavam a aplicabilidade."@pt-BR ;
    mado:restricao "ACAT"@pt-BR,
        "MPD"@pt-BR,
        "Movimento residual dos dedos"@pt-BR,
        "arquitetura/desempenho"@pt-BR,
        "baixa visão"@pt-BR,
        "quadriplegia"@pt-BR,
        "webcam"@pt-BR ;
    mado:statusDaRelacao "CONHECIMENTO_CANDIDATO" ;
    mado:sustentadoPorTrecho mado:TD-EV22,
        mado:TD-EV23,
        mado:TD-EV24 .

mado:K30 a mado:ConhecimentoMultimodalArticulado ;
    rdfs:label "A reutilização de estratégias de acessibilidade em outros sistemas precisa considerar arquitetura, legado e maturidade técnica da equipe; uma recomendação situada não deve ser generalizada como pacote universal."@pt-BR ;
    mado:aplicavelAAmbiente mado:AMB-CONTEXTO-DIGITAL-DE-APRENDIZAGEM-42D27F5 ;
    mado:aplicavelABarreira mado:BAR-DUVIDA-AMBIGUIDADE-NECESSIDADE-DE-ORIENTACAO-8BC4FE1 ;
    mado:aplicavelARecursoDisponivel mado:REC-AJUDA-TEXTUAL-CONTEXTUAL-POTENCIALMENTE-MULTIMOD-B60AF74 ;
    mado:aplicavelATarefa mado:TAR-EXECUTAR-TAREFAS-NO-AVA-7BEF3BD ;
    mado:articulacao "A conclusão do estudo registra que a generalização para outros AVAs é condicionada pela heterogeneidade arquitetural, sistemas legados e capacidade das equipes de traduzir requisitos em código robusto compatível com tecnologias assistivas. Esse limite passa a integrar a rastreabilidade da recomendação."@pt-BR ;
    mado:articuladoSobPerspectiva mado:P01 ;
    mado:classificacaoOperacional "OPERACIONALIZAVEL" ;
    mado:derivadoDe mado:F08 ;
    mado:enunciado "A reutilização de estratégias de acessibilidade em outros sistemas precisa considerar arquitetura, legado e maturidade técnica da equipe; uma recomendação situada não deve ser generalizada como pacote universal."@pt-BR ;
    mado:identificador "K30"^^xsd:string ;
    mado:natureza "EXPLÍCITO NA FONTE" ;
    mado:origemDaEstruturacaoSemantica "Relações derivadas de contextos e decisões documentados; complementações RC3 foram estabelecidas somente quando o enunciado, a articulação e os trechos sustentavam a aplicabilidade."@pt-BR ;
    mado:restricao "Ajuda contextual"@pt-BR,
        "arquitetura/legado"@pt-BR,
        "assistente virtual"@pt-BR,
        "conteúdo"@pt-BR,
        "mensagens"@pt-BR ;
    mado:statusDaRelacao "CONHECIMENTO_CANDIDATO" ;
    mado:sustentadoPorTrecho mado:TD-EV31 .

