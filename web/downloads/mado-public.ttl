<https://w3id.org/mado#OP-PAD-PAPEIS-TURNOS-AUTORIA> <https://w3id.org/mado#contratoOperacionalSerializado> "{\"action\": \"Identificar quem realiza a atividade e quem pode organizar ou adaptar sua apresentação, preservando as condições declaradas de participação.\", \"claim_support\": [{\"claim_id\": \"CLM-K35-C-K35-01\", \"claim_scope_limit\": [\"Oferece fundamento parcial para considerar quem participa. Não confirma a distribuição específica de papéis do novo cenário.\"], \"criterion_id\": null, \"justification\": \"Parcela contextual documentada; não constitui fundamento deste critério.\", \"knowledge_id\": \"K35\", \"origin_ids\": [], \"semantic_pair_review\": {\"claim_excerpt_ids\": [\"TD-EV34\"], \"limit\": \"Conferência semântica do registro preservado; não nova consulta do original nem autorização do enunciado histórico inteiro.\", \"origin_excerpt_ids\": [], \"original_document_rechecked\": false, \"scope\": \"CONTEXTUAL_CONTRIBUTION_ONLY\", \"status\": \"CONFERIDO_NO_REGISTRO\"}}, {\"claim_id\": \"CLM-K34-LEGACY\", \"claim_scope_limit\": [\"Aplicar somente após caracterizar a interação concreta; diagnóstico isolado exige suspensão.\"], \"criterion_id\": null, \"justification\": \"Parcela contextual documentada; não constitui fundamento deste critério.\", \"knowledge_id\": \"K34\", \"origin_ids\": [], \"semantic_pair_review\": {\"claim_excerpt_ids\": [\"TD-EV07\", \"TD-EV19\", \"TD-EV20\", \"TD-EV39\", \"TD-EV40\", \"TD-EV41\", \"TD-EV42\"], \"limit\": \"Conferência semântica do registro preservado; não nova consulta do original nem autorização do enunciado histórico inteiro.\", \"origin_excerpt_ids\": [], \"original_document_rechecked\": false, \"scope\": \"CONTEXTUAL_CONTRIBUTION_ONLY\", \"status\": \"CONFERIDO_NO_REGISTRO\"}}], \"claim_support_audit\": {\"previous_claim_support\": [{\"claim_id\": \"CLM-K35-C-K35-01\", \"claim_scope_limit\": [\"Oferece fundamento parcial para considerar quem participa. Não confirma a distribuição específica de papéis do novo cenário.\"], \"criterion_id\": \"CA74\", \"justification\": \"Acordos precisam ser claros e compreensíveis.\", \"knowledge_id\": \"K35\", \"origin_ids\": [\"ORI-0362\", \"ORI-0363\", \"ORI-0364\"]}, {\"claim_id\": \"CLM-K34-LEGACY\", \"claim_scope_limit\": [\"Aplicar somente após caracterizar a interação concreta; diagnóstico isolado exige suspensão.\"], \"criterion_id\": \"CA74\", \"justification\": \"Acordos precisam ser claros e compreensíveis.\", \"knowledge_id\": \"K34\", \"origin_ids\": [\"ORI-0362\", \"ORI-0363\", \"ORI-0364\"]}], \"reason\": \"Pares anteriores preservados para auditoria; a identidade do conhecimento não autoriza associar toda afirmação a todos os critérios.\", \"status\": \"HISTORICAL_BINDINGS_NOT_OPERATIONAL_SUPPORT\"}, \"condition_phases\": [{\"id\": \"OP-PAD-PAPEIS-TURNOS-AUTORIA:verify_information\", \"label\": \"Depois de preparar, conferir com a pessoa se a informação necessária à tarefa permanece disponível e compreensível.\", \"phase\": \"verification\"}], \"conditions\": [], \"function_ids\": [\"FUN-CARACTERIZAR-CONDICOES\"], \"grounded_claim_ids\": [\"CLM-K35-C-K35-01\", \"CLM-K34-LEGACY\"], \"historical_action_preserved\": true, \"historical_conditions\": [\"Identificar a informação essencial na tarefa e conferir as condições de percepção, ação e mediação com os participantes.\"], \"historical_function_ids\": [\"FUN-PRESERVAR-PROTAGONISMO\", \"FUN-COORDENAR-AUTORIA\", \"FUN-REDUZIR-SOBRECARGA\"], \"id\": \"OP-PAD-PAPEIS-TURNOS-AUTORIA\", \"independent_support_allowed\": true, \"input_requirements\": [{\"meaning_unit\": \"INFORMACAO_ESSENCIAL_DA_TAREFA\", \"operator\": \"ANY_IN_GROUP\", \"representation_id\": \"MOD-FALA\", \"required\": true}], \"integration_gaps\": [\"Este contrato não fundamenta, sozinho, uma relação entre modalidades; pode fornecer uma operação parcial.\"], \"limits\": [\"Não autoriza uma divisão fixa de papéis, regras de turno ou resultado de autoria; estes itens do padrão histórico permanecem a fundamentar.\", \"As ações do padrão histórico não incluídas neste contrato não foram autorizadas pela migração.\", \"A caracterização tem apoio documental, mas não há aplicação de critério suficientemente sustentada por estas parcelas; esta operação permanece somente na auditoria até curadoria específica.\"], \"output_spec\": [{\"meaning_unit\": \"INFORMACAO_ESSENCIAL_DA_TAREFA\", \"representation_id\": \"MOD-TEXTO\", \"required\": true}], \"rc2_audit\": {\"date\": \"2026-10-21\", \"historical_statement_promoted\": false, \"result\": \"SCOPED_OPERATION_REVIEW\", \"scoped_claim_ids\": [\"CLM-K35-C-K35-01\", \"CLM-K34-LEGACY\"]}, \"relations\": [], \"representation_ids\": [\"MOD-FALA\", \"MOD-TEXTO\"], \"resource_requirements\": {\"all\": [], \"any\": [], \"capability_check_required\": true, \"historical_operator_role_id\": \"PAPEL-PROFESSORA\", \"operator_role_id\": null}, \"role_requirements\": {\"all\": [], \"responsibility\": \"Confirmar quem executa e quem prepara a ação; papéis do exemplo histórico não são exigência geral.\", \"subject_role_ids\": [\"PAPEL-PESSOA-APOIADA\", \"PAPEL-ESTUDANTE\"]}, \"schema_version\": \"1.5.0-rc2\", \"semantic_curation\": {\"claim_ids\": [\"CLM-K34-LEGACY\", \"CLM-K35-C-K35-01\"], \"disposition\": \"SCOPED_CONTRACT_WITH_SITUATED_GATES\", \"history\": {\"sha256\": \"3c5a82395ecfba700ab6d5c5fb366e257851fdb34197f5be8f6c4115dc28d740\", \"state_fields\": {}}, \"human_evaluation\": false, \"reason\": \"Contrato OP-PAD-PAPEIS-TURNOS-AUTORIA: Identificar quem realiza a atividade e quem pode organizar ou adaptar sua apresentação, preservando as condições declaradas de participação. Sua autorização limita-se aos apoios exatos; recursos, acesso e integração continuam sujeitos às verificações declaradas.\", \"review_date\": \"2026-10-25\", \"review_scope\": \"RECORDED_SCOPE_WITH_EXPLICIT_POINT_REVIEWS\", \"schema_version\": \"1.6.0-rc1\", \"whole_statement_promoted\": false}, \"transfer_scope\": {\"allow_new_task_with_functional_witness\": true, \"function_witness_required\": true, \"historical_task_ids\": [\"TAR-COMUNICAR-E-EXPRESSAR\", \"TAR-PRODUZIR-CONTEUDO-MULTIMODAL\"], \"requires_existing_representation\": false, \"task_ids\": []}}" .
