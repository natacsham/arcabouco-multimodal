    mado:categoriaDaCaracteristica "CARACTERISTICA_FUNCIONAL" ;
    mado:condicaoDeUsoDaCaracteristica "A alternativa deve preservar o significado necessário à tarefa."@pt-BR ;
    mado:contraindicacao "Não tratar áudio ou vibração como equivalentes automáticos a qualquer conteúdo visual."@pt-BR ;
    mado:efeitoPossivelNaTarefa "Pode impedir reconhecer conteúdo, estrutura, posição e estado."@pt-BR ;
    mado:identificador "CAR-INTERACAO-NAO-VISUAL"^^xsd:string ;
    mado:statusDoRegistro "CONTROLADO_RC4" .

