        mado:TD-RC3-REF-05 .

mado:K41 a mado:ConhecimentoMultimodalArticulado ;
    rdfs:label "Uma entrada alternativa somente apoia a tarefa quando o gesto ou movimento exigido é viável, o dispositivo e o sistema são compatíveis, o desempenho é suficiente e o usuário recebe confirmação perceptível."@pt-BR ;
    mado:aplicavelABarreira mado:BAR-RECURSO-INCOMPATIVEL-CAPACIDADE ;
    mado:aplicavelACaracteristicaRelevanteDaPessoa mado:CAR-OPERACAO-NAO-CONVENCIONAL ;
