<https://w3id.org/mado#OP-PAD-REVISAO-CONFIRMACAO> <https://w3id.org/mado#contratoOperacionalSerializado> "{\"action\": \"Disponibilizar informação sobre a ação realizada, instruções e possibilidade de conferência ou correção no fluxo da tarefa.\", \"claim_support\": [{\"claim_id\": \"CLM-K28-SCOPED-1\", \"claim_scope_limit\": [\"Oferece precedente de revisão e confirmação numa tarefa de mensagens; sua transferência para autoria de recurso digital exige justificar a equivalência funcional, não copiar a interface.\", \"A transferência mantém somente esta parcela; o enunciado candidato completo continua pendente.\"], \"criterion_id\": \"CA88\", \"justification\": \"O registro de identificação de erro, confirmação e feedback sustenta aplicar a comunicação perceptível de estado (CA88, item WCAG preservado AT88), não uma regra sobre imagens ou estrutura.\", \"knowledge_id\": \"K28\", \"origin_ids\": [\"ORI-0414\"], \"semantic_pair_review\": {\"claim_excerpt_ids\": [\"TD-EV29\"], \"limit\": \"Conferência semântica do registro preservado; não nova consulta do original nem autorização do enunciado histórico inteiro.\", \"origin_excerpt_ids\": [\"TD-ORI-0414\"], \"original_document_rechecked\": false, \"scope\": \"SCOPED_ANALYTICAL_APPLICATION\", \"status\": \"CONFERIDO_NO_REGISTRO\"}}, {\"claim_id\": \"CLM-K38-C-K38-03\", \"claim_scope_limit\": [\"Oferece precedente de revisão e confirmação numa tarefa de mensagens; sua transferência para autoria de recurso digital exige justificar a equivalência funcional, não copiar a interface.\"], \"criterion_id\": null, \"justification\": \"Parcela contextual documentada; não constitui fundamento deste critério.\", \"knowledge_id\": \"K38\", \"origin_ids\": [], \"semantic_pair_review\": {\"claim_excerpt_ids\": [\"TD-EV29\"], \"limit\": \"Conferência semântica do registro preservado; não nova consulta do original nem autorização do enunciado histórico inteiro.\", \"origin_excerpt_ids\": [], \"original_document_rechecked\": false, \"scope\": \"CONTEXTUAL_CONTRIBUTION_ONLY\", \"status\": \"CONFERIDO_NO_REGISTRO\"}}], \"claim_support_audit\": {\"previous_claim_support\": [{\"claim_id\": \"CLM-K28-SCOPED-1\", \"claim_scope_limit\": [\"Oferece precedente de revisão e confirmação numa tarefa de mensagens; sua transferência para autoria de recurso digital exige justificar a equivalência funcional, não copiar a interface.\", \"A transferência mantém somente esta parcela; o enunciado candidato completo continua pendente.\"], \"criterion_id\": \"CA88\", \"justification\": \"Confirmação e estado precisam ser perceptíveis.\", \"knowledge_id\": \"K28\", \"origin_ids\": [\"ORI-0414\", \"ORI-0415\", \"ORI-0416\"]}, {\"claim_id\": \"CLM-K38-C-K38-03\", \"claim_scope_limit\": [\"Oferece precedente de revisão e confirmação numa tarefa de mensagens; sua transferência para autoria de recurso digital exige justificar a equivalência funcional, não copiar a interface.\"], \"criterion_id\": \"CA01\", \"justification\": \"Revisão inclui verificar o significado das representações visuais.\", \"knowledge_id\": \"K38\", \"origin_ids\": [\"ORI-0001\", \"ORI-0002\", \"ORI-0003\"]}, {\"claim_id\": \"CLM-K38-C-K38-03\", \"claim_scope_limit\": [\"Oferece precedente de revisão e confirmação numa tarefa de mensagens; sua transferência para autoria de recurso digital exige justificar a equivalência funcional, não copiar a interface.\"], \"criterion_id\": \"CA02\", \"justification\": \"Estrutura precisa permanecer identificável.\", \"knowledge_id\": \"K38\", \"origin_ids\": [\"ORI-0012\", \"ORI-0013\", \"ORI-0014\"]}], \"reason\": \"Pares anteriores preservados para auditoria; a identidade do conhecimento não autoriza associar toda afirmação a todos os critérios.\", \"status\": \"HISTORICAL_BINDINGS_NOT_OPERATIONAL_SUPPORT\"}, \"condition_phases\": [{\"id\": \"OP-PAD-REVISAO-CONFIRMACAO:verify_information\", \"label\": \"Depois de preparar, conferir com a pessoa se a informação necessária à tarefa permanece disponível e compreensível.\", \"phase\": \"verification\"}], \"conditions\": [], \"function_ids\": [\"FUN-PERMITIR-REVISAO\", \"FUN-FEEDBACK-PERCEPTIVEL\"], \"grounded_claim_ids\": [\"CLM-K28-SCOPED-1\", \"CLM-K38-C-K38-03\"], \"historical_action_preserved\": true, \"historical_conditions\": [\"Identificar a informação essencial na tarefa e conferir as condições de percepção, ação e mediação com os participantes.\"], \"historical_function_ids\": [\"FUN-PERMITIR-REVISAO\", \"FUN-FEEDBACK-PERCEPTIVEL\", \"FUN-ACOMPANHAR-RESULTADO\"], \"id\": \"OP-PAD-REVISAO-CONFIRMACAO\", \"independent_support_allowed\": true, \"input_requirements\": [{\"meaning_unit\": \"INFORMACAO_ESSENCIAL_DA_TAREFA\", \"operator\": \"ANY_IN_GROUP\", \"representation_id\": \"MOD-TEXTO\", \"required\": true}], \"integration_gaps\": [\"Este contrato não fundamenta, sozinho, uma relação entre modalidades; pode fornecer uma operação parcial.\"], \"limits\": [\"Precedente de mensagens; não obriga testar com colega nem comprova efeito de uma etapa editorial de publicação.\", \"As ações do padrão histórico não incluídas neste contrato não foram autorizadas pela migração.\"], \"output_spec\": [{\"meaning_unit\": \"INFORMACAO_ESSENCIAL_DA_TAREFA\", \"representation_id\": \"MOD-TEXTO\", \"required\": true}], \"rc2_audit\": {\"date\": \"2026-10-21\", \"historical_statement_promoted\": false, \"result\": \"SCOPED_OPERATION_REVIEW\", \"scoped_claim_ids\": [\"CLM-K28-SCOPED-1\", \"CLM-K38-C-K38-03\"]}, \"relations\": [], \"representation_ids\": [\"MOD-TEXTO\"], \"resource_requirements\": {\"all\": [], \"any\": [[\"REC-EDITOR-MULTIMIDIA\", \"REC-FEEDBACK-ACESSIVEL\"]], \"capability_check_required\": true, \"historical_operator_role_id\": \"PAPEL-ESTUDANTE\", \"operator_role_id\": null}, \"role_requirements\": {\"all\": [], \"responsibility\": \"Confirmar quem executa e quem prepara a ação; papéis do exemplo histórico não são exigência geral.\", \"subject_role_ids\": [\"PAPEL-PESSOA-APOIADA\", \"PAPEL-ESTUDANTE\"]}, \"schema_version\": \"1.5.0-rc2\", \"semantic_curation\": {\"claim_ids\": [\"CLM-K28-SCOPED-1\", \"CLM-K38-C-K38-03\"], \"disposition\": \"SCOPED_CONTRACT_WITH_SITUATED_GATES\", \"history\": {\"sha256\": \"58ca1359a611450487c642387c2ef887aaf78a3eda224499ef48037de02aee79\", \"state_fields\": {}}, \"human_evaluation\": false, \"reason\": \"Contrato OP-PAD-REVISAO-CONFIRMACAO: Disponibilizar informação sobre a ação realizada, instruções e possibilidade de conferência ou correção no fluxo da tarefa. Sua autorização limita-se aos apoios exatos; recursos, acesso e integração continuam sujeitos às verificações declaradas.\", \"review_date\": \"2026-10-25\", \"review_scope\": \"RECORDED_SCOPE_WITH_EXPLICIT_POINT_REVIEWS\", \"schema_version\": \"1.6.0-rc1\", \"whole_statement_promoted\": false}, \"transfer_scope\": {\"allow_new_task_with_functional_witness\": true, \"function_witness_required\": true, \"historical_task_ids\": [\"TAR-REVISAR-E-CONFIRMAR\"], \"requires_existing_representation\": false, \"task_ids\": []}}" .
