<https://w3id.org/mado#OP-PAD-EXPRESSAO-AUTORAL-FALA-AUDIO> <https://w3id.org/mado#contratoOperacionalSerializado> "{\"action\": \"Quando áudio gravado for a forma escolhida para registrar conteúdo, preparar alternativa que preserve a informação essencial.\", \"applicability_witness\": {\"any\": [{\"field\": \"tarefas\", \"ids\": [\"TAR-COMUNICAR-E-EXPRESSAR\", \"TAR-COMUNICAR-CONTEUDO-1545B38\"]}, {\"field\": \"necessidades\", \"ids\": [\"NEC-COMUNICACAO-MULTIFORMATO\"]}], \"rationale\": \"A autoria e expressão precisam aparecer como ação/necessidade; acesso a conteúdo de outra pessoa não implica produção autoral.\"}, \"claim_support\": [{\"claim_id\": \"CLM-K29-SCOPED-1\", \"claim_scope_limit\": [\"Contribuição apenas contextual: não documenta jogo, ordenação de eventos, relação causal ou consolidação da aprendizagem.\", \"A transferência mantém somente esta parcela; o enunciado candidato completo continua pendente.\"], \"criterion_id\": null, \"justification\": \"Parcela contextual documentada; não constitui fundamento deste critério.\", \"knowledge_id\": \"K29\", \"origin_ids\": [], \"semantic_pair_review\": {\"claim_excerpt_ids\": [\"TD-EV30\"], \"limit\": \"Conferência semântica do registro preservado; não nova consulta do original nem autorização do enunciado histórico inteiro.\", \"origin_excerpt_ids\": [], \"original_document_rechecked\": false, \"scope\": \"CONTEXTUAL_CONTRIBUTION_ONLY\", \"status\": \"CONFERIDO_NO_REGISTRO\"}}, {\"claim_id\": \"CLM-K42-TD-ORI-0142\", \"claim_scope_limit\": [\"Somente o item e as condições documentadas; não extrapolar mídia gravada para transmissão ao vivo.\"], \"criterion_id\": \"CA16\", \"justification\": \"A cláusula registrada de áudio-apenas pré-gravado sustenta alternativa equivalente, com suas exceções; não exige legenda de vídeo sincronizado.\", \"knowledge_id\": \"K42\", \"origin_ids\": [\"ORI-0142\"], \"semantic_pair_review\": {\"claim_excerpt_ids\": [\"TD-ORI-0142\"], \"limit\": \"Conferência semântica do registro preservado; não nova consulta do original nem autorização do enunciado histórico inteiro.\", \"origin_excerpt_ids\": [\"TD-ORI-0142\"], \"original_document_rechecked\": false, \"scope\": \"DIRECT_NORMATIVE_CLAUSE\", \"status\": \"CONFERIDO_NO_REGISTRO\"}}], \"claim_support_audit\": {\"previous_claim_support\": [{\"claim_id\": \"CLM-K29-SCOPED-1\", \"claim_scope_limit\": [\"Contribuição apenas contextual: não documenta jogo, ordenação de eventos, relação causal ou consolidação da aprendizagem.\", \"A transferência mantém somente esta parcela; o enunciado candidato completo continua pendente.\"], \"criterion_id\": \"CA17\", \"justification\": \"A informação sonora gravada precisa de alternativa textual sincronizada ou associada.\", \"knowledge_id\": \"K29\", \"origin_ids\": [\"ORI-0148\", \"ORI-0149\", \"ORI-0150\"]}, {\"claim_id\": \"CLM-K42-TD-ORI-0142\", \"claim_scope_limit\": [\"Somente o item e as condições documentadas; não extrapolar mídia gravada para transmissão ao vivo.\"], \"criterion_id\": \"CA16\", \"justification\": \"Áudio gravado requer alternativa equivalente nos limites registrados de WCAG 1.2.1.\", \"knowledge_id\": \"K42\", \"origin_ids\": [\"ORI-0142\"]}], \"reason\": \"Pares anteriores preservados para auditoria; a identidade do conhecimento não autoriza associar toda afirmação a todos os critérios.\", \"status\": \"HISTORICAL_BINDINGS_NOT_OPERATIONAL_SUPPORT\"}, \"condition_phases\": [{\"id\": \"OP-PAD-EXPRESSAO-AUTORAL-FALA-AUDIO:produce_resource\", \"label\": \"Preparar o recurso proposto e conservar a informação identificada como necessária.\", \"phase\": \"production\"}, {\"id\": \"OP-PAD-EXPRESSAO-AUTORAL-FALA-AUDIO:verify_information\", \"label\": \"Depois de preparar, conferir com a pessoa se a informação necessária à tarefa permanece disponível e compreensível.\", \"phase\": \"verification\"}], \"conditions\": [], \"function_ids\": [\"FUN-EXPRESSAR-CONHECIMENTO\", \"FUN-PRESERVAR-ACESSO\"], \"grounded_claim_ids\": [\"CLM-K29-SCOPED-1\", \"CLM-K42-TD-ORI-0142\"], \"historical_action_preserved\": true, \"historical_conditions\": [\"Identificar a informação essencial na tarefa e conferir as condições de percepção, ação e mediação com os participantes.\"], \"historical_function_ids\": [\"FUN-PRESERVAR-PROTAGONISMO\", \"FUN-EXPRESSAR-CONHECIMENTO\", \"FUN-PERMITIR-REVISAO\"], \"id\": \"OP-PAD-EXPRESSAO-AUTORAL-FALA-AUDIO\", \"independent_support_allowed\": true, \"input_requirements\": [{\"meaning_unit\": \"INFORMACAO_ESSENCIAL_DA_TAREFA\", \"operator\": \"ANY_IN_GROUP\", \"representation_id\": \"MOD-AUDIO\", \"required\": true}], \"integration_gaps\": [], \"limits\": [\"Não infere capacidade de fala, preferência por gravação ou benefício autoral. Esta parcela cobre áudio gravado, não comunicação ao vivo.\", \"As ações do padrão histórico não incluídas neste contrato não foram autorizadas pela migração.\"], \"operation_scope\": \"PREPARATION_FOR_RECIPIENT\", \"output_resource_ids\": [\"REC-DESCRICAO-TEXTUAL\"], \"output_spec\": [{\"meaning_unit\": \"INFORMACAO_ESSENCIAL_DA_TAREFA\", \"representation_id\": \"MOD-TEXTO\", \"required\": true}], \"preparation_responsibility\": \"A pessoa que prepara ou adapta o material executa a ação; a via de acesso é conferida separadamente para cada destinatário.\", \"preparation_role_ids\": [\"PAPEL-RESPONSAVEL-ADAPTACAO\", \"PAPEL-MEDIADOR\", \"PAPEL-PROFESSORA\"], \"rc2_audit\": {\"date\": \"2026-10-21\", \"historical_statement_promoted\": false, \"result\": \"SCOPED_OPERATION_REVIEW\", \"scoped_claim_ids\": [\"CLM-K29-SCOPED-1\", \"CLM-K42-TD-ORI-0142\"]}, \"relations\": [{\"claim_support\": [{\"claim_id\": \"CLM-K29-SCOPED-1\", \"claim_scope_limit\": [\"Contribuição apenas contextual: não documenta jogo, ordenação de eventos, relação causal ou consolidação da aprendizagem.\", \"A transferência mantém somente esta parcela; o enunciado candidato completo continua pendente.\"], \"criterion_id\": null, \"justification\": \"Parcela contextual documentada; não constitui fundamento deste critério.\", \"knowledge_id\": \"K29\", \"origin_ids\": [], \"semantic_pair_review\": {\"claim_excerpt_ids\": [\"TD-EV30\"], \"limit\": \"Conferência semântica do registro preservado; não nova consulta do original nem autorização do enunciado histórico inteiro.\", \"origin_excerpt_ids\": [], \"original_document_rechecked\": false, \"scope\": \"CONTEXTUAL_CONTRIBUTION_ONLY\", \"status\": \"CONFERIDO_NO_REGISTRO\"}}, {\"claim_id\": \"CLM-K42-TD-ORI-0142\", \"claim_scope_limit\": [\"Somente o item e as condições documentadas; não extrapolar mídia gravada para transmissão ao vivo.\"], \"criterion_id\": \"CA16\", \"justification\": \"A cláusula registrada de áudio-apenas pré-gravado sustenta alternativa equivalente, com suas exceções; não exige legenda de vídeo sincronizado.\", \"knowledge_id\": \"K42\", \"origin_ids\": [\"ORI-0142\"], \"semantic_pair_review\": {\"claim_excerpt_ids\": [\"TD-ORI-0142\"], \"limit\": \"Conferência semântica do registro preservado; não nova consulta do original nem autorização do enunciado histórico inteiro.\", \"origin_excerpt_ids\": [\"TD-ORI-0142\"], \"original_document_rechecked\": false, \"scope\": \"DIRECT_NORMATIVE_CLAUSE\", \"status\": \"CONFERIDO_NO_REGISTRO\"}}], \"each_alone_sufficient\": {\"MOD-AUDIO\": null, \"MOD-TEXTO\": null}, \"from_function_ids\": [\"FUN-EXPRESSAR-CONHECIMENTO\"], \"from_representation_ids\": [\"MOD-AUDIO\"], \"goal\": \"Oferecer acesso à informação relevante por uma representação de destino adequada à pessoa.\", \"id\": \"REL-PAD-EXPRESSAO-AUTORAL-FALA-AUDIO-01\", \"information_roles\": [{\"alone_sufficient_for_goal\": null, \"claim_ids\": [\"CLM-K29-SCOPED-1\", \"CLM-K42-TD-ORI-0142\"], \"function_id\": \"FUN-EXPRESSAR-CONHECIMENTO\", \"information_component\": \"CONTRIBUICAO_AUTORAL_INFORMADA\", \"representation_id\": \"MOD-AUDIO\", \"role\": \"Apresentar a informação de partida que delimita a transformação.\", \"role_side\": \"SOURCE\"}, {\"alone_sufficient_for_goal\": null, \"claim_ids\": [\"CLM-K29-SCOPED-1\", \"CLM-K42-TD-ORI-0142\"], \"function_id\": \"FUN-PRESERVAR-ACESSO\", \"information_component\": \"CONTRIBUICAO_AUTORAL_INFORMADA\", \"representation_id\": \"MOD-TEXTO\", \"role\": \"Disponibilizar a mesma informação relevante na representação de destino; preservação deve ser conferida.\", \"role_side\": \"TARGET\"}], \"joint_sufficiency_scope\": \"Alternativa delimitada à informação indicada; não comprova equivalência integral nem exige uso simultâneo das representações.\", \"kind\": \"ALTERNATIVE\", \"meaning_unit\": \"INFORMACAO_ESSENCIAL_DA_TAREFA\", \"preserves\": \"A informação ou o sinal funcional explicitado no caso; não presume equivalência de todo o conteúdo.\", \"required_information\": [\"CONTRIBUICAO_AUTORAL_INFORMADA\"], \"requires_analytical_authorization\": true, \"scope\": \"WITHIN_OPERATION\", \"sufficiency\": \"REQUIRES_SITUATED_CONFIRMATION\", \"temporal\": \"COORDINATION_MUST_BE_SPECIFIED_IN_CONTEXT\", \"temporal_contract\": {\"organization\": \"NO_SIMULTANEITY_REQUIRED\", \"verification_required\": true, \"window_requirement\": \"Conferir a ligação com a informação de origem e a possibilidade de consulta no momento necessário.\"}, \"to_function_ids\": [\"FUN-PRESERVAR-ACESSO\"], \"to_representation_ids\": [\"MOD-TEXTO\"]}], \"representation_ids\": [\"MOD-AUDIO\", \"MOD-TEXTO\"], \"resource_requirements\": {\"all\": [], \"any\": [[\"REC-EDITOR-MULTIMIDIA\"]], \"capability_check_required\": false, \"historical_operator_role_id\": \"PAPEL-ESTUDANTE\", \"operator_role_id\": null}, \"role_requirements\": {\"all\": [], \"responsibility\": \"Confirmar quem executa e quem prepara a ação; papéis do exemplo histórico não são exigência geral.\", \"subject_role_ids\": [\"PAPEL-PESSOA-APOIADA\", \"PAPEL-ESTUDANTE\"]}, \"schema_version\": \"1.5.0-rc2\", \"semantic_curation\": {\"claim_ids\": [\"CLM-K29-SCOPED-1\", \"CLM-K42-TD-ORI-0142\"], \"disposition\": \"SCOPED_CONTRACT_WITH_SITUATED_GATES\", \"history\": {\"sha256\": \"046aa5eba83f719a697dbb3264bd140292dc4178fd08927fcd7cc80861f752f4\", \"state_fields\": {}}, \"human_evaluation\": false, \"reason\": \"Contrato OP-PAD-EXPRESSAO-AUTORAL-FALA-AUDIO: Quando áudio gravado for a forma escolhida para registrar conteúdo, preparar alternativa que preserve a informação essencial. Sua autorização limita-se aos apoios exatos; recursos, acesso e integração continuam sujeitos às verificações declaradas.\", \"review_date\": \"2026-10-25\", \"review_scope\": \"RECORDED_SCOPE_WITH_EXPLICIT_POINT_REVIEWS\", \"schema_version\": \"1.6.0-rc1\", \"whole_statement_promoted\": false}, \"transfer_scope\": {\"allow_new_task_with_functional_witness\": true, \"function_witness_required\": true, \"historical_task_ids\": [\"TAR-COMUNICAR-E-EXPRESSAR\", \"TAR-PRODUZIR-CONTEUDO-MULTIMODAL\"], \"requires_existing_representation\": true, \"task_ids\": []}}" .
