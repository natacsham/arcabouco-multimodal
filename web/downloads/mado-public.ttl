<https://w3id.org/mado#OP-PAD-COMUNICACAO-MULTIFORMATO> <https://w3id.org/mado#contratoOperacionalSerializado> "{\"action\": \"Conferir a compatibilidade da forma de entrada com a ação, os movimentos e os recursos efetivamente disponíveis; manter revisão do que foi registrado.\", \"claim_support\": [{\"claim_id\": \"CLM-K41-C-K41-02\", \"claim_scope_limit\": [\"Apoia testar ação e compatibilidade concretas. Não demonstra que todo acionador ou voz atenderá outra pessoa.\"], \"criterion_id\": null, \"justification\": \"Parcela contextual documentada; não constitui fundamento deste critério.\", \"knowledge_id\": \"K41\", \"origin_ids\": [], \"semantic_pair_review\": {\"claim_excerpt_ids\": [\"TD-RC3-REF-07\"], \"limit\": \"Conferência semântica do registro preservado; não nova consulta do original nem autorização do enunciado histórico inteiro.\", \"origin_excerpt_ids\": [], \"original_document_rechecked\": false, \"scope\": \"CONTEXTUAL_CONTRIBUTION_ONLY\", \"status\": \"CONFERIDO_NO_REGISTRO\"}}, {\"claim_id\": \"CLM-K28-SCOPED-1\", \"claim_scope_limit\": [\"Oferece precedente de revisão e confirmação numa tarefa de mensagens; sua transferência para autoria de recurso digital exige justificar a equivalência funcional, não copiar a interface.\", \"A transferência mantém somente esta parcela; o enunciado candidato completo continua pendente.\"], \"criterion_id\": \"CA88\", \"justification\": \"O registro específico de confirmação e feedback sustenta a comunicação perceptível do estado (CA88, item WCAG preservado AT88); a compatibilidade da entrada, isoladamente, não fundamenta esse critério.\", \"knowledge_id\": \"K28\", \"origin_ids\": [\"ORI-0414\"], \"semantic_pair_review\": {\"claim_excerpt_ids\": [\"TD-EV29\"], \"limit\": \"Conferência semântica do registro preservado; não nova consulta do original nem autorização do enunciado histórico inteiro.\", \"origin_excerpt_ids\": [\"TD-ORI-0414\"], \"original_document_rechecked\": false, \"scope\": \"SCOPED_ANALYTICAL_APPLICATION\", \"status\": \"CONFERIDO_NO_REGISTRO\"}}, {\"claim_id\": \"CLM-K29-SCOPED-1\", \"claim_scope_limit\": [\"Contribuição apenas contextual: não documenta jogo, ordenação de eventos, relação causal ou consolidação da aprendizagem.\", \"A transferência mantém somente esta parcela; o enunciado candidato completo continua pendente.\"], \"criterion_id\": null, \"justification\": \"Parcela contextual documentada; não constitui fundamento deste critério.\", \"knowledge_id\": \"K29\", \"origin_ids\": [], \"semantic_pair_review\": {\"claim_excerpt_ids\": [\"TD-EV30\"], \"limit\": \"Conferência semântica do registro preservado; não nova consulta do original nem autorização do enunciado histórico inteiro.\", \"origin_excerpt_ids\": [], \"original_document_rechecked\": false, \"scope\": \"CONTEXTUAL_CONTRIBUTION_ONLY\", \"status\": \"CONFERIDO_NO_REGISTRO\"}}], \"claim_support_audit\": {\"previous_claim_support\": [{\"claim_id\": \"CLM-K41-C-K41-02\", \"claim_scope_limit\": [\"Apoia testar ação e compatibilidade concretas. Não demonstra que todo acionador ou voz atenderá outra pessoa.\"], \"criterion_id\": \"CA88\", \"justification\": \"Reconhecimento, envio, erro e confirmação exigem retorno perceptível.\", \"knowledge_id\": \"K41\", \"origin_ids\": [\"ORI-0414\", \"ORI-0415\", \"ORI-0416\"]}, {\"claim_id\": \"CLM-K28-SCOPED-1\", \"claim_scope_limit\": [\"Oferece precedente de revisão e confirmação numa tarefa de mensagens; sua transferência para autoria de recurso digital exige justificar a equivalência funcional, não copiar a interface.\", \"A transferência mantém somente esta parcela; o enunciado candidato completo continua pendente.\"], \"criterion_id\": null, \"justification\": \"Parcela documental da operação; nenhum critério específico é atribuído automaticamente.\", \"knowledge_id\": \"K28\", \"origin_ids\": []}, {\"claim_id\": \"CLM-K29-SCOPED-1\", \"claim_scope_limit\": [\"Contribuição apenas contextual: não documenta jogo, ordenação de eventos, relação causal ou consolidação da aprendizagem.\", \"A transferência mantém somente esta parcela; o enunciado candidato completo continua pendente.\"], \"criterion_id\": null, \"justification\": \"Parcela documental da operação; nenhum critério específico é atribuído automaticamente.\", \"knowledge_id\": \"K29\", \"origin_ids\": []}], \"reason\": \"Pares anteriores preservados para auditoria; a identidade do conhecimento não autoriza associar toda afirmação a todos os critérios.\", \"status\": \"HISTORICAL_BINDINGS_NOT_OPERATIONAL_SUPPORT\"}, \"condition_phases\": [{\"id\": \"OP-PAD-COMUNICACAO-MULTIFORMATO:verify_information\", \"label\": \"Depois de preparar, conferir com a pessoa se a informação necessária à tarefa permanece disponível e compreensível.\", \"phase\": \"verification\"}], \"conditions\": [], \"function_ids\": [\"FUN-SELECIONAR-MODO-POR-CONDICAO\", \"FUN-PERMITIR-REVISAO\"], \"grounded_claim_ids\": [\"CLM-K41-C-K41-02\", \"CLM-K28-SCOPED-1\", \"CLM-K29-SCOPED-1\"], \"historical_action_preserved\": true, \"historical_conditions\": [\"Identificar a informação essencial na tarefa e conferir as condições de percepção, ação e mediação com os participantes.\"], \"historical_function_ids\": [\"FUN-SELECIONAR-MODO-POR-CONDICAO\", \"FUN-PRESERVAR-SIGNIFICADO-ENTRE-MODOS\", \"FUN-FEEDBACK-PERCEPTIVEL\"], \"id\": \"OP-PAD-COMUNICACAO-MULTIFORMATO\", \"independent_support_allowed\": true, \"input_requirements\": [{\"meaning_unit\": \"INFORMACAO_ESSENCIAL_DA_TAREFA\", \"operator\": \"ANY_IN_GROUP\", \"representation_id\": \"MOD-VOZ\", \"required\": true}, {\"meaning_unit\": \"INFORMACAO_ESSENCIAL_DA_TAREFA\", \"operator\": \"ANY_IN_GROUP\", \"representation_id\": \"MOD-TECLADO\", \"required\": true}], \"integration_gaps\": [\"Este contrato não fundamenta, sozinho, uma relação entre modalidades; pode fornecer uma operação parcial.\"], \"limits\": [\"Não confirma precisão do reconhecimento de voz nem presume que teclado, fala e leitura sejam utilizáveis pela mesma pessoa.\", \"As ações do padrão histórico não incluídas neste contrato não foram autorizadas pela migração.\"], \"output_spec\": [{\"meaning_unit\": \"INFORMACAO_ESSENCIAL_DA_TAREFA\", \"representation_id\": \"MOD-TEXTO\", \"required\": true}], \"rc2_audit\": {\"date\": \"2026-10-21\", \"historical_statement_promoted\": false, \"result\": \"SCOPED_OPERATION_REVIEW\", \"scoped_claim_ids\": [\"CLM-K41-C-K41-02\", \"CLM-K28-SCOPED-1\", \"CLM-K29-SCOPED-1\"]}, \"relations\": [], \"representation_ids\": [\"MOD-VOZ\", \"MOD-TECLADO\", \"MOD-TEXTO\"], \"resource_requirements\": {\"all\": [], \"any\": [[\"REC-ENTRADA-VOZ\", \"REC-TECLADO\", \"REC-SENSORES\"]], \"capability_check_required\": true, \"historical_operator_role_id\": \"PAPEL-RESPONSAVEL-ADAPTACAO\", \"operator_role_id\": null}, \"role_requirements\": {\"all\": [], \"responsibility\": \"Confirmar quem executa e quem prepara a ação; papéis do exemplo histórico não são exigência geral.\", \"subject_role_ids\": [\"PAPEL-PESSOA-APOIADA\", \"PAPEL-ESTUDANTE\"]}, \"schema_version\": \"1.5.0-rc2\", \"semantic_curation\": {\"claim_ids\": [\"CLM-K28-SCOPED-1\", \"CLM-K29-SCOPED-1\", \"CLM-K41-C-K41-02\"], \"disposition\": \"SCOPED_CONTRACT_WITH_SITUATED_GATES\", \"history\": {\"sha256\": \"95955be3c9942ab9847cca8b122b72b6039283e4881be9b5bf012f79cf7ce706\", \"state_fields\": {}}, \"human_evaluation\": false, \"reason\": \"Contrato OP-PAD-COMUNICACAO-MULTIFORMATO: Conferir a compatibilidade da forma de entrada com a ação, os movimentos e os recursos efetivamente disponíveis; manter revisão do que foi registrado. Sua autorização limita-se aos apoios exatos; recursos, acesso e integração continuam sujeitos às verificações declaradas.\", \"review_date\": \"2026-10-25\", \"review_scope\": \"RECORDED_SCOPE_WITH_EXPLICIT_POINT_REVIEWS\", \"schema_version\": \"1.6.0-rc1\", \"whole_statement_promoted\": false}, \"transfer_scope\": {\"allow_new_task_with_functional_witness\": true, \"function_witness_required\": true, \"historical_task_ids\": [\"TAR-COMUNICAR-E-EXPRESSAR\", \"TAR-OPERAR-SISTEMA\"], \"requires_existing_representation\": false, \"task_ids\": []}}" .
