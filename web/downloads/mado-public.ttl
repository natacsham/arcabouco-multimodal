mado:K35 a mado:ConhecimentoMultimodalArticulado ;
    rdfs:label "Em uma produção digital colaborativa, preservar o protagonismo exige distribuir funções complementares: a pessoa apoiada mantém autoria sobre o conhecimento; a professora enquadra o objetivo, o tempo e a acessibilidade; e os colegas pesquisam, organizam e testam a compreensão sem substituir essa autoria."@pt-BR ;
    mado:aplicavelAAmbiente mado:AMB-LABORATORIO-INFORMATICA,
        mado:AMB-SALA-DE-AULA ;
    mado:aplicavelABarreira mado:BAR-AUTORIA-SEM-COORDENACAO,
        mado:BAR-TRANSICAO-E-CONTRADICAO-DIFICIL ;
    mado:aplicavelANecessidade mado:NEC-COORDENAR-AUTORIA-COLABORATIVA,
        mado:NEC-PRESERVAR-PROTAGONISMO,
        mado:NEC-PRESERVAR-VINCULO-SOCIAL ;
    mado:aplicavelATarefa mado:TAR-CONSTRUIR-RECURSO-DIGITAL-HISTORIA ;
    mado:articulacao "Articula a curadoria multimodal das Personas, a necessidade de contextualizar tarefa e ferramentas, o interesse pessoal observado na elicitação e o princípio de não decidir por diagnóstico. O resultado transforma participação oral em autoria compartilhada com responsabilidades explícitas."@pt-BR ;
    mado:articuladoSobPerspectiva mado:P02,
        mado:P03 ;
    mado:classificacaoOperacional "OPERACIONALIZAVEL" ;
    mado:contribuiParaFuncaoDecisoria mado:FUN-COORDENAR-AUTORIA,
        mado:FUN-PRESERVAR-PROTAGONISMO ;
    mado:derivadoDe mado:F06,
        mado:F07,
        mado:F08,
        mado:F12 ;
    mado:enunciado "Em uma produção digital colaborativa, preservar o protagonismo exige distribuir funções complementares: a pessoa apoiada mantém autoria sobre o conhecimento; a professora enquadra o objetivo, o tempo e a acessibilidade; e os colegas pesquisam, organizam e testam a compreensão sem substituir essa autoria."@pt-BR ;
    mado:identificador "K35"^^xsd:string ;
    mado:limite "A divisão de papéis é uma configuração situada a ser confirmada; não constitui prescrição pedagógica universal."@pt-BR ;
    mado:natureza "CONHECIMENTO_ARTICULADO_RC2" ;
    mado:origemDaEstruturacaoSemantica "Produzido por ART-TRF-01 a partir de conhecimentos e trechos preexistentes, com origem e nível de confirmação explícitos."@pt-BR ;
    mado:requerElementoDoContexto mado:NEC-COORDENAR-AUTORIA-COLABORATIVA ;
    mado:restricao "interesse e conhecimento da pessoa"@pt-BR,
        "mediação"@pt-BR,
        "objetivo curricular"@pt-BR,
        "papéis explícitos"@pt-BR,
        "tarefa coletiva"@pt-BR ;
    mado:statusDaRelacao "PRODUTO_DE_ARTICULACAO_RC2" ;
    mado:sustentadoPorTrecho mado:TD-EL01,
        mado:TD-EL04,
        mado:TD-EL05,
        mado:TD-EV34,
        mado:TD-EV39,
        mado:TD-EV40,
