<https://w3id.org/mado> a owl:Ontology ;
    rdfs:label "MADO — Ontologia do Arcabouço Multimodal para Acessibilidade Digital"@pt-BR ;
    dcterms:creator "Natacsha Ordones Raposo de Melo" ;
    rdfs:comment "Representa a articulação rastreável entre fontes, conhecimento multimodal articulado, critérios, características situadas da pessoa, contextos, decisões e resultados. Não possui classe de deficiência e não automatiza julgamento situado."@pt-BR ;
    owl:priorVersion <https://w3id.org/mado/1.2.0-RC4> ;
    owl:versionIRI <https://w3id.org/mado/1.3.0-rc1> ;
    owl:versionInfo "1.3.0-rc1" ;
    prov:wasDerivedFrom <https://w3id.org/mado/1.2.0-RC4> .

