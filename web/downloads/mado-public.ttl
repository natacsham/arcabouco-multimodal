    mado:identificador "CA84"^^xsd:string ;
    mado:justificativaDeFundamentacao "Oferecer ajuda vinculada à tarefa e ao contexto corrente. Em versão anterior, a ligação foi reconstruída analiticamente porque o critério participa de uma configuração modalidade–função–recurso–responsável fundamentada por esses conhecimentos; não se atribui essa formalização retrospectiva às publicações originais. Na RC2, a ligação ao conhecimento articulado foi conferida para o cenário de transferência e permanece limitada às condições registradas."@pt-BR ;
    mado:possuiOrigem mado:ORI-0398,
        mado:ORI-0399,
        mado:ORI-0400 ;
    mado:statusDaRelacao "RELACAO_SEM_JUSTIFICATIVA_EXPLICITA" .

mado:D-TESTE-RC4-TRANSFERENCIA a mado:DecisaoDeAcessibilidadeMultimodal ;
    rdfs:label "Configuração multimodal situada para construir, revisar e testar um recurso digital com autoria preservada."@pt-BR ;
    mado:alternativa "Realizar a mesma atividade com cartões, quadro ou discussão guiada e feedback oral mais registro textual."@pt-BR,
        "Registrar a contribuição por ditado, desenho comentado ou fala mediada com confirmação imediata."@pt-BR,
        "Revisar em papel ou áudio e registrar manualmente as alterações confirmadas."@pt-BR,
        "Substituir por sequência de imagens descritas, desenho em etapas ou demonstração narrada."@pt-BR,
        "Usar cartões de turno ou uma pauta visual simples, mantendo espaço para contribuição não prevista."@pt-BR,
        "Usar cartões, quadro ou folha com a mesma sequência e digitalizar somente após a revisão."@pt-BR,
        "Usar desenho em papel, objeto ou explicação oral e registrar a mesma relação em texto curto."@pt-BR ;
    mado:aplicaCriterio mado:CA01,
        mado:CA02,
        mado:CA05,
        mado:CA17,
        mado:CA74,
        mado:CA84,
        mado:CA88 ;
    mado:articulaModalidade mado:MOD-AUDIO,
        mado:MOD-FALA,
        mado:MOD-IMAGEM,
        mado:MOD-JOGO-INTERATIVO,
        mado:MOD-TEXTO,
        mado:MOD-VIDEO ;
    mado:atendeRequisitoDeExpressao mado:K33 ;
    mado:condicaoDeAplicacao "Alinhar previamente com o estudante quais imagens representam corretamente sua explicação."@pt-BR,
        "Confirmar objetivo e papéis antes de estruturar os blocos."@pt-BR,
        "Manter versões editáveis e identificar quem aprovou o conteúdo autoral."@pt-BR,
        "Negociar sinais e papéis antes da atividade e permitir ajustes sem exposição pública."@pt-BR,
        "O estudante deve controlar o conteúdo e autorizar a versão final."@pt-BR,
        "Selecionar vídeo apenas se ele acrescentar processo, mudança, contraste ou perspectiva ao objetivo."@pt-BR,
        "Usar somente após o conteúdo ter sido construído e se a plataforma for operável pelos participantes."@pt-BR ;
    mado:consideraRecursoCondicional mado:REC-PLATAFORMA-JOGO-QUIZ,
        mado:REC-REPRODUTOR-VIDEO ;
    mado:empregaRecurso mado:REC-AUDIODESCRICAO,
        mado:REC-CAMERA,
        mado:REC-CELULAR-CAMERA-MICROFONE,
        mado:REC-DESCRICAO-TEXTUAL,
        mado:REC-EDITOR-MULTIMIDIA,
        mado:REC-FEEDBACK-ACESSIVEL,
        mado:REC-LEGENDAS,
        mado:REC-MICROFONE,
        mado:REC-ROTEIRO-COLABORATIVO ;
    mado:enunciado "Configuração multimodal situada para construir, revisar e testar um recurso digital com autoria preservada."@pt-BR ;
    mado:estatutoDoResultadoEsperado "EXPECTATIVA_OBSERVAVEL_NAO_EVIDENCIA_DE_EFICACIA" ;
    mado:identificador "D-TESTE-RC4-TRANSFERENCIA"^^xsd:string ;
    mado:indicadorDeAcompanhamento "Após o trecho, pedir que os participantes indiquem qual relação nova o vídeo tornou compreensível."@pt-BR,
        "Confirmar se o estudante reconhece seu conteúdo e consegue localizar o trecho que deseja revisar."@pt-BR,
        "Observar os tipos de relação que geram dúvida e revisar o bloco correspondente, não apenas contar acertos."@pt-BR,
        "Observar se o estudante mantém autoria, se a professora mantém a condução e se os colegas conseguem contribuir sem ruptura do vínculo."@pt-BR,
        "Pedir a outro participante que retome a sequência e identifique a ideia central de cada bloco."@pt-BR,
        "Perguntar a um colega o que a imagem demonstra e comparar a resposta com a intenção do estudante."@pt-BR,
        "Registrar quais blocos foram compreendidos, adaptados ou suspensos e por quê."@pt-BR ;
    mado:limite "Oráculo de verificação técnica; não substitui julgamento da especialista nem demonstra eficácia pedagógica."@pt-BR ;
    mado:mobilizaArticulacao mado:ART-REF-01,
        mado:ART-REF-02,
        mado:ART-REF-03,
        mado:ART-REF-04,
        mado:ART-REF-05 ;
    mado:possuiConfiguracaoModal mado:CFG-RC4-01,
        mado:CFG-RC4-02,
        mado:CFG-RC4-03,
        mado:CFG-RC4-04,
        mado:CFG-RC4-05,
        mado:CFG-RC4-06,
        mado:CFG-RC4-07 ;
    mado:rationale "Oráculo sintético para verificar o de/para, a articulação entre modos e os estados de disponibilidade da RC4."@pt-BR ;
    mado:respondeA mado:CTX-TRANSFERENCIA-RECURSO-DIGITAL-01 ;
    mado:resultadoEsperado "Observar se a contribuição permanece identificável, se os modos cumprem suas funções sem competir e se a produção pode ser compreendida, revisada e ajustada pelos participantes."@pt-BR ;
    mado:statusDecisao "ORACULO_SINTETICO_NAO_EMPIRICO_RC4" ;
    mado:statusDoRegistro "ORACULO_SINTETICO_NAO_EMPIRICO_RC4" ;
