        "faixa etária"@pt-BR,
        "interesse da pessoa"@pt-BR,
        "objetivo de aprendizagem"@pt-BR,
        "recurso digital"@pt-BR ;
    mado:statusDaRelacao "APOIO_ELICITADO_A_CARACTERIZACAO_NAO_FUNDAMENTO_INDEPENDENTE" ;
