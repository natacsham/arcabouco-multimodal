mado:K25 a mado:ConhecimentoMultimodalArticulado ;
    rdfs:label "Na leitura e navegação de conteúdo educacional, barreiras visuais e de interação podem exigir uma composição multimodal de percepção e controle que combine saída auditiva, entrada por voz e ajustes visuais selecionados pelos critérios aplicáveis."@pt-BR ;
    mado:aplicavelAAmbiente mado:AMB-CONTEXTO-DIGITAL-DE-APRENDIZAGEM-SIGAA-8C300D7 ;
    mado:aplicavelABarreira mado:BAR-ZOOM-CONTRASTE-E-OPERACAO-NAVEGACAO-F73629E ;
    mado:aplicavelACaracteristicaRelevanteDaPessoa mado:CAR-BAIXA-VISAO,
        mado:CAR-ENTRADA-CONVENCIONAL-DIFICIL,
        mado:CAR-NECESSITA-ORGANIZACAO-COGNITIVA ;
    mado:aplicavelARecursoDisponivel mado:REC-TTS-VOZ-CONTROLES-VISUAIS-5D9B39A ;
    mado:aplicavelATarefa mado:TAR-ACESSAR-CONTEUDO-9DCCC00 ;
    mado:articulacao "No caso da tela de conteúdo, o cenário de Camila revela problemas de zoom, contraste, mídia e navegação. O redesign combina TTS, ditado/controle por voz, tamanho de fonte e alto contraste, todos ligados a critérios específicos. A composição é consequência do conjunto de barreiras e não de uma recomendação única isolada."@pt-BR ;
    mado:articuladoSobPerspectiva mado:P02 ;
    mado:classificacaoOperacional "OPERACIONALIZAVEL" ;
    mado:derivadoDe mado:F08 ;
    mado:enunciado "Na leitura e navegação de conteúdo educacional, barreiras visuais e de interação podem exigir uma composição multimodal de percepção e controle que combine saída auditiva, entrada por voz e ajustes visuais selecionados pelos critérios aplicáveis."@pt-BR ;
    mado:identificador "K25"^^xsd:string ;
    mado:natureza "RECONSTRUÇÃO ANALÍTICA FORTEMENTE SUSTENTADA" ;
    mado:origemDaEstruturacaoSemantica "Relações derivadas de contextos e decisões documentados; complementações RC3 foram estabelecidas somente quando o enunciado, a articulação e os trechos sustentavam a aplicabilidade."@pt-BR ;
    mado:restricao "Baixa visão"@pt-BR,
        "TTS"@pt-BR,
        "contraste"@pt-BR,
        "critérios"@pt-BR,
        "fonte"@pt-BR,
        "tela de conteúdo"@pt-BR,
        "voz"@pt-BR ;
    mado:statusDaRelacao "CONHECIMENTO_CANDIDATO" ;
    mado:sustentadoPorTrecho mado:TD-EV27,
        mado:TD-EV28 .

