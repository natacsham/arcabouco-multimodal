knowledge_id\": \"K42\", \"origin_ids\": [\"ORI-0012\", \"ORI-0013\", \"ORI-0014\"]}, {\"claim_id\": \"CLM-K42-TD-ORI-0014\", \"claim_scope_limit\": [\"Somente o item e as condições documentadas; não extrapolar mídia gravada para transmissão ao vivo.\"], \"criterion_id\": \"CA74\", \"justification\": \"A descrição deve ser clara e ligada à tarefa.\", \"knowledge_id\": \"K42\", \"origin_ids\": [\"ORI-0362\", \"ORI-0363\", \"ORI-0364\"]}, {\"claim_id\": \"CLM-K10-SCOPED-1\", \"claim_scope_limit\": [\"Contribui com a necessidade de representação adequada, não apenas conversão técnica para áudio.\", \"A transferência mantém somente esta parcela; o enunciado candidato completo continua pendente.\"], \"criterion_id\": \"CA01\", \"justification\": \"Elementos visuais essenciais precisam de texto alternativo equivalente à função.\", \"knowledge_id\": \"K10\", \"origin_ids\": [\"ORI-0001\", \"ORI-0002\", \"ORI-0003\"]}], \"reason\": \"Pares anteriores preservados para auditoria; a identidade do conhecimento não autoriza associar toda afirmação a todos os critérios.\", \"status\": \"HISTORICAL_BINDINGS_NOT_OPERATIONAL_SUPPORT\"}, \"condition_phases\": [{\"id\": \"OP-PAD-CONTEUDO-WEB-EQUIVALENTE:produce_resource\", \"label\": \"Preparar o recurso proposto e conservar a informação identificada como necessária.\", \"phase\": \"production\"}, {\"id\": \"OP-PAD-CONTEUDO-WEB-EQUIVALENTE:verify_information\", \"label\": \"Depois de preparar, conferir com a pessoa se a informação necessária à tarefa permanece disponível e compreensível.\", \"phase\": \"verification\"}], \"conditions\": [], \"function_ids\": [\"FUN-PRESERVAR-SIGNIFICADO-ENTRE-MODOS\", \"FUN-PRESERVAR-ACESSO\"], \"grounded_claim_ids\": [\"CLM-K38-C-K38-01\", \"CLM-K42-C-K42-01\", \"CLM-K42-TD-ORI-0001\", \"CLM-K42-C-K42-02\", \"CLM-K38-MMI-NAV\"], \"historical_action_preserved\": true, \"historical_conditions\": [\"Identificar a informação essencial na tarefa e conferir as condições de percepção, ação e mediação com os