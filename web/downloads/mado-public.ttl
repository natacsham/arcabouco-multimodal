mado:K43 a mado:ConhecimentoMultimodalArticulado ;
    rdfs:label "Combinar mais modalidades não é suficiente: os modos devem ter papéis distintos, ordem compreensível e controle para evitar competição, sobrecarga e perda de continuidade."@pt-BR ;
    mado:aplicavelABarreira mado:BAR-CONTEUDO-SEM-ESTRUTURA-PERSISTENTE,
        mado:BAR-FORMATOS-COMPETEM-PELA-ATENCAO ;
    mado:aplicavelACaracteristicaRelevanteDaPessoa mado:CAR-NECESSITA-ESTRUTURA-TRANSICAO ;
    mado:aplicavelANecessidade mado:NEC-FUNCAO-EXPLICITA-POR-MODALIDADE,
        mado:NEC-REVISAO-E-CONFIRMACAO ;
    mado:aplicavelATarefa mado:TAR-ORGANIZAR-CONTEUDO-DIGITAL,
        mado:TAR-PRODUZIR-CONTEUDO-MULTIMODAL ;
    mado:articulacao "Resultados das personas e dos estudos educacionais mostram que disponibilidade de formatos pode coexistir com confusão; a contextualização funcional e a validação das personas exigem tarefa, tecnologia assistiva e critérios explícitos."@pt-BR ;
    mado:articuladoSobPerspectiva mado:P02 ;
    mado:classificacaoOperacional "OPERACIONALIZAVEL" ;
    mado:contribuiParaFuncaoDecisoria mado:FUN-ORGANIZAR-CONTEUDO,
        mado:FUN-PERMITIR-REVISAO,
        mado:FUN-REDUZIR-SOBRECARGA ;
    mado:derivadoDe mado:F06,
        mado:F07,
        mado:F08 ;
    mado:enunciado "Combinar mais modalidades não é suficiente: os modos devem ter papéis distintos, ordem compreensível e controle para evitar competição, sobrecarga e perda de continuidade."@pt-BR ;
    mado:identificador "K43"^^xsd:string ;
    mado:limite "A organização reduz uma barreira possível, mas não demonstra resultado pedagógico sem observação da tarefa."@pt-BR ;
    mado:natureza "RECONSTRUCAO_ANALITICA_RASTREAVEL" ;
    mado:origemDaEstruturacaoSemantica "Relação reconstruída pela autora entre trechos do corpus, condições funcionais, tarefa e função decisória; não é atribuída como formulação original às publicações."@pt-BR ;
    mado:restricao "BAR-CONTEUDO-SEM-ESTRUTURA-PERSISTENTE"@pt-BR,
        "BAR-FORMATOS-COMPETEM-PELA-ATENCAO"@pt-BR,
