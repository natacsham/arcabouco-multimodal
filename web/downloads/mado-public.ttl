<https://w3id.org/mado#OP-PAD-RETORNO-HAPTICO-RUIDO> <https://w3id.org/mado#contratoOperacionalSerializado> "{\"action\": \"Examinar um sinal tátil para avisar sobre a orientação quando o áudio é prejudicado, mantendo o significado na mensagem recuperável.\", \"analytical_application_ids\": [\"APP-ART-REF-02-HAPTIC-AUDIO\"], \"applicability_witness\": {\"all\": [{\"field\": \"modalidades\", \"ids\": [\"MOD-AUDIO\"]}, {\"field\": \"barreiras\", \"ids\": [\"BAR-AUDIO-PODE-PERDER-EFETIVIDADE-COM-RUIDO-04E2CCE\"]}, {\"field\": \"tarefas\", \"ids\": [\"TAR-NAVEGAR-E-ORIENTAR-SE\", \"TAR-ACOMPANHAR-ORIENTACAO-317CD64\"]}], \"rationale\": \"Exige orientação sonora situada e sua barreira própria; a coincidência com retomada ou feedback genéricos não autoriza transferência.\"}, \"claim_support\": [{\"claim_id\": \"CLM-K40-C-K40-02\", \"claim_scope_limit\": [\"Registra sugestões de participantes, não eficácia demonstrada de toda combinação áudio-háptica.\"], \"criterion_id\": \"CA88\", \"justification\": \"A sugestão registrada de retorno háptico apoia sinalizar perceptivelmente a disponibilidade da orientação (CA88, item WCAG preservado AT88). A vibração não substitui o conteúdo da mensagem nem prova seu entendimento.\", \"knowledge_id\": \"K40\", \"origin_ids\": [\"ORI-0414\"], \"semantic_pair_review\": {\"claim_excerpt_ids\": [\"TD-RC3-REF-05\"], \"limit\": \"Conferência semântica do registro preservado; não nova consulta do original nem autorização do enunciado histórico inteiro.\", \"origin_excerpt_ids\": [\"TD-ORI-0414\"], \"original_document_rechecked\": false, \"scope\": \"SCOPED_ANALYTICAL_APPLICATION\", \"status\": \"CONFERIDO_NO_REGISTRO\"}}], \"claim_support_audit\": {\"previous_claim_support\": [{\"claim_id\": \"CLM-K40-C-K40-02\", \"claim_scope_limit\": [\"Registra sugestões de participantes, não eficácia demonstrada de toda combinação áudio-háptica.\"], \"criterion_id\": \"CA84\", \"justification\": \"A sinalização precisa estar vinculada ao momento em que a orientação é necessária.\", \"knowledge_id\": \"K40\", \"origin_ids\": [\"ORI-0398\", \"ORI-0399\", \"ORI-0400\"]}, {\"claim_id\": \"CLM-K40-C-K40-02\", \"claim_scope_limit\": [\"Registra sugestões de participantes, não eficácia demonstrada de toda combinação áudio-háptica.\"], \"criterion_id\": \"CA88\", \"justification\": \"O retorno da ação precisa ser percebido sem exigir mudança de foco.\", \"knowledge_id\": \"K40\", \"origin_ids\": [\"ORI-0414\", \"ORI-0415\", \"ORI-0416\"]}], \"reason\": \"Pares anteriores preservados para auditoria; a identidade do conhecimento não autoriza associar toda afirmação a todos os critérios.\", \"status\": \"HISTORICAL_BINDINGS_NOT_OPERATIONAL_SUPPORT\"}, \"condition_phases\": [{\"id\": \"OP-PAD-RETORNO-HAPTICO-RUIDO:verify_information\", \"label\": \"Depois de preparar, conferir com a pessoa se a informação necessária à tarefa permanece disponível e compreensível.\", \"phase\": \"verification\"}], \"conditions\": [], \"function_ids\": [\"FUN-FEEDBACK-PERCEPTIVEL\", \"FUN-MANTER-INFORMACAO-RECUPERAVEL\"], \"grounded_claim_ids\": [\"CLM-K40-C-K40-02\"], \"historical_action_preserved\": true, \"historical_conditions\": [\"Identificar a informação essencial na tarefa e conferir as condições de percepção, ação e mediação com os participantes.\"], \"historical_function_ids\": [\"FUN-FEEDBACK-PERCEPTIVEL\"], \"id\": \"OP-PAD-RETORNO-HAPTICO-RUIDO\", \"independent_support_allowed\": false, \"input_requirements\": [{\"meaning_unit\": \"INFORMACAO_ESSENCIAL_DA_TAREFA\", \"operator\": \"ANY_IN_GROUP\", \"representation_id\": \"MOD-AUDIO\", \"required\": true}], \"integration_gaps\": [], \"limits\": [\"Sugestão documentada de participantes; percepção e significado do sinal dependem de teste situado, sem eficácia universal.\", \"As ações do padrão histórico não incluídas neste contrato não foram autorizadas pela migração.\", \"Saída de áudio operante não comprova retenção da orientação nem controle de repetição; a recuperação da mesma mensagem exige confirmação situada própria.\"], \"output_spec\": [{\"meaning_unit\": \"INFORMACAO_ESSENCIAL_DA_TAREFA\", \"representation_id\": \"MOD-HAPTICO\", \"required\": true}, {\"meaning_unit\": \"INFORMACAO_ESSENCIAL_DA_TAREFA\", \"representation_id\": \"MOD-AUDIO\", \"required\": true}], \"rc2_audit\": {\"date\": \"2026-10-21\", \"historical_statement_promoted\": false, \"result\": \"SCOPED_OPERATION_REVIEW\", \"scoped_claim_ids\": [\"CLM-K40-C-K40-02\"]}, \"relations\": [{\"analytical_application_ids\": [\"APP-ART-REF-02-HAPTIC-AUDIO\"], \"claim_support\": [{\"claim_id\": \"CLM-K40-C-K40-02\", \"claim_scope_limit\": [\"Registra sugestões de participantes, não eficácia demonstrada de toda combinação áudio-háptica.\"], \"criterion_id\": \"CA88\", \"justification\": \"A sugestão registrada de retorno háptico apoia sinalizar perceptivelmente a disponibilidade da orientação (CA88, item WCAG preservado AT88). A vibração não substitui o conteúdo da mensagem nem prova seu entendimento.\", \"knowledge_id\": \"K40\", \"origin_ids\": [\"ORI-0414\"], \"semantic_pair_review\": {\"claim_excerpt_ids\": [\"TD-RC3-REF-05\"], \"limit\": \"Conferência semântica do registro preservado; não nova consulta do original nem autorização do enunciado histórico inteiro.\", \"origin_excerpt_ids\": [\"TD-ORI-0414\"], \"original_document_rechecked\": false, \"scope\": \"SCOPED_ANALYTICAL_APPLICATION\", \"status\": \"CONFERIDO_NO_REGISTRO\"}}], \"each_alone_sufficient\": {\"MOD-AUDIO\": false, \"MOD-HAPTICO\": false}, \"from_function_ids\": [\"FUN-FEEDBACK-PERCEPTIVEL\"], \"from_representation_ids\": [\"MOD-AUDIO\"], \"goal\": \"Perceber o aviso tátil necessário e recuperar o conteúdo da mesma orientação sonora.\", \"id\": \"REL-PAD-RETORNO-HAPTICO-RUIDO-01\", \"information_roles\": [{\"alone_sufficient_for_goal\": false, \"claim_ids\": [\"CLM-K40-C-K40-02\", \"CLM-K40-CARE-COMPLEMENTARITY\"], \"function_id\": \"FUN-FEEDBACK-PERCEPTIVEL\", \"information_component\": \"DISPONIBILIDADE_DA_MENSAGEM\", \"representation_id\": \"MOD-HAPTICO\", \"role\": \"Anunciar a disponibilidade da orientação; não codifica sua instrução verbal.\"}, {\"alone_sufficient_for_goal\": false, \"claim_ids\": [\"CLM-K40-C-K40-01\", \"CLM-K40-CARE-COMPLEMENTARITY\"], \"function_id\": \"FUN-MANTER-INFORMACAO-RECUPERAVEL\", \"information_component\": \"CONTEUDO_DA_ORIENTACAO\", \"representation_id\": \"MOD-AUDIO\", \"role\": \"Fornecer conteúdo recuperável do evento anunciado; não realiza o aviso tátil exigido neste arranjo.\"}], \"joint_sufficiency_scope\": \"Somente para o objetivo composto confirmado e a alocação proposta aviso/conteúdo; não equivale a comprovar compreensão ou segurança da navegação.\", \"kind\": \"COMPLEMENTARITY\", \"meaning_unit\": \"INFORMACAO_ESSENCIAL_DA_TAREFA\", \"preserves\": \"A informação ou o sinal funcional explicitado no caso; não presume equivalência de todo o conteúdo.\", \"required_information\": [\"DISPONIBILIDADE_DA_MENSAGEM\", \"CONTEUDO_DA_ORIENTACAO\"], \"requires_analytical_authorization\": true, \"scope\": \"WITHIN_OPERATION\", \"sufficiency\": \"REQUIRES_SITUATED_CONFIRMATION\", \"temporal\": \"COORDINATION_MUST_BE_SPECIFIED_IN_CONTEXT\", \"temporal_contract\": {\"binding_status\": \"PROPOSED_ALLOCATION_REQUIRES_SITUATED_CONFIRMATION\", \"organization\": \"SEQUENTIAL_OR_CO_TEMPORAL_WITH_BOUND_EVENT\", \"verification_required\": true, \"window_requirement\": \"A janela liga o aviso ao acesso à mesma mensagem; duração a confirmar no contexto.\"}, \"to_function_ids\": [\"FUN-MANTER-INFORMACAO-RECUPERAVEL\"], \"to_representation_ids\": [\"MOD-HAPTICO\", \"MOD-AUDIO\"]}], \"representation_ids\": [\"MOD-AUDIO\", \"MOD-HAPTICO\"], \"requires_facts\": [{\"id\": \"OP-PAD-RETORNO-HAPTICO-RUIDO:recoverable_message\", \"label\": \"A mesma orientação sonora continua disponível, e a pessoa consegue acionar sua repetição quando recebe o sinal tátil?\"}, {\"id\": \"AudioUsable\", \"label\": \"A pessoa consegue acessar a mensagem sonora neste ambiente?\"}, {\"id\": \"OP-PAD-RETORNO-HAPTICO-RUIDO:tactile_notice_needed\", \"label\": \"Nesta tarefa, a pessoa precisa de um aviso tátil adicional e consegue distingui-lo?\"}, {\"id\": \"OP-PAD-RETORNO-HAPTICO-RUIDO:same_event_binding\", \"label\": \"O aviso tátil identifica a mesma orientação sonora, que pode ser retomada no momento necessário?\"}], \"resource_requirements\": {\"all\": [\"REC-VIBRACAO\", \"REC-SAIDA-AUDIO\"], \"any\": [], \"capability_check_required\": true, \"historical_operator_role_id\": \"PAPEL-PESSOA-APOIADA\", \"operator_role_id\": null}, \"role_requirements\": {\"all\": [], \"responsibility\": \"Confirmar quem executa e quem prepara a ação; papéis do exemplo histórico não são exigência geral.\", \"subject_role_ids\": [\"PAPEL-PESSOA-APOIADA\", \"PAPEL-ESTUDANTE\"]}, \"schema_version\": \"1.5.0-rc2\", \"selected_representation_ids\": [\"MOD-HAPTICO\", \"MOD-AUDIO\"], \"semantic_change_history\": {\"date\": \"2026-10-25\", \"previous_analytical_application_ids\": [], \"previous_selected_representation_ids\": []}, \"semantic_curation\": {\"claim_ids\": [\"CLM-K40-C-K40-02\"], \"disposition\": \"SCOPED_CONTRACT_WITH_SITUATED_GATES\", \"history\": {\"sha256\": \"58bd715bdf77327df08a8681d26e46a3ddc0149f3fdf01f997f75c44969368a8\", \"state_fields\": {}}, \"human_evaluation\": false, \"reason\": \"Contrato OP-PAD-RETORNO-HAPTICO-RUIDO: Examinar um sinal tátil para avisar sobre a orientação quando o áudio é prejudicado, mantendo o significado na mensagem recuperável. Sua autorização limita-se aos apoios exatos; recursos, acesso e integração continuam sujeitos às verificações declaradas.\", \"review_date\": \"2026-10-25\", \"review_scope\": \"RECORDED_SCOPE_WITH_EXPLICIT_POINT_REVIEWS\", \"schema_version\": \"1.6.0-rc1\", \"whole_statement_promoted\": false}, \"transfer_scope\": {\"allow_new_task_with_functional_witness\": false, \"function_witness_required\": true, \"historical_task_ids\": [\"TAR-NAVEGAR-E-ORIENTAR-SE\"], \"requires_existing_representation\": true, \"task_ids\": [\"TAR-NAVEGAR-E-ORIENTAR-SE\", \"TAR-ACOMPANHAR-ORIENTACAO-317CD64\"]}}" .
