mado:CAR-EXPERIENCIA-DIGITAL-VARIAVEL a skos:Concept ;
    skos:inScheme <https://w3id.org/mado/scheme/CARACTERISTICA_PESSOA> ;
    skos:prefLabel "A experiência com o recurso digital pode alterar a execução da tarefa"@pt-BR ;
    mado:caracteristicaDerivadaDeFonte mado:F01,
        mado:F05 ;
    mado:caracteristicaSustentadaPorTrecho mado:TD-RC3-REF-03,
        mado:TD-RC3-REF-07 ;
    mado:categoriaDaCaracteristica "EXPERIENCIA_E_PROFICIENCIA_DIGITAL" ;
    mado:condicaoDeUsoDaCaracteristica "Observar a execução real e permitir ajuda sem encobrir a ruptura."@pt-BR ;
    mado:contraindicacao "Não inferir proficiência do uso de uma tecnologia semelhante."@pt-BR ;
    mado:efeitoPossivelNaTarefa "Tecnologia assistiva lenta, gesto desconhecido ou retorno ambíguo pode bloquear a ação."@pt-BR ;
    mado:identificador "CAR-EXPERIENCIA-DIGITAL-VARIAVEL"^^xsd:string ;
    mado:statusDoRegistro "CONTROLADO_1_2_RC3" .

mado:CTX-DEMO-MOB-RUIDO a mado:ContextoDeInteracaoDigital ;
    rdfs:label "Orientação no celular em ambiente ruidoso"@pt-BR ;
    mado:apresentaBarreira mado:BAR-AUDIO-PODE-PERDER-EFETIVIDADE-COM-RUIDO-04E2CCE,
        mado:BAR-EFEMERIDADE-DO-FEEDBACK-AUDITIVO-611AFB8,
        mado:BAR-INFORMACAO-EM-UM-SO-MODO ;
    mado:apresentaNecessidade mado:NEC-FUNCAO-EXPLICITA-POR-MODALIDADE,
        mado:NEC-REDUNDANCIA-PERCEPTIVA,
        mado:NEC-REVISAO-E-CONFIRMACAO ;
    mado:consideraCaracteristicaRelevanteDaPessoa mado:CAR-INTERACAO-NAO-VISUAL ;
    mado:descricaoDoContexto "Neste exemplo sintético, uma pessoa que realiza a interação de forma não visual acompanha instruções de um aplicativo de orientação no smartphone durante um deslocamento. O aplicativo apresenta mensagens em áudio, mas não oferece uma forma simples de recuperar a última orientação; o ruído pode impedir sua percepção contínua. O celular tem saída de áudio e vibração operantes. Assume-se, para este teste, que a pessoa percebe o sinal tátil e opera os controles básicos do aplicativo. A tarefa é localizar, repetir e confirmar as orientações sem depender apenas da memória. O retorno acessível e a associação da vibração à mensagem ainda precisam ser preparados. Não se pressupõem mapa, GPS, internet ou fones de ouvido; nenhum outro recurso foi declarado impedido neste exemplo."@pt-BR ;
    mado:descritoSobPerspectiva mado:P02 ;
    mado:envolveRecursoDigital mado:RED-APLICATIVO-ORIENTACAO ;
    mado:identificador "CTX-DEMO-MOB-RUIDO"^^xsd:string ;
    mado:impedimentosVerificados true ;
    mado:natureza "SINTETICO_COBERTURA" ;
    mado:objetivo "Acompanhar orientação móvel em ambiente ruidoso."@pt-BR ;
    mado:ocorreEmAmbiente mado:AMB-MOBILIDADE-EM-AMBIENTE-FISICO-570C361 ;
    mado:operacaoDoRecurso "A pessoa apoiada utiliza os controles básicos do aplicativo e confirma a orientação; saída sonora e motor de vibração são meios atuais. Repetição acessível e vínculo entre sinal tátil e mensagem são ajustes a preparar e testar, não fatos já implementados."@pt-BR ;
    mado:premissaDoExemplo "A pessoa opera os controles básicos do aplicativo e percebe a vibração no recorte do exemplo; isso deve ser conferido antes do uso real."@pt-BR,
        "Cenário sintético de demonstração, sem participante humano avaliado."@pt-BR,
        "Não foram definidos impedimentos adicionais de recursos; a limitação do áudio em ruído permanece explícita."@pt-BR,
        "O recurso digital é um aplicativo de orientação, sem pressupor mapa, GPS, internet ou produto específico."@pt-BR,
        "Saída de áudio e vibração estão operantes; fones não são requisito e não tiveram disponibilidade afirmada."@pt-BR ;
    mado:requerFuncaoDecisoria mado:FUN-FEEDBACK-PERCEPTIVEL,
        mado:FUN-MANTER-INFORMACAO-RECUPERAVEL,
        mado:FUN-SELECIONAR-MODO-POR-CONDICAO ;
    mado:restricao "Antes de uso real, conferir percepção, operação e segurança no ambiente de deslocamento; este ensaio não comprova navegação segura."@pt-BR,
        "O áudio pode não ser percebido continuamente."@pt-BR,
        "Vibração não substitui sozinha instruções complexas."@pt-BR ;
    mado:statusDoRegistro "CENARIO_SINTETICO_DE_TESTE" ;
    mado:temModalidadeDisponivel mado:MOD-AUDIO,
        mado:MOD-HAPTICO ;
