    mado:aplicavelARecursoDisponivel mado:REC-ENTRADA-VOZ,
        mado:REC-SENSORES,
        mado:REC-TECLADO ;
    mado:aplicavelATarefa mado:TAR-OPERAR-SISTEMA ;
    mado:articulacao "O estudo ACAT/MPD articula movimento residual, baixa visão, webcam, dispositivo de pressão e teclado em tela; o RotaColab mostra falhas quando gesto, touchscreen, rede ou retorno não correspondem às condições reais."@pt-BR ;
    mado:articuladoSobPerspectiva mado:P02 ;
    mado:classificacaoOperacional "OPERACIONALIZAVEL" ;
    mado:contribuiParaFuncaoDecisoria mado:FUN-FEEDBACK-PERCEPTIVEL,
        mado:FUN-SELECIONAR-MODO-POR-CONDICAO ;
    mado:derivadoDe mado:F01,
        mado:F05 ;
    mado:enunciado "Uma entrada alternativa somente apoia a tarefa quando o gesto ou movimento exigido é viável, o dispositivo e o sistema são compatíveis, o desempenho é suficiente e o usuário recebe confirmação perceptível."@pt-BR ;
    mado:identificador "K41"^^xsd:string ;
    mado:limite "A viabilidade do mecanismo deve ser testada com o movimento, o dispositivo e a tarefa reais."@pt-BR ;
    mado:natureza "RECONSTRUCAO_ANALITICA_RASTREAVEL" ;
    mado:origemDaEstruturacaoSemantica "Relação reconstruída pela autora entre trechos do corpus, condições funcionais, tarefa e função decisória; não é atribuída como formulação original às publicações."@pt-BR ;
    mado:restricao "BAR-RECURSO-INCOMPATIVEL-CAPACIDADE"@pt-BR,
        "CAR-OPERACAO-NAO-CONVENCIONAL"@pt-BR,
