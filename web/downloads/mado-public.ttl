        mado:CAR-NECESSITA-ESTRUTURA-TRANSICAO ;
    mado:aplicavelANecessidade mado:NEC-COORDENAR-AUTORIA-COLABORATIVA,
        mado:NEC-PRESERVAR-PROTAGONISMO ;
    mado:aplicavelATarefa mado:TAR-COMUNICAR-E-EXPRESSAR,
        mado:TAR-PRODUZIR-CONTEUDO-MULTIMODAL ;
    mado:articulacao "A elicitação situa o conhecimento e as formas de expressão do estudante; os estudos com personas e critérios acrescentam contextualização de tarefa e limites. A articulação transforma hiperfoco ou diagnóstico em condições funcionais observáveis, sem generalizar o caso."@pt-BR ;
    mado:articuladoSobPerspectiva mado:P02 ;
    mado:classificacaoOperacional "OPERACIONALIZAVEL" ;
    mado:contribuiParaFuncaoDecisoria mado:FUN-COORDENAR-AUTORIA,
        mado:FUN-EXPRESSAR-CONHECIMENTO,
