        mado:NEC-SINALIZAR-AUSENCIA-IMAGEM ;
    mado:baseadoEmContexto mado:CTX-RELATADO-01 ;
    mado:consideraCaracteristicaRelevanteDaPessoa mado:CAR-CONHECIMENTO-PREVIO-HISTORIA,
        mado:CAR-EXPERIENCIA-APRESENTAR-PUBLICOS,
        mado:CAR-EXPRESSAO-POR-DESENHO-IMAGEM,
        mado:CAR-FALA-ESPONTANEA-EXTENSA,
