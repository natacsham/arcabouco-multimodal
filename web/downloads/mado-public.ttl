\": \"TARGET\"}], \"joint_sufficiency_scope\": \"Alternativa delimitada à informação indicada; não comprova equivalência integral nem exige uso simultâneo das representações.\", \"kind\": \"ALTERNATIVE\", \"meaning_unit\": \"INFORMACAO_ESSENCIAL_DA_TAREFA\", \"preserves\": \"Informação relevante do conteúdo visual, suas relações e sua finalidade na tarefa; a equivalência será conferida, não presumida.\", \"required_information\": [\"INFORMACAO_VISUAL_RELEVANTE\"], \"requires_analytical_authorization\": true, \"scope\": \"WITHIN_OPERATION\", \"sufficiency\": \"REQUIRES_SITUATED_CONFIRMATION\", \"temporal\": \"COORDINATION_MUST_BE_SPECIFIED_IN_CONTEXT\", \"temporal_contract\": {\"organization\": \"NO_SIMULTANEITY_REQUIRED\", \"verification_required\": true, \"window_requirement\": \"Conferir a ligação com a informação de origem e a possibilidade de consulta no momento necessário.\"}, \"to_function_ids\": [\"FUN-PRESERVAR-ACESSO\"], \"to_representation_ids\": [\"MOD-TEXTO\"], \"verification_phase\": \"verification\"}], \"representation_ids\": [\"MOD-IMAGEM\", \"MOD-DESENHO\", \"MOD-TEXTO\", \"MOD-AUDIO\"], \"requires_facts\": [{\"id\": \"CanReadText\", \"label\": \"A pessoa consegue acompanhar o texto apresentado visualmente?\"}], \"resource_requirements\": {\"all\": [], \"any\": [[\"REC-EDITOR-MULTIMIDIA\"]], \"capability_check_required\": false, \"historical_operator_role_id\": \"PAPEL-ESTUDANTE\", \"operator_role_id\": null}, \"role_requirements\": {\"all\": [], \"responsibility\": \"Confirmar quem executa e quem prepara a ação; papéis do exemplo histórico não são exigência geral.\", \"subject_role_ids\": [\"PAPEL-PESSOA-APOIADA\", \"PAPEL-ESTUDANTE\"]}, \"schema_version\": \"1.5.0-rc2\", \"selected_representation_ids\": [\"MOD-TEXTO\"], \"semantic_curation\": {\"claim_ids\": [\"CLM-K38-C-K38-01\", \"CLM-K38-MMI-NAV\", \"CLM-K42-C-K42-01\", \"CLM-K42-C-K42-02\", \"CLM-K42-TD-ORI-0001\"], \"disposition\": \"SCOPED_CONTRACT_WITH_SITUATED_GATES\", \"history\": {\"sha25