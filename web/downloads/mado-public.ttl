        "TAR-ORGANIZAR-CONTEUDO-DIGITAL"@pt-BR,
        "TAR-PRODUZIR-CONTEUDO-MULTIMODAL"@pt-BR ;
    mado:statusDaRelacao "PRODUTO_DE_ARTICULACAO_RC3" ;
    mado:sustentadoPorTrecho mado:TD-EV34,
        mado:TD-EV36,
        mado:TD-RC3-REF-09,
        mado:TD-RC3-REF-10 .

