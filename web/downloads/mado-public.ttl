mado:CA74 a mado:CriterioDeDecisaoMultimodal ;
    rdfs:label "O conteúdo textual deve utilizar uma linguagem clara e simples ou, para textos complexos, fornecer uma versão alternativa ou conteúdo suplementar que seja mais fácil de compreender."@pt-BR ;
    mado:criterioAplicavelAModalidade mado:MOD-DESENHO,
        mado:MOD-FALA,
        mado:MOD-IMAGEM,
        mado:MOD-JOGO-INTERATIVO,
        mado:MOD-TEXTO ;
    mado:criterioAplicavelARecurso mado:REC-COMPUTADOR-DATASHOW,
        mado:REC-DESENHO-QUADRO-PAPEL,
        mado:REC-LEITOR-DE-TELA,
        mado:REC-PALAVRAS-CHAVE-LINHA-DO-TEMPO,
        mado:RED-JOGO-HISTORIA ;
    mado:criterioAplicavelATarefa mado:TAR-ACESSAR-CONTEUDO-9DCCC00,
        mado:TAR-ACESSAR-CONTEUDO-WEB-E80BA3E,
        mado:TAR-COMUNICAR-CONTEUDO-1545B38,
        mado:TAR-CONSTRUIR-RECURSO-DIGITAL-HISTORIA,
        mado:TAR-ENVIAR-LER-MENSAGEM-INTERAGIR-COM-MENSAGENS-4C0CACA,
        mado:TAR-EXPLICAR-CONTEUDO-HISTORIA,
        mado:TAR-MICROEXPLICACAO-CURRICULAR,
        mado:TAR-ORGANIZAR-PARTICIPACAO-MULTIMODAL,
        mado:TAR-REVISAR-PUBLICAR-RECURSO ;
    mado:enunciado "O conteúdo textual deve utilizar uma linguagem clara e simples ou, para textos complexos, fornecer uma versão alternativa ou conteúdo suplementar que seja mais fácil de compreender."@pt-BR ;
    mado:funcaoDecisoria "ancorar relações cronológicas ou conceituais mencionadas na fala"@pt-BR,
        "expressar o conhecimento prévio e relacioná-lo ao objetivo curricular"@pt-BR,
        "expressão principal do conhecimento da pessoa"@pt-BR,
        "externalizar relações e apoiar a preparação ou continuidade da explicação"@pt-BR,
        "manter uma forma persistente, editável e compatível com tecnologia assistiva"@pt-BR,
        "marcar a sequência, o objetivo e as transições sem substituir a explicação"@pt-BR,
        "mobilizar o interesse para uma tarefa curricular verificável"@pt-BR,
        "orientar sequência, objetivo e transições sem substituir a fala"@pt-BR,
        "preservar o significado visual em estrutura e descrição processáveis"@pt-BR ;
    mado:fundamentadoPor mado:K07,
        mado:K10,
        mado:K11,
        mado:K12,
        mado:K17,
        mado:K19,
        mado:K27,
        mado:K29,
        mado:K31,
        mado:K32,
        mado:K33,
        mado:K34,
        mado:K35,
        mado:K37,
        mado:K38 ;
    mado:identificador "CA74"^^xsd:string ;
    mado:justificativaDeFundamentacao "Expressar orientação e conteúdo em linguagem clara, objetiva e compreensível. Em versão anterior, a ligação foi reconstruída analiticamente porque o critério participa de uma configuração modalidade–função–recurso–responsável fundamentada por esses conhecimentos; não se atribui essa formalização retrospectiva às publicações originais. Na RC2, a ligação ao conhecimento articulado foi conferida para o cenário de transferência e permanece limitada às condições registradas."@pt-BR ;
    mado:possuiOrigem mado:ORI-0362,
        mado:ORI-0363,
        mado:ORI-0364,
        mado:ORI-0365 ;
    mado:statusDaRelacao "RELACAO_SEM_JUSTIFICATIVA_EXPLICITA" .

