mado:K04 a mado:ConhecimentoMultimodalArticulado ;
    rdfs:label "Em fluxos acessíveis, pré-requisitos e estados do sistema precisam ser comunicados antes que uma ação dependente seja disponibilizada ou solicitada."@pt-BR ;
    mado:aplicavelAAmbiente mado:AMB-FLUXO-DEPENDENTE-DE-CARREGAMENTO-6156C7C ;
    mado:aplicavelABarreira mado:BAR-ACAO-HABILITADA-SOLICITADA-SEM-PRE-REQUISITO-SAT-41B7AA6 ;
    mado:aplicavelACaracteristicaRelevanteDaPessoa mado:CAR-INTERACAO-NAO-VISUAL ;
    mado:aplicavelARecursoDisponivel mado:REC-FEEDBACK-ACESSIVEL-DE-ESTADO-E1BDA1F ;
    mado:aplicavelATarefa mado:TAR-SELECIONAR-DESTINO-2780D83 ;
    mado:articulacao "Na seleção de destino, o componente podia ser acionado mesmo sem as informações anteriores carregadas e o usuário não era informado do pré-requisito. A ruptura mostra que a acessibilidade depende também da comunicação do estado e da sequência lógica da tarefa, e não apenas da modalidade usada para apresentar uma mensagem."@pt-BR ;
    mado:articuladoSobPerspectiva mado:P02 ;
    mado:classificacaoOperacional "OPERACIONALIZAVEL" ;
    mado:derivadoDe mado:F01 ;
    mado:enunciado "Em fluxos acessíveis, pré-requisitos e estados do sistema precisam ser comunicados antes que uma ação dependente seja disponibilizada ou solicitada."@pt-BR ;
    mado:identificador "K04"^^xsd:string ;
    mado:natureza "RECONSTRUÇÃO ANALÍTICA FORTEMENTE SUSTENTADA" ;
    mado:origemDaEstruturacaoSemantica "Relações derivadas de contextos e decisões documentados; complementações RC3 foram estabelecidas somente quando o enunciado, a articulação e os trechos sustentavam a aplicabilidade."@pt-BR ;
    mado:restricao "Fluxo de tarefa"@pt-BR,
        "dependência entre etapas"@pt-BR,
        "estado do sistema"@pt-BR,
        "feedback"@pt-BR ;
    mado:statusDaRelacao "CONHECIMENTO_CANDIDATO" ;
    mado:sustentadoPorTrecho mado:TD-EV05 .

mado:K05 a mado:ConhecimentoMultimodalArticulado ;
    rdfs:label "Quando diferentes fontes de feedback operam simultaneamente, a acessibilidade depende da coordenação e da prioridade entre mensagens para evitar sobreposição e perda de significado."@pt-BR ;
    mado:aplicavelAAmbiente mado:AMB-USO-CONJUNTO-DE-APP-TALKBACK-4E44DB8 ;
    mado:aplicavelABarreira mado:BAR-MENSAGENS-CONCORRENTES-472A703 ;
