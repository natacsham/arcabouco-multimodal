    mado:criterioAplicavelAModalidade mado:MOD-AUDIO,
        mado:MOD-HAPTICO,
        mado:MOD-VOZ ;
    mado:criterioAplicavelATarefa mado:TAR-AUTENTICAR-SELECIONAR-DESTINO-A098E60,
        mado:TAR-ENVIAR-LER-MENSAGEM-INTERAGIR-COM-MENSAGENS-4C0CACA,
        mado:TAR-SEGUIR-ROTA-3D861F4,
        mado:TAR-SELECIONAR-DESTINO-2780D83 ;
    mado:enunciado "A interface não deve restringir ou desabilitar modalidades de entrada disponíveis na plataforma (como teclado, mouse, toque ou voz), a menos que a restrição seja essencial para a segurança ou funcionamento da aplicação."@pt-BR ;
    mado:funcaoDecisoria "manter orientação perceptível quando o áudio é afetado pelo ambiente"@pt-BR,
        "oferecer alternativa à digitação ou seleção visual"@pt-BR,
        "oferecer expressão e acesso alternativos ao texto digitado"@pt-BR ;
    mado:fundamentadoPor mado:K01,
        mado:K03,
        mado:K07,
        mado:K18,
        mado:K21,
        mado:K29,
        mado:K32 ;
    mado:identificador "CA68"^^xsd:string ;
    mado:justificativaDeFundamentacao "Não bloquear modalidades de entrada disponíveis quando elas constituem alternativa situada. Em versão anterior, a ligação foi reconstruída analiticamente porque o critério participa de uma configuração modalidade–função–recurso–responsável fundamentada por esses conhecimentos; não se atribui essa formalização retrospectiva às publicações originais."@pt-BR ;
    mado:possuiOrigem mado:ORI-0346,
        mado:ORI-0347,
        mado:ORI-0348,
        mado:ORI-0349 ;
