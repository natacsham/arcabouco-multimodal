mado:K37 a mado:ConhecimentoMultimodalArticulado ;
    rdfs:label "Um jogo ou atividade interativa curta pode consolidar relações históricas quando exige ordenar eventos, associar causa e consequência ou comparar interpretações, distribui papéis entre os participantes e oferece feedback explicativo; não deve funcionar apenas como recompensa ou competição."@pt-BR ;
    mado:aplicavelABarreira mado:BAR-FORMATOS-COMPETEM-PELA-ATENCAO ;
    mado:aplicavelAModalidade mado:MOD-JOGO-INTERATIVO ;
    mado:aplicavelANecessidade mado:NEC-ESTRUTURAR-RELACOES-HISTORICAS,
        mado:NEC-FEEDBACK-E-FECHAMENTO ;
    mado:aplicavelARecursoDigital mado:RED-JOGO-QUIZ-HISTORIA ;
    mado:aplicavelARecursoDisponivel mado:REC-PLATAFORMA-JOGO-QUIZ ;
    mado:aplicavelATarefa mado:TAR-CONSTRUIR-RECURSO-DIGITAL-HISTORIA,
        mado:TAR-REVISAR-PUBLICAR-RECURSO ;
    mado:articulacao "Articula organização cognitiva, interatividade com função, interesse pessoal e revisão da configuração. O jogo converte uma relação histórica em ação verificável e usa o feedback para revelar compreensão e orientar retomada."@pt-BR ;
    mado:articuladoSobPerspectiva mado:P02,
        mado:P03 ;
    mado:classificacaoOperacional "CONDICIONAL" ;
    mado:contribuiParaFuncaoDecisoria mado:FUN-ACOMPANHAR-RESULTADO,
        mado:FUN-CONSOLIDAR-COM-FEEDBACK ;
    mado:derivadoDe mado:F06,
        mado:F08,
        mado:F12 ;
    mado:enunciado "Um jogo ou atividade interativa curta pode consolidar relações históricas quando exige ordenar eventos, associar causa e consequência ou comparar interpretações, distribui papéis entre os participantes e oferece feedback explicativo; não deve funcionar apenas como recompensa ou competição."@pt-BR ;
    mado:identificador "K37"^^xsd:string ;
    mado:limite "O jogo é uma possibilidade funcional a conferir; as fontes não demonstram eficácia universal de jogos para esse perfil."@pt-BR ;
    mado:natureza "CONHECIMENTO_ARTICULADO_RC2" ;
    mado:origemDaEstruturacaoSemantica "Produzido por ART-TRF-03; a ligação é analítica, explicitamente limitada e conferida para o teste RC2."@pt-BR ;
    mado:requerElementoDoContexto mado:REC-PLATAFORMA-JOGO-QUIZ ;
    mado:restricao "alternativa não digital"@pt-BR,
        "feedback"@pt-BR,
        "objetivo verificável"@pt-BR,
        "papéis"@pt-BR,
        "relação histórica explícita"@pt-BR,
        "tempo delimitado"@pt-BR ;
    mado:statusDaRelacao "PRODUTO_DE_ARTICULACAO_RC2" ;
    mado:sustentadoPorTrecho mado:TD-EL02,
        mado:TD-EL03,
        mado:TD-EL04,
        mado:TD-EV27,
        mado:TD-EV28,
        mado:TD-EV29,
        mado:TD-EV30,
        mado:TD-EV34,
        mado:TD-EV36 .

mado:K45 a mado:ConhecimentoMultimodalArticulado ;
    rdfs:label "Interesse e conhecimento aprofundado podem sustentar autoria e engajamento quando são ligados a uma tarefa com objetivo explícito, papéis negociados, transições previsíveis e possibilidade de revisão."@pt-BR ;
    mado:aplicavelACaracteristicaRelevanteDaPessoa mado:CAR-EXPRESSAO-ORAL-AUTORAL,
        mado:CAR-EXPRESSAO-VISUAL-AUTORAL,
