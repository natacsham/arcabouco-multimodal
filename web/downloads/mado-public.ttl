        mado:CAR-INTERESSE-GEOGRAFIA-MAPAS,
        mado:CAR-INTERESSE-HISTORIA,
        mado:CAR-SETIMO-ANO ;
    mado:aplicavelARecursoDigital mado:RED-MAPA-DIGITAL ;
    mado:aplicavelATarefa mado:TAR-COMUNICAR-CONTEUDO-1545B38,
        mado:TAR-MICROEXPLICACAO-CURRICULAR ;
    mado:articulacao "A especialista relaciona significado, prazer e adequação à idade com aprendizagem e engajamento; no caso do estudante do sétimo ano, o forte interesse por História foi convertido em espaço de expressão e participação. A articulação une o raciocínio profissional geral ao caso concreto."@pt-BR ;
    mado:articuladoSobPerspectiva mado:P03 ;
    mado:classificacaoOperacional "OPERACIONALIZAVEL" ;
    mado:contribuiParaFuncaoDecisoria mado:FUN-EXPRESSAR-CONHECIMENTO,
        mado:FUN-PRESERVAR-PROTAGONISMO ;
    mado:derivadoDe mado:F12 ;
    mado:enunciado "Um recurso digital ou multimodal favorece o engajamento quando sua função está ligada ao interesse da pessoa, à faixa etária e ao objetivo de aprendizagem, e não apenas à disponibilidade ou novidade da tecnologia."@pt-BR ;
    mado:identificador "K31"^^xsd:string ;
    mado:limite "Não permite inferir que um tema de interesse produzirá engajamento em qualquer tarefa; depende de objetivo, forma de participação e acompanhamento."@pt-BR ;
    mado:natureza "CONHECIMENTO_ARTICULADO_A_PARTIR_DA_ELICITACAO" ;
    mado:origemDaEstruturacaoSemantica "Relações derivadas de contextos e decisões documentados; complementações RC3 foram estabelecidas somente quando o enunciado, a articulação e os trechos sustentavam a aplicabilidade."@pt-BR ;
    mado:restricao "conteúdo educacional"@pt-BR,
