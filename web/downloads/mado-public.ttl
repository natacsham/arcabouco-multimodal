<https://w3id.org/mado#OP-PAD-ORGANIZAR-CONTEUDO-PERSISTENTE> <https://w3id.org/mado#contratoOperacionalSerializado> "{\"action\": \"Preparar instruções consultáveis, com a ordem das ações e relações explícitas, para localizar e retomar o ponto necessário.\", \"analytical_application_ids\": [\"APP-ART-TRF-04-ORGANIZAR-RETOMAR\"], \"claim_support\": [{\"claim_id\": \"CLM-K38-C-K38-02\", \"claim_scope_limit\": [\"Apoia relacionar formatos a funções de organização. A proposição de uma unidade persistente e revisável é reconstrução posterior, não citação da persona.\"], \"criterion_id\": null, \"justification\": \"Parcela delimitada mobilizada nesta aplicação analítica.\", \"knowledge_id\": \"K38\", \"origin_ids\": [], \"semantic_pair_review\": {\"claim_excerpt_ids\": [\"TD-EV34\"], \"limit\": \"Conferência desta aplicação; mantém o estado documental específico de cada premissa.\", \"origin_excerpt_ids\": [], \"original_document_rechecked\": false, \"scope\": \"CONTEXTUAL_CONTRIBUTION_ONLY\", \"status\": \"CONFERIDO_NO_REGISTRO\"}}, {\"claim_id\": \"CLM-K43-C-K43-02\", \"claim_scope_limit\": [\"Apoia não equiparar mais formatos a melhor interação. O registro é uma síntese de persona; não foi conferido nesta revisão como trecho literal do PDF.\"], \"criterion_id\": null, \"justification\": \"Parcela delimitada mobilizada nesta aplicação analítica.\", \"knowledge_id\": \"K43\", \"origin_ids\": [], \"semantic_pair_review\": {\"claim_excerpt_ids\": [\"TD-EV36\"], \"limit\": \"Conferência desta aplicação; mantém o estado documental específico de cada premissa.\", \"origin_excerpt_ids\": [], \"original_document_rechecked\": false, \"scope\": \"CONTEXTUAL_CONTRIBUTION_ONLY\", \"status\": \"CONFERIDO_NO_REGISTRO\"}}, {\"claim_id\": \"CLM-K38-MMI-NAV\", \"claim_scope_limit\": [\"MMI é uma Note sobre requisitos das especificações; não certifica aplicações nem prescreve um recurso didático.\"], \"criterion_id\": \"CA02\", \"justification\": \"Parcela delimitada mobilizada nesta aplicação analítica.\", \"knowledge_id\": \"K38\", \"origin_ids\": [\"ORI-0012\"], \"semantic_pair_review\": {\"claim_excerpt_ids\": [\"TD-ORI-0012\"], \"limit\": \"Conferência desta aplicação; mantém o estado documental específico de cada premissa.\", \"origin_excerpt_ids\": [\"TD-ORI-0012\"], \"original_document_rechecked\": false, \"scope\": \"SCOPED_ANALYTICAL_APPLICATION\", \"status\": \"CONFERIDO_NO_REGISTRO\"}}, {\"claim_id\": \"CLM-K42-C-K42-02\", \"claim_scope_limit\": [\"Conferência do requisito 1.3.1 na Recommendation de 2023-10-05, em 2026-10-11. Apoia preservar relações essenciais; não determina sozinho uma tradução única nem comprova a adequação de toda configuração.\"], \"criterion_id\": \"CA02\", \"justification\": \"Parcela delimitada mobilizada nesta aplicação analítica.\", \"knowledge_id\": \"K42\", \"origin_ids\": [\"ORI-0014\"], \"semantic_pair_review\": {\"claim_excerpt_ids\": [\"TD-ORI-0014\"], \"limit\": \"Conferência desta aplicação; mantém o estado documental específico de cada premissa.\", \"origin_excerpt_ids\": [\"TD-ORI-0014\"], \"original_document_rechecked\": false, \"scope\": \"SCOPED_ANALYTICAL_APPLICATION\", \"status\": \"CONFERIDO_NO_REGISTRO\"}}], \"claim_support_audit\": {\"previous_claim_support\": [{\"claim_id\": \"CLM-K38-C-K38-02\", \"claim_scope_limit\": [\"Apoia relacionar formatos a funções de organização. A proposição de uma unidade persistente e revisável é reconstrução posterior, não citação da persona.\"], \"criterion_id\": \"CA02\", \"justification\": \"Estrutura e relações precisam permanecer explícitas e processáveis.\", \"knowledge_id\": \"K38\", \"origin_ids\": [\"ORI-0012\", \"ORI-0013\", \"ORI-0014\"]}, {\"claim_id\": \"CLM-K43-C-K43-02\", \"claim_scope_limit\": [\"Apoia não equiparar mais formatos a melhor interação. O registro é uma síntese de persona; não foi conferido nesta revisão como trecho literal do PDF.\"], \"criterion_id\": \"CA02\", \"justification\": \"Estrutura e relações precisam permanecer explícitas e processáveis.\", \"knowledge_id\": \"K43\", \"origin_ids\": [\"ORI-0012\", \"ORI-0013\", \"ORI-0014\"]}, {\"claim_id\": \"CLM-K43-C-K43-02\", \"claim_scope_limit\": [\"Apoia não equiparar mais formatos a melhor interação. O registro é uma síntese de persona; não foi conferido nesta revisão como trecho literal do PDF.\"], \"criterion_id\": \"CA74\", \"justification\": \"Texto curto e claro sustenta organização sem substituir a autoria.\", \"knowledge_id\": \"K43\", \"origin_ids\": [\"ORI-0362\", \"ORI-0363\", \"ORI-0364\"]}, {\"claim_id\": \"CLM-K43-C-K43-02\", \"claim_scope_limit\": [\"Apoia não equiparar mais formatos a melhor interação. O registro é uma síntese de persona; não foi conferido nesta revisão como trecho literal do PDF.\"], \"criterion_id\": \"CA84\", \"justification\": \"Ajuda situada sustenta sequência e retomada.\", \"knowledge_id\": \"K43\", \"origin_ids\": [\"ORI-0398\", \"ORI-0399\", \"ORI-0400\"]}], \"reason\": \"Pares anteriores preservados para auditoria; a identidade do conhecimento não autoriza associar toda afirmação a todos os critérios.\", \"status\": \"HISTORICAL_BINDINGS_NOT_OPERATIONAL_SUPPORT\"}, \"condition_phases\": [{\"id\": \"OP-PAD-ORGANIZAR-CONTEUDO-PERSISTENTE:produce_resource\", \"label\": \"Preparar o recurso proposto e conservar a informação identificada como necessária.\", \"phase\": \"production\"}, {\"id\": \"OP-PAD-ORGANIZAR-CONTEUDO-PERSISTENTE:verify_information\", \"label\": \"Depois de preparar, conferir com a pessoa se a informação necessária à tarefa permanece disponível e compreensível.\", \"phase\": \"verification\"}, {\"id\": \"OP-PAD-ORGANIZAR-CONTEUDO-PERSISTENTE:verify_retrieval\", \"label\": \"Disponibilizar a instrução e verificar se a pessoa consegue localizar e retomar a etapa necessária.\", \"phase\": \"verification\"}], \"conditions\": [], \"function_ids\": [\"FUN-ORGANIZAR-CONTEUDO\", \"FUN-MANTER-INFORMACAO-RECUPERAVEL\"], \"grounded_claim_ids\": [\"CLM-K38-C-K38-02\", \"CLM-K43-C-K43-02\", \"CLM-K38-MMI-NAV\", \"CLM-K42-C-K42-02\"], \"historical_action_preserved\": true, \"historical_conditions\": [\"Identificar a informação essencial na tarefa e conferir as condições de percepção, ação e mediação com os participantes.\"], \"historical_function_ids\": [\"FUN-ORGANIZAR-CONTEUDO\", \"FUN-MANTER-INFORMACAO-RECUPERAVEL\", \"FUN-PERMITIR-REVISAO\"], \"historical_relations\": [{\"claim_support\": [{\"claim_id\": \"CLM-K38-C-K38-02\", \"claim_scope_limit\": [\"Apoia relacionar formatos a funções de organização. A proposição de uma unidade persistente e revisável é reconstrução posterior, não citação da persona.\"], \"criterion_id\": \"CA02\", \"justification\": \"A organização entre formatos registrada na persona é aplicada ao princípio documentado de coordenação da navegação e do fluxo entre modalidades (MMI 1.9); não implica fusão de dados.\", \"knowledge_id\": \"K38\", \"origin_ids\": [\"ORI-0012\"], \"semantic_pair_review\": {\"claim_excerpt_ids\": [\"TD-EV34\"], \"limit\": \"Conferência semântica do registro preservado; não nova consulta do original nem autorização do enunciado histórico inteiro.\", \"origin_excerpt_ids\": [\"TD-ORI-0012\"], \"original_document_rechecked\": false, \"scope\": \"SCOPED_ANALYTICAL_APPLICATION\", \"status\": \"CONFERIDO_NO_REGISTRO\"}}, {\"claim_id\": \"CLM-K43-C-K43-02\", \"claim_scope_limit\": [\"Apoia não equiparar mais formatos a melhor interação. O registro é uma síntese de persona; não foi conferido nesta revisão como trecho literal do PDF.\"], \"criterion_id\": \"CA02\", \"justification\": \"O risco registrado de competição entre formatos fundamenta conferir sua coordenação no fluxo da tarefa; não demonstra redução causal de carga nem exige texto curto.\", \"knowledge_id\": \"K43\", \"origin_ids\": [\"ORI-0012\"], \"semantic_pair_review\": {\"claim_excerpt_ids\": [\"TD-EV36\"], \"limit\": \"Conferência semântica do registro preservado; não nova consulta do original nem autorização do enunciado histórico inteiro.\", \"origin_excerpt_ids\": [\"TD-ORI-0012\"], \"original_document_rechecked\": false, \"scope\": \"SCOPED_ANALYTICAL_APPLICATION\", \"status\": \"CONFERIDO_NO_REGISTRO\"}}], \"from_function_ids\": [\"FUN-ORGANIZAR-CONTEUDO\"], \"from_representation_ids\": [\"MOD-TEXTO\", \"MOD-IMAGEM\"], \"id\": \"REL-PAD-ORGANIZAR-CONTEUDO-PERSISTENTE-01\", \"kind\": \"COMPLEMENTARITY\", \"meaning_unit\": \"INFORMACAO_ESSENCIAL_DA_TAREFA\", \"preserves\": \"A informação ou o sinal funcional explicitado no caso; não presume equivalência de todo o conteúdo.\", \"scope\": \"WITHIN_OPERATION\", \"sufficiency\": \"REQUIRES_SITUATED_CONFIRMATION\", \"temporal\": \"COORDINATION_MUST_BE_SPECIFIED_IN_CONTEXT\", \"to_function_ids\": [\"FUN-REDUZIR-SOBRECARGA\"], \"to_representation_ids\": [\"MOD-TEXTO\"]}], \"id\": \"OP-PAD-ORGANIZAR-CONTEUDO-PERSISTENTE\", \"independent_support_allowed\": true, \"input_requirements\": [{\"meaning_unit\": \"INFORMACAO_ESSENCIAL_DA_TAREFA\", \"operator\": \"ANY_IN_GROUP\", \"representation_id\": \"MOD-TEXTO\", \"required\": true}, {\"meaning_unit\": \"INFORMACAO_ESSENCIAL_DA_TAREFA\", \"operator\": \"ANY_IN_GROUP\", \"representation_id\": \"MOD-IMAGEM\", \"required\": true}], \"integration_gaps\": [], \"limits\": [\"A retomada exige que as instruções permaneçam disponíveis e localizáveis; isso será conferido após a preparação.\", \"Esta síntese de projeto não demonstra memória, compreensão ou aprendizagem melhores e não exige imagens.\", \"Organização textual isolada não é apresentada como combinação multimodal.\"], \"operation_scope\": \"PREPARATION_FOR_RECIPIENT\", \"output_resource_ids\": [\"REC-ROTEIRO-COLABORATIVO\"], \"output_spec\": [{\"meaning_unit\": \"INFORMACAO_ESSENCIAL_DA_TAREFA\", \"representation_id\": \"MOD-TEXTO\", \"required\": true}], \"preparation_responsibility\": \"A pessoa que prepara ou adapta o material executa a ação; a via de acesso é conferida separadamente para cada destinatário.\", \"preparation_role_ids\": [\"PAPEL-RESPONSAVEL-ADAPTACAO\", \"PAPEL-MEDIADOR\", \"PAPEL-PROFESSORA\"], \"rc2_audit\": {\"date\": \"2026-10-21\", \"historical_statement_promoted\": false, \"result\": \"SCOPED_OPERATION_REVIEW\", \"scoped_claim_ids\": [\"CLM-K38-C-K38-02\", \"CLM-K43-C-K43-02\", \"CLM-K38-MMI-NAV\", \"CLM-K42-C-K42-02\"]}, \"relations\": [{\"analytical_application_ids\": [\"APP-ART-TRF-04-DESCREVER-ORGANIZAR\"], \"binding\": {\"same_information_unit\": true, \"same_situation\": true, \"same_subject\": true}, \"claim_support\": [], \"each_alone_sufficient\": {\"MOD-TEXTO\": null}, \"explanation\": \"Primeiro, representar em texto a informação visual necessária; depois, organizar essa mesma descrição para consulta e retomada. A passagem entre representações ocorre na descrição, enquanto a ligação entre as ações é sequencial, não complementaridade automática.\", \"from_function_ids\": [\"FUN-PRESERVAR-SIGNIFICADO-ENTRE-MODOS\"], \"from_operation_ids\": [\"OP-PAD-REPRESENTACAO-VISUAL-EXPLICADA-TEXT_VISUAL\", \"OP-PAD-CONTEUDO-WEB-EQUIVALENTE-TEXT_VISUAL\"], \"from_representation_ids\": [\"MOD-TEXTO\"], \"goal\": \"Disponibilizar para organização o conteúdo descrito da mesma situação.\", \"id\": \"REL-ART-TRF-04-DESCREVER-ORGANIZAR\", \"information_roles\": [{\"alone_sufficient_for_goal\": null, \"claim_ids\": [\"CLM-K38-C-K38-01\", \"CLM-K38-C-K38-02\", \"CLM-K38-MMI-NAV\", \"CLM-K42-C-K42-02\", \"CLM-K42-TD-ORI-0001\", \"CLM-K43-C-K43-02\"], \"function_id\": \"FUN-PRESERVAR-SIGNIFICADO-ENTRE-MODOS\", \"information_component\": \"CONTEUDO_A_RETOMAR\", \"representation_id\": \"MOD-TEXTO\", \"role\": \"Apresentar a informação de partida que delimita a transformação.\", \"role_side\": \"SOURCE\"}, {\"alone_sufficient_for_goal\": null, \"claim_ids\": [\"CLM-K38-C-K38-01\", \"CLM-K38-C-K38-02\", \"CLM-K38-MMI-NAV\", \"CLM-K42-C-K42-02\", \"CLM-K42-TD-ORI-0001\", \"CLM-K43-C-K43-02\"], \"function_id\": \"FUN-ORGANIZAR-CONTEUDO\", \"information_component\": \"CONTEUDO_A_RETOMAR\", \"representation_id\": \"MOD-TEXTO\", \"role\": \"Disponibilizar a mesma informação relevante na representação de destino; preservação deve ser conferida.\", \"role_side\": \"TARGET\"}], \"joint_sufficiency_scope\": \"Encadeamento de operações sobre o mesmo conteúdo; não é complementaridade CARE.\", \"kind\": \"SEQUENTIAL\", \"meaning_unit\": \"INFORMACAO_ESSENCIAL_DA_TAREFA\", \"preserves\": \"A descrição textual produzida da informação visual é a entrada a organizar e disponibilizar para retomada pelo mesmo destinatário, na mesma situação. Não basta que dois textos tenham o mesmo tipo.\", \"required_information\": [\"CONTEUDO_A_RETOMAR\"], \"requires_analytical_authorization\": true, \"scope\": \"BETWEEN_OPERATIONS\", \"sufficiency\": \"REQUIRES_SITUATED_CONFIRMATION\", \"temporal\": \"SEQUENTIAL\", \"temporal_contract\": {\"organization\": \"OUTPUT_THEN_INPUT\", \"verification_required\": true, \"window_requirement\": \"Conferir a ligação com a informação de origem e a possibilidade de consulta no momento necessário.\"}, \"to_function_ids\": [\"FUN-ORGANIZAR-CONTEUDO\", \"FUN-MANTER-INFORMACAO-RECUPERAVEL\"], \"to_operation_ids\": [\"OP-PAD-ORGANIZAR-CONTEUDO-PERSISTENTE\"], \"to_representation_ids\": [\"MOD-TEXTO\"], \"verification_phase\": \"verification\"}], \"representation_ids\": [\"MOD-TEXTO\", \"MOD-IMAGEM\"], \"requires_facts\": [{\"id\": \"CanReadText\", \"label\": \"A pessoa consegue acompanhar instruções escritas nesta tarefa?\"}], \"resource_requirements\": {\"all\": [], \"any\": [[\"REC-EDITOR-MULTIMIDIA\"]], \"capability_check_required\": false, \"historical_operator_role_id\": \"PAPEL-PROFESSORA\", \"operator_role_id\": null}, \"role_requirements\": {\"all\": [], \"responsibility\": \"Confirmar quem executa e quem prepara a ação; papéis do exemplo histórico não são exigência geral.\", \"subject_role_ids\": [\"PAPEL-PESSOA-APOIADA\", \"PAPEL-ESTUDANTE\"]}, \"schema_version\": \"1.5.0-rc3\", \"selected_representation_ids\": [\"MOD-TEXTO\"], \"semantic_curation\": {\"claim_ids\": [\"CLM-K38-C-K38-02\", \"CLM-K38-MMI-NAV\", \"CLM-K42-C-K42-02\", \"CLM-K43-C-K43-02\"], \"disposition\": \"SCOPED_CONTRACT_WITH_SITUATED_GATES\", \"history\": {\"sha256\": \"c1ff0fcc5afbf95069b136d167b7df5743604f49619a4fc985952d82bfdfef2c\", \"state_fields\": {}}, \"human_evaluation\": false, \"reason\": \"Contrato OP-PAD-ORGANIZAR-CONTEUDO-PERSISTENTE: Preparar instruções consultáveis, com a ordem das ações e relações explícitas, para localizar e retomar o ponto necessário. Sua autorização limita-se aos apoios exatos; recursos, acesso e integração continuam sujeitos às verificações declaradas.\", \"review_date\": \"2026-10-25\", \"review_scope\": \"RECORDED_SCOPE_WITH_EXPLICIT_POINT_REVIEWS\", \"schema_version\": \"1.6.0-rc1\", \"whole_statement_promoted\": false}, \"transfer_scope\": {\"allow_new_task_with_functional_witness\": true, \"function_witness_required\": true, \"historical_task_ids\": [\"TAR-ORGANIZAR-CONTEUDO-DIGITAL\", \"TAR-PRODUZIR-CONTEUDO-MULTIMODAL\"], \"requires_existing_representation\": false, \"task_ids\": []}}" .
