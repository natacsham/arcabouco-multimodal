    mado:contraindicacao "Não multiplicar formatos sem estrutura ou alternativa."@pt-BR ;
    mado:efeitoPossivelNaTarefa "A entrada apenas textual pode reduzir autoria e detalhe."@pt-BR ;
    mado:identificador "CAR-EXPRESSAO-ORAL-AUTORAL"^^xsd:string ;
    mado:statusDoRegistro "CONTROLADO_1_2_RC3" .

