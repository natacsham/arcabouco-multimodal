mado:CTX-ELICITACAO-01 a mado:ContextoDeInteracaoDigital ;
    rdfs:label "CTX-ELICITACAO-01"@pt-BR ;
    mado:apresentaBarreira mado:BAR-CONTRIBUICAO-EXTENSA-SEM-SEQUENCIA ;
    mado:apresentaNecessidade mado:NEC-APOIAR-COMPREENSAO-TURMA,
        mado:NEC-ORGANIZAR-DELIMITAR-PARTICIPACAO,
        mado:NEC-PRESERVAR-PROTAGONISMO,
        mado:NEC-RELACIONAR-OBJETIVO-CURRICULAR ;
    mado:consideraCaracteristicaRelevanteDaPessoa mado:CAR-INTERESSE-HISTORIA,
        mado:CAR-SETIMO-ANO ;
    mado:descricaoDoContexto "Exemplo didático adaptado: um estudante tem interesse intenso e conhecimento aprofundado sobre um tema. Expressa suas ideias por fala, imagens e desenho. É necessário preservar sua autoria e organizar os momentos de participação com a professora e a turma. Este texto público não é a transcrição da entrevista."@pt-BR ;
    mado:descritoSobPerspectiva mado:P02,
        mado:P03 ;
    mado:envolveRecursoDigital mado:RED-SEQUENCIA-MULTIMODAL-DIGITAL ;
    mado:identificador "CTX-ELICITACAO-01"^^xsd:string ;
    mado:informacaoAusente "Forma de transição que o estudante e a professora consideram respeitosa e viável."@pt-BR,
        "Indicadores de compreensão e participação que a especialista considera adequados."@pt-BR,
        "Objetivo curricular e recorte temático exatos da nova atividade."@pt-BR,
        "Recursos digitais efetivamente disponíveis e condições de acessibilidade da turma."@pt-BR,
        "Tempo disponível e número adequado de blocos da explicação."@pt-BR ;
    mado:natureza "CENARIO_MISTO_HISTORICO_PRESERVADO" ;
    mado:objetivo "Transformar o conhecimento e o interesse do estudante em participação curricular compreensível e delimitada, relacionando sua contribuição a um objetivo de aprendizagem e envolvendo a turma."@pt-BR ;
    mado:ocorreEmAmbiente mado:AMB-SALA-DE-AULA ;
    mado:restricao "Não misturar este caso com relatos referentes a outros estudantes."@pt-BR,
        "Não presumir diagnóstico, equipamento, conexão, recurso digital disponível ou eficácia."@pt-BR,
        "Não transformar o interesse do estudante em prescrição rígida ou limitar seu protagonismo."@pt-BR,
        "Tratar a atividade digital como reconstrução proposta pela pesquisadora e não como prática originalmente relatada."@pt-BR ;
    mado:statusDoRegistro "ADAPTACAO_PUBLICA" ;
    mado:temModalidadeDisponivel mado:MOD-FALA,
        mado:MOD-IMAGEM,
        mado:MOD-TEXTO ;
    mado:temTarefa mado:TAR-MICROEXPLICACAO-CURRICULAR .

mado:CTX-SINTETICO-GEO-01 a mado:ContextoDeInteracaoDigital ;
    rdfs:label "CTX-SINTETICO-GEO-01"@pt-BR ;
    mado:apresentaBarreira mado:BAR-CONTRIBUICAO-EXTENSA-SEM-SEQUENCIA ;
    mado:apresentaNecessidade mado:NEC-APOIAR-COMPREENSAO-TURMA,
        mado:NEC-ORGANIZAR-DELIMITAR-PARTICIPACAO,
        mado:NEC-PRESERVAR-PROTAGONISMO ;
    mado:baseadoEmContexto mado:CTX-RELATADO-01 ;
    mado:consideraCaracteristicaRelevanteDaPessoa mado:CAR-ENSINO-FUNDAMENTAL-II,
        mado:CAR-INTERESSE-GEOGRAFIA-MAPAS ;
    mado:descricaoDoContexto "Novo caso fictício semelhante: estudante do Ensino Fundamental II com interesse e conhecimento em Geografia e mapas fará uma explicação curta para a turma. Sua fala é extensa e espontânea. A atividade dispõe de mapa digital, projeção, palavras-chave e imagens e deve preservar seu protagonismo enquanto organiza a sequência e apoia a compreensão da turma."@pt-BR ;
    mado:descritoSobPerspectiva mado:P02,
        mado:P03 ;
    mado:envolveRecursoDigital mado:RED-MAPA-DIGITAL ;
    mado:identificador "CTX-SINTETICO-GEO-01"^^xsd:string ;
    mado:natureza "SINTETICO_HISTORICO_PRESERVADO" ;
    mado:objetivo "Explicar relações espaciais de um conteúdo de Geografia e permitir que a turma identifique os pontos centrais."@pt-BR ;
    mado:ocorreEmAmbiente mado:AMB-SALA-DE-AULA ;
    mado:restricao "O mapa digital é uma escolha sintética para testar transferência; não foi relatado como prática do caso original."@pt-BR,
        "Preservar o protagonismo sem transformar a atividade em roteiro rígido."@pt-BR ;
    mado:statusDoRegistro "SUBSTITUIDO_NA_SESSAO_PELA_RC4" ;
    mado:temModalidadeDisponivel mado:MOD-FALA,
        mado:MOD-IMAGEM,
        mado:MOD-TEXTO ;
    mado:temRecursoDisponivel mado:REC-MAPA-DIGITAL-PROJECAO ;
    mado:temTarefa mado:TAR-COMUNICAR-CONTEUDO-1545B38,
        mado:TAR-MICROEXPLICACAO-CURRICULAR .

mado:D-TESTE-RC2-SUSPENSA a mado:DecisaoDeAcessibilidadeMultimodal ;
    rdfs:label "Decisão suspensa porque diagnóstico isolado não caracteriza a interação."@pt-BR ;
    mado:atendeRequisitoDeExpressao mado:K33 ;
    mado:condicaoDeAplicacao "Caracterizar a tarefa e as condições funcionais antes de decidir."@pt-BR ;
    mado:enunciado "Decisão suspensa porque diagnóstico isolado não caracteriza a interação."@pt-BR ;
    mado:expressaoOperacional "A MADO deve perguntar ou suspender."@pt-BR ;
    mado:identificador "D-TESTE-RC2-SUSPENSA"^^xsd:string ;
    mado:limite "Registro técnico; não é orientação à especialista."@pt-BR ;
    mado:natureza "CASO_NEGATIVO_DE_REGRESSAO" ;
    mado:rationale "Não há tarefa, barreira, necessidade, capacidade observada, modalidade ou recurso suficiente."@pt-BR ;
    mado:respondeA mado:CTX-TESTE-RC2-DIAGNOSTICO-ISOLADO ;
