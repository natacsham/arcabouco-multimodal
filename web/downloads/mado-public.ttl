mado:AplicacaoDeCriterio a owl:Class ;
    rdfs:label "Aplicação situada de critério"@pt-BR ;
    rdfs:comment "Associação de um único critério a uma única configuração, com os conhecimentos que fundamentam seu emprego, as origens documentais pertinentes e a justificativa situada. Preserva o pareamento; a presença de conhecimentos e critérios na mesma configuração, por si só, não afirma que todos fundamentam todos."@pt-BR .

mado:ConfiguracaoModalDaDecisao a owl:Class ;
    rdfs:label "Configuração modal da decisão"@pt-BR ;
