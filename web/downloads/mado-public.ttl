    mado:envolveRecursoDigital mado:RED-APRESENTACAO-DIGITAL,
        mado:RED-IMAGEM-DIGITAL ;
    mado:identificador "CTX-RECONSTRUIDO-HISTORIA-01"^^xsd:string ;
    mado:natureza "ORGANIZACAO_SEMANTICA_DO_MESMO_CASO" ;
    mado:objetivo "Organizar uma explicação multimodal vinculada ao conteúdo da aula, preservando o protagonismo do estudante, a compreensão da turma e o vínculo social durante turnos e transições."@pt-BR ;
    mado:ocorreEmAmbiente mado:AMB-AUDITORIO,
        mado:AMB-LABORATORIO-INFORMATICA,
        mado:AMB-SALA-DE-AULA ;
    mado:restricao "O diagnóstico corrigido pela especialista não integra a prescrição; são modeladas apenas condições observadas na interação."@pt-BR,
        "Registro consolidado retrospectivamente porque o log automático original da sessão não foi preservado."@pt-BR ;
    mado:statusConfirmacao "AGUARDANDO_CONFIRMACAO" ;
    mado:statusDoRegistro "ADAPTACAO_PUBLICA" ;
    mado:temModalidadeDisponivel mado:MOD-DESENHO,
        mado:MOD-FALA,
        mado:MOD-IMAGEM,
        mado:MOD-TEXTO ;
    mado:temParticipacao mado:PART-RECONSTRUIDO-ESTUDANTE,
