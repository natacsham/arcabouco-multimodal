        mado:FUN-PRESERVAR-PROTAGONISMO ;
    mado:derivadoDe mado:F06,
        mado:F08,
        mado:F12 ;
    mado:enunciado "Interesse e conhecimento aprofundado podem sustentar autoria e engajamento quando são ligados a uma tarefa com objetivo explícito, papéis negociados, transições previsíveis e possibilidade de revisão."@pt-BR ;
    mado:identificador "K45"^^xsd:string ;
    mado:limite "Válido para o caso e para situações com condições funcionais equivalentes; não autoriza inferência a partir de TEA ou de outro diagnóstico."@pt-BR ;
    mado:natureza "RECONSTRUCAO_ANALITICA_RASTREAVEL" ;
    mado:origemDaEstruturacaoSemantica "Relação reconstruída pela autora entre trechos do corpus, condições funcionais, tarefa e função decisória; não é atribuída como formulação original às publicações."@pt-BR ;
    mado:restricao "CAR-EXPRESSAO-ORAL-AUTORAL"@pt-BR,
        "CAR-EXPRESSAO-VISUAL-AUTORAL"@pt-BR,
        "CAR-INTERESSE-CONHECIMENTO-TEMA"@pt-BR,
        "CAR-NECESSITA-ESTRUTURA-TRANSICAO"@pt-BR,
        "NEC-COORDENAR-AUTORIA-COLABORATIVA"@pt-BR,
        "NEC-PRESERVAR-PROTAGONISMO"@pt-BR,
        "TAR-COMUNICAR-E-EXPRESSAR"@pt-BR,
        "TAR-PRODUZIR-CONTEUDO-MULTIMODAL"@pt-BR ;
    mado:statusDaRelacao "PRODUTO_DE_ARTICULACAO_RC3" ;
    mado:sustentadoPorTrecho mado:TD-ELIC-02,
        mado:TD-EV34,
        mado:TD-RC3-REF-09,
        mado:TD-RC3-REF-10 .

