  <rdf:Description rdf:about="https://w3id.org/mado#D10">
    <rdf:type rdf:resource="https://w3id.org/mado#DecisaoDeAcessibilidadeMultimodal"/>
    <rdfs:label xml:lang="pt-BR">Para permitir o uso do ACAT por uma pessoa que não consegue operar teclado convencional, selecionar uma entrada compatível com o movimento residual disponível e verificar sua integração e desempenho na plataforma.</rdfs:label>
    <mado:condicaoDeAplicacao xml:lang="pt-BR">Arquitetura, CPU, hardware disponível</mado:condicaoDeAplicacao>
    <mado:enunciado xml:lang="pt-BR">Para permitir o uso do ACAT por uma pessoa que não consegue operar teclado convencional, selecionar uma entrada compatível com o movimento residual disponível e verificar sua integração e desempenho na plataforma.</mado:enunciado>
    <mado:expressaoOperacional xml:lang="pt-BR">Selecionar a forma de entrada a partir do movimento funcional efetivamente disponível e verificar a viabilidade da integração com a tecnologia assistiva e a arquitetura de execução.</mado:expressaoOperacional>
    <mado:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D10</mado:identificador>
    <mado:natureza>RECONSTRUÇÃO ANALÍTICA FORTEMENTE SUSTENTADA</mado:natureza>
    <mado:produziuResultado rdf:resource="https://w3id.org/mado#R-EV21"/>
    <mado:produziuResultado rdf:resource="https://w3id.org/mado#R-EV23"/>
    <mado:produziuResultado rdf:resource="https://w3id.org/mado#R-EV24"/>
    <mado:rationale xml:lang="pt-BR">Por quê: a configuração padrão do ACAT era incompatível com a capacidade motora da participante. Para quê: viabilizar comunicação/interação. Como: características funcionais orientam a escolha do MPD e testes de combinação/CPU verificam se a solução pode coexistir com os demais recursos.</mado:rationale>
    <mado:respondeA rdf:resource="https://w3id.org/mado#CTX-D10"/>
    <mado:statusDecisao>DECISAO_HISTORICA_RECONSTRUIDA</mado:statusDecisao>
    <mado:statusDoRegistro>DECISAO_HISTORICA_RECONSTRUIDA</mado:statusDoRegistro>
    <mado:sustentadaPor rdf:resource="https://w3id.org/mado#K14"/>
    <mado:sustentadaPor rdf:resource="https://w3id.org/mado#K15"/>
    <mado:sustentadaPor rdf:resource="https://w3id.org/mado#K16"/>
  </rdf:Description>
