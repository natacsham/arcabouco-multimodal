  <rdf:Description rdf:about="https://w3id.org/mado#K10">
    <rdf:type rdf:resource="https://w3id.org/mado#ConhecimentoMultimodalArticulado"/>
    <rdfs:label xml:lang="pt-BR">Compatibilidade com leitor de tela não garante compreensão do conteúdo; elementos relevantes precisam ser representados de forma acessível para que seu significado possa ser percebido por outra modalidade.</rdfs:label>
    <mado:aplicavelAAmbiente rdf:resource="https://w3id.org/mado#AMB-CONTEUDO-EDUCACIONAL-NA-WEB-D1FE594"/>
    <mado:aplicavelABarreira rdf:resource="https://w3id.org/mado#BAR-ELEMENTOS-SEM-REPRESENTACAO-ADEQUADA-F915D33"/>
    <mado:aplicavelACaracteristicaRelevanteDaPessoa rdf:resource="https://w3id.org/mado#CAR-BAIXA-VISAO"/>
    <mado:aplicavelACaracteristicaRelevanteDaPessoa rdf:resource="https://w3id.org/mado#CAR-INTERACAO-NAO-VISUAL"/>
    <mado:aplicavelACaracteristicaRelevanteDaPessoa rdf:resource="https://w3id.org/mado#CAR-USA-LEITOR-TELA"/>
    <mado:aplicavelAModalidade rdf:resource="https://w3id.org/mado#MOD-AUDIO"/>
    <mado:aplicavelAModalidade rdf:resource="https://w3id.org/mado#MOD-IMAGEM"/>
    <mado:aplicavelAModalidade rdf:resource="https://w3id.org/mado#MOD-TEXTO"/>
    <mado:aplicavelANecessidade rdf:resource="https://w3id.org/mado#NEC-ACESSO-EQUIVALENTE"/>
    <mado:aplicavelANecessidade rdf:resource="https://w3id.org/mado#NEC-ALINHAR-IMAGENS-PREVIAMENTE"/>
    <mado:aplicavelANecessidade rdf:resource="https://w3id.org/mado#NEC-SINALIZAR-AUSENCIA-IMAGEM"/>
    <mado:aplicavelARecursoDigital rdf:resource="https://w3id.org/mado#RED-APRESENTACAO-DIGITAL"/>
    <mado:aplicavelARecursoDigital rdf:resource="https://w3id.org/mado#RED-IMAGEM-DIGITAL"/>
    <mado:aplicavelARecursoDisponivel rdf:resource="https://w3id.org/mado#REC-TEXTO-DESCRITIVO-SINTESE-POR-LEITOR-DE-TELA-CD10406"/>
    <mado:aplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-ACESSAR-COMPREENDER-CONTEUDO-DIGITAL"/>
    <mado:aplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-ACESSAR-CONTEUDO-WEB-E80BA3E"/>
    <mado:aplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-COMUNICAR-CONTEUDO-1545B38"/>
    <mado:articulacao xml:lang="pt-BR">O artigo explicita que leitores de tela sintetizam informação, mas usuários podem continuar sem compreender elementos cuja construção não previu recursos acessíveis. A WABlind responde com representação descritiva e alternativa textual que o leitor de tela pode sintetizar em áudio.</mado:articulacao>
    <mado:articuladoSobPerspectiva rdf:resource="https://w3id.org/mado#P02"/>
    <mado:classificacaoOperacional>OPERACIONALIZAVEL</mado:classificacaoOperacional>
    <mado:contribuiParaFuncaoDecisoria rdf:resource="https://w3id.org/mado#FUN-PRESERVAR-ACESSO"/>
    <mado:derivadoDe rdf:resource="https://w3id.org/mado#F03"/>
    <mado:enunciado xml:lang="pt-BR">Compatibilidade com leitor de tela não garante compreensão do conteúdo; elementos relevantes precisam ser representados de forma acessível para que seu significado possa ser percebido por outra modalidade.</mado:enunciado>
    <mado:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">K10</mado:identificador>
    <mado:natureza>RECONSTRUÇÃO ANALÍTICA FORTEMENTE SUSTENTADA</mado:natureza>
    <mado:origemDaEstruturacaoSemantica xml:lang="pt-BR">Relações derivadas de contextos e decisões documentados; complementações RC3 foram estabelecidas somente quando o enunciado, a articulação e os trechos sustentavam a aplicabilidade.</mado:origemDaEstruturacaoSemantica>
    <mado:restricao xml:lang="pt-BR">Conteúdo web</mado:restricao>
    <mado:restricao xml:lang="pt-BR">deficiência visual</mado:restricao>
    <mado:restricao xml:lang="pt-BR">leitor de tela</mado:restricao>
    <mado:restricao xml:lang="pt-BR">representação descritiva</mado:restricao>
    <mado:restricao xml:lang="pt-BR">áudio</mado:restricao>
    <mado:statusDaRelacao>CONHECIMENTO_CANDIDATO_RC2</mado:statusDaRelacao>
    <mado:sustentadoPorTrecho rdf:resource="https://w3id.org/mado#TD-EV12"/>
    <mado:sustentadoPorTrecho rdf:resource="https://w3id.org/mado#TD-EV13"/>
    <mado:sustentadoPorTrecho rdf:resource="https://w3id.org/mado#TD-EV14"/>
    <mado:sustentadoPorTrecho rdf:resource="https://w3id.org/mado#TD-EV16"/>
  </rdf:Description>
