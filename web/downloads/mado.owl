  <rdf:Description rdf:about="https://w3id.org/mado#DecisaoDeAcessibilidadeMultimodal">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="pt-BR">Decisão de acessibilidade multimodal</rdfs:label>
    <rdfs:comment xml:lang="pt-BR">Emprego situado de conhecimentos e critérios para definir configurações de interação, condições, alternativas e acompanhamento em um contexto. A proposta de decisão e seu resultado esperado não comprovam efeito observado.</rdfs:comment>
  </rdf:Description>
