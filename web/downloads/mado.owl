  <rdf:Description rdf:about="https://w3id.org/mado#K32">
    <rdf:type rdf:resource="https://w3id.org/mado#ConhecimentoMultimodalArticulado"/>
    <rdfs:label xml:lang="pt-BR">A decisão de apoio precisa considerar conjuntamente nível de compreensão, potencial observado, tempo, recursos, ambiente, pessoas disponíveis e uma alternativa de revisão quando a primeira configuração não produzir envolvimento.</rdfs:label>
    <mado:aplicavelAAmbiente rdf:resource="https://w3id.org/mado#AMB-AUDITORIO"/>
    <mado:aplicavelAAmbiente rdf:resource="https://w3id.org/mado#AMB-LABORATORIO-INFORMATICA"/>
    <mado:aplicavelAAmbiente rdf:resource="https://w3id.org/mado#AMB-SALA-DE-AULA"/>
    <mado:aplicavelABarreira rdf:resource="https://w3id.org/mado#BAR-REPETICAO-PREJUDICA-VINCULO"/>
    <mado:aplicavelABarreira rdf:resource="https://w3id.org/mado#BAR-TRANSICAO-E-CONTRADICAO-DIFICIL"/>
    <mado:aplicavelACaracteristicaRelevanteDaPessoa rdf:resource="https://w3id.org/mado#CAR-EXPRESSAO-POR-DESENHO-IMAGEM"/>
    <mado:aplicavelACaracteristicaRelevanteDaPessoa rdf:resource="https://w3id.org/mado#CAR-FALA-ESPONTANEA-EXTENSA"/>
    <mado:aplicavelACaracteristicaRelevanteDaPessoa rdf:resource="https://w3id.org/mado#CAR-FALA-PERSISTENTE-REPETITIVA"/>
    <mado:aplicavelACaracteristicaRelevanteDaPessoa rdf:resource="https://w3id.org/mado#CAR-POTENCIAL-OBSERVADO"/>
    <mado:aplicavelACaracteristicaRelevanteDaPessoa rdf:resource="https://w3id.org/mado#CAR-REAGE-DEFENSIVAMENTE-A-CONTRADICAO"/>
    <mado:aplicavelANecessidade rdf:resource="https://w3id.org/mado#NEC-ALINHAR-IMAGENS-PREVIAMENTE"/>
    <mado:aplicavelANecessidade rdf:resource="https://w3id.org/mado#NEC-NEGOCIAR-TURNOS-TRANSICOES"/>
    <mado:aplicavelANecessidade rdf:resource="https://w3id.org/mado#NEC-ORGANIZAR-DELIMITAR-PARTICIPACAO"/>
    <mado:aplicavelANecessidade rdf:resource="https://w3id.org/mado#NEC-PRESERVAR-PROTAGONISMO"/>
    <mado:aplicavelANecessidade rdf:resource="https://w3id.org/mado#NEC-PRESERVAR-VINCULO-SOCIAL"/>
    <mado:aplicavelANecessidade rdf:resource="https://w3id.org/mado#NEC-SINALIZAR-AUSENCIA-IMAGEM"/>
    <mado:aplicavelARecursoDigital rdf:resource="https://w3id.org/mado#RED-APRESENTACAO-DIGITAL"/>
    <mado:aplicavelARecursoDigital rdf:resource="https://w3id.org/mado#RED-IMAGEM-DIGITAL"/>
    <mado:aplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-APRESENTAR-CONTEUDO-DIFERENTES-ESPACOS"/>
    <mado:aplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-COMUNICAR-CONTEUDO-1545B38"/>
    <mado:aplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-MICROEXPLICACAO-CURRICULAR"/>
    <mado:articulacao xml:lang="pt-BR">A especialista descreve esses fatores em diferentes momentos do raciocínio profissional e do caso. A compreensão articulada é que a escolha não decorre do diagnóstico nem de um recurso isolado, mas da compatibilidade entre condições e da possibilidade de observar e mudar.</mado:articulacao>
    <mado:articuladoSobPerspectiva rdf:resource="https://w3id.org/mado#P03"/>
    <mado:classificacaoOperacional>OPERACIONALIZAVEL</mado:classificacaoOperacional>
    <mado:contribuiParaFuncaoDecisoria rdf:resource="https://w3id.org/mado#FUN-ACOMPANHAR-RESULTADO"/>
    <mado:contribuiParaFuncaoDecisoria rdf:resource="https://w3id.org/mado#FUN-CARACTERIZAR-CONDICOES"/>
    <mado:contribuiParaFuncaoDecisoria rdf:resource="https://w3id.org/mado#FUN-PERMITIR-REVISAO"/>
    <mado:derivadoDe rdf:resource="https://w3id.org/mado#F12"/>
    <mado:enunciado xml:lang="pt-BR">A decisão de apoio precisa considerar conjuntamente nível de compreensão, potencial observado, tempo, recursos, ambiente, pessoas disponíveis e uma alternativa de revisão quando a primeira configuração não produzir envolvimento.</mado:enunciado>
    <mado:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">K32</mado:identificador>
    <mado:limite xml:lang="pt-BR">As condições específicas do novo cenário ainda precisam ser confirmadas antes de aplicação.</mado:limite>
    <mado:natureza>CONHECIMENTO_ARTICULADO_A_PARTIR_DA_ELICITACAO</mado:natureza>
    <mado:origemDaEstruturacaoSemantica xml:lang="pt-BR">Relações derivadas de contextos e decisões documentados; complementações RC3 foram estabelecidas somente quando o enunciado, a articulação e os trechos sustentavam a aplicabilidade.</mado:origemDaEstruturacaoSemantica>
    <mado:restricao xml:lang="pt-BR">acompanhamento</mado:restricao>
    <mado:restricao xml:lang="pt-BR">alternativa</mado:restricao>
    <mado:restricao xml:lang="pt-BR">ambiente de interação</mado:restricao>
    <mado:restricao xml:lang="pt-BR">engajamento</mado:restricao>
    <mado:restricao xml:lang="pt-BR">nível de compreensão</mado:restricao>
    <mado:restricao xml:lang="pt-BR">pessoas disponíveis</mado:restricao>
    <mado:restricao xml:lang="pt-BR">recursos disponíveis</mado:restricao>
    <mado:restricao xml:lang="pt-BR">tempo disponível</mado:restricao>
    <mado:statusDaRelacao>APOIO_ELICITADO_A_CARACTERIZACAO_NAO_FUNDAMENTO_INDEPENDENTE</mado:statusDaRelacao>
