  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mado#CAR-INTERESSE-CONHECIMENTO-TEMA">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://w3id.org/mado/scheme/CARACTERISTICA_PESSOA"/>
    <skos:prefLabel xml:lang="pt-BR">Demonstra interesse intenso e conhecimento aprofundado sobre um tema específico</skos:prefLabel>
    <mado:caracteristicaDerivadaDeFonte rdf:resource="https://w3id.org/mado#F08"/>
    <mado:caracteristicaDerivadaDeFonte rdf:resource="https://w3id.org/mado#F12"/>
    <mado:caracteristicaSustentadaPorTrecho rdf:resource="https://w3id.org/mado#TD-ELIC-02"/>
    <mado:caracteristicaSustentadaPorTrecho rdf:resource="https://w3id.org/mado#TD-ELIC-03"/>
    <mado:caracteristicaSustentadaPorTrecho rdf:resource="https://w3id.org/mado#TD-RC3-REF-10"/>
    <mado:categoriaDaCaracteristica>INTERESSES_CONHECIMENTOS_POTENCIALIDADES</mado:categoriaDaCaracteristica>
    <mado:condicaoDeUsoDaCaracteristica xml:lang="pt-BR">Objetivo e papéis devem ser confirmados com os participantes.</mado:condicaoDeUsoDaCaracteristica>
    <mado:condicaoDeUsoDaCaracteristica xml:lang="pt-BR">Vincular o interesse a uma tarefa verificável e manter autoria identificável.</mado:condicaoDeUsoDaCaracteristica>
    <mado:contraindicacao xml:lang="pt-BR">Não converter organização em silenciamento ou roteiro rígido.</mado:contraindicacao>
    <mado:contraindicacao xml:lang="pt-BR">Não usar diagnóstico ou interesse como justificativa suficiente para um modo.</mado:contraindicacao>
    <mado:efeitoPossivelNaTarefa xml:lang="pt-BR">Quando ligado ao objetivo, pode ampliar participação; sem estrutura, pode se desconectar da atividade.</mado:efeitoPossivelNaTarefa>
    <mado:efeitoPossivelNaTarefa xml:lang="pt-BR">Sem combinação explícita, autoria pode ser retirada ou a participação pode se tornar conflitiva.</mado:efeitoPossivelNaTarefa>
    <mado:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CAR-INTERESSE-CONHECIMENTO-TEMA</mado:identificador>
    <mado:statusDoRegistro>CONTROLADO_1_2_RC3</mado:statusDoRegistro>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mado#K39">
    <rdf:type rdf:resource="https://w3id.org/mado#ConhecimentoMultimodalArticulado"/>
    <rdfs:label xml:lang="pt-BR">A seleção de modalidades deve considerar conjuntamente a tarefa, as condições funcionais observadas, a proficiência com o recurso, o ambiente e a tecnologia disponível.</rdfs:label>
    <mado:aplicavelABarreira rdf:resource="https://w3id.org/mado#BAR-RECURSO-INCOMPATIVEL-CAPACIDADE"/>
    <mado:aplicavelACaracteristicaRelevanteDaPessoa rdf:resource="https://w3id.org/mado#CAR-EXPERIENCIA-DIGITAL-VARIAVEL"/>
    <mado:aplicavelACaracteristicaRelevanteDaPessoa rdf:resource="https://w3id.org/mado#CAR-INTERESSE-CONHECIMENTO-TEMA"/>
    <mado:aplicavelACaracteristicaRelevanteDaPessoa rdf:resource="https://w3id.org/mado#CAR-OPERACAO-NAO-CONVENCIONAL"/>
    <mado:aplicavelANecessidade rdf:resource="https://w3id.org/mado#NEC-FUNCAO-EXPLICITA-POR-MODALIDADE"/>
    <mado:aplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-COMUNICAR-E-EXPRESSAR"/>
    <mado:aplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-NAVEGAR-E-ORIENTAR-SE"/>
    <mado:aplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-OPERAR-SISTEMA"/>
    <mado:aplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-PRODUZIR-CONTEUDO-MULTIMODAL"/>
    <mado:articulacao xml:lang="pt-BR">O esquema de recomendação condiciona canais a necessidades e tecnologia; o estudo ACAT/MPD mostra que movimento disponível, visão, dispositivo e desempenho alteram a configuração; o RotaColab mostra que experiência prévia com TalkBack não elimina dificuldades de operação. A articulação impede que diagnóstico ou modalidade isolada determine a decisão.</mado:articulacao>
    <mado:articuladoSobPerspectiva rdf:resource="https://w3id.org/mado#P02"/>
    <mado:classificacaoOperacional>OPERACIONALIZAVEL</mado:classificacaoOperacional>
    <mado:contribuiParaFuncaoDecisoria rdf:resource="https://w3id.org/mado#FUN-CARACTERIZAR-CONDICOES"/>
    <mado:contribuiParaFuncaoDecisoria rdf:resource="https://w3id.org/mado#FUN-SELECIONAR-MODO-POR-CONDICAO"/>
    <mado:derivadoDe rdf:resource="https://w3id.org/mado#F01"/>
    <mado:derivadoDe rdf:resource="https://w3id.org/mado#F02"/>
    <mado:derivadoDe rdf:resource="https://w3id.org/mado#F05"/>
    <mado:derivadoDe rdf:resource="https://w3id.org/mado#F06"/>
    <mado:derivadoDe rdf:resource="https://w3id.org/mado#F08"/>
    <mado:enunciado xml:lang="pt-BR">A seleção de modalidades deve considerar conjuntamente a tarefa, as condições funcionais observadas, a proficiência com o recurso, o ambiente e a tecnologia disponível.</mado:enunciado>
    <mado:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">K39</mado:identificador>
    <mado:limite xml:lang="pt-BR">Não permite deduzir uma configuração sem caracterizar a tarefa e verificar os recursos disponíveis.</mado:limite>
    <mado:natureza>RECONSTRUCAO_ANALITICA_RASTREAVEL</mado:natureza>
    <mado:origemDaEstruturacaoSemantica xml:lang="pt-BR">Relação reconstruída pela autora entre trechos do corpus, condições funcionais, tarefa e função decisória; não é atribuída como formulação original às publicações.</mado:origemDaEstruturacaoSemantica>
    <mado:restricao xml:lang="pt-BR">BAR-RECURSO-INCOMPATIVEL-CAPACIDADE</mado:restricao>
    <mado:restricao xml:lang="pt-BR">CAR-EXPERIENCIA-DIGITAL-VARIAVEL</mado:restricao>
    <mado:restricao xml:lang="pt-BR">CAR-INTERESSE-CONHECIMENTO-TEMA</mado:restricao>
    <mado:restricao xml:lang="pt-BR">CAR-OPERACAO-NAO-CONVENCIONAL</mado:restricao>
    <mado:restricao xml:lang="pt-BR">NEC-FUNCAO-EXPLICITA-POR-MODALIDADE</mado:restricao>
    <mado:restricao xml:lang="pt-BR">TAR-COMUNICAR-E-EXPRESSAR</mado:restricao>
    <mado:restricao xml:lang="pt-BR">TAR-NAVEGAR-E-ORIENTAR-SE</mado:restricao>
    <mado:restricao xml:lang="pt-BR">TAR-OPERAR-SISTEMA</mado:restricao>
    <mado:restricao xml:lang="pt-BR">TAR-PRODUZIR-CONTEUDO-MULTIMODAL</mado:restricao>
    <mado:statusDaRelacao>PRODUTO_DE_ARTICULACAO_RC3</mado:statusDaRelacao>
    <mado:sustentadoPorTrecho rdf:resource="https://w3id.org/mado#TD-RC3-REF-01"/>
    <mado:sustentadoPorTrecho rdf:resource="https://w3id.org/mado#TD-RC3-REF-03"/>
    <mado:sustentadoPorTrecho rdf:resource="https://w3id.org/mado#TD-RC3-REF-06"/>
    <mado:sustentadoPorTrecho rdf:resource="https://w3id.org/mado#TD-RC3-REF-07"/>
    <mado:sustentadoPorTrecho rdf:resource="https://w3id.org/mado#TD-RC3-REF-10"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mado#ORI-0149">
    <rdf:type rdf:resource="https://w3id.org/mado#RelacaoDeOrigemDoCriterio"/>
    <rdfs:label xml:lang="pt-BR">ORI-0149</rdfs:label>
    <mado:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ORI-0149</mado:identificador>
    <mado:origemEmFonte rdf:resource="https://w3id.org/mado#FN-ABNT-MOBILE"/>
    <mado:origemSustentadaPorTrecho rdf:resource="https://w3id.org/mado#TD-ORI-0149"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mado#K38">
    <rdf:type rdf:resource="https://w3id.org/mado#ConhecimentoMultimodalArticulado"/>
    <rdfs:label xml:lang="pt-BR">Um recurso digital multimodal revisável deve organizar cada unidade de conteúdo com uma ideia central, sua representação principal, alternativas que preservem significado, indicação de autoria e fonte, e um ponto de verificação antes da publicação.</rdfs:label>
    <mado:aplicavelABarreira rdf:resource="https://w3id.org/mado#BAR-FALA-ISOLADA-NAO-PERSISTE"/>
    <mado:aplicavelABarreira rdf:resource="https://w3id.org/mado#BAR-FORMATOS-COMPETEM-PELA-ATENCAO"/>
    <mado:aplicavelAModalidade rdf:resource="https://w3id.org/mado#MOD-AUDIO"/>
    <mado:aplicavelAModalidade rdf:resource="https://w3id.org/mado#MOD-IMAGEM"/>
    <mado:aplicavelAModalidade rdf:resource="https://w3id.org/mado#MOD-TEXTO"/>
    <mado:aplicavelANecessidade rdf:resource="https://w3id.org/mado#NEC-ALTERNATIVAS-DE-ACESSO-AO-RECURSO"/>
    <mado:aplicavelANecessidade rdf:resource="https://w3id.org/mado#NEC-PRESERVAR-CONTEUDO-PARA-REVISAO"/>
    <mado:aplicavelARecursoDigital rdf:resource="https://w3id.org/mado#RED-AMBIENTE-AUTORIA-MULTIMIDIA"/>
    <mado:aplicavelARecursoDigital rdf:resource="https://w3id.org/mado#RED-RECURSO-DIGITAL-HISTORIA"/>
    <mado:aplicavelARecursoDisponivel rdf:resource="https://w3id.org/mado#REC-EDITOR-MULTIMIDIA"/>
    <mado:aplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-CONSTRUIR-RECURSO-DIGITAL-HISTORIA"/>
    <mado:aplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-REVISAR-PUBLICAR-RECURSO"/>
    <mado:articulacao xml:lang="pt-BR">Combina representação acessível, organização contra sobrecarga, comunicação multiformato, contextualização de tarefa e necessidade de observar e revisar. O produto persistente permite retomar a fala sem depender de memória ou de um único momento de apresentação.</mado:articulacao>
    <mado:articuladoSobPerspectiva rdf:resource="https://w3id.org/mado#P02"/>
    <mado:articuladoSobPerspectiva rdf:resource="https://w3id.org/mado#P03"/>
    <mado:classificacaoOperacional>OPERACIONALIZAVEL</mado:classificacaoOperacional>
    <mado:contribuiParaFuncaoDecisoria rdf:resource="https://w3id.org/mado#FUN-ORGANIZAR-CONTEUDO"/>
    <mado:contribuiParaFuncaoDecisoria rdf:resource="https://w3id.org/mado#FUN-PERMITIR-REVISAO"/>
    <mado:contribuiParaFuncaoDecisoria rdf:resource="https://w3id.org/mado#FUN-PRESERVAR-ACESSO"/>
    <mado:derivadoDe rdf:resource="https://w3id.org/mado#F03"/>
    <mado:derivadoDe rdf:resource="https://w3id.org/mado#F06"/>
    <mado:derivadoDe rdf:resource="https://w3id.org/mado#F07"/>
    <mado:derivadoDe rdf:resource="https://w3id.org/mado#F08"/>
    <mado:derivadoDe rdf:resource="https://w3id.org/mado#F12"/>
    <mado:enunciado xml:lang="pt-BR">Um recurso digital multimodal revisável deve organizar cada unidade de conteúdo com uma ideia central, sua representação principal, alternativas que preservem significado, indicação de autoria e fonte, e um ponto de verificação antes da publicação.</mado:enunciado>
    <mado:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">K38</mado:identificador>
    <mado:limite xml:lang="pt-BR">A estrutura apoia a decisão, mas a qualidade histórica e pedagógica do conteúdo requer revisão da professora e da turma.</mado:limite>
    <mado:natureza>CONHECIMENTO_ARTICULADO_RC2</mado:natureza>
    <mado:origemDaEstruturacaoSemantica xml:lang="pt-BR">Produzido por ART-TRF-04 pela complementação de conhecimentos acumulados e contextualizados.</mado:origemDaEstruturacaoSemantica>
    <mado:requerElementoDoContexto rdf:resource="https://w3id.org/mado#REC-EDITOR-MULTIMIDIA"/>
    <mado:restricao xml:lang="pt-BR">alternativas acessíveis</mado:restricao>
    <mado:restricao xml:lang="pt-BR">conteúdo persistente</mado:restricao>
    <mado:restricao xml:lang="pt-BR">estrutura por unidades</mado:restricao>
    <mado:restricao xml:lang="pt-BR">fontes e autoria</mado:restricao>
    <mado:restricao xml:lang="pt-BR">revisão</mado:restricao>
    <mado:statusDaRelacao>PRODUTO_DE_ARTICULACAO_RC2</mado:statusDaRelacao>
    <mado:sustentadoPorTrecho rdf:resource="https://w3id.org/mado#TD-EL01"/>
    <mado:sustentadoPorTrecho rdf:resource="https://w3id.org/mado#TD-EL03"/>
    <mado:sustentadoPorTrecho rdf:resource="https://w3id.org/mado#TD-EV12"/>
    <mado:sustentadoPorTrecho rdf:resource="https://w3id.org/mado#TD-EV13"/>
    <mado:sustentadoPorTrecho rdf:resource="https://w3id.org/mado#TD-EV29"/>
    <mado:sustentadoPorTrecho rdf:resource="https://w3id.org/mado#TD-EV30"/>
