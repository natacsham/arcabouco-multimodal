  <rdf:Description rdf:about="https://w3id.org/mado#CTX-SINTETICO-GEO-01">
    <rdf:type rdf:resource="https://w3id.org/mado#ContextoDeInteracaoDigital"/>
    <rdfs:label xml:lang="pt-BR">CTX-SINTETICO-GEO-01</rdfs:label>
    <mado:apresentaBarreira rdf:resource="https://w3id.org/mado#BAR-CONTRIBUICAO-EXTENSA-SEM-SEQUENCIA"/>
    <mado:apresentaNecessidade rdf:resource="https://w3id.org/mado#NEC-APOIAR-COMPREENSAO-TURMA"/>
    <mado:apresentaNecessidade rdf:resource="https://w3id.org/mado#NEC-ORGANIZAR-DELIMITAR-PARTICIPACAO"/>
    <mado:apresentaNecessidade rdf:resource="https://w3id.org/mado#NEC-PRESERVAR-PROTAGONISMO"/>
    <mado:baseadoEmContexto rdf:resource="https://w3id.org/mado#CTX-RELATADO-01"/>
    <mado:consideraCaracteristicaRelevanteDaPessoa rdf:resource="https://w3id.org/mado#CAR-ENSINO-FUNDAMENTAL-II"/>
    <mado:consideraCaracteristicaRelevanteDaPessoa rdf:resource="https://w3id.org/mado#CAR-INTERESSE-GEOGRAFIA-MAPAS"/>
    <mado:descricaoDoContexto xml:lang="pt-BR">Novo caso fictício semelhante: estudante do Ensino Fundamental II com interesse e conhecimento em Geografia e mapas fará uma explicação curta para a turma. Sua fala é extensa e espontânea. A atividade dispõe de mapa digital, projeção, palavras-chave e imagens e deve preservar seu protagonismo enquanto organiza a sequência e apoia a compreensão da turma.</mado:descricaoDoContexto>
    <mado:descritoSobPerspectiva rdf:resource="https://w3id.org/mado#P02"/>
    <mado:descritoSobPerspectiva rdf:resource="https://w3id.org/mado#P03"/>
    <mado:envolveRecursoDigital rdf:resource="https://w3id.org/mado#RED-MAPA-DIGITAL"/>
    <mado:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CTX-SINTETICO-GEO-01</mado:identificador>
    <mado:natureza>SINTETICO_HISTORICO_PRESERVADO</mado:natureza>
    <mado:objetivo xml:lang="pt-BR">Explicar relações espaciais de um conteúdo de Geografia e permitir que a turma identifique os pontos centrais.</mado:objetivo>
    <mado:ocorreEmAmbiente rdf:resource="https://w3id.org/mado#AMB-SALA-DE-AULA"/>
    <mado:restricao xml:lang="pt-BR">O mapa digital é uma escolha sintética para testar transferência; não foi relatado como prática do caso original.</mado:restricao>
    <mado:restricao xml:lang="pt-BR">Preservar o protagonismo sem transformar a atividade em roteiro rígido.</mado:restricao>
    <mado:statusDoRegistro>SUBSTITUIDO_NA_SESSAO_PELA_RC4</mado:statusDoRegistro>
    <mado:temModalidadeDisponivel rdf:resource="https://w3id.org/mado#MOD-FALA"/>
    <mado:temModalidadeDisponivel rdf:resource="https://w3id.org/mado#MOD-IMAGEM"/>
    <mado:temModalidadeDisponivel rdf:resource="https://w3id.org/mado#MOD-TEXTO"/>
    <mado:temRecursoDisponivel rdf:resource="https://w3id.org/mado#REC-MAPA-DIGITAL-PROJECAO"/>
    <mado:temTarefa rdf:resource="https://w3id.org/mado#TAR-COMUNICAR-CONTEUDO-1545B38"/>
    <mado:temTarefa rdf:resource="https://w3id.org/mado#TAR-MICROEXPLICACAO-CURRICULAR"/>
  </rdf:Description>
