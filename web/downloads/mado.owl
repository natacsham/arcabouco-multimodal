  <rdf:Description rdf:about="https://w3id.org/mado#CA64">
    <rdf:type rdf:resource="https://w3id.org/mado#CriterioDeDecisaoMultimodal"/>
    <rdfs:label xml:lang="pt-BR"> A ativação de uma função não deve ocorrer no evento de pressionar o ponteiro (down-event), mas sim ao soltá-lo (up-event), ou deve haver um mecanismo para cancelar ou reverter a ação.</rdfs:label>
    <mado:enunciado xml:lang="pt-BR">A ativação de uma função não deve ocorrer no evento de pressionar o ponteiro (down-event), mas sim ao soltá-lo (up-event), ou deve haver um mecanismo para cancelar ou reverter a ação.</mado:enunciado>
    <mado:fundamentadoPor rdf:resource="https://w3id.org/mado#K28"/>
    <mado:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CA64</mado:identificador>
    <mado:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0334"/>
    <mado:statusDaRelacao>RELACAO_SEM_JUSTIFICATIVA_EXPLICITA</mado:statusDaRelacao>
  </rdf:Description>
