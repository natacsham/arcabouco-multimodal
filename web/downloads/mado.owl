  <rdf:Description rdf:about="https://w3id.org/mado#CAR-NECESSITA-ESTRUTURA-TRANSICAO">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://w3id.org/mado/scheme/CARACTERISTICA_PESSOA"/>
    <skos:prefLabel xml:lang="pt-BR">Beneficia-se de estrutura explícita para transições, retomada e fechamento</skos:prefLabel>
    <mado:caracteristicaDerivadaDeFonte rdf:resource="https://w3id.org/mado#F06"/>
    <mado:caracteristicaDerivadaDeFonte rdf:resource="https://w3id.org/mado#F07"/>
    <mado:caracteristicaDerivadaDeFonte rdf:resource="https://w3id.org/mado#F08"/>
    <mado:caracteristicaDerivadaDeFonte rdf:resource="https://w3id.org/mado#F12"/>
    <mado:caracteristicaSustentadaPorTrecho rdf:resource="https://w3id.org/mado#TD-ELIC-03"/>
    <mado:caracteristicaSustentadaPorTrecho rdf:resource="https://w3id.org/mado#TD-EV34"/>
    <mado:caracteristicaSustentadaPorTrecho rdf:resource="https://w3id.org/mado#TD-RC3-REF-09"/>
    <mado:caracteristicaSustentadaPorTrecho rdf:resource="https://w3id.org/mado#TD-RC3-REF-10"/>
    <mado:categoriaDaCaracteristica>ATENCAO_E_ORGANIZACAO</mado:categoriaDaCaracteristica>
    <mado:condicaoDeUsoDaCaracteristica xml:lang="pt-BR">Objetivo e papéis devem ser confirmados com os participantes.</mado:condicaoDeUsoDaCaracteristica>
    <mado:condicaoDeUsoDaCaracteristica xml:lang="pt-BR">Usar poucos marcos persistentes e permitir retomada.</mado:condicaoDeUsoDaCaracteristica>
    <mado:contraindicacao xml:lang="pt-BR">Não converter organização em silenciamento ou roteiro rígido.</mado:contraindicacao>
    <mado:contraindicacao xml:lang="pt-BR">Não pressupor que mais estímulos aumentam compreensão.</mado:contraindicacao>
    <mado:efeitoPossivelNaTarefa xml:lang="pt-BR">Formatos simultâneos ou mudanças abruptas podem prejudicar continuidade e participação.</mado:efeitoPossivelNaTarefa>
    <mado:efeitoPossivelNaTarefa xml:lang="pt-BR">Sem combinação explícita, autoria pode ser retirada ou a participação pode se tornar conflitiva.</mado:efeitoPossivelNaTarefa>
    <mado:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CAR-NECESSITA-ESTRUTURA-TRANSICAO</mado:identificador>
    <mado:statusDoRegistro>CONTROLADO_1_2_RC3</mado:statusDoRegistro>
  </rdf:Description>
