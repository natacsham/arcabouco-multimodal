    <rdf:type rdf:resource="https://w3id.org/mado#CriterioDeDecisaoMultimodal"/>
    <rdfs:label xml:lang="pt-BR">A cor não deve ser o único meio de transmitir informação, indicar ação, pedir resposta ou distinguir elementos.</rdfs:label>
