  <rdf:Description rdf:about="https://w3id.org/mado#CA74">
    <rdf:type rdf:resource="https://w3id.org/mado#CriterioDeDecisaoMultimodal"/>
    <rdfs:label xml:lang="pt-BR">O conteúdo textual deve utilizar uma linguagem clara e simples ou, para textos complexos, fornecer uma versão alternativa ou conteúdo suplementar que seja mais fácil de compreender.</rdfs:label>
    <mado:criterioAplicavelAModalidade rdf:resource="https://w3id.org/mado#MOD-DESENHO"/>
    <mado:criterioAplicavelAModalidade rdf:resource="https://w3id.org/mado#MOD-FALA"/>
    <mado:criterioAplicavelAModalidade rdf:resource="https://w3id.org/mado#MOD-IMAGEM"/>
    <mado:criterioAplicavelAModalidade rdf:resource="https://w3id.org/mado#MOD-JOGO-INTERATIVO"/>
    <mado:criterioAplicavelAModalidade rdf:resource="https://w3id.org/mado#MOD-TEXTO"/>
    <mado:criterioAplicavelARecurso rdf:resource="https://w3id.org/mado#REC-COMPUTADOR-DATASHOW"/>
    <mado:criterioAplicavelARecurso rdf:resource="https://w3id.org/mado#REC-DESENHO-QUADRO-PAPEL"/>
    <mado:criterioAplicavelARecurso rdf:resource="https://w3id.org/mado#REC-LEITOR-DE-TELA"/>
    <mado:criterioAplicavelARecurso rdf:resource="https://w3id.org/mado#REC-PALAVRAS-CHAVE-LINHA-DO-TEMPO"/>
    <mado:criterioAplicavelARecurso rdf:resource="https://w3id.org/mado#RED-JOGO-HISTORIA"/>
    <mado:criterioAplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-ACESSAR-CONTEUDO-9DCCC00"/>
    <mado:criterioAplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-ACESSAR-CONTEUDO-WEB-E80BA3E"/>
    <mado:criterioAplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-COMUNICAR-CONTEUDO-1545B38"/>
    <mado:criterioAplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-CONSTRUIR-RECURSO-DIGITAL-HISTORIA"/>
    <mado:criterioAplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-ENVIAR-LER-MENSAGEM-INTERAGIR-COM-MENSAGENS-4C0CACA"/>
    <mado:criterioAplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-EXPLICAR-CONTEUDO-HISTORIA"/>
    <mado:criterioAplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-MICROEXPLICACAO-CURRICULAR"/>
    <mado:criterioAplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-ORGANIZAR-PARTICIPACAO-MULTIMODAL"/>
    <mado:criterioAplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-REVISAR-PUBLICAR-RECURSO"/>
    <mado:enunciado xml:lang="pt-BR">O conteúdo textual deve utilizar uma linguagem clara e simples ou, para textos complexos, fornecer uma versão alternativa ou conteúdo suplementar que seja mais fácil de compreender.</mado:enunciado>
    <mado:funcaoDecisoria xml:lang="pt-BR">ancorar relações cronológicas ou conceituais mencionadas na fala</mado:funcaoDecisoria>
    <mado:funcaoDecisoria xml:lang="pt-BR">expressar o conhecimento prévio e relacioná-lo ao objetivo curricular</mado:funcaoDecisoria>
    <mado:funcaoDecisoria xml:lang="pt-BR">expressão principal do conhecimento da pessoa</mado:funcaoDecisoria>
    <mado:funcaoDecisoria xml:lang="pt-BR">externalizar relações e apoiar a preparação ou continuidade da explicação</mado:funcaoDecisoria>
    <mado:funcaoDecisoria xml:lang="pt-BR">manter uma forma persistente, editável e compatível com tecnologia assistiva</mado:funcaoDecisoria>
    <mado:funcaoDecisoria xml:lang="pt-BR">marcar a sequência, o objetivo e as transições sem substituir a explicação</mado:funcaoDecisoria>
    <mado:funcaoDecisoria xml:lang="pt-BR">mobilizar o interesse para uma tarefa curricular verificável</mado:funcaoDecisoria>
    <mado:funcaoDecisoria xml:lang="pt-BR">orientar sequência, objetivo e transições sem substituir a fala</mado:funcaoDecisoria>
    <mado:funcaoDecisoria xml:lang="pt-BR">preservar o significado visual em estrutura e descrição processáveis</mado:funcaoDecisoria>
    <mado:fundamentadoPor rdf:resource="https://w3id.org/mado#K07"/>
    <mado:fundamentadoPor rdf:resource="https://w3id.org/mado#K10"/>
    <mado:fundamentadoPor rdf:resource="https://w3id.org/mado#K11"/>
