  <rdf:Description rdf:about="https://w3id.org/mado#K18">
    <rdf:type rdf:resource="https://w3id.org/mado#ConhecimentoMultimodalArticulado"/>
    <rdfs:label xml:lang="pt-BR">A continuidade da interação de pessoas cegas pode depender da coordenação entre leitor de tela, voz, informação textual, mensagens e dispositivos, especialmente quando tarefas atravessam diferentes sistemas e contextos.</rdfs:label>
    <mado:aplicavelACaracteristicaRelevanteDaPessoa rdf:resource="https://w3id.org/mado#CAR-INTERACAO-NAO-VISUAL"/>
    <mado:aplicavelACaracteristicaRelevanteDaPessoa rdf:resource="https://w3id.org/mado#CAR-USA-LEITOR-TELA"/>
    <mado:aplicavelANecessidade rdf:resource="https://w3id.org/mado#NEC-COMUNICACAO-MULTIFORMATO"/>
    <mado:aplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-ENVIAR-LER-MENSAGEM-INTERAGIR-COM-MENSAGENS-4C0CACA"/>
    <mado:articulacao xml:lang="pt-BR">Gustavo é fundamentado no RotaColab e em seu reprojeto. O conhecimento de mobilidade, feedback e alternativas de interação é reorganizado no perfil para representar uso cotidiano de smartphone/computador, assistente de voz, mensagens e sistemas corporativos.</mado:articulacao>
    <mado:articuladoSobPerspectiva rdf:resource="https://w3id.org/mado#P02"/>
    <mado:classificacaoOperacional>OPERACIONALIZAVEL</mado:classificacaoOperacional>
    <mado:derivadoDe rdf:resource="https://w3id.org/mado#F06"/>
    <mado:enunciado xml:lang="pt-BR">A continuidade da interação de pessoas cegas pode depender da coordenação entre leitor de tela, voz, informação textual, mensagens e dispositivos, especialmente quando tarefas atravessam diferentes sistemas e contextos.</mado:enunciado>
    <mado:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">K18</mado:identificador>
    <mado:natureza>RECONSTRUÇÃO ANALÍTICA FORTEMENTE SUSTENTADA</mado:natureza>
    <mado:origemDaEstruturacaoSemantica xml:lang="pt-BR">Relações derivadas de contextos e decisões documentados; complementações RC3 foram estabelecidas somente quando o enunciado, a articulação e os trechos sustentavam a aplicabilidade.</mado:origemDaEstruturacaoSemantica>
    <mado:statusDaRelacao>CONHECIMENTO_CANDIDATO</mado:statusDaRelacao>
    <mado:sustentadoPorTrecho rdf:resource="https://w3id.org/mado#TD-EV35"/>
  </rdf:Description>
