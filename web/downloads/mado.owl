    <mado:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CFG-RC4-05</mado:identificador>
    <mado:limiteDaConfiguracao xml:lang="pt-BR">O jogo não é indicado quando aumenta pressão, competição ou carga sem acrescentar compreensão.</mado:limiteDaConfiguracao>
    <mado:origemDoRegistro>CONFIGURACAO_MATURA_RC4</mado:origemDoRegistro>
    <mado:significadoFuncional xml:lang="pt-BR">Uma relação já construída precisa ser testada e discutida com feedback explicativo.</mado:significadoFuncional>
    <mado:temAcaoOperacional xml:lang="pt-BR">criar poucas situações de ordenar, relacionar ou comparar; após cada resposta, oferecer feedback explicativo, permitir nova tentativa e discutir divergências com a turma</mado:temAcaoOperacional>
    <mado:temFuncaoModal xml:lang="pt-BR">consolidar relações e tornar dúvidas observáveis sem transformar acerto em objetivo isolado</mado:temFuncaoModal>
    <mado:temPapelModal rdf:resource="https://w3id.org/mado#PAPEL-COMPLEMENTAR"/>
    <mado:possuiAplicacaoDeCriterio rdf:resource="https://w3id.org/mado#APL-CFG-RC4-05-01"/>
