  <rdf:Description rdf:about="https://w3id.org/mado#K22">
    <rdf:type rdf:resource="https://w3id.org/mado#ConhecimentoMultimodalArticulado"/>
    <rdfs:label xml:lang="pt-BR">Personas usadas para apoiar decisões de acessibilidade precisam explicitar tarefas, barreiras, ferramentas, contexto e limites das inferências sobre a pessoa, em vez de registrar características como traços estáveis e descontextualizados.</rdfs:label>
    <mado:articulacao xml:lang="pt-BR">A validação das cinco personas mostra diferenças de clareza e comentários recorrentes sobre falta de detalhes de tarefas, sistemas, tecnologias, ambiente, produtividade e esforço. No estudo de 2025, esses aprendizados são consolidados em quatro oportunidades de melhoria e usados no refinamento posterior.</mado:articulacao>
    <mado:articuladoSobPerspectiva rdf:resource="https://w3id.org/mado#P02"/>
    <mado:classificacaoOperacional>OPERACIONALIZAVEL</mado:classificacaoOperacional>
    <mado:contribuiParaFuncaoDecisoria rdf:resource="https://w3id.org/mado#FUN-CARACTERIZAR-CONDICOES"/>
    <mado:derivadoDe rdf:resource="https://w3id.org/mado#F07"/>
    <mado:derivadoDe rdf:resource="https://w3id.org/mado#F08"/>
    <mado:enunciado xml:lang="pt-BR">Personas usadas para apoiar decisões de acessibilidade precisam explicitar tarefas, barreiras, ferramentas, contexto e limites das inferências sobre a pessoa, em vez de registrar características como traços estáveis e descontextualizados.</mado:enunciado>
    <mado:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">K22</mado:identificador>
    <mado:natureza>RECONSTRUÇÃO ANALÍTICA FORTEMENTE SUSTENTADA</mado:natureza>
    <mado:origemDaEstruturacaoSemantica xml:lang="pt-BR">Relações derivadas de contextos e decisões documentados; complementações RC3 foram estabelecidas somente quando o enunciado, a articulação e os trechos sustentavam a aplicabilidade.</mado:origemDaEstruturacaoSemantica>
    <mado:restricao xml:lang="pt-BR">Persona</mado:restricao>
    <mado:restricao xml:lang="pt-BR">RF01–RF05</mado:restricao>
    <mado:restricao xml:lang="pt-BR">SIGAA</mado:restricao>
    <mado:restricao xml:lang="pt-BR">critérios</mado:restricao>
    <mado:restricao xml:lang="pt-BR">objetivos</mado:restricao>
    <mado:restricao xml:lang="pt-BR">tarefas</mado:restricao>
    <mado:restricao xml:lang="pt-BR">tecnologias assistivas</mado:restricao>
    <mado:statusDaRelacao>CONHECIMENTO_CANDIDATO</mado:statusDaRelacao>
