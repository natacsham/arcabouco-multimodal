  <rdf:Description rdf:about="https://w3id.org/mado#K41">
    <rdf:type rdf:resource="https://w3id.org/mado#ConhecimentoMultimodalArticulado"/>
    <rdfs:label xml:lang="pt-BR">Uma entrada alternativa somente apoia a tarefa quando o gesto ou movimento exigido é viável, o dispositivo e o sistema são compatíveis, o desempenho é suficiente e o usuário recebe confirmação perceptível.</rdfs:label>
    <mado:aplicavelABarreira rdf:resource="https://w3id.org/mado#BAR-RECURSO-INCOMPATIVEL-CAPACIDADE"/>
    <mado:aplicavelACaracteristicaRelevanteDaPessoa rdf:resource="https://w3id.org/mado#CAR-OPERACAO-NAO-CONVENCIONAL"/>
    <mado:aplicavelANecessidade rdf:resource="https://w3id.org/mado#NEC-ENTRADA-ALTERNATIVA"/>
    <mado:aplicavelARecursoDisponivel rdf:resource="https://w3id.org/mado#REC-ENTRADA-VOZ"/>
    <mado:aplicavelARecursoDisponivel rdf:resource="https://w3id.org/mado#REC-SENSORES"/>
    <mado:aplicavelARecursoDisponivel rdf:resource="https://w3id.org/mado#REC-TECLADO"/>
    <mado:aplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-OPERAR-SISTEMA"/>
    <mado:articulacao xml:lang="pt-BR">O estudo ACAT/MPD articula movimento residual, baixa visão, webcam, dispositivo de pressão e teclado em tela; o RotaColab mostra falhas quando gesto, touchscreen, rede ou retorno não correspondem às condições reais.</mado:articulacao>
    <mado:articuladoSobPerspectiva rdf:resource="https://w3id.org/mado#P02"/>
    <mado:classificacaoOperacional>OPERACIONALIZAVEL</mado:classificacaoOperacional>
    <mado:contribuiParaFuncaoDecisoria rdf:resource="https://w3id.org/mado#FUN-FEEDBACK-PERCEPTIVEL"/>
    <mado:contribuiParaFuncaoDecisoria rdf:resource="https://w3id.org/mado#FUN-SELECIONAR-MODO-POR-CONDICAO"/>
    <mado:derivadoDe rdf:resource="https://w3id.org/mado#F01"/>
    <mado:derivadoDe rdf:resource="https://w3id.org/mado#F05"/>
    <mado:enunciado xml:lang="pt-BR">Uma entrada alternativa somente apoia a tarefa quando o gesto ou movimento exigido é viável, o dispositivo e o sistema são compatíveis, o desempenho é suficiente e o usuário recebe confirmação perceptível.</mado:enunciado>
    <mado:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">K41</mado:identificador>
    <mado:limite xml:lang="pt-BR">A viabilidade do mecanismo deve ser testada com o movimento, o dispositivo e a tarefa reais.</mado:limite>
    <mado:natureza>RECONSTRUCAO_ANALITICA_RASTREAVEL</mado:natureza>
    <mado:origemDaEstruturacaoSemantica xml:lang="pt-BR">Relação reconstruída pela autora entre trechos do corpus, condições funcionais, tarefa e função decisória; não é atribuída como formulação original às publicações.</mado:origemDaEstruturacaoSemantica>
    <mado:restricao xml:lang="pt-BR">BAR-RECURSO-INCOMPATIVEL-CAPACIDADE</mado:restricao>
    <mado:restricao xml:lang="pt-BR">CAR-OPERACAO-NAO-CONVENCIONAL</mado:restricao>
    <mado:restricao xml:lang="pt-BR">NEC-ENTRADA-ALTERNATIVA</mado:restricao>
    <mado:restricao xml:lang="pt-BR">REC-ENTRADA-VOZ</mado:restricao>
    <mado:restricao xml:lang="pt-BR">REC-SENSORES</mado:restricao>
    <mado:restricao xml:lang="pt-BR">REC-TECLADO</mado:restricao>
    <mado:restricao xml:lang="pt-BR">TAR-OPERAR-SISTEMA</mado:restricao>
    <mado:statusDaRelacao>PRODUTO_DE_ARTICULACAO_RC3</mado:statusDaRelacao>
    <mado:sustentadoPorTrecho rdf:resource="https://w3id.org/mado#TD-RC3-REF-04"/>
    <mado:sustentadoPorTrecho rdf:resource="https://w3id.org/mado#TD-RC3-REF-07"/>
  </rdf:Description>
