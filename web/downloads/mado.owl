  <rdf:Description rdf:about="https://w3id.org/mado#K40">
    <rdf:type rdf:resource="https://w3id.org/mado#ConhecimentoMultimodalArticulado"/>
    <rdfs:label xml:lang="pt-BR">Informação auditiva usada para orientar uma ação precisa poder ser repetida; em ambiente ruidoso, um retorno háptico distinguível pode complementar o áudio sem substituir seu conteúdo.</rdfs:label>
    <mado:aplicavelAAmbiente rdf:resource="https://w3id.org/mado#AMB-MOBILIDADE-EM-AMBIENTE-FISICO-570C361"/>
    <mado:aplicavelABarreira rdf:resource="https://w3id.org/mado#BAR-EFEMERIDADE-DO-FEEDBACK-AUDITIVO-611AFB8"/>
    <mado:aplicavelABarreira rdf:resource="https://w3id.org/mado#BAR-INFORMACAO-EM-UM-SO-MODO"/>
    <mado:aplicavelARecursoDisponivel rdf:resource="https://w3id.org/mado#REC-FEEDBACK-ACESSIVEL"/>
    <mado:aplicavelARecursoDisponivel rdf:resource="https://w3id.org/mado#REC-FONES"/>
    <mado:aplicavelARecursoDisponivel rdf:resource="https://w3id.org/mado#REC-VIBRACAO"/>
    <mado:aplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-NAVEGAR-E-ORIENTAR-SE"/>
    <mado:aplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-REVISAR-E-CONFIRMAR"/>
    <mado:articulacao xml:lang="pt-BR">As rupturas do RotaColab distinguem periodicidade de recuperabilidade e mostram que ruído, vibração e possibilidade de repetir a mensagem cumprem funções diferentes e complementares.</mado:articulacao>
    <mado:articuladoSobPerspectiva rdf:resource="https://w3id.org/mado#P02"/>
    <mado:classificacaoOperacional>OPERACIONALIZAVEL</mado:classificacaoOperacional>
    <mado:contribuiParaFuncaoDecisoria rdf:resource="https://w3id.org/mado#FUN-FEEDBACK-PERCEPTIVEL"/>
    <mado:contribuiParaFuncaoDecisoria rdf:resource="https://w3id.org/mado#FUN-MANTER-INFORMACAO-RECUPERAVEL"/>
    <mado:derivadoDe rdf:resource="https://w3id.org/mado#F01"/>
    <mado:derivadoDe rdf:resource="https://w3id.org/mado#F02"/>
    <mado:enunciado xml:lang="pt-BR">Informação auditiva usada para orientar uma ação precisa poder ser repetida; em ambiente ruidoso, um retorno háptico distinguível pode complementar o áudio sem substituir seu conteúdo.</mado:enunciado>
    <mado:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">K40</mado:identificador>
    <mado:limite xml:lang="pt-BR">O retorno háptico precisa ser percebido e distinguível; não codifica sozinho informação verbal complexa.</mado:limite>
    <mado:natureza>RECONSTRUCAO_ANALITICA_RASTREAVEL</mado:natureza>
    <mado:origemDaEstruturacaoSemantica xml:lang="pt-BR">Relação reconstruída pela autora entre trechos do corpus, condições funcionais, tarefa e função decisória; não é atribuída como formulação original às publicações.</mado:origemDaEstruturacaoSemantica>
    <mado:restricao xml:lang="pt-BR">AMB-MOBILIDADE-EM-AMBIENTE-FISICO-570C361</mado:restricao>
    <mado:restricao xml:lang="pt-BR">BAR-EFEMERIDADE-DO-FEEDBACK-AUDITIVO-611AFB8</mado:restricao>
    <mado:restricao xml:lang="pt-BR">BAR-INFORMACAO-EM-UM-SO-MODO</mado:restricao>
    <mado:restricao xml:lang="pt-BR">REC-FEEDBACK-ACESSIVEL</mado:restricao>
    <mado:restricao xml:lang="pt-BR">REC-FONES</mado:restricao>
    <mado:restricao xml:lang="pt-BR">REC-VIBRACAO</mado:restricao>
    <mado:restricao xml:lang="pt-BR">TAR-NAVEGAR-E-ORIENTAR-SE</mado:restricao>
    <mado:restricao xml:lang="pt-BR">TAR-REVISAR-E-CONFIRMAR</mado:restricao>
    <mado:statusDaRelacao>PRODUTO_DE_ARTICULACAO_RC3</mado:statusDaRelacao>
