  <rdf:Description rdf:about="https://w3id.org/mado#K03">
    <rdf:type rdf:resource="https://w3id.org/mado#ConhecimentoMultimodalArticulado"/>
    <rdfs:label xml:lang="pt-BR">Formas de entrada em aplicações móveis acessíveis devem poder variar conforme a tarefa e as condições de interação, evitando dependência de digitação ou seleção visual quando essas formas se tornam difíceis.</rdfs:label>
    <mado:aplicavelAAmbiente rdf:resource="https://w3id.org/mado#AMB-APLICACAO-MOVEL-FF572C3"/>
    <mado:aplicavelABarreira rdf:resource="https://w3id.org/mado#BAR-DIGITACAO-SELECAO-CONVENCIONAL-DIFICIL-30CB86A"/>
    <mado:aplicavelACaracteristicaRelevanteDaPessoa rdf:resource="https://w3id.org/mado#CAR-ENTRADA-CONVENCIONAL-DIFICIL"/>
    <mado:aplicavelACaracteristicaRelevanteDaPessoa rdf:resource="https://w3id.org/mado#CAR-INTERACAO-NAO-VISUAL"/>
    <mado:aplicavelARecursoDisponivel rdf:resource="https://w3id.org/mado#REC-VOZ-RECONHECIMENTO-DE-FALA-B24FB5F"/>
    <mado:aplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-AUTENTICAR-SELECIONAR-DESTINO-A098E60"/>
    <mado:articulacao xml:lang="pt-BR">A avaliação identifica o login como tarefa crítica e registra sugestões de entrada por voz e de seleção de destino por comando de voz. A conclusão não é que voz seja universalmente superior, mas que a entrada precisa admitir alternativas compatíveis com a situação e com o modo de interação do usuário.</mado:articulacao>
    <mado:articuladoSobPerspectiva rdf:resource="https://w3id.org/mado#P02"/>
    <mado:classificacaoOperacional>OPERACIONALIZAVEL</mado:classificacaoOperacional>
    <mado:derivadoDe rdf:resource="https://w3id.org/mado#F01"/>
    <mado:enunciado xml:lang="pt-BR">Formas de entrada em aplicações móveis acessíveis devem poder variar conforme a tarefa e as condições de interação, evitando dependência de digitação ou seleção visual quando essas formas se tornam difíceis.</mado:enunciado>
    <mado:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">K03</mado:identificador>
    <mado:limite xml:lang="pt-BR">A voz foi proposta a partir da avaliação; o estudo não apresenta experimento específico comparando sua eficácia.</mado:limite>
    <mado:natureza>RECONSTRUÇÃO ANALÍTICA FORTEMENTE SUSTENTADA</mado:natureza>
    <mado:origemDaEstruturacaoSemantica xml:lang="pt-BR">Relações derivadas de contextos e decisões documentados; complementações RC3 foram estabelecidas somente quando o enunciado, a articulação e os trechos sustentavam a aplicabilidade.</mado:origemDaEstruturacaoSemantica>
    <mado:restricao xml:lang="pt-BR">Pessoa cega</mado:restricao>
    <mado:restricao xml:lang="pt-BR">digitação</mado:restricao>
    <mado:restricao xml:lang="pt-BR">login</mado:restricao>
    <mado:restricao xml:lang="pt-BR">seleção de destino</mado:restricao>
    <mado:restricao xml:lang="pt-BR">smartphone</mado:restricao>
    <mado:restricao xml:lang="pt-BR">voz</mado:restricao>
    <mado:statusDaRelacao>CONHECIMENTO_CANDIDATO</mado:statusDaRelacao>
    <mado:sustentadoPorTrecho rdf:resource="https://w3id.org/mado#TD-EV04"/>
    <mado:sustentadoPorTrecho rdf:resource="https://w3id.org/mado#TD-EV06"/>
  </rdf:Description>
