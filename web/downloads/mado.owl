<rdf:Description rdf:about="https://w3id.org/mado#CA86">
<rdf:type rdf:resource="https://w3id.org/mado#CriterioDeDecisaoMultimodal" />
<ns1:label xml:lang="pt-BR">Processos de autenticação não devem exigir exclusivamente um teste de função cognitiva (como memorização de senhas) sem oferecer uma alternativa ou um mecanismo de ajuda.</ns1:label>
<ns4:enunciado xml:lang="pt-BR">Processos de autenticação não devem exigir exclusivamente um teste de função cognitiva (como memorização de senhas) sem oferecer uma alternativa ou um mecanismo de ajuda.</ns4:enunciado>
<ns4:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CA86</ns4:identificador>
<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0403" />
