    <mado:aplicavelAModalidade rdf:resource="https://w3id.org/mado#MOD-VIDEO"/>
    <mado:aplicavelANecessidade rdf:resource="https://w3id.org/mado#NEC-ALTERNATIVA-FUNCIONAL-EQUIVALENTE"/>
    <mado:aplicavelANecessidade rdf:resource="https://w3id.org/mado#NEC-FUNCAO-EXPLICITA-POR-MODALIDADE"/>
    <mado:aplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-ACESSAR-COMPREENDER-CONTEUDO-DIGITAL"/>
    <mado:aplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-COMUNICAR-E-EXPRESSAR"/>
    <mado:aplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-ORGANIZAR-CONTEUDO-DIGITAL"/>
    <mado:aplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-PRODUZIR-CONTEUDO-MULTIMODAL"/>
    <mado:articulacao xml:lang="pt-BR">Conhecimentos sobre curadoria de conteúdo, competição entre formatos e alternativas perceptivas foram cruzados com as origens normativas de texto alternativo, legenda, audiodescrição e estrutura programática.</mado:articulacao>
    <mado:articuladoSobPerspectiva rdf:resource="https://w3id.org/mado#P02"/>
    <mado:classificacaoOperacional>OPERACIONALIZAVEL</mado:classificacaoOperacional>
    <mado:contribuiParaFuncaoDecisoria rdf:resource="https://w3id.org/mado#FUN-PRESERVAR-ACESSO"/>
    <mado:contribuiParaFuncaoDecisoria rdf:resource="https://w3id.org/mado#FUN-PRESERVAR-SIGNIFICADO-ENTRE-MODOS"/>
    <mado:derivadoDe rdf:resource="https://w3id.org/mado#F03"/>
    <mado:derivadoDe rdf:resource="https://w3id.org/mado#F06"/>
    <mado:derivadoDe rdf:resource="https://w3id.org/mado#F08"/>
    <mado:derivadoDe rdf:resource="https://w3id.org/mado#FN-ABNT-MOBILE"/>
    <mado:derivadoDe rdf:resource="https://w3id.org/mado#FN-ABNT-WEB"/>
    <mado:derivadoDe rdf:resource="https://w3id.org/mado#FN-WCAG"/>
    <mado:enunciado xml:lang="pt-BR">Imagem, desenho e vídeo somente ampliam o acesso quando cada modo tem função explícita e o significado essencial permanece disponível por estrutura, descrição, legenda, audiodescrição ou alternativa equivalente.</mado:enunciado>
    <mado:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">K42</mado:identificador>
    <mado:limite xml:lang="pt-BR">A alternativa deve preservar a informação relevante à tarefa; presença de múltiplos formatos não prova equivalência.</mado:limite>
    <mado:natureza>RECONSTRUCAO_ANALITICA_RASTREAVEL</mado:natureza>
    <mado:origemDaEstruturacaoSemantica xml:lang="pt-BR">Relação reconstruída pela autora entre trechos do corpus, condições funcionais, tarefa e função decisória; não é atribuída como formulação original às publicações.</mado:origemDaEstruturacaoSemantica>
    <mado:restricao xml:lang="pt-BR">BAR-CANAL-EXCLUSIVAMENTE-TEXTUAL-587ACB3</mado:restricao>
