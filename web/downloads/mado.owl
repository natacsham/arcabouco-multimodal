    <mado:enunciado xml:lang="pt-BR">Quando um erro de entrada de dados é detectado, ele deve ser identificado em texto, descrevendo claramente qual é o problema e qual campo o contém.</mado:enunciado>
    <mado:funcaoDecisoria xml:lang="pt-BR">preservar operação, foco, correção e confirmação</mado:funcaoDecisoria>
    <mado:fundamentadoPor rdf:resource="https://w3id.org/mado#K28"/>
    <mado:fundamentadoPor rdf:resource="https://w3id.org/mado#K29"/>
    <mado:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CA80</mado:identificador>
    <mado:justificativaDeFundamentacao xml:lang="pt-BR">Em versão anterior, a ligação foi reconstruída analiticamente porque o critério participa de uma configuração modalidade–função–recurso–responsável fundamentada por esses conhecimentos; não se atribui essa formalização retrospectiva às publicações originais.</mado:justificativaDeFundamentacao>
    <mado:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0381"/>
    <mado:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0382"/>
    <mado:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0383"/>
    <mado:statusDaRelacao>RELACAO_SEM_JUSTIFICATIVA_EXPLICITA</mado:statusDaRelacao>
  </rdf:Description>
