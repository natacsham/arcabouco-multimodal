<rdf:type rdf:resource="https://w3id.org/mado#CriterioDeDecisaoMultimodal" />
<ns1:label xml:lang="pt-BR">Deve haver um mecanismo para fornecer as definições de palavras, jargões ou expressões idiomáticas usadas de forma incomum ou com significado restrito.</ns1:label>
<ns4:enunciado xml:lang="pt-BR">Deve haver um mecanismo para fornecer as definições de palavras, jargões ou expressões idiomáticas usadas de forma incomum ou com significado restrito.</ns4:enunciado>
<ns4:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CA72</ns4:identificador>
