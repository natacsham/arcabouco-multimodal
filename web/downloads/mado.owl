  <rdf:Description rdf:about="https://w3id.org/mado#K11">
    <rdf:type rdf:resource="https://w3id.org/mado#ConhecimentoMultimodalArticulado"/>
    <rdfs:label xml:lang="pt-BR">Em contextos educacionais, a adaptação de conteúdo pode exigir mediação de quem conhece o objetivo pedagógico e o conteúdo, porque nem toda decisão sobre relevância e descrição pode ser resolvida apenas por tratamento automático.</rdfs:label>
    <mado:aplicavelAAmbiente rdf:resource="https://w3id.org/mado#AMB-MEDIACAO-DOCENTE-78522C6"/>
    <mado:aplicavelABarreira rdf:resource="https://w3id.org/mado#BAR-NECESSIDADE-DE-CONTEXTUALIZAR-A-ADAPTACAO-586A964"/>
    <mado:aplicavelACaracteristicaRelevanteDaPessoa rdf:resource="https://w3id.org/mado#CAR-INTERACAO-NAO-VISUAL"/>
    <mado:aplicavelACaracteristicaRelevanteDaPessoa rdf:resource="https://w3id.org/mado#CAR-USA-LEITOR-TELA"/>
    <mado:aplicavelARecursoDisponivel rdf:resource="https://w3id.org/mado#REC-MARCADORES-DESCRICAO-LEITOR-DE-TELA-4B8877E"/>
    <mado:aplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-PREPARAR-ADAPTAR-CONTEUDO-5107638"/>
    <mado:articulacao xml:lang="pt-BR">A WABlind combina um nível automático de tratamento sintático com uma camada colaborativa em que professores associam marcadores aos elementos. O papel do mediador decorre do objetivo de adequar o conteúdo às necessidades dos alunos preservando sua finalidade educacional.</mado:articulacao>
    <mado:articuladoSobPerspectiva rdf:resource="https://w3id.org/mado#P02"/>
    <mado:classificacaoOperacional>OPERACIONALIZAVEL</mado:classificacaoOperacional>
    <mado:derivadoDe rdf:resource="https://w3id.org/mado#F03"/>
    <mado:enunciado xml:lang="pt-BR">Em contextos educacionais, a adaptação de conteúdo pode exigir mediação de quem conhece o objetivo pedagógico e o conteúdo, porque nem toda decisão sobre relevância e descrição pode ser resolvida apenas por tratamento automático.</mado:enunciado>
    <mado:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">K11</mado:identificador>
    <mado:natureza>RECONSTRUÇÃO ANALÍTICA FORTEMENTE SUSTENTADA</mado:natureza>
    <mado:origemDaEstruturacaoSemantica xml:lang="pt-BR">Relações derivadas de contextos e decisões documentados; complementações RC3 foram estabelecidas somente quando o enunciado, a articulação e os trechos sustentavam a aplicabilidade.</mado:origemDaEstruturacaoSemantica>
    <mado:restricao xml:lang="pt-BR">Professor mediador</mado:restricao>
    <mado:restricao xml:lang="pt-BR">conteúdo</mado:restricao>
    <mado:restricao xml:lang="pt-BR">leitor de tela</mado:restricao>
    <mado:restricao xml:lang="pt-BR">marcadores</mado:restricao>
    <mado:restricao xml:lang="pt-BR">objetivo pedagógico</mado:restricao>
    <mado:statusDaRelacao>CONHECIMENTO_CANDIDATO</mado:statusDaRelacao>
    <mado:sustentadoPorTrecho rdf:resource="https://w3id.org/mado#TD-EV12"/>
    <mado:sustentadoPorTrecho rdf:resource="https://w3id.org/mado#TD-EV13"/>
    <mado:sustentadoPorTrecho rdf:resource="https://w3id.org/mado#TD-EV15"/>
  </rdf:Description>
