  <rdf:Description rdf:about="https://w3id.org/mado#D16">
    <rdf:type rdf:resource="https://w3id.org/mado#DecisaoDeAcessibilidadeMultimodal"/>
    <rdfs:label xml:lang="pt-BR">Para ampliar as formas de interação na comunicação do AVA, oferecer alternativas de entrada e percepção, incluindo leitura de texto, voz, ajustes visuais e suporte a LIBRAS, compatíveis com tecnologias assistivas.</rdfs:label>
    <mado:aplicaCriterio rdf:resource="https://w3id.org/mado#CA01"/>
    <mado:aplicaCriterio rdf:resource="https://w3id.org/mado#CA10"/>
    <mado:aplicaCriterio rdf:resource="https://w3id.org/mado#CA17"/>
    <mado:aplicaCriterio rdf:resource="https://w3id.org/mado#CA28"/>
    <mado:aplicaCriterio rdf:resource="https://w3id.org/mado#CA38"/>
    <mado:aplicaCriterio rdf:resource="https://w3id.org/mado#CA78"/>
    <mado:aplicaCriterio rdf:resource="https://w3id.org/mado#CA88"/>
    <mado:condicaoDeAplicacao xml:lang="pt-BR">Depende da implementação técnica e plataforma</mado:condicaoDeAplicacao>
    <mado:condicaoDeAplicacao xml:lang="pt-BR">Recursos devem permanecer compatíveis com TA</mado:condicaoDeAplicacao>
    <mado:enunciado xml:lang="pt-BR">Para ampliar as formas de interação na comunicação do AVA, oferecer alternativas de entrada e percepção, incluindo leitura de texto, voz, ajustes visuais e suporte a LIBRAS, compatíveis com tecnologias assistivas.</mado:enunciado>
    <mado:expressaoOperacional xml:lang="pt-BR">Em funcionalidades de comunicação, oferecer formas alternativas de entrada e percepção, como leitura de texto, voz, ajustes visuais e suporte a LIBRAS, selecionadas conforme os perfis e critérios do cenário.</mado:expressaoOperacional>
    <mado:expressaoOperacional xml:lang="pt-BR">Verificar a compatibilidade da composição multimodal com tecnologias assistivas efetivamente usadas no cenário antes de considerar a estratégia reutilizável.</mado:expressaoOperacional>
    <mado:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D16</mado:identificador>
    <mado:natureza>RECONSTRUÇÃO ANALÍTICA FORTEMENTE SUSTENTADA</mado:natureza>
    <mado:rationale xml:lang="pt-BR">Por quê: uma única forma de entrada/saída não atende aos diferentes perfis considerados. Para quê: ampliar autonomia na comunicação. Como: a barra multimodal combina funções ligadas a critérios de percepção, entrada e apresentação.</mado:rationale>
    <mado:respondeA rdf:resource="https://w3id.org/mado#CTX-D16"/>
    <mado:statusDecisao>DECISAO_HISTORICA_RECONSTRUIDA</mado:statusDecisao>
    <mado:statusDoRegistro>DECISAO_HISTORICA_RECONSTRUIDA</mado:statusDoRegistro>
    <mado:sustentadaPor rdf:resource="https://w3id.org/mado#K29"/>
  </rdf:Description>
