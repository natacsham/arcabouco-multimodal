  <rdf:Description rdf:about="https://w3id.org/mado#K27">
    <rdf:type rdf:resource="https://w3id.org/mado#ConhecimentoMultimodalArticulado"/>
    <rdfs:label xml:lang="pt-BR">Acessibilidade em tarefas de aprendizagem também pode exigir apoio à organização, compreensão e orientação, por meio de recursos cognitivos e de navegação que complementem as correções perceptivas e operacionais.</rdfs:label>
    <mado:aplicavelAAmbiente rdf:resource="https://w3id.org/mado#AMB-CONTEXTO-DIGITAL-DE-APRENDIZAGEM-42D27F5"/>
    <mado:aplicavelABarreira rdf:resource="https://w3id.org/mado#BAR-DUVIDA-AMBIGUIDADE-NECESSIDADE-DE-ORIENTACAO-8BC4FE1"/>
    <mado:aplicavelABarreira rdf:resource="https://w3id.org/mado#BAR-REPETICAO-PREJUDICA-VINCULO"/>
    <mado:aplicavelABarreira rdf:resource="https://w3id.org/mado#BAR-SOBRECARGA-AMBIGUIDADE-DESORIENTACAO-D622185"/>
    <mado:aplicavelABarreira rdf:resource="https://w3id.org/mado#BAR-TRANSICAO-E-CONTRADICAO-DIFICIL"/>
    <mado:aplicavelACaracteristicaRelevanteDaPessoa rdf:resource="https://w3id.org/mado#CAR-FALA-PERSISTENTE-REPETITIVA"/>
    <mado:aplicavelACaracteristicaRelevanteDaPessoa rdf:resource="https://w3id.org/mado#CAR-NECESSITA-ORGANIZACAO-COGNITIVA"/>
    <mado:aplicavelACaracteristicaRelevanteDaPessoa rdf:resource="https://w3id.org/mado#CAR-REAGE-DEFENSIVAMENTE-A-CONTRADICAO"/>
    <mado:aplicavelANecessidade rdf:resource="https://w3id.org/mado#NEC-ACESSO-EQUIVALENTE"/>
    <mado:aplicavelANecessidade rdf:resource="https://w3id.org/mado#NEC-ALINHAR-IMAGENS-PREVIAMENTE"/>
    <mado:aplicavelANecessidade rdf:resource="https://w3id.org/mado#NEC-APOIAR-COMPREENSAO-TURMA"/>
    <mado:aplicavelANecessidade rdf:resource="https://w3id.org/mado#NEC-NEGOCIAR-TURNOS-TRANSICOES"/>
    <mado:aplicavelANecessidade rdf:resource="https://w3id.org/mado#NEC-PRESERVAR-VINCULO-SOCIAL"/>
    <mado:aplicavelANecessidade rdf:resource="https://w3id.org/mado#NEC-SINALIZAR-AUSENCIA-IMAGEM"/>
    <mado:aplicavelARecursoDigital rdf:resource="https://w3id.org/mado#RED-APRESENTACAO-DIGITAL"/>
    <mado:aplicavelARecursoDigital rdf:resource="https://w3id.org/mado#RED-IMAGEM-DIGITAL"/>
    <mado:aplicavelARecursoDisponivel rdf:resource="https://w3id.org/mado#REC-AJUDA-TEXTUAL-CONTEXTUAL-POTENCIALMENTE-MULTIMOD-B60AF74"/>
    <mado:aplicavelARecursoDisponivel rdf:resource="https://w3id.org/mado#REC-MAPA-MENTAL-ICONOGRAFIA-CLARA-AJUDA-CONTEXTUAL-20533D7"/>
    <mado:aplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-ACESSAR-CONTEUDO-WEB-E80BA3E"/>
    <mado:aplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-APRESENTAR-CONTEUDO-DIFERENTES-ESPACOS"/>
    <mado:aplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-COMUNICAR-CONTEUDO-1545B38"/>
    <mado:aplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-EXECUTAR-TAREFAS-NO-AVA-7BEF3BD"/>
    <mado:aplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-LOCALIZAR-COMPREENDER-BAIXAR-CONTEUDO-922122F"/>
    <mado:articulacao xml:lang="pt-BR">Além de controles visuais e alternativas de mídia, o caso de conteúdo inclui mapa mental, ícone de download mais claro e ajuda contextual. Esses recursos respondem a problemas de organização, ambiguidade e carga cognitiva e são apresentados como parte da composição do redesign.</mado:articulacao>
    <mado:articuladoSobPerspectiva rdf:resource="https://w3id.org/mado#P02"/>
    <mado:classificacaoOperacional>OPERACIONALIZAVEL</mado:classificacaoOperacional>
    <mado:contribuiParaFuncaoDecisoria rdf:resource="https://w3id.org/mado#FUN-ORGANIZAR-CONTEUDO"/>
    <mado:contribuiParaFuncaoDecisoria rdf:resource="https://w3id.org/mado#FUN-PERMITIR-REVISAO"/>
    <mado:derivadoDe rdf:resource="https://w3id.org/mado#F08"/>
    <mado:enunciado xml:lang="pt-BR">Acessibilidade em tarefas de aprendizagem também pode exigir apoio à organização, compreensão e orientação, por meio de recursos cognitivos e de navegação que complementem as correções perceptivas e operacionais.</mado:enunciado>
    <mado:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">K27</mado:identificador>
    <mado:natureza>RECONSTRUÇÃO ANALÍTICA FORTEMENTE SUSTENTADA</mado:natureza>
    <mado:origemDaEstruturacaoSemantica xml:lang="pt-BR">Relações derivadas dos contextos, das decisões e dos trechos documentados; a aplicabilidade somente foi ampliada quando o enunciado e as fontes sustentavam a relação.</mado:origemDaEstruturacaoSemantica>
    <mado:restricao xml:lang="pt-BR">Ajuda contextual</mado:restricao>
    <mado:restricao xml:lang="pt-BR">Conteúdo</mado:restricao>
    <mado:restricao xml:lang="pt-BR">ajuda contextual</mado:restricao>
    <mado:restricao xml:lang="pt-BR">arquitetura/legado</mado:restricao>
    <mado:restricao xml:lang="pt-BR">assistente virtual</mado:restricao>
    <mado:restricao xml:lang="pt-BR">conteúdo</mado:restricao>
    <mado:restricao xml:lang="pt-BR">download</mado:restricao>
    <mado:restricao xml:lang="pt-BR">mapa mental</mado:restricao>
    <mado:restricao xml:lang="pt-BR">mensagens</mado:restricao>
    <mado:restricao xml:lang="pt-BR">navegação</mado:restricao>
    <mado:restricao xml:lang="pt-BR">organização</mado:restricao>
    <mado:statusDaRelacao>CONHECIMENTO_CANDIDATO_RC2</mado:statusDaRelacao>
