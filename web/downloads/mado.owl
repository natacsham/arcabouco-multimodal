    <mado:aplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-PRODUZIR-CONTEUDO-MULTIMODAL"/>
    <mado:articulacao xml:lang="pt-BR">A elicitação situa o conhecimento e as formas de expressão do estudante; os estudos com personas e critérios acrescentam contextualização de tarefa e limites. A articulação transforma hiperfoco ou diagnóstico em condições funcionais observáveis, sem generalizar o caso.</mado:articulacao>
    <mado:articuladoSobPerspectiva rdf:resource="https://w3id.org/mado#P02"/>
    <mado:classificacaoOperacional>OPERACIONALIZAVEL</mado:classificacaoOperacional>
