    <mado:configuracaoSustentadaPorConhecimento rdf:resource="https://w3id.org/mado#K36"/>
    <mado:configuracaoSustentadaPorConhecimento rdf:resource="https://w3id.org/mado#K42"/>
    <mado:configuracaoSustentadaPorConhecimento rdf:resource="https://w3id.org/mado#K43"/>
    <mado:configuracaoUsaOrigemDoCriterio rdf:resource="https://w3id.org/mado#ORI-0090"/>
