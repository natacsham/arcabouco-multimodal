<ns4:cumpreFuncaoDecisoria rdf:resource="https://w3id.org/mado#FUN-REDUZIR-SOBRECARGA" />
<ns4:estadoDeDisponibilidadeDaConfiguracao>CONFIRMADO_DISPONIVEL</ns4:estadoDeDisponibilidadeDaConfiguracao>
<ns4:executadaPorPapel rdf:resource="https://w3id.org/mado#PAPEL-PROFESSORA" />
<ns4:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CFG-RC4-06</ns4:identificador>
<ns4:limiteDaConfiguracao xml:lang="pt-BR">O acordo não deve ser usado para silenciar, punir repetição ou atribuir toda regulação ao estudante.</ns4:limiteDaConfiguracao>
<ns4:origemDoRegistro>CONFIGURACAO_MATURA_RC4</ns4:origemDoRegistro>
<ns4:possuiAplicacaoDeCriterio rdf:resource="https://w3id.org/mado#APL-CFG-RC4-06-01" />
<ns4:possuiAplicacaoDeCriterio rdf:resource="https://w3id.org/mado#APL-CFG-RC4-06-02" />
<ns4:possuiAplicacaoDeCriterio rdf:resource="https://w3id.org/mado#APL-CFG-RC4-06-03" />
<ns4:significadoFuncional xml:lang="pt-BR">A participação precisa preservar autoria e vínculo por regras previsíveis de transição.</ns4:significadoFuncional>
<ns4:temAcaoOperacional xml:lang="pt-BR">combinar quem abre cada bloco, quando colegas perguntam, como a professora sinaliza a transição e como o estudante registra uma contribuição que ficará para revisão</ns4:temAcaoOperacional>
<ns4:temFuncaoModal xml:lang="pt-BR">coordenar momentos de autoria, perguntas, complementação e fechamento</ns4:temFuncaoModal>
<ns4:temPapelModal rdf:resource="https://w3id.org/mado#PAPEL-APOIO-ORGANIZACAO" />
</rdf:Description>
<rdf:Description rdf:about="https://w3id.org/mado#CFG-RC4-07">
<rdf:type rdf:resource="https://w3id.org/mado#ConfiguracaoModalDaDecisao" />
<ns4:acompanhamentoDaConfiguracao xml:lang="pt-BR">Registrar quais blocos foram compreendidos, adaptados ou suspensos e por quê.</ns4:acompanhamentoDaConfiguracao>
<ns4:alternativaDaConfiguracao xml:lang="pt-BR">Revisar em papel ou áudio e registrar manualmente as alterações confirmadas.</ns4:alternativaDaConfiguracao>
<ns4:condicaoDaConfiguracao xml:lang="pt-BR">Manter versões editáveis e identificar quem aprovou o conteúdo autoral.</ns4:condicaoDaConfiguracao>
<ns4:configuraModalidade rdf:resource="https://w3id.org/mado#MOD-TEXTO" />
