  <rdf:Description rdf:about="https://w3id.org/mado#D06">
    <rdf:type rdf:resource="https://w3id.org/mado#DecisaoDeAcessibilidadeMultimodal"/>
    <rdfs:label xml:lang="pt-BR">Para reduzir a manipulação direta do smartphone durante o deslocamento, disponibilizar controles físicos alternativos, como botões do fone de ouvido, quando a tarefa permitir.</rdfs:label>
    <mado:condicaoDeAplicacao xml:lang="pt-BR">Não foi testada no estudo</mado:condicaoDeAplicacao>
    <mado:enunciado xml:lang="pt-BR">Para reduzir a manipulação direta do smartphone durante o deslocamento, disponibilizar controles físicos alternativos, como botões do fone de ouvido, quando a tarefa permitir.</mado:enunciado>
    <mado:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D06</mado:identificador>
    <mado:limite xml:lang="pt-BR">Proposta pós-avaliação, não testada no estudo.</mado:limite>
    <mado:natureza>RECONSTRUÇÃO ANALÍTICA FORTEMENTE SUSTENTADA</mado:natureza>
    <mado:rationale xml:lang="pt-BR">Por quê: mobilidade exige atenção ao ambiente e manipular o aparelho pode competir com a tarefa. Para quê: permitir interação mantendo o telefone no bolso. Como: o estudo propõe o headset como meio de controle após a avaliação.</mado:rationale>
    <mado:respondeA rdf:resource="https://w3id.org/mado#CTX-D06"/>
    <mado:statusDecisao>DECISAO_HISTORICA_RECONSTRUIDA</mado:statusDecisao>
    <mado:statusDoRegistro>DECISAO_HISTORICA_RECONSTRUIDA</mado:statusDoRegistro>
    <mado:sustentadaPor rdf:resource="https://w3id.org/mado#K06"/>
  </rdf:Description>
