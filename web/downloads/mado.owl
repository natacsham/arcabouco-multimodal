  <rdf:Description rdf:about="https://w3id.org/mado#CTX-ELICITACAO-01">
    <rdf:type rdf:resource="https://w3id.org/mado#ContextoDeInteracaoDigital"/>
    <rdfs:label xml:lang="pt-BR">CTX-ELICITACAO-01</rdfs:label>
    <mado:apresentaBarreira rdf:resource="https://w3id.org/mado#BAR-CONTRIBUICAO-EXTENSA-SEM-SEQUENCIA"/>
    <mado:apresentaNecessidade rdf:resource="https://w3id.org/mado#NEC-APOIAR-COMPREENSAO-TURMA"/>
    <mado:apresentaNecessidade rdf:resource="https://w3id.org/mado#NEC-ORGANIZAR-DELIMITAR-PARTICIPACAO"/>
    <mado:apresentaNecessidade rdf:resource="https://w3id.org/mado#NEC-PRESERVAR-PROTAGONISMO"/>
    <mado:apresentaNecessidade rdf:resource="https://w3id.org/mado#NEC-RELACIONAR-OBJETIVO-CURRICULAR"/>
    <mado:consideraCaracteristicaRelevanteDaPessoa rdf:resource="https://w3id.org/mado#CAR-INTERESSE-HISTORIA"/>
    <mado:consideraCaracteristicaRelevanteDaPessoa rdf:resource="https://w3id.org/mado#CAR-SETIMO-ANO"/>
    <mado:descricaoDoContexto xml:lang="pt-BR">Exemplo didático adaptado: um estudante tem interesse intenso e conhecimento aprofundado sobre um tema. Expressa suas ideias por fala, imagens e desenho. É necessário preservar sua autoria e organizar os momentos de participação com a professora e a turma. Este texto público não é a transcrição da entrevista.</mado:descricaoDoContexto>
    <mado:descritoSobPerspectiva rdf:resource="https://w3id.org/mado#P02"/>
    <mado:descritoSobPerspectiva rdf:resource="https://w3id.org/mado#P03"/>
    <mado:envolveRecursoDigital rdf:resource="https://w3id.org/mado#RED-SEQUENCIA-MULTIMODAL-DIGITAL"/>
    <mado:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CTX-ELICITACAO-01</mado:identificador>
    <mado:informacaoAusente xml:lang="pt-BR">Forma de transição que o estudante e a professora consideram respeitosa e viável.</mado:informacaoAusente>
    <mado:informacaoAusente xml:lang="pt-BR">Indicadores de compreensão e participação que a especialista considera adequados.</mado:informacaoAusente>
    <mado:informacaoAusente xml:lang="pt-BR">Objetivo curricular e recorte temático exatos da nova atividade.</mado:informacaoAusente>
    <mado:informacaoAusente xml:lang="pt-BR">Recursos digitais efetivamente disponíveis e condições de acessibilidade da turma.</mado:informacaoAusente>
    <mado:informacaoAusente xml:lang="pt-BR">Tempo disponível e número adequado de blocos da explicação.</mado:informacaoAusente>
    <mado:natureza>CENARIO_MISTO_HISTORICO_PRESERVADO</mado:natureza>
    <mado:objetivo xml:lang="pt-BR">Transformar o conhecimento e o interesse do estudante em participação curricular compreensível e delimitada, relacionando sua contribuição a um objetivo de aprendizagem e envolvendo a turma.</mado:objetivo>
    <mado:ocorreEmAmbiente rdf:resource="https://w3id.org/mado#AMB-SALA-DE-AULA"/>
    <mado:restricao xml:lang="pt-BR">Não misturar este caso com relatos referentes a outros estudantes.</mado:restricao>
    <mado:restricao xml:lang="pt-BR">Não presumir diagnóstico, equipamento, conexão, recurso digital disponível ou eficácia.</mado:restricao>
    <mado:restricao xml:lang="pt-BR">Não transformar o interesse do estudante em prescrição rígida ou limitar seu protagonismo.</mado:restricao>
    <mado:restricao xml:lang="pt-BR">Tratar a atividade digital como reconstrução proposta pela pesquisadora e não como prática originalmente relatada.</mado:restricao>
    <mado:statusDoRegistro>ADAPTACAO_PUBLICA</mado:statusDoRegistro>
    <mado:temModalidadeDisponivel rdf:resource="https://w3id.org/mado#MOD-FALA"/>
    <mado:temModalidadeDisponivel rdf:resource="https://w3id.org/mado#MOD-IMAGEM"/>
    <mado:temModalidadeDisponivel rdf:resource="https://w3id.org/mado#MOD-TEXTO"/>
    <mado:temTarefa rdf:resource="https://w3id.org/mado#TAR-MICROEXPLICACAO-CURRICULAR"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mado#K35">
    <rdf:type rdf:resource="https://w3id.org/mado#ConhecimentoMultimodalArticulado"/>
    <rdfs:label xml:lang="pt-BR">Em uma produção digital colaborativa, preservar o protagonismo exige distribuir funções complementares: a pessoa apoiada mantém autoria sobre o conhecimento; a professora enquadra o objetivo, o tempo e a acessibilidade; e os colegas pesquisam, organizam e testam a compreensão sem substituir essa autoria.</rdfs:label>
    <mado:aplicavelAAmbiente rdf:resource="https://w3id.org/mado#AMB-LABORATORIO-INFORMATICA"/>
    <mado:aplicavelAAmbiente rdf:resource="https://w3id.org/mado#AMB-SALA-DE-AULA"/>
    <mado:aplicavelABarreira rdf:resource="https://w3id.org/mado#BAR-AUTORIA-SEM-COORDENACAO"/>
    <mado:aplicavelABarreira rdf:resource="https://w3id.org/mado#BAR-TRANSICAO-E-CONTRADICAO-DIFICIL"/>
    <mado:aplicavelANecessidade rdf:resource="https://w3id.org/mado#NEC-COORDENAR-AUTORIA-COLABORATIVA"/>
    <mado:aplicavelANecessidade rdf:resource="https://w3id.org/mado#NEC-PRESERVAR-PROTAGONISMO"/>
    <mado:aplicavelANecessidade rdf:resource="https://w3id.org/mado#NEC-PRESERVAR-VINCULO-SOCIAL"/>
    <mado:aplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-CONSTRUIR-RECURSO-DIGITAL-HISTORIA"/>
    <mado:articulacao xml:lang="pt-BR">Articula a curadoria multimodal das Personas, a necessidade de contextualizar tarefa e ferramentas, o interesse pessoal observado na elicitação e o princípio de não decidir por diagnóstico. O resultado transforma participação oral em autoria compartilhada com responsabilidades explícitas.</mado:articulacao>
    <mado:articuladoSobPerspectiva rdf:resource="https://w3id.org/mado#P02"/>
    <mado:articuladoSobPerspectiva rdf:resource="https://w3id.org/mado#P03"/>
    <mado:classificacaoOperacional>OPERACIONALIZAVEL</mado:classificacaoOperacional>
    <mado:contribuiParaFuncaoDecisoria rdf:resource="https://w3id.org/mado#FUN-COORDENAR-AUTORIA"/>
    <mado:contribuiParaFuncaoDecisoria rdf:resource="https://w3id.org/mado#FUN-PRESERVAR-PROTAGONISMO"/>
    <mado:derivadoDe rdf:resource="https://w3id.org/mado#F06"/>
    <mado:derivadoDe rdf:resource="https://w3id.org/mado#F07"/>
    <mado:derivadoDe rdf:resource="https://w3id.org/mado#F08"/>
    <mado:derivadoDe rdf:resource="https://w3id.org/mado#F12"/>
    <mado:enunciado xml:lang="pt-BR">Em uma produção digital colaborativa, preservar o protagonismo exige distribuir funções complementares: a pessoa apoiada mantém autoria sobre o conhecimento; a professora enquadra o objetivo, o tempo e a acessibilidade; e os colegas pesquisam, organizam e testam a compreensão sem substituir essa autoria.</mado:enunciado>
    <mado:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">K35</mado:identificador>
    <mado:limite xml:lang="pt-BR">A divisão de papéis é uma configuração situada a ser confirmada; não constitui prescrição pedagógica universal.</mado:limite>
    <mado:natureza>CONHECIMENTO_ARTICULADO_RC2</mado:natureza>
    <mado:origemDaEstruturacaoSemantica xml:lang="pt-BR">Produzido por ART-TRF-01 a partir de conhecimentos e trechos preexistentes, com origem e nível de confirmação explícitos.</mado:origemDaEstruturacaoSemantica>
    <mado:requerElementoDoContexto rdf:resource="https://w3id.org/mado#NEC-COORDENAR-AUTORIA-COLABORATIVA"/>
    <mado:restricao xml:lang="pt-BR">interesse e conhecimento da pessoa</mado:restricao>
    <mado:restricao xml:lang="pt-BR">mediação</mado:restricao>
    <mado:restricao xml:lang="pt-BR">objetivo curricular</mado:restricao>
    <mado:restricao xml:lang="pt-BR">papéis explícitos</mado:restricao>
    <mado:restricao xml:lang="pt-BR">tarefa coletiva</mado:restricao>
    <mado:statusDaRelacao>PRODUTO_DE_ARTICULACAO_RC2</mado:statusDaRelacao>
    <mado:sustentadoPorTrecho rdf:resource="https://w3id.org/mado#TD-EL01"/>
    <mado:sustentadoPorTrecho rdf:resource="https://w3id.org/mado#TD-EL04"/>
    <mado:sustentadoPorTrecho rdf:resource="https://w3id.org/mado#TD-EL05"/>
    <mado:sustentadoPorTrecho rdf:resource="https://w3id.org/mado#TD-EV34"/>
    <mado:sustentadoPorTrecho rdf:resource="https://w3id.org/mado#TD-EV39"/>
    <mado:sustentadoPorTrecho rdf:resource="https://w3id.org/mado#TD-EV40"/>
    <mado:sustentadoPorTrecho rdf:resource="https://w3id.org/mado#TD-EV41"/>
    <mado:sustentadoPorTrecho rdf:resource="https://w3id.org/mado#TD-EV42"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mado#RED-JOGO">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://w3id.org/mado/scheme/RECURSO_DIGITAL"/>
    <skos:prefLabel xml:lang="pt-BR">Jogo ou atividade interativa</skos:prefLabel>
