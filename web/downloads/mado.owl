    <mado:configuracaoUsaOrigemDoCriterio rdf:resource="https://w3id.org/mado#ORI-0398"/>
    <mado:configuracaoUsaOrigemDoCriterio rdf:resource="https://w3id.org/mado#ORI-0399"/>
    <mado:configuracaoUsaOrigemDoCriterio rdf:resource="https://w3id.org/mado#ORI-0400"/>
    <mado:cumpreFuncaoDecisoria rdf:resource="https://w3id.org/mado#FUN-MANTER-INFORMACAO-RECUPERAVEL"/>
    <mado:cumpreFuncaoDecisoria rdf:resource="https://w3id.org/mado#FUN-ORGANIZAR-CONTEUDO"/>
    <mado:cumpreFuncaoDecisoria rdf:resource="https://w3id.org/mado#FUN-PERMITIR-REVISAO"/>
    <mado:estadoDeDisponibilidadeDaConfiguracao>CONFIRMADO_DISPONIVEL</mado:estadoDeDisponibilidadeDaConfiguracao>
    <mado:executadaPorPapel rdf:resource="https://w3id.org/mado#PAPEL-PROFESSORA"/>
    <mado:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CFG-RC4-01</mado:identificador>
    <mado:limiteDaConfiguracao xml:lang="pt-BR">A estrutura não deve transformar a participação em roteiro rígido nem substituir o conteúdo autoral.</mado:limiteDaConfiguracao>
    <mado:origemDoRegistro>CONFIGURACAO_MATURA_RC4</mado:origemDoRegistro>
    <mado:significadoFuncional xml:lang="pt-BR">O conteúdo precisa persistir e ter sequência visível para ser retomado.</mado:significadoFuncional>
    <mado:temAcaoOperacional xml:lang="pt-BR">criar blocos curtos com uma ideia central, autoria identificada, fonte ou exemplo e um ponto explícito de revisão antes de publicar</mado:temAcaoOperacional>
    <mado:temFuncaoModal xml:lang="pt-BR">organizar unidades curtas, autoria, sequência e pontos de revisão</mado:temFuncaoModal>
    <mado:temPapelModal rdf:resource="https://w3id.org/mado#PAPEL-PRINCIPAL"/>
