  <rdf:Description rdf:about="https://w3id.org/mado#K30">
    <rdf:type rdf:resource="https://w3id.org/mado#ConhecimentoMultimodalArticulado"/>
    <rdfs:label xml:lang="pt-BR">A reutilização de estratégias de acessibilidade em outros sistemas precisa considerar arquitetura, legado e maturidade técnica da equipe; uma recomendação situada não deve ser generalizada como pacote universal.</rdfs:label>
    <mado:aplicavelAAmbiente rdf:resource="https://w3id.org/mado#AMB-CONTEXTO-DIGITAL-DE-APRENDIZAGEM-42D27F5"/>
    <mado:aplicavelABarreira rdf:resource="https://w3id.org/mado#BAR-DUVIDA-AMBIGUIDADE-NECESSIDADE-DE-ORIENTACAO-8BC4FE1"/>
    <mado:aplicavelARecursoDisponivel rdf:resource="https://w3id.org/mado#REC-AJUDA-TEXTUAL-CONTEXTUAL-POTENCIALMENTE-MULTIMOD-B60AF74"/>
    <mado:aplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-EXECUTAR-TAREFAS-NO-AVA-7BEF3BD"/>
    <mado:articulacao xml:lang="pt-BR">A conclusão do estudo registra que a generalização para outros AVAs é condicionada pela heterogeneidade arquitetural, sistemas legados e capacidade das equipes de traduzir requisitos em código robusto compatível com tecnologias assistivas. Esse limite passa a integrar a rastreabilidade da recomendação.</mado:articulacao>
    <mado:articuladoSobPerspectiva rdf:resource="https://w3id.org/mado#P01"/>
    <mado:classificacaoOperacional>OPERACIONALIZAVEL</mado:classificacaoOperacional>
    <mado:derivadoDe rdf:resource="https://w3id.org/mado#F08"/>
    <mado:enunciado xml:lang="pt-BR">A reutilização de estratégias de acessibilidade em outros sistemas precisa considerar arquitetura, legado e maturidade técnica da equipe; uma recomendação situada não deve ser generalizada como pacote universal.</mado:enunciado>
    <mado:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">K30</mado:identificador>
    <mado:natureza>EXPLÍCITO NA FONTE</mado:natureza>
    <mado:origemDaEstruturacaoSemantica xml:lang="pt-BR">Relações derivadas de contextos e decisões documentados; complementações RC3 foram estabelecidas somente quando o enunciado, a articulação e os trechos sustentavam a aplicabilidade.</mado:origemDaEstruturacaoSemantica>
    <mado:restricao xml:lang="pt-BR">Ajuda contextual</mado:restricao>
    <mado:restricao xml:lang="pt-BR">arquitetura/legado</mado:restricao>
    <mado:restricao xml:lang="pt-BR">assistente virtual</mado:restricao>
    <mado:restricao xml:lang="pt-BR">conteúdo</mado:restricao>
    <mado:restricao xml:lang="pt-BR">mensagens</mado:restricao>
    <mado:statusDaRelacao>CONHECIMENTO_CANDIDATO</mado:statusDaRelacao>
    <mado:sustentadoPorTrecho rdf:resource="https://w3id.org/mado#TD-EV31"/>
  </rdf:Description>
