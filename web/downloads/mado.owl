<ns4:statusDaRelacao>RELACAO_SEM_JUSTIFICATIVA_EXPLICITA</ns4:statusDaRelacao>
</rdf:Description>
<rdf:Description rdf:about="https://w3id.org/mado#CA79">
<rdf:type rdf:resource="https://w3id.org/mado#CriterioDeDecisaoMultimodal" />
<ns1:label xml:lang="pt-BR">Mecanismos de ajuda repetidos em um conjunto de páginas (como links de contato ou autoajuda) devem aparecer sempre na mesma ordem relativa em relação ao restante do conteúdo.</ns1:label>
<ns4:enunciado xml:lang="pt-BR">Mecanismos de ajuda repetidos em um conjunto de páginas (como links de contato ou autoajuda) devem aparecer sempre na mesma ordem relativa em relação ao restante do conteúdo.</ns4:enunciado>
<ns4:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CA79</ns4:identificador>
<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0380" />
<ns4:statusDaRelacao>RELACAO_SEM_JUSTIFICATIVA_EXPLICITA</ns4:statusDaRelacao>
</rdf:Description>
<rdf:Description rdf:about="https://w3id.org/mado#CA80">
<rdf:type rdf:resource="https://w3id.org/mado#CriterioDeDecisaoMultimodal" />
<ns1:label xml:lang="pt-BR">Quando um erro de entrada de dados é detectado, ele deve ser identificado em texto, descrevendo claramente qual é o problema e qual campo o contém.</ns1:label>
<ns4:criterioAplicavelAModalidade rdf:resource="https://w3id.org/mado#MOD-TECLADO" />
<ns4:criterioAplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-EXECUTAR-TAREFAS-NO-AVA-7BEF3BD" />
<ns4:criterioAplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-PREENCHER-ENVIAR-MENSAGEM-0C1FB87" />
<ns4:enunciado xml:lang="pt-BR">Quando um erro de entrada de dados é detectado, ele deve ser identificado em texto, descrevendo claramente qual é o problema e qual campo o contém.</ns4:enunciado>
<ns4:funcaoDecisoria xml:lang="pt-BR">preservar operação, foco, correção e confirmação</ns4:funcaoDecisoria>
<ns4:fundamentadoPor rdf:resource="https://w3id.org/mado#K28" />
