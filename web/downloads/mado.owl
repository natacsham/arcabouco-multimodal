  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mado#K34">
    <rdf:type rdf:resource="https://w3id.org/mado#ConhecimentoMultimodalArticulado"/>
    <rdfs:label xml:lang="pt-BR">Uma decisão multimodal situada deve relacionar características funcionais, capacidades observadas, tarefa, barreira, modalidades, recursos e ambiente, sem converter o diagnóstico em prescrição automática.</rdfs:label>
    <mado:aplicavelAAmbiente rdf:resource="https://w3id.org/mado#AMB-AUDITORIO"/>
    <mado:aplicavelAAmbiente rdf:resource="https://w3id.org/mado#AMB-LABORATORIO-INFORMATICA"/>
    <mado:aplicavelAAmbiente rdf:resource="https://w3id.org/mado#AMB-SALA-DE-AULA"/>
    <mado:aplicavelABarreira rdf:resource="https://w3id.org/mado#BAR-DIAGNOSTICO-SEM-CARACTERIZACAO-FUNCIONAL"/>
    <mado:aplicavelABarreira rdf:resource="https://w3id.org/mado#BAR-PARTICIPACAO-EXTENSA-SEM-DELIMITACAO"/>
