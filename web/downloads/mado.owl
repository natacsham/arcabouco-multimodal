  <rdf:Description rdf:about="https://w3id.org/mado#CFG-RC4-01">
    <rdf:type rdf:resource="https://w3id.org/mado#ConfiguracaoModalDaDecisao"/>
    <mado:acompanhamentoDaConfiguracao xml:lang="pt-BR">Pedir a outro participante que retome a sequência e identifique a ideia central de cada bloco.</mado:acompanhamentoDaConfiguracao>
    <mado:alternativaDaConfiguracao xml:lang="pt-BR">Usar cartões, quadro ou folha com a mesma sequência e digitalizar somente após a revisão.</mado:alternativaDaConfiguracao>
    <mado:condicaoDaConfiguracao xml:lang="pt-BR">Confirmar objetivo e papéis antes de estruturar os blocos.</mado:condicaoDaConfiguracao>
    <mado:configuraModalidade rdf:resource="https://w3id.org/mado#MOD-TEXTO"/>
    <mado:configuraRecurso rdf:resource="https://w3id.org/mado#REC-EDITOR-MULTIMIDIA"/>
    <mado:configuraRecurso rdf:resource="https://w3id.org/mado#REC-ROTEIRO-COLABORATIVO"/>
