  <rdf:Description rdf:about="https://w3id.org/mado#K26">
    <rdf:type rdf:resource="https://w3id.org/mado#ConhecimentoMultimodalArticulado"/>
    <rdfs:label xml:lang="pt-BR">Conteúdo audiovisual em contexto de aprendizagem precisa admitir alternativas perceptivas coerentes com o tipo de informação, como legendas, audiodescrição e descrições de materiais, para não depender de um único canal.</rdfs:label>
    <mado:aplicavelAAmbiente rdf:resource="https://w3id.org/mado#AMB-CONTEXTO-DIGITAL-DE-APRENDIZAGEM-42D27F5"/>
    <mado:aplicavelABarreira rdf:resource="https://w3id.org/mado#BAR-CONTEUDO-AUDIOVISUAL-OU-VISUAL-SEM-ALTERNATIVA-7F52587"/>
    <mado:aplicavelACaracteristicaRelevanteDaPessoa rdf:resource="https://w3id.org/mado#CAR-INTERACAO-NAO-VISUAL"/>
    <mado:aplicavelACaracteristicaRelevanteDaPessoa rdf:resource="https://w3id.org/mado#CAR-PERFIS-FUNCIONAIS-DIVERSOS"/>
    <mado:aplicavelARecursoDisponivel rdf:resource="https://w3id.org/mado#REC-LEGENDA-AUDIODESCRICAO-DESCRICAO-SONORA-TEXTUAL-45356D1"/>
    <mado:aplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-CONSUMIR-MIDIA-MATERIAL-A2D1D3F"/>
    <mado:articulacao xml:lang="pt-BR">O redesign associa legendas a conteúdo sonoro, audiodescrição a informação visual e etiquetas/descrições sonoras a materiais. Cada recurso é ligado a Critérios de Acessibilidade e a barreiras diferentes, formando uma estratégia de equivalência/complementaridade perceptiva.</mado:articulacao>
    <mado:articuladoSobPerspectiva rdf:resource="https://w3id.org/mado#P02"/>
    <mado:classificacaoOperacional>OPERACIONALIZAVEL</mado:classificacaoOperacional>
    <mado:contribuiParaFuncaoDecisoria rdf:resource="https://w3id.org/mado#FUN-CONTEXTUALIZAR-MUDANCA"/>
    <mado:contribuiParaFuncaoDecisoria rdf:resource="https://w3id.org/mado#FUN-PRESERVAR-ACESSO"/>
    <mado:derivadoDe rdf:resource="https://w3id.org/mado#F08"/>
    <mado:enunciado xml:lang="pt-BR">Conteúdo audiovisual em contexto de aprendizagem precisa admitir alternativas perceptivas coerentes com o tipo de informação, como legendas, audiodescrição e descrições de materiais, para não depender de um único canal.</mado:enunciado>
    <mado:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">K26</mado:identificador>
    <mado:natureza>RECONSTRUÇÃO ANALÍTICA FORTEMENTE SUSTENTADA</mado:natureza>
    <mado:origemDaEstruturacaoSemantica xml:lang="pt-BR">Relações derivadas de contextos e decisões documentados; complementações RC3 foram estabelecidas somente quando o enunciado, a articulação e os trechos sustentavam a aplicabilidade.</mado:origemDaEstruturacaoSemantica>
    <mado:restricao xml:lang="pt-BR">Vídeo/mídia</mado:restricao>
    <mado:restricao xml:lang="pt-BR">audiodescrição</mado:restricao>
    <mado:restricao xml:lang="pt-BR">critérios</mado:restricao>
    <mado:restricao xml:lang="pt-BR">descrições sonoras</mado:restricao>
    <mado:restricao xml:lang="pt-BR">legenda</mado:restricao>
    <mado:statusDaRelacao>CONHECIMENTO_CANDIDATO_RC2</mado:statusDaRelacao>
    <mado:sustentadoPorTrecho rdf:resource="https://w3id.org/mado#TD-EV27"/>
    <mado:sustentadoPorTrecho rdf:resource="https://w3id.org/mado#TD-EV28"/>
  </rdf:Description>
