<ns4:configuracaoConsideraCondicao rdf:resource="https://w3id.org/mado#CAR-FALA-ESPONTANEA-EXTENSA" />
<ns4:configuracaoConsideraCondicao rdf:resource="https://w3id.org/mado#NEC-PRESERVAR-PROTAGONISMO" />
