  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mado#TD-ORI-0375">
    <rdf:type rdf:resource="https://w3id.org/mado#TrechoDocumental"/>
    <rdfs:label xml:lang="pt-BR">Referência ao trecho TD-ORI-0375</rdfs:label>
