    <mado:aplicavelACaracteristicaRelevanteDaPessoa rdf:resource="https://w3id.org/mado#CAR-FALA-ESPONTANEA-EXTENSA"/>
    <mado:aplicavelACaracteristicaRelevanteDaPessoa rdf:resource="https://w3id.org/mado#CAR-FALA-PERSISTENTE-REPETITIVA"/>
    <mado:aplicavelACaracteristicaRelevanteDaPessoa rdf:resource="https://w3id.org/mado#CAR-POTENCIAL-OBSERVADO"/>
    <mado:aplicavelACaracteristicaRelevanteDaPessoa rdf:resource="https://w3id.org/mado#CAR-REAGE-DEFENSIVAMENTE-A-CONTRADICAO"/>
    <mado:aplicavelAModalidade rdf:resource="https://w3id.org/mado#MOD-DESENHO"/>
    <mado:aplicavelAModalidade rdf:resource="https://w3id.org/mado#MOD-FALA"/>
    <mado:aplicavelAModalidade rdf:resource="https://w3id.org/mado#MOD-IMAGEM"/>
    <mado:aplicavelAModalidade rdf:resource="https://w3id.org/mado#MOD-TEXTO"/>
    <mado:aplicavelANecessidade rdf:resource="https://w3id.org/mado#NEC-ALINHAR-IMAGENS-PREVIAMENTE"/>
    <mado:aplicavelANecessidade rdf:resource="https://w3id.org/mado#NEC-CONSIDERAR-POTENCIAL-E-CONHECIMENTO"/>
    <mado:aplicavelANecessidade rdf:resource="https://w3id.org/mado#NEC-NEGOCIAR-TURNOS-TRANSICOES"/>
    <mado:aplicavelANecessidade rdf:resource="https://w3id.org/mado#NEC-PRESERVAR-VINCULO-SOCIAL"/>
    <mado:aplicavelANecessidade rdf:resource="https://w3id.org/mado#NEC-RELACIONAR-PARTICIPACAO-OBJETIVO-CURRICULAR"/>
    <mado:aplicavelANecessidade rdf:resource="https://w3id.org/mado#NEC-SINALIZAR-AUSENCIA-IMAGEM"/>
    <mado:aplicavelARecursoDigital rdf:resource="https://w3id.org/mado#RED-APRESENTACAO-DIGITAL"/>
    <mado:aplicavelARecursoDigital rdf:resource="https://w3id.org/mado#RED-IMAGEM-DIGITAL"/>
    <mado:aplicavelARecursoDisponivel rdf:resource="https://w3id.org/mado#REC-COMPUTADOR-DATASHOW"/>
    <mado:aplicavelARecursoDisponivel rdf:resource="https://w3id.org/mado#REC-DESENHO-QUADRO-PAPEL"/>
    <mado:aplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-APRESENTAR-CONTEUDO-DIFERENTES-ESPACOS"/>
    <mado:aplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-EXPLICAR-CONTEUDO-HISTORIA"/>
    <mado:aplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-ORGANIZAR-PARTICIPACAO-MULTIMODAL"/>
    <mado:articulacao xml:lang="pt-BR">O esquema de recomendação exige seleção situada de modalidades; o estudo ACAT/MPD mostra que a entrada depende do movimento efetivamente disponível; a validação das personas exige ligar características a tarefas, ferramentas e limites; e o estudo dos critérios mostra que perfis, tecnologias assistivas e requisitos concretos tornam os critérios utilizáveis.</mado:articulacao>
    <mado:articuladoSobPerspectiva rdf:resource="https://w3id.org/mado#P01"/>
    <mado:articuladoSobPerspectiva rdf:resource="https://w3id.org/mado#P02"/>
    <mado:classificacaoOperacional>OPERACIONALIZAVEL</mado:classificacaoOperacional>
    <mado:contribuiParaFuncaoDecisoria rdf:resource="https://w3id.org/mado#FUN-CARACTERIZAR-CONDICOES"/>
    <mado:contribuiParaFuncaoDecisoria rdf:resource="https://w3id.org/mado#FUN-PRESERVAR-PROTAGONISMO"/>
    <mado:derivadoDe rdf:resource="https://w3id.org/mado#F02"/>
    <mado:derivadoDe rdf:resource="https://w3id.org/mado#F05"/>
    <mado:derivadoDe rdf:resource="https://w3id.org/mado#F07"/>
    <mado:derivadoDe rdf:resource="https://w3id.org/mado#F08"/>
    <mado:enunciado xml:lang="pt-BR">Uma decisão multimodal situada deve relacionar características funcionais, capacidades observadas, tarefa, barreira, modalidades, recursos e ambiente, sem converter o diagnóstico em prescrição automática.</mado:enunciado>
    <mado:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">K34</mado:identificador>
    <mado:impedidoPorElementoDoContexto rdf:resource="https://w3id.org/mado#BAR-DIAGNOSTICO-SEM-CARACTERIZACAO-FUNCIONAL"/>
    <mado:limite xml:lang="pt-BR">Não autoriza inferir capacidade, barreira ou modalidade apenas a partir de diagnóstico ou categoria de deficiência.</mado:limite>
    <mado:natureza>RECONSTRUCAO_ANALITICA_DA_TRAJETORIA</mado:natureza>
    <mado:origemDaEstruturacaoSemantica xml:lang="pt-BR">Articulação retrospectiva de fontes anteriores à elicitação, posteriormente confrontada com condições funcionais do caso; não depende de um rótulo diagnóstico.</mado:origemDaEstruturacaoSemantica>
    <mado:requerElementoDoContexto rdf:resource="https://w3id.org/mado#NEC-CONSIDERAR-POTENCIAL-E-CONHECIMENTO"/>
    <mado:restricao xml:lang="pt-BR">barreira</mado:restricao>
    <mado:restricao xml:lang="pt-BR">capacidade observada</mado:restricao>
    <mado:restricao xml:lang="pt-BR">caracterização funcional</mado:restricao>
    <mado:restricao xml:lang="pt-BR">contexto</mado:restricao>
    <mado:restricao xml:lang="pt-BR">modalidade</mado:restricao>
    <mado:restricao xml:lang="pt-BR">recurso</mado:restricao>
    <mado:restricao xml:lang="pt-BR">tarefa</mado:restricao>
    <mado:statusDaRelacao>FUNDAMENTO_DA_CARACTERIZACAO_SITUADA</mado:statusDaRelacao>
