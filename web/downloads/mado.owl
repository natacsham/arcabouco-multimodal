  <rdf:Description rdf:about="https://w3id.org/mado#CA31">
    <rdf:type rdf:resource="https://w3id.org/mado#CriterioDeDecisaoMultimodal"/>
    <rdfs:label xml:lang="pt-BR">Áudio pré-gravado com fala deve ter sem ruído de fundo, opção de desligar o fundo ou fundo ≥ 20 dB abaixo da voz</rdfs:label>
    <mado:criterioAplicavelABarreira rdf:resource="https://w3id.org/mado#BAR-AUDIO-PODE-PERDER-EFETIVIDADE-COM-RUIDO-04E2CCE"/>
    <mado:criterioAplicavelAModalidade rdf:resource="https://w3id.org/mado#MOD-HAPTICO"/>
    <mado:criterioAplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-SEGUIR-ROTA-3D861F4"/>
    <mado:enunciado xml:lang="pt-BR">Áudio pré-gravado com fala deve ter sem ruído de fundo, opção de desligar o fundo ou fundo ≥ 20 dB abaixo da voz</mado:enunciado>
    <mado:funcaoDecisoria xml:lang="pt-BR">manter orientação perceptível quando o áudio é afetado pelo ambiente</mado:funcaoDecisoria>
    <mado:fundamentadoPor rdf:resource="https://w3id.org/mado#K01"/>
    <mado:fundamentadoPor rdf:resource="https://w3id.org/mado#K07"/>
    <mado:fundamentadoPor rdf:resource="https://w3id.org/mado#K21"/>
    <mado:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CA31</mado:identificador>
    <mado:justificativaDeFundamentacao xml:lang="pt-BR">Evitar que ruído de fundo torne a orientação auditiva imperceptível. Em versão anterior, a ligação foi reconstruída analiticamente porque o critério participa de uma configuração modalidade–função–recurso–responsável fundamentada por esses conhecimentos; não se atribui essa formalização retrospectiva às publicações originais.</mado:justificativaDeFundamentacao>
    <mado:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0203"/>
    <mado:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0204"/>
    <mado:statusDaRelacao>RELACAO_SEM_JUSTIFICATIVA_EXPLICITA</mado:statusDaRelacao>
  </rdf:Description>
