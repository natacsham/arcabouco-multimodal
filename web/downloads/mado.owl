  <rdf:Description rdf:about="https://w3id.org/mado#K09">
    <rdf:type rdf:resource="https://w3id.org/mado#ConhecimentoMultimodalArticulado"/>
    <rdfs:label xml:lang="pt-BR">Experiências e resultados de aplicações anteriores podem tornar-se casos recuperáveis e alimentar decisões posteriores, desde que a situação e suas especificidades sejam preservadas.</rdfs:label>
    <mado:articulacao xml:lang="pt-BR">O esquema trata cada situação como novo caso armazenável e recuperável, e o artigo afirma que as aplicações desenvolvidas são ponto-chave para sua definição. Também documenta que informações e comportamentos observados no RotaColab foram considerados na WABlind.</mado:articulacao>
    <mado:articuladoSobPerspectiva rdf:resource="https://w3id.org/mado#P02"/>
    <mado:classificacaoOperacional>DESCRITIVO_METODOLOGICO</mado:classificacaoOperacional>
    <mado:derivadoDe rdf:resource="https://w3id.org/mado#F02"/>
    <mado:enunciado xml:lang="pt-BR">Experiências e resultados de aplicações anteriores podem tornar-se casos recuperáveis e alimentar decisões posteriores, desde que a situação e suas especificidades sejam preservadas.</mado:enunciado>
    <mado:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">K09</mado:identificador>
    <mado:natureza>RECONSTRUÇÃO ANALÍTICA FORTEMENTE SUSTENTADA</mado:natureza>
    <mado:origemDaEstruturacaoSemantica xml:lang="pt-BR">Relações derivadas de contextos e decisões documentados; complementações RC3 foram estabelecidas somente quando o enunciado, a articulação e os trechos sustentavam a aplicabilidade.</mado:origemDaEstruturacaoSemantica>
    <mado:statusDaRelacao>CONHECIMENTO_CANDIDATO</mado:statusDaRelacao>
    <mado:sustentadoPorTrecho rdf:resource="https://w3id.org/mado#TD-EV09"/>
    <mado:sustentadoPorTrecho rdf:resource="https://w3id.org/mado#TD-EV10"/>
