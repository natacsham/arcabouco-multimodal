<ns4:statusDaRelacao>RELACAO_SEM_JUSTIFICATIVA_EXPLICITA</ns4:statusDaRelacao>
</rdf:Description>
<rdf:Description rdf:about="https://w3id.org/mado#CA87">
<rdf:type rdf:resource="https://w3id.org/mado#CriterioDeDecisaoMultimodal" />
<ns1:label xml:lang="pt-BR">Todos os componentes de interface devem ter seu nome, função, estados e valores determinados e, quando aplicável, alterados programaticamente, notificando as tecnologias assistivas sobre quaisquer mudanças.</ns1:label>
<ns4:enunciado xml:lang="pt-BR">Todos os componentes de interface devem ter seu nome, função, estados e valores determinados e, quando aplicável, alterados programaticamente, notificando as tecnologias assistivas sobre quaisquer mudanças.</ns4:enunciado>
<ns4:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CA87</ns4:identificador>
<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0405" />
