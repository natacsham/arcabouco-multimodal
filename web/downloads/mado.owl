  <rdf:Description rdf:about="https://w3id.org/mado#CA23">
    <rdf:type rdf:resource="https://w3id.org/mado#CriterioDeDecisaoMultimodal"/>
    <rdfs:label xml:lang="pt-BR">Áudio ao vivo (só áudio) deve ter alternativa em texto equivalente</rdfs:label>
    <mado:criterioAplicavelAModalidade rdf:resource="https://w3id.org/mado#MOD-AUDIO"/>
    <mado:criterioAplicavelAModalidade rdf:resource="https://w3id.org/mado#MOD-VOZ"/>
    <mado:criterioAplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-CONSTRUIR-RECURSO-DIGITAL-HISTORIA"/>
    <mado:criterioAplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-ENVIAR-LER-MENSAGEM-INTERAGIR-COM-MENSAGENS-4C0CACA"/>
    <mado:criterioAplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-REVISAR-PUBLICAR-RECURSO"/>
    <mado:enunciado xml:lang="pt-BR">Áudio ao vivo (só áudio) deve ter alternativa em texto equivalente</mado:enunciado>
    <mado:funcaoDecisoria xml:lang="pt-BR">oferecer expressão e acesso alternativos ao texto digitado</mado:funcaoDecisoria>
    <mado:fundamentadoPor rdf:resource="https://w3id.org/mado#K18"/>
    <mado:fundamentadoPor rdf:resource="https://w3id.org/mado#K29"/>
    <mado:fundamentadoPor rdf:resource="https://w3id.org/mado#K32"/>
    <mado:fundamentadoPor rdf:resource="https://w3id.org/mado#K38"/>
    <mado:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CA23</mado:identificador>
    <mado:justificativaDeFundamentacao xml:lang="pt-BR">Disponibilizar alternativa textual para conteúdo somente em áudio. Em versão anterior, a ligação foi reconstruída analiticamente porque o critério participa de uma configuração modalidade–função–recurso–responsável fundamentada por esses conhecimentos; não se atribui essa formalização retrospectiva às publicações originais. Na RC2, a ligação ao conhecimento articulado foi conferida para o cenário de transferência e permanece limitada às condições registradas.</mado:justificativaDeFundamentacao>
    <mado:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0170"/>
    <mado:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0171"/>
    <mado:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0172"/>
    <mado:statusDaRelacao>RELACAO_SEM_JUSTIFICATIVA_EXPLICITA</mado:statusDaRelacao>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mado#AMB-SALA-DE-AULA-COM-PROFESSORES-DISCIPLINAS-E-METOD-B74F4ED">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://w3id.org/mado/scheme/AMBIENTE"/>
    <skos:prefLabel xml:lang="pt-BR">Sala de aula, com professores, disciplinas e metodologias diferentes; necessidade de tempo delimitado, mediação docente e acompanhamento.</skos:prefLabel>
    <mado:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AMB-SALA-DE-AULA-COM-PROFESSORES-DISCIPLINAS-E-METOD-B74F4ED</mado:identificador>
    <mado:statusDoRegistro>RECONSTRUIDO_DA_BASE_ANTERIOR</mado:statusDoRegistro>
  </rdf:Description>
