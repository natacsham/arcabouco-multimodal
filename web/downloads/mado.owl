  <rdf:Description rdf:about="https://w3id.org/mado#D08">
    <rdf:type rdf:resource="https://w3id.org/mado#DecisaoDeAcessibilidadeMultimodal"/>
    <rdfs:label xml:lang="pt-BR">Para adequar conteúdo educacional às necessidades dos alunos sem depender apenas de tratamento automático, permitir que professores mediadores personalizem e marquem elementos relevantes.</rdfs:label>
    <mado:condicaoDeAplicacao xml:lang="pt-BR">Depende da compreensão da interface pelo mediador</mado:condicaoDeAplicacao>
    <mado:enunciado xml:lang="pt-BR">Para adequar conteúdo educacional às necessidades dos alunos sem depender apenas de tratamento automático, permitir que professores mediadores personalizem e marquem elementos relevantes.</mado:enunciado>
    <mado:expressaoOperacional xml:lang="pt-BR">Permitir que mediadores personalizem e marquem elementos do conteúdo quando objetivos pedagógicos e necessidades de acesso exigirem interpretação contextual.</mado:expressaoOperacional>
    <mado:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D08</mado:identificador>
    <mado:natureza>RECONSTRUÇÃO ANALÍTICA FORTEMENTE SUSTENTADA</mado:natureza>
    <mado:produziuResultado rdf:resource="https://w3id.org/mado#R-EV15"/>
    <mado:rationale xml:lang="pt-BR">Por quê: relevância pedagógica e necessidade de adaptação podem exigir interpretação contextual. Para quê: produzir conteúdo mais focado e adequado ao aluno. Como: a ferramenta combina nível automático e camada colaborativa de marcação pelo mediador.</mado:rationale>
    <mado:respondeA rdf:resource="https://w3id.org/mado#CTX-D08"/>
    <mado:statusDecisao>DECISAO_HISTORICA_RECONSTRUIDA</mado:statusDecisao>
    <mado:statusDoRegistro>DECISAO_HISTORICA_RECONSTRUIDA</mado:statusDoRegistro>
    <mado:sustentadaPor rdf:resource="https://w3id.org/mado#K11"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mado#CA38">
    <rdf:type rdf:resource="https://w3id.org/mado#CriterioDeDecisaoMultimodal"/>
    <rdfs:label xml:lang="pt-BR">Toda funcionalidade deve ser operável por teclado (sem exigir tempo preciso)</rdfs:label>
    <mado:criterioAplicavelAModalidade rdf:resource="https://w3id.org/mado#MOD-TECLADO"/>
    <mado:criterioAplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-EXECUTAR-TAREFAS-NO-AVA-7BEF3BD"/>
    <mado:criterioAplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-PREENCHER-ENVIAR-MENSAGEM-0C1FB87"/>
    <mado:enunciado xml:lang="pt-BR">Toda funcionalidade deve ser operável por teclado (sem exigir tempo preciso)</mado:enunciado>
    <mado:funcaoDecisoria xml:lang="pt-BR">preservar operação, foco, correção e confirmação</mado:funcaoDecisoria>
    <mado:fundamentadoPor rdf:resource="https://w3id.org/mado#K25"/>
    <mado:fundamentadoPor rdf:resource="https://w3id.org/mado#K28"/>
    <mado:fundamentadoPor rdf:resource="https://w3id.org/mado#K29"/>
    <mado:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CA38</mado:identificador>
    <mado:justificativaDeFundamentacao xml:lang="pt-BR">Em versão anterior, a ligação foi reconstruída analiticamente porque o critério participa de uma configuração modalidade–função–recurso–responsável fundamentada por esses conhecimentos; não se atribui essa formalização retrospectiva às publicações originais.</mado:justificativaDeFundamentacao>
    <mado:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0238"/>
    <mado:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0239"/>
    <mado:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0240"/>
    <mado:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0241"/>
    <mado:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0242"/>
    <mado:statusDaRelacao>RELACAO_SEM_JUSTIFICATIVA_EXPLICITA</mado:statusDaRelacao>
  </rdf:Description>
