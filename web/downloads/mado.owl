  <rdf:Description rdf:about="https://w3id.org/mado#D04">
    <rdf:type rdf:resource="https://w3id.org/mado#DecisaoDeAcessibilidadeMultimodal"/>
    <rdfs:label xml:lang="pt-BR">Para impedir ações inválidas e reduzir desorientação, comunicar de forma acessível o estado do sistema e os pré-requisitos antes de habilitar ou solicitar a próxima ação.</rdfs:label>
    <mado:condicaoDeAplicacao xml:lang="pt-BR">Deve ser perceptível pela tecnologia assistiva usada</mado:condicaoDeAplicacao>
    <mado:enunciado xml:lang="pt-BR">Para impedir ações inválidas e reduzir desorientação, comunicar de forma acessível o estado do sistema e os pré-requisitos antes de habilitar ou solicitar a próxima ação.</mado:enunciado>
    <mado:expressaoOperacional xml:lang="pt-BR">Comunicar de forma acessível pré-requisitos, carregamento e estado antes de permitir ou solicitar uma ação dependente.</mado:expressaoOperacional>
    <mado:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D04</mado:identificador>
    <mado:natureza>RECONSTRUÇÃO ANALÍTICA FORTEMENTE SUSTENTADA</mado:natureza>
    <mado:rationale xml:lang="pt-BR">Por quê: o usuário tentava selecionar destino sem que a lista dependente estivesse carregada e não recebia explicação. Para quê: manter previsibilidade do fluxo. Como: a ruptura evidencia que estado e dependência precisam ser explicitados antes da ação.</mado:rationale>
    <mado:respondeA rdf:resource="https://w3id.org/mado#CTX-D04"/>
    <mado:statusDecisao>DECISAO_HISTORICA_RECONSTRUIDA</mado:statusDecisao>
    <mado:statusDoRegistro>DECISAO_HISTORICA_RECONSTRUIDA</mado:statusDoRegistro>
    <mado:sustentadaPor rdf:resource="https://w3id.org/mado#K04"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mado#TD-EV38">
