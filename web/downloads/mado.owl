<rdf:Description rdf:about="https://w3id.org/mado#CA07">
<rdf:type rdf:resource="https://w3id.org/mado#CriterioDeDecisaoMultimodal" />
<ns1:label xml:lang="pt-BR">Conteúdo e controles devem funcionar com tecnologias assistivas e entradas alternativas</ns1:label>
<ns4:criterioAplicavelABarreira rdf:resource="https://w3id.org/mado#BAR-DIGITACAO-SELECAO-CONVENCIONAL-DIFICIL-30CB86A" />
<ns4:criterioAplicavelAModalidade rdf:resource="https://w3id.org/mado#MOD-VOZ" />
<ns4:criterioAplicavelARecurso rdf:resource="https://w3id.org/mado#REC-LEITOR-DE-TELA" />
<ns4:criterioAplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-ACESSAR-CONTEUDO-9DCCC00" />
<ns4:criterioAplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-ACESSAR-CONTEUDO-WEB-E80BA3E" />
<ns4:criterioAplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-AUTENTICAR-SELECIONAR-DESTINO-A098E60" />
<ns4:criterioAplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-SELECIONAR-DESTINO-2780D83" />
<ns4:enunciado xml:lang="pt-BR">Conteúdo e controles devem funcionar com tecnologias assistivas e entradas alternativas</ns4:enunciado>
<ns4:funcaoDecisoria xml:lang="pt-BR">oferecer alternativa à digitação ou seleção visual</ns4:funcaoDecisoria>
<ns4:funcaoDecisoria xml:lang="pt-BR">preservar o significado visual em estrutura e descrição processáveis</ns4:funcaoDecisoria>
<ns4:fundamentadoPor rdf:resource="https://w3id.org/mado#K03" />
<ns4:fundamentadoPor rdf:resource="https://w3id.org/mado#K07" />
<ns4:fundamentadoPor rdf:resource="https://w3id.org/mado#K10" />
<ns4:fundamentadoPor rdf:resource="https://w3id.org/mado#K11" />
<ns4:fundamentadoPor rdf:resource="https://w3id.org/mado#K12" />
<ns4:fundamentadoPor rdf:resource="https://w3id.org/mado#K18" />
<ns4:fundamentadoPor rdf:resource="https://w3id.org/mado#K21" />
<ns4:fundamentadoPor rdf:resource="https://w3id.org/mado#K27" />
<ns4:fundamentadoPor rdf:resource="https://w3id.org/mado#K29" />
<ns4:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CA07</ns4:identificador>
<ns4:justificativaDeFundamentacao xml:lang="pt-BR">Preservar funcionamento com tecnologias assistivas e formas alternativas de entrada. Em versão anterior, a ligação foi reconstruída analiticamente porque o critério participa de uma configuração modalidade–função–recurso–responsável fundamentada por esses conhecimentos; não se atribui essa formalização retrospectiva às publicações originais.</ns4:justificativaDeFundamentacao>
