<ns4:configuracaoConsideraCondicao rdf:resource="https://w3id.org/mado#NEC-ALTERNATIVAS-DE-ACESSO-AO-RECURSO" />
<ns4:configuracaoDeDecisao rdf:resource="https://w3id.org/mado#D-TESTE-RC4-TRANSFERENCIA" />
<ns4:configuracaoMobilizaArticulacao rdf:resource="https://w3id.org/mado#ART-REF-03" />
<ns4:configuracaoMobilizaArticulacao rdf:resource="https://w3id.org/mado#ART-REF-04" />
