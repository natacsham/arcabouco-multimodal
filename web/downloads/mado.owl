<rdf:Description rdf:about="https://w3id.org/mado#CTX-SINTETICO-GEO-01">
<rdf:type rdf:resource="https://w3id.org/mado#ContextoDeInteracaoDigital" />
<ns1:label xml:lang="pt-BR">CTX-SINTETICO-GEO-01</ns1:label>
<ns4:apresentaBarreira rdf:resource="https://w3id.org/mado#BAR-CONTRIBUICAO-EXTENSA-SEM-SEQUENCIA" />
<ns4:apresentaNecessidade rdf:resource="https://w3id.org/mado#NEC-APOIAR-COMPREENSAO-TURMA" />
<ns4:apresentaNecessidade rdf:resource="https://w3id.org/mado#NEC-ORGANIZAR-DELIMITAR-PARTICIPACAO" />
<ns4:apresentaNecessidade rdf:resource="https://w3id.org/mado#NEC-PRESERVAR-PROTAGONISMO" />
<ns4:baseadoEmContexto rdf:resource="https://w3id.org/mado#CTX-RELATADO-01" />
<ns4:consideraCaracteristicaRelevanteDaPessoa rdf:resource="https://w3id.org/mado#CAR-ENSINO-FUNDAMENTAL-II" />
<ns4:consideraCaracteristicaRelevanteDaPessoa rdf:resource="https://w3id.org/mado#CAR-INTERESSE-GEOGRAFIA-MAPAS" />
<ns4:descricaoDoContexto xml:lang="pt-BR">Novo caso fictício semelhante: estudante do Ensino Fundamental II com interesse e conhecimento em Geografia e mapas fará uma explicação curta para a turma. Sua fala é extensa e espontânea. A atividade dispõe de mapa digital, projeção, palavras-chave e imagens e deve preservar seu protagonismo enquanto organiza a sequência e apoia a compreensão da turma.</ns4:descricaoDoContexto>
<ns4:descritoSobPerspectiva rdf:resource="https://w3id.org/mado#P02" />
<ns4:descritoSobPerspectiva rdf:resource="https://w3id.org/mado#P03" />
<ns4:envolveRecursoDigital rdf:resource="https://w3id.org/mado#RED-MAPA-DIGITAL" />
<ns4:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CTX-SINTETICO-GEO-01</ns4:identificador>
<ns4:natureza>SINTETICO_HISTORICO_PRESERVADO</ns4:natureza>
<ns4:objetivo xml:lang="pt-BR">Explicar relações espaciais de um conteúdo de Geografia e permitir que a turma identifique os pontos centrais.</ns4:objetivo>
<ns4:ocorreEmAmbiente rdf:resource="https://w3id.org/mado#AMB-SALA-DE-AULA" />
<ns4:restricao xml:lang="pt-BR">O mapa digital é uma escolha sintética para testar transferência; não foi relatado como prática do caso original.</ns4:restricao>
<ns4:restricao xml:lang="pt-BR">Preservar o protagonismo sem transformar a atividade em roteiro rígido.</ns4:restricao>
<ns4:statusDoRegistro>SUBSTITUIDO_NA_SESSAO_PELA_RC4</ns4:statusDoRegistro>
<ns4:temModalidadeDisponivel rdf:resource="https://w3id.org/mado#MOD-FALA" />
<ns4:temModalidadeDisponivel rdf:resource="https://w3id.org/mado#MOD-IMAGEM" />
<ns4:temModalidadeDisponivel rdf:resource="https://w3id.org/mado#MOD-TEXTO" />
<ns4:temRecursoDisponivel rdf:resource="https://w3id.org/mado#REC-MAPA-DIGITAL-PROJECAO" />
<ns4:temTarefa rdf:resource="https://w3id.org/mado#TAR-COMUNICAR-CONTEUDO-1545B38" />
<ns4:temTarefa rdf:resource="https://w3id.org/mado#TAR-MICROEXPLICACAO-CURRICULAR" />
</rdf:Description>
<rdf:Description rdf:about="https://w3id.org/mado#CTX-TESTE-RC2-DIAGNOSTICO-ISOLADO">
<rdf:type rdf:resource="https://w3id.org/mado#ContextoDeInteracaoDigital" />
<ns1:label xml:lang="pt-BR">CTX-TESTE-RC2-DIAGNOSTICO-ISOLADO</ns1:label>
<ns4:consideraCaracteristicaRelevanteDaPessoa rdf:resource="https://w3id.org/mado#CAR-DIAGNOSTICO-ISOLADO" />
<ns4:descricaoDoContexto xml:lang="pt-BR">Somente um rótulo diagnóstico foi informado, sem tarefa, barreira, necessidade ou característica funcional observada.</ns4:descricaoDoContexto>
<ns4:descritoSobPerspectiva rdf:resource="https://w3id.org/mado#P02" />
<ns4:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CTX-TESTE-RC2-DIAGNOSTICO-ISOLADO</ns4:identificador>
<ns4:informacaoAusente xml:lang="pt-BR">Tarefa</ns4:informacaoAusente>
<ns4:informacaoAusente xml:lang="pt-BR">barreira ou necessidade</ns4:informacaoAusente>
<ns4:informacaoAusente xml:lang="pt-BR">características funcionais observadas</ns4:informacaoAusente>
<ns4:natureza>SINTETICO_NEGATIVO</ns4:natureza>
<ns4:ocorreEmAmbiente rdf:resource="https://w3id.org/mado#AMB-SALA-DE-AULA" />
<ns4:restricao xml:lang="pt-BR">Diagnóstico não pode produzir decisão automática.</ns4:restricao>
<ns4:statusDoRegistro>CASO_NEGATIVO_DE_REGRESSAO_RC2</ns4:statusDoRegistro>
</rdf:Description>
