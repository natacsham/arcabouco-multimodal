  <rdf:Description rdf:about="https://w3id.org/mado#CAR-EXPERIENCIA-DIGITAL-VARIAVEL">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://w3id.org/mado/scheme/CARACTERISTICA_PESSOA"/>
    <skos:prefLabel xml:lang="pt-BR">A experiência com o recurso digital pode alterar a execução da tarefa</skos:prefLabel>
    <mado:caracteristicaDerivadaDeFonte rdf:resource="https://w3id.org/mado#F01"/>
    <mado:caracteristicaDerivadaDeFonte rdf:resource="https://w3id.org/mado#F05"/>
    <mado:caracteristicaSustentadaPorTrecho rdf:resource="https://w3id.org/mado#TD-RC3-REF-03"/>
    <mado:caracteristicaSustentadaPorTrecho rdf:resource="https://w3id.org/mado#TD-RC3-REF-07"/>
    <mado:categoriaDaCaracteristica>EXPERIENCIA_E_PROFICIENCIA_DIGITAL</mado:categoriaDaCaracteristica>
    <mado:condicaoDeUsoDaCaracteristica xml:lang="pt-BR">Observar a execução real e permitir ajuda sem encobrir a ruptura.</mado:condicaoDeUsoDaCaracteristica>
    <mado:contraindicacao xml:lang="pt-BR">Não inferir proficiência do uso de uma tecnologia semelhante.</mado:contraindicacao>
    <mado:efeitoPossivelNaTarefa xml:lang="pt-BR">Tecnologia assistiva lenta, gesto desconhecido ou retorno ambíguo pode bloquear a ação.</mado:efeitoPossivelNaTarefa>
    <mado:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CAR-EXPERIENCIA-DIGITAL-VARIAVEL</mado:identificador>
    <mado:statusDoRegistro>CONTROLADO_1_2_RC3</mado:statusDoRegistro>
  </rdf:Description>
