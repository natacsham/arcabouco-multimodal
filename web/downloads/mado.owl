  <rdf:Description rdf:about="https://w3id.org/mado#K02">
    <rdf:type rdf:resource="https://w3id.org/mado#ConhecimentoMultimodalArticulado"/>
    <rdfs:label xml:lang="pt-BR">Informações auditivas temporárias usadas para orientar uma tarefa precisam ser recuperáveis sob demanda quando sua perda compromete a continuidade da ação.</rdfs:label>
    <mado:aplicavelAAmbiente rdf:resource="https://w3id.org/mado#AMB-NOTIFICACOES-PERIODICAS-F006B13"/>
    <mado:aplicavelABarreira rdf:resource="https://w3id.org/mado#BAR-EFEMERIDADE-DO-FEEDBACK-AUDITIVO-611AFB8"/>
    <mado:aplicavelACaracteristicaRelevanteDaPessoa rdf:resource="https://w3id.org/mado#CAR-INTERACAO-NAO-VISUAL"/>
    <mado:aplicavelARecursoDisponivel rdf:resource="https://w3id.org/mado#REC-REPRODUCAO-SAIDA-AUDITIVA-SOB-DEMANDA-7639958"/>
    <mado:aplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-ACOMPANHAR-ORIENTACAO-317CD64"/>
    <mado:articulacao xml:lang="pt-BR">O RotaColab emitia orientações auditivas em intervalos aproximados de sete segundos. Durante o percurso, participantes pararam esperando nova informação e recorreram ao mediador. O próprio estudo identifica a ausência de um recurso para reapresentar a última orientação. A compreensão é produzida pela diferença entre periodicidade automática e necessidade situada de recuperação.</mado:articulacao>
    <mado:articuladoSobPerspectiva rdf:resource="https://w3id.org/mado#P02"/>
    <mado:classificacaoOperacional>OPERACIONALIZAVEL</mado:classificacaoOperacional>
    <mado:derivadoDe rdf:resource="https://w3id.org/mado#F01"/>
    <mado:enunciado xml:lang="pt-BR">Informações auditivas temporárias usadas para orientar uma tarefa precisam ser recuperáveis sob demanda quando sua perda compromete a continuidade da ação.</mado:enunciado>
    <mado:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">K02</mado:identificador>
    <mado:natureza>RECONSTRUÇÃO ANALÍTICA FORTEMENTE SUSTENTADA</mado:natureza>
    <mado:origemDaEstruturacaoSemantica xml:lang="pt-BR">Relações derivadas de contextos e decisões documentados; complementações RC3 foram estabelecidas somente quando o enunciado, a articulação e os trechos sustentavam a aplicabilidade.</mado:origemDaEstruturacaoSemantica>
    <mado:restricao xml:lang="pt-BR">Tarefa de orientação</mado:restricao>
    <mado:restricao xml:lang="pt-BR">continuidade da ação</mado:restricao>
    <mado:restricao xml:lang="pt-BR">temporalidade</mado:restricao>
    <mado:restricao xml:lang="pt-BR">áudio efêmero</mado:restricao>
    <mado:statusDaRelacao>CONHECIMENTO_CANDIDATO</mado:statusDaRelacao>
    <mado:sustentadoPorTrecho rdf:resource="https://w3id.org/mado#TD-EV02"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mado#K44">
    <rdf:type rdf:resource="https://w3id.org/mado#ConhecimentoMultimodalArticulado"/>
    <rdfs:label xml:lang="pt-BR">Feedback e mensagens de estado devem ser perceptíveis, não interromper indevidamente o foco e permanecer ou poder ser recuperados quando orientam a continuidade da tarefa.</rdfs:label>
    <mado:aplicavelABarreira rdf:resource="https://w3id.org/mado#BAR-EFEMERIDADE-DO-FEEDBACK-AUDITIVO-611AFB8"/>
    <mado:aplicavelANecessidade rdf:resource="https://w3id.org/mado#NEC-REVISAO-E-CONFIRMACAO"/>
    <mado:aplicavelARecursoDisponivel rdf:resource="https://w3id.org/mado#REC-FEEDBACK-ACESSIVEL"/>
    <mado:aplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-OPERAR-SISTEMA"/>
    <mado:aplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-REVISAR-E-CONFIRMAR"/>
    <mado:articulacao xml:lang="pt-BR">As rupturas temporárias do RotaColab foram articuladas aos itens normativos sobre mensagens de status e feedback perceptível para transformar um requisito geral em condição operacional de continuidade.</mado:articulacao>
    <mado:articuladoSobPerspectiva rdf:resource="https://w3id.org/mado#P02"/>
    <mado:classificacaoOperacional>OPERACIONALIZAVEL</mado:classificacaoOperacional>
    <mado:contribuiParaFuncaoDecisoria rdf:resource="https://w3id.org/mado#FUN-FEEDBACK-PERCEPTIVEL"/>
    <mado:contribuiParaFuncaoDecisoria rdf:resource="https://w3id.org/mado#FUN-MANTER-INFORMACAO-RECUPERAVEL"/>
    <mado:derivadoDe rdf:resource="https://w3id.org/mado#F01"/>
    <mado:derivadoDe rdf:resource="https://w3id.org/mado#FN-ABNT-MOBILE"/>
    <mado:derivadoDe rdf:resource="https://w3id.org/mado#FN-ABNT-WEB"/>
    <mado:derivadoDe rdf:resource="https://w3id.org/mado#FN-WCAG"/>
    <mado:enunciado xml:lang="pt-BR">Feedback e mensagens de estado devem ser perceptíveis, não interromper indevidamente o foco e permanecer ou poder ser recuperados quando orientam a continuidade da tarefa.</mado:enunciado>
    <mado:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">K44</mado:identificador>
    <mado:limite xml:lang="pt-BR">O canal e a persistência do feedback dependem do tipo de ação, do ambiente e da tecnologia assistiva.</mado:limite>
    <mado:natureza>RECONSTRUCAO_ANALITICA_RASTREAVEL</mado:natureza>
    <mado:origemDaEstruturacaoSemantica xml:lang="pt-BR">Relação reconstruída pela autora entre trechos do corpus, condições funcionais, tarefa e função decisória; não é atribuída como formulação original às publicações.</mado:origemDaEstruturacaoSemantica>
    <mado:restricao xml:lang="pt-BR">BAR-EFEMERIDADE-DO-FEEDBACK-AUDITIVO-611AFB8</mado:restricao>
    <mado:restricao xml:lang="pt-BR">NEC-REVISAO-E-CONFIRMACAO</mado:restricao>
    <mado:restricao xml:lang="pt-BR">REC-FEEDBACK-ACESSIVEL</mado:restricao>
    <mado:restricao xml:lang="pt-BR">TAR-OPERAR-SISTEMA</mado:restricao>
    <mado:restricao xml:lang="pt-BR">TAR-REVISAR-E-CONFIRMAR</mado:restricao>
    <mado:statusDaRelacao>PRODUTO_DE_ARTICULACAO_RC3</mado:statusDaRelacao>
    <mado:sustentadoPorTrecho rdf:resource="https://w3id.org/mado#TD-EV02"/>
    <mado:sustentadoPorTrecho rdf:resource="https://w3id.org/mado#TD-ORI-0414"/>
    <mado:sustentadoPorTrecho rdf:resource="https://w3id.org/mado#TD-ORI-0415"/>
    <mado:sustentadoPorTrecho rdf:resource="https://w3id.org/mado#TD-ORI-0416"/>
    <mado:sustentadoPorTrecho rdf:resource="https://w3id.org/mado#TD-RC3-REF-05"/>
  </rdf:Description>
