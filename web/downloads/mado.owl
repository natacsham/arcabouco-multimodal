    <mado:temRecursoDisponivel rdf:resource="https://w3id.org/mado#REC-DESENHO-QUADRO-PAPEL"/>
    <mado:temTarefa rdf:resource="https://w3id.org/mado#TAR-APRESENTAR-CONTEUDO-DIFERENTES-ESPACOS"/>
    <mado:temTarefa rdf:resource="https://w3id.org/mado#TAR-COMUNICAR-CONTEUDO-1545B38"/>
  </rdf:Description>
