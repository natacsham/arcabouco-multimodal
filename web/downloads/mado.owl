<rdf:Description rdf:about="https://w3id.org/mado#CAR-ESTUDANTE-DO-SETIMO-ANO-FORTE-INTERESSE-E-CONHEC-8859C47">
<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
<ns5:inScheme rdf:resource="https://w3id.org/mado/scheme/CARACTERISTICA_PESSOA" />
<ns5:prefLabel xml:lang="pt-BR">Estudante do sétimo ano; forte interesse e conhecimento em História; público, idade/série e nível de compreensão devem ser considerados sem inferir características não relatadas.</ns5:prefLabel>
<ns4:categoriaDaCaracteristica>DESCRITOR_CONTEXTUAL_LEGADO</ns4:categoriaDaCaracteristica>
<ns4:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CAR-ESTUDANTE-DO-SETIMO-ANO-FORTE-INTERESSE-E-CONHEC-8859C47</ns4:identificador>
<ns4:statusDoRegistro>RECONSTRUIDO_DA_BASE_ANTERIOR</ns4:statusDoRegistro>
</rdf:Description>
<rdf:Description rdf:about="https://w3id.org/mado#CAR-EXPERIENCIA-APRESENTAR-PUBLICOS">
<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
<ns5:inScheme rdf:resource="https://w3id.org/mado/scheme/CARACTERISTICA_PESSOA" />
<ns5:prefLabel xml:lang="pt-BR">Possui experiência apresentando conteúdo em diferentes espaços e para diferentes públicos</ns5:prefLabel>
<ns4:categoriaDaCaracteristica>CAPACIDADE_E_CONHECIMENTO_OBSERVADO</ns4:categoriaDaCaracteristica>
<ns4:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CAR-EXPERIENCIA-APRESENTAR-PUBLICOS</ns4:identificador>
<ns4:statusDoRegistro>CONTROLADO_1_2_RC1</ns4:statusDoRegistro>
</rdf:Description>
<rdf:Description rdf:about="https://w3id.org/mado#CAR-EXPERIENCIA-DIGITAL-VARIAVEL">
<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
<ns5:inScheme rdf:resource="https://w3id.org/mado/scheme/CARACTERISTICA_PESSOA" />
<ns5:prefLabel xml:lang="pt-BR">A experiência com o recurso digital pode alterar a execução da tarefa</ns5:prefLabel>
<ns4:caracteristicaDerivadaDeFonte rdf:resource="https://w3id.org/mado#F01" />
<ns4:caracteristicaDerivadaDeFonte rdf:resource="https://w3id.org/mado#F05" />
<ns4:caracteristicaSustentadaPorTrecho rdf:resource="https://w3id.org/mado#TD-RC3-REF-03" />
<ns4:caracteristicaSustentadaPorTrecho rdf:resource="https://w3id.org/mado#TD-RC3-REF-07" />
<ns4:categoriaDaCaracteristica>EXPERIENCIA_E_PROFICIENCIA_DIGITAL</ns4:categoriaDaCaracteristica>
<ns4:condicaoDeUsoDaCaracteristica xml:lang="pt-BR">Observar a execução real e permitir ajuda sem encobrir a ruptura.</ns4:condicaoDeUsoDaCaracteristica>
<ns4:contraindicacao xml:lang="pt-BR">Não inferir proficiência do uso de uma tecnologia semelhante.</ns4:contraindicacao>
<ns4:efeitoPossivelNaTarefa xml:lang="pt-BR">Tecnologia assistiva lenta, gesto desconhecido ou retorno ambíguo pode bloquear a ação.</ns4:efeitoPossivelNaTarefa>
<ns4:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CAR-EXPERIENCIA-DIGITAL-VARIAVEL</ns4:identificador>
<ns4:statusDoRegistro>CONTROLADO_1_2_RC3</ns4:statusDoRegistro>
</rdf:Description>
<rdf:Description rdf:about="https://w3id.org/mado#CAR-EXPRESSAO-ORAL-AUTORAL">
<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
<ns5:inScheme rdf:resource="https://w3id.org/mado/scheme/CARACTERISTICA_PESSOA" />
<ns5:prefLabel xml:lang="pt-BR">Expressa e desenvolve conhecimento principalmente pela fala</ns5:prefLabel>
<ns4:caracteristicaDerivadaDeFonte rdf:resource="https://w3id.org/mado#F08" />
<ns4:caracteristicaDerivadaDeFonte rdf:resource="https://w3id.org/mado#F12" />
<ns4:caracteristicaSustentadaPorTrecho rdf:resource="https://w3id.org/mado#TD-ELIC-02" />
<ns4:caracteristicaSustentadaPorTrecho rdf:resource="https://w3id.org/mado#TD-RC3-REF-10" />
<ns4:categoriaDaCaracteristica>COMUNICACAO_E_EXPRESSAO</ns4:categoriaDaCaracteristica>
<ns4:condicaoDeUsoDaCaracteristica xml:lang="pt-BR">Cada forma deve cumprir função explícita e admitir revisão.</ns4:condicaoDeUsoDaCaracteristica>
<ns4:contraindicacao xml:lang="pt-BR">Não multiplicar formatos sem estrutura ou alternativa.</ns4:contraindicacao>
<ns4:efeitoPossivelNaTarefa xml:lang="pt-BR">A entrada apenas textual pode reduzir autoria e detalhe.</ns4:efeitoPossivelNaTarefa>
<ns4:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CAR-EXPRESSAO-ORAL-AUTORAL</ns4:identificador>
<ns4:statusDoRegistro>CONTROLADO_1_2_RC3</ns4:statusDoRegistro>
</rdf:Description>
<rdf:Description rdf:about="https://w3id.org/mado#CAR-EXPRESSAO-POR-DESENHO-IMAGEM">
<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
<ns5:inScheme rdf:resource="https://w3id.org/mado/scheme/CARACTERISTICA_PESSOA" />
<ns5:prefLabel xml:lang="pt-BR">Expressa relações também por desenho e imagem</ns5:prefLabel>
<ns4:categoriaDaCaracteristica>FORMA_DE_EXPRESSAO_OBSERVADA</ns4:categoriaDaCaracteristica>
<ns4:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CAR-EXPRESSAO-POR-DESENHO-IMAGEM</ns4:identificador>
<ns4:statusDoRegistro>CONTROLADO_RC4</ns4:statusDoRegistro>
</rdf:Description>
<rdf:Description rdf:about="https://w3id.org/mado#CAR-EXPRESSAO-VISUAL-AUTORAL">
<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
<ns5:inScheme rdf:resource="https://w3id.org/mado/scheme/CARACTERISTICA_PESSOA" />
<ns5:prefLabel xml:lang="pt-BR">Usa imagem ou desenho para explicar e organizar ideias</ns5:prefLabel>
<ns4:caracteristicaDerivadaDeFonte rdf:resource="https://w3id.org/mado#F08" />
<ns4:caracteristicaDerivadaDeFonte rdf:resource="https://w3id.org/mado#F12" />
<ns4:caracteristicaSustentadaPorTrecho rdf:resource="https://w3id.org/mado#TD-ELIC-02" />
<ns4:caracteristicaSustentadaPorTrecho rdf:resource="https://w3id.org/mado#TD-RC3-REF-10" />
<ns4:categoriaDaCaracteristica>COMUNICACAO_E_EXPRESSAO</ns4:categoriaDaCaracteristica>
<ns4:condicaoDeUsoDaCaracteristica xml:lang="pt-BR">Cada forma deve cumprir função explícita e admitir revisão.</ns4:condicaoDeUsoDaCaracteristica>
<ns4:contraindicacao xml:lang="pt-BR">Não multiplicar formatos sem estrutura ou alternativa.</ns4:contraindicacao>
<ns4:efeitoPossivelNaTarefa xml:lang="pt-BR">A entrada apenas textual pode reduzir autoria e detalhe.</ns4:efeitoPossivelNaTarefa>
<ns4:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CAR-EXPRESSAO-VISUAL-AUTORAL</ns4:identificador>
<ns4:statusDoRegistro>CONTROLADO_1_2_RC3</ns4:statusDoRegistro>
</rdf:Description>
<rdf:Description rdf:about="https://w3id.org/mado#CAR-FALA-ESPONTANEA-EXTENSA">
<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
<ns5:inScheme rdf:resource="https://w3id.org/mado/scheme/CARACTERISTICA_PESSOA" />
<ns5:prefLabel xml:lang="pt-BR">Contribuições orais espontâneas e extensas</ns5:prefLabel>
<ns4:categoriaDaCaracteristica>FORMA_DE_EXPRESSAO_OBSERVADA</ns4:categoriaDaCaracteristica>
<ns4:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CAR-FALA-ESPONTANEA-EXTENSA</ns4:identificador>
<ns4:statusDoRegistro>CONTROLADO_RC4</ns4:statusDoRegistro>
</rdf:Description>
<rdf:Description rdf:about="https://w3id.org/mado#CAR-FALA-LEITURA-OPERAVEIS">
<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
<ns1:comment xml:lang="pt-BR">Premissa sintética: a pessoa pode falar e revisar o texto reconhecido; não é deduzida de uma deficiência nem generalizada.</ns1:comment>
<ns5:inScheme rdf:resource="https://w3id.org/mado/scheme/CARACTERISTICA_PESSOA" />
<ns5:prefLabel xml:lang="pt-BR">Fala e leitura de texto operáveis nesta tarefa</ns5:prefLabel>
<ns4:categoriaDaCaracteristica>CAPACIDADE_FUNCIONAL_SITUADA</ns4:categoriaDaCaracteristica>
<ns4:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CAR-FALA-LEITURA-OPERAVEIS</ns4:identificador>
<ns4:statusDoRegistro>PREMISSA_SINTETICA_DEMONSTRACAO_FIX2</ns4:statusDoRegistro>
</rdf:Description>
<rdf:Description rdf:about="https://w3id.org/mado#CAR-FALA-PERSISTENTE-REPETITIVA">
<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
<ns5:inScheme rdf:resource="https://w3id.org/mado/scheme/CARACTERISTICA_PESSOA" />
<ns5:prefLabel xml:lang="pt-BR">Insiste ou repete contribuições quando busca manter a fala</ns5:prefLabel>
<ns4:categoriaDaCaracteristica>FORMA_DE_PARTICIPACAO_OBSERVADA</ns4:categoriaDaCaracteristica>
<ns4:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CAR-FALA-PERSISTENTE-REPETITIVA</ns4:identificador>
<ns4:statusDoRegistro>CONTROLADO_1_2_RC1</ns4:statusDoRegistro>
</rdf:Description>
<rdf:Description rdf:about="https://w3id.org/mado#CAR-INTERACAO-NAO-VISUAL">
<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
<ns5:inScheme rdf:resource="https://w3id.org/mado/scheme/CARACTERISTICA_PESSOA" />
<ns5:prefLabel xml:lang="pt-BR">Interação predominantemente não visual</ns5:prefLabel>
<ns4:caracteristicaDerivadaDeFonte rdf:resource="https://w3id.org/mado#F01" />
<ns4:caracteristicaDerivadaDeFonte rdf:resource="https://w3id.org/mado#F03" />
<ns4:caracteristicaDerivadaDeFonte rdf:resource="https://w3id.org/mado#FN-WCAG" />
<ns4:caracteristicaSustentadaPorTrecho rdf:resource="https://w3id.org/mado#TD-EV01" />
<ns4:caracteristicaSustentadaPorTrecho rdf:resource="https://w3id.org/mado#TD-EV12" />
<ns4:caracteristicaSustentadaPorTrecho rdf:resource="https://w3id.org/mado#TD-ORI-0001" />
<ns4:categoriaDaCaracteristica>CARACTERISTICA_FUNCIONAL</ns4:categoriaDaCaracteristica>
<ns4:condicaoDeUsoDaCaracteristica xml:lang="pt-BR">A alternativa deve preservar o significado necessário à tarefa.</ns4:condicaoDeUsoDaCaracteristica>
<ns4:contraindicacao xml:lang="pt-BR">Não tratar áudio ou vibração como equivalentes automáticos a qualquer conteúdo visual.</ns4:contraindicacao>
<ns4:efeitoPossivelNaTarefa xml:lang="pt-BR">Pode impedir reconhecer conteúdo, estrutura, posição e estado.</ns4:efeitoPossivelNaTarefa>
<ns4:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CAR-INTERACAO-NAO-VISUAL</ns4:identificador>
<ns4:statusDoRegistro>CONTROLADO_RC4</ns4:statusDoRegistro>
</rdf:Description>
<rdf:Description rdf:about="https://w3id.org/mado#CAR-INTERESSE-CONHECIMENTO-TEMA">
<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
<ns5:inScheme rdf:resource="https://w3id.org/mado/scheme/CARACTERISTICA_PESSOA" />
<ns5:prefLabel xml:lang="pt-BR">Demonstra interesse intenso e conhecimento aprofundado sobre um tema específico</ns5:prefLabel>
<ns4:caracteristicaDerivadaDeFonte rdf:resource="https://w3id.org/mado#F08" />
<ns4:caracteristicaDerivadaDeFonte rdf:resource="https://w3id.org/mado#F12" />
<ns4:caracteristicaSustentadaPorTrecho rdf:resource="https://w3id.org/mado#TD-ELIC-02" />
<ns4:caracteristicaSustentadaPorTrecho rdf:resource="https://w3id.org/mado#TD-ELIC-03" />
<ns4:caracteristicaSustentadaPorTrecho rdf:resource="https://w3id.org/mado#TD-RC3-REF-10" />
<ns4:categoriaDaCaracteristica>INTERESSES_CONHECIMENTOS_POTENCIALIDADES</ns4:categoriaDaCaracteristica>
<ns4:condicaoDeUsoDaCaracteristica xml:lang="pt-BR">Objetivo e papéis devem ser confirmados com os participantes.</ns4:condicaoDeUsoDaCaracteristica>
<ns4:condicaoDeUsoDaCaracteristica xml:lang="pt-BR">Vincular o interesse a uma tarefa verificável e manter autoria identificável.</ns4:condicaoDeUsoDaCaracteristica>
<ns4:contraindicacao xml:lang="pt-BR">Não converter organização em silenciamento ou roteiro rígido.</ns4:contraindicacao>
<ns4:contraindicacao xml:lang="pt-BR">Não usar diagnóstico ou interesse como justificativa suficiente para um modo.</ns4:contraindicacao>
<ns4:efeitoPossivelNaTarefa xml:lang="pt-BR">Quando ligado ao objetivo, pode ampliar participação; sem estrutura, pode se desconectar da atividade.</ns4:efeitoPossivelNaTarefa>
<ns4:efeitoPossivelNaTarefa xml:lang="pt-BR">Sem combinação explícita, autoria pode ser retirada ou a participação pode se tornar conflitiva.</ns4:efeitoPossivelNaTarefa>
<ns4:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CAR-INTERESSE-CONHECIMENTO-TEMA</ns4:identificador>
<ns4:statusDoRegistro>CONTROLADO_1_2_RC3</ns4:statusDoRegistro>
</rdf:Description>
<rdf:Description rdf:about="https://w3id.org/mado#CAR-INTERESSE-GEOGRAFIA-MAPAS">
<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
<ns5:inScheme rdf:resource="https://w3id.org/mado/scheme/CARACTERISTICA_PESSOA" />
<ns5:prefLabel xml:lang="pt-BR">Interesse e conhecimento em Geografia e mapas</ns5:prefLabel>
<ns4:categoriaDaCaracteristica>DESCRITOR_CONTEXTUAL_LEGADO</ns4:categoriaDaCaracteristica>
<ns4:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CAR-INTERESSE-GEOGRAFIA-MAPAS</ns4:identificador>
<ns4:statusDoRegistro>SINTETICO</ns4:statusDoRegistro>
</rdf:Description>
<rdf:Description rdf:about="https://w3id.org/mado#CAR-INTERESSE-HISTORIA">
<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
<ns5:broader rdf:resource="https://w3id.org/mado#CAR-INTERESSE-CONHECIMENTO-TEMA" />
<ns5:inScheme rdf:resource="https://w3id.org/mado/scheme/CARACTERISTICA_PESSOA" />
<ns5:prefLabel xml:lang="pt-BR">Interesse intenso e conhecimento em História</ns5:prefLabel>
<ns4:categoriaDaCaracteristica>DESCRITOR_CONTEXTUAL_LEGADO</ns4:categoriaDaCaracteristica>
<ns4:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CAR-INTERESSE-HISTORIA</ns4:identificador>
<ns4:statusDoRegistro>ELICITADO_A_CONFIRMAR</ns4:statusDoRegistro>
</rdf:Description>
<rdf:Description rdf:about="https://w3id.org/mado#CAR-MOVIMENTO-RESIDUAL-DEDOS">
<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
<ns5:inScheme rdf:resource="https://w3id.org/mado/scheme/CARACTERISTICA_PESSOA" />
<ns5:prefLabel xml:lang="pt-BR">Movimento residual dos dedos disponível para interação</ns5:prefLabel>
<ns4:categoriaDaCaracteristica>CAPACIDADE_OBSERVADA</ns4:categoriaDaCaracteristica>
<ns4:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CAR-MOVIMENTO-RESIDUAL-DEDOS</ns4:identificador>
<ns4:statusDoRegistro>CONTROLADO_RC4</ns4:statusDoRegistro>
</rdf:Description>
<rdf:Description rdf:about="https://w3id.org/mado#CAR-NECESSITA-ESTRUTURA-TRANSICAO">
<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
<ns5:inScheme rdf:resource="https://w3id.org/mado/scheme/CARACTERISTICA_PESSOA" />
<ns5:prefLabel xml:lang="pt-BR">Beneficia-se de estrutura explícita para transições, retomada e fechamento</ns5:prefLabel>
<ns4:caracteristicaDerivadaDeFonte rdf:resource="https://w3id.org/mado#F06" />
<ns4:caracteristicaDerivadaDeFonte rdf:resource="https://w3id.org/mado#F07" />
<ns4:caracteristicaDerivadaDeFonte rdf:resource="https://w3id.org/mado#F08" />
<ns4:caracteristicaDerivadaDeFonte rdf:resource="https://w3id.org/mado#F12" />
<ns4:caracteristicaSustentadaPorTrecho rdf:resource="https://w3id.org/mado#TD-ELIC-03" />
<ns4:caracteristicaSustentadaPorTrecho rdf:resource="https://w3id.org/mado#TD-EV34" />
<ns4:caracteristicaSustentadaPorTrecho rdf:resource="https://w3id.org/mado#TD-RC3-REF-09" />
<ns4:caracteristicaSustentadaPorTrecho rdf:resource="https://w3id.org/mado#TD-RC3-REF-10" />
<ns4:categoriaDaCaracteristica>ATENCAO_E_ORGANIZACAO</ns4:categoriaDaCaracteristica>
<ns4:condicaoDeUsoDaCaracteristica xml:lang="pt-BR">Objetivo e papéis devem ser confirmados com os participantes.</ns4:condicaoDeUsoDaCaracteristica>
<ns4:condicaoDeUsoDaCaracteristica xml:lang="pt-BR">Usar poucos marcos persistentes e permitir retomada.</ns4:condicaoDeUsoDaCaracteristica>
<ns4:contraindicacao xml:lang="pt-BR">Não converter organização em silenciamento ou roteiro rígido.</ns4:contraindicacao>
<ns4:contraindicacao xml:lang="pt-BR">Não pressupor que mais estímulos aumentam compreensão.</ns4:contraindicacao>
<ns4:efeitoPossivelNaTarefa xml:lang="pt-BR">Formatos simultâneos ou mudanças abruptas podem prejudicar continuidade e participação.</ns4:efeitoPossivelNaTarefa>
<ns4:efeitoPossivelNaTarefa xml:lang="pt-BR">Sem combinação explícita, autoria pode ser retirada ou a participação pode se tornar conflitiva.</ns4:efeitoPossivelNaTarefa>
<ns4:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CAR-NECESSITA-ESTRUTURA-TRANSICAO</ns4:identificador>
<ns4:statusDoRegistro>CONTROLADO_1_2_RC3</ns4:statusDoRegistro>
</rdf:Description>
<rdf:Description rdf:about="https://w3id.org/mado#CAR-NECESSITA-ORGANIZACAO-COGNITIVA">
<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
<ns5:inScheme rdf:resource="https://w3id.org/mado/scheme/CARACTERISTICA_PESSOA" />
<ns5:prefLabel xml:lang="pt-BR">Necessita apoio para organização, foco ou compreensão</ns5:prefLabel>
<ns4:categoriaDaCaracteristica>NECESSIDADE_FUNCIONAL</ns4:categoriaDaCaracteristica>
<ns4:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CAR-NECESSITA-ORGANIZACAO-COGNITIVA</ns4:identificador>
<ns4:statusDoRegistro>CONTROLADO_RC4</ns4:statusDoRegistro>
</rdf:Description>
<rdf:Description rdf:about="https://w3id.org/mado#CAR-OPERACAO-NAO-CONVENCIONAL">
<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
<ns5:inScheme rdf:resource="https://w3id.org/mado/scheme/CARACTERISTICA_PESSOA" />
<ns5:prefLabel xml:lang="pt-BR">A forma convencional de operação não é compatível com o movimento disponível</ns5:prefLabel>
<ns4:caracteristicaDerivadaDeFonte rdf:resource="https://w3id.org/mado#F01" />
<ns4:caracteristicaDerivadaDeFonte rdf:resource="https://w3id.org/mado#F05" />
<ns4:caracteristicaSustentadaPorTrecho rdf:resource="https://w3id.org/mado#TD-RC3-REF-04" />
<ns4:caracteristicaSustentadaPorTrecho rdf:resource="https://w3id.org/mado#TD-RC3-REF-07" />
<ns4:categoriaDaCaracteristica>OPERACAO_E_CONTROLE</ns4:categoriaDaCaracteristica>
<ns4:condicaoDeUsoDaCaracteristica xml:lang="pt-BR">Testar movimento, precisão, esforço, compatibilidade e feedback.</ns4:condicaoDeUsoDaCaracteristica>
<ns4:contraindicacao xml:lang="pt-BR">Não recomendar um controle apenas por ser alternativo.</ns4:contraindicacao>
<ns4:efeitoPossivelNaTarefa xml:lang="pt-BR">Pode impedir entrada, navegação ou confirmação.</ns4:efeitoPossivelNaTarefa>
<ns4:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CAR-OPERACAO-NAO-CONVENCIONAL</ns4:identificador>
<ns4:statusDoRegistro>CONTROLADO_1_2_RC3</ns4:statusDoRegistro>
</rdf:Description>
<rdf:Description rdf:about="https://w3id.org/mado#CAR-PERFIS-FUNCIONAIS-DIVERSOS">
<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
<ns5:inScheme rdf:resource="https://w3id.org/mado/scheme/CARACTERISTICA_PESSOA" />
<ns5:prefLabel xml:lang="pt-BR">Perfis funcionais diversos documentados</ns5:prefLabel>
<ns4:categoriaDaCaracteristica>ESCOPO_DE_PUBLICO</ns4:categoriaDaCaracteristica>
<ns4:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CAR-PERFIS-FUNCIONAIS-DIVERSOS</ns4:identificador>
<ns4:statusDoRegistro>CONTROLADO_RC4</ns4:statusDoRegistro>
</rdf:Description>
<rdf:Description rdf:about="https://w3id.org/mado#CAR-PESSOA-CEGA-LEITOR-TELA">
