<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0371" />
<ns4:statusDaRelacao>RELACAO_SEM_JUSTIFICATIVA_EXPLICITA</ns4:statusDaRelacao>
</rdf:Description>
<rdf:Description rdf:about="https://w3id.org/mado#CA77">
<rdf:type rdf:resource="https://w3id.org/mado#CriterioDeDecisaoMultimodal" />
<ns1:label xml:lang="pt-BR">Componentes com a mesma funcionalidade que aparecem em múltiplas páginas ou em diferentes locais da mesma página devem ser identificados de forma consistente.</ns1:label>
<ns4:enunciado xml:lang="pt-BR">Componentes com a mesma funcionalidade que aparecem em múltiplas páginas ou em diferentes locais da mesma página devem ser identificados de forma consistente.</ns4:enunciado>
<ns4:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CA77</ns4:identificador>
<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0372" />
<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0373" />
<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0374" />
<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0375" />
<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0376" />
<ns4:statusDaRelacao>RELACAO_SEM_JUSTIFICATIVA_EXPLICITA</ns4:statusDaRelacao>
</rdf:Description>
<rdf:Description rdf:about="https://w3id.org/mado#CA78">
<rdf:type rdf:resource="https://w3id.org/mado#CriterioDeDecisaoMultimodal" />
<ns1:label xml:lang="pt-BR">Mudanças de contexto devem ser iniciadas apenas por uma ação explícita do usuário, ou deve haver uma opção para desativar mudanças automáticas.&#13;
</ns1:label>
<ns4:enunciado xml:lang="pt-BR">Mudanças de contexto devem ser iniciadas apenas por uma ação explícita do usuário, ou deve haver uma opção para desativar mudanças automáticas.</ns4:enunciado>
<ns4:fundamentadoPor rdf:resource="https://w3id.org/mado#K29" />
<ns4:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CA78</ns4:identificador>
