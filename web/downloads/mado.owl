  <rdf:Description rdf:about="https://w3id.org/mado#CAR-EXPRESSAO-VISUAL-AUTORAL">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://w3id.org/mado/scheme/CARACTERISTICA_PESSOA"/>
    <skos:prefLabel xml:lang="pt-BR">Usa imagem ou desenho para explicar e organizar ideias</skos:prefLabel>
