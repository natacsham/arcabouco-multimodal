  <rdf:Description rdf:about="https://w3id.org/mado#D07">
    <rdf:type rdf:resource="https://w3id.org/mado#DecisaoDeAcessibilidadeMultimodal"/>
    <rdfs:label xml:lang="pt-BR">Para tornar elementos web percebíveis por pessoas que usam leitor de tela, representar seu significado de forma textual/descritiva para síntese em áudio.</rdfs:label>
    <mado:condicaoDeAplicacao xml:lang="pt-BR">Qualidade da descrição e estrutura do conteúdo</mado:condicaoDeAplicacao>
    <mado:enunciado xml:lang="pt-BR">Para tornar elementos web percebíveis por pessoas que usam leitor de tela, representar seu significado de forma textual/descritiva para síntese em áudio.</mado:enunciado>
    <mado:expressaoOperacional xml:lang="pt-BR">Fornecer representação textual/descritiva dos elementos relevantes para que leitores de tela possam sintetizar sua função e significado.</mado:expressaoOperacional>
    <mado:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D07</mado:identificador>
    <mado:natureza>RECONSTRUÇÃO ANALÍTICA FORTEMENTE SUSTENTADA</mado:natureza>
    <mado:produziuResultado rdf:resource="https://w3id.org/mado#R-EV15"/>
    <mado:produziuResultado rdf:resource="https://w3id.org/mado#R-EV18"/>
    <mado:rationale xml:lang="pt-BR">Por quê: leitor de tela não resolve conteúdo originalmente sem representação adequada. Para quê: ampliar acesso e compreensão. Como: a WABlind mantém elementos importantes e acrescenta descrição/alternativa textual que pode ser sintetizada.</mado:rationale>
    <mado:respondeA rdf:resource="https://w3id.org/mado#CTX-D07"/>
    <mado:statusDecisao>DECISAO_HISTORICA_RECONSTRUIDA</mado:statusDecisao>
    <mado:statusDoRegistro>DECISAO_HISTORICA_RECONSTRUIDA</mado:statusDoRegistro>
    <mado:sustentadaPor rdf:resource="https://w3id.org/mado#K10"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mado#Retroalimentacao">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="pt-BR">Retroalimentação entre ciclos</rdfs:label>
    <rdfs:comment xml:lang="pt-BR">Registro de reutilização ou refinamento entre ciclos. Não implica promoção automática de uma orientação ou avaliação à base executável.</rdfs:comment>
  </rdf:Description>
