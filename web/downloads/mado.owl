  <rdf:Description rdf:about="https://w3id.org/mado#K25">
    <rdf:type rdf:resource="https://w3id.org/mado#ConhecimentoMultimodalArticulado"/>
    <rdfs:label xml:lang="pt-BR">Na leitura e navegação de conteúdo educacional, barreiras visuais e de interação podem exigir uma composição multimodal de percepção e controle que combine saída auditiva, entrada por voz e ajustes visuais selecionados pelos critérios aplicáveis.</rdfs:label>
    <mado:aplicavelAAmbiente rdf:resource="https://w3id.org/mado#AMB-CONTEXTO-DIGITAL-DE-APRENDIZAGEM-SIGAA-8C300D7"/>
    <mado:aplicavelABarreira rdf:resource="https://w3id.org/mado#BAR-ZOOM-CONTRASTE-E-OPERACAO-NAVEGACAO-F73629E"/>
    <mado:aplicavelACaracteristicaRelevanteDaPessoa rdf:resource="https://w3id.org/mado#CAR-BAIXA-VISAO"/>
    <mado:aplicavelACaracteristicaRelevanteDaPessoa rdf:resource="https://w3id.org/mado#CAR-ENTRADA-CONVENCIONAL-DIFICIL"/>
    <mado:aplicavelACaracteristicaRelevanteDaPessoa rdf:resource="https://w3id.org/mado#CAR-NECESSITA-ORGANIZACAO-COGNITIVA"/>
    <mado:aplicavelARecursoDisponivel rdf:resource="https://w3id.org/mado#REC-TTS-VOZ-CONTROLES-VISUAIS-5D9B39A"/>
    <mado:aplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-ACESSAR-CONTEUDO-9DCCC00"/>
    <mado:articulacao xml:lang="pt-BR">No caso da tela de conteúdo, o cenário de Camila revela problemas de zoom, contraste, mídia e navegação. O redesign combina TTS, ditado/controle por voz, tamanho de fonte e alto contraste, todos ligados a critérios específicos. A composição é consequência do conjunto de barreiras e não de uma recomendação única isolada.</mado:articulacao>
    <mado:articuladoSobPerspectiva rdf:resource="https://w3id.org/mado#P02"/>
    <mado:classificacaoOperacional>OPERACIONALIZAVEL</mado:classificacaoOperacional>
    <mado:derivadoDe rdf:resource="https://w3id.org/mado#F08"/>
    <mado:enunciado xml:lang="pt-BR">Na leitura e navegação de conteúdo educacional, barreiras visuais e de interação podem exigir uma composição multimodal de percepção e controle que combine saída auditiva, entrada por voz e ajustes visuais selecionados pelos critérios aplicáveis.</mado:enunciado>
    <mado:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">K25</mado:identificador>
    <mado:natureza>RECONSTRUÇÃO ANALÍTICA FORTEMENTE SUSTENTADA</mado:natureza>
    <mado:origemDaEstruturacaoSemantica xml:lang="pt-BR">Relações derivadas de contextos e decisões documentados; complementações RC3 foram estabelecidas somente quando o enunciado, a articulação e os trechos sustentavam a aplicabilidade.</mado:origemDaEstruturacaoSemantica>
    <mado:restricao xml:lang="pt-BR">Baixa visão</mado:restricao>
    <mado:restricao xml:lang="pt-BR">TTS</mado:restricao>
    <mado:restricao xml:lang="pt-BR">contraste</mado:restricao>
    <mado:restricao xml:lang="pt-BR">critérios</mado:restricao>
    <mado:restricao xml:lang="pt-BR">fonte</mado:restricao>
    <mado:restricao xml:lang="pt-BR">tela de conteúdo</mado:restricao>
    <mado:restricao xml:lang="pt-BR">voz</mado:restricao>
    <mado:statusDaRelacao>CONHECIMENTO_CANDIDATO</mado:statusDaRelacao>
    <mado:sustentadoPorTrecho rdf:resource="https://w3id.org/mado#TD-EV27"/>
    <mado:sustentadoPorTrecho rdf:resource="https://w3id.org/mado#TD-EV28"/>
  </rdf:Description>
