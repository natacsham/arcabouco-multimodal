</rdf:Description>
<rdf:Description rdf:about="https://w3id.org/mado#CA73">
<rdf:type rdf:resource="https://w3id.org/mado#CriterioDeDecisaoMultimodal" />
<ns1:label xml:lang="pt-BR">Deve haver um mecanismo para identificar e fornecer o significado por extenso de siglas e abreviações.</ns1:label>
<ns4:enunciado xml:lang="pt-BR">Deve haver um mecanismo para identificar e fornecer o significado por extenso de siglas e abreviações.</ns4:enunciado>
<ns4:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CA73</ns4:identificador>
