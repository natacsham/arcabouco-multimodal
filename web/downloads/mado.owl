    <mado:cumpreFuncaoDecisoria rdf:resource="https://w3id.org/mado#FUN-PRESERVAR-PROTAGONISMO"/>
    <mado:cumpreFuncaoDecisoria rdf:resource="https://w3id.org/mado#FUN-REDUZIR-SOBRECARGA"/>
    <mado:estadoDeDisponibilidadeDaConfiguracao>CONFIRMADO_DISPONIVEL</mado:estadoDeDisponibilidadeDaConfiguracao>
    <mado:executadaPorPapel rdf:resource="https://w3id.org/mado#PAPEL-PROFESSORA"/>
    <mado:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CFG-RC4-06</mado:identificador>
    <mado:limiteDaConfiguracao xml:lang="pt-BR">O acordo não deve ser usado para silenciar, punir repetição ou atribuir toda regulação ao estudante.</mado:limiteDaConfiguracao>
    <mado:origemDoRegistro>CONFIGURACAO_MATURA_RC4</mado:origemDoRegistro>
    <mado:significadoFuncional xml:lang="pt-BR">A participação precisa preservar autoria e vínculo por regras previsíveis de transição.</mado:significadoFuncional>
    <mado:temAcaoOperacional xml:lang="pt-BR">combinar quem abre cada bloco, quando colegas perguntam, como a professora sinaliza a transição e como o estudante registra uma contribuição que ficará para revisão</mado:temAcaoOperacional>
    <mado:temFuncaoModal xml:lang="pt-BR">coordenar momentos de autoria, perguntas, complementação e fechamento</mado:temFuncaoModal>
    <mado:temPapelModal rdf:resource="https://w3id.org/mado#PAPEL-APOIO-ORGANIZACAO"/>
