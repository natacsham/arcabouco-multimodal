<ns4:configuracaoUsaOrigemDoCriterio rdf:resource="https://w3id.org/mado#ORI-0364" />
<ns4:configuracaoUsaOrigemDoCriterio rdf:resource="https://w3id.org/mado#ORI-0414" />
