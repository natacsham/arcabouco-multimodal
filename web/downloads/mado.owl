<ns4:envolvePersona rdf:resource="https://w3id.org/mado#PER-MARCIA" />
<ns4:estadoDeCuradoria>APROVADA_PARA_TESTE_RC2</ns4:estadoDeCuradoria>
<ns4:explicacaoDaOperacaoAnalitica xml:lang="pt-BR">Relaciona precedentes gerais de acessibilidade e feedback a uma proposta de jogo. Não foi localizada nos registros conferidos sustentação específica para as mecânicas de ordenar eventos ou comparar causas.</ns4:explicacaoDaOperacaoAnalitica>
<ns4:habilitadaParaDecisao rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns4:habilitadaParaDecisao>
<ns4:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ART-TRF-03</ns4:identificador>
<ns4:limite xml:lang="pt-BR">Ligação proposta analiticamente pela autora; não constitui evidência de eficácia universal de jogos.</ns4:limite>
<ns4:limiteDaArticulacao xml:lang="pt-BR">Ligação proposta analiticamente pela autora; não constitui evidência de eficácia universal de jogos.</ns4:limiteDaArticulacao>
<ns4:nivelDeConfirmacao>INFORMADA_PELA_AUTORA</ns4:nivelDeConfirmacao>
