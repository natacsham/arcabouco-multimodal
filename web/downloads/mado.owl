  <rdf:Description rdf:about="https://w3id.org/mado#CFG-RC4-04">
    <rdf:type rdf:resource="https://w3id.org/mado#ConfiguracaoModalDaDecisao"/>
    <mado:acompanhamentoDaConfiguracao xml:lang="pt-BR">Após o trecho, pedir que os participantes indiquem qual relação nova o vídeo tornou compreensível.</mado:acompanhamentoDaConfiguracao>
    <mado:alternativaDaConfiguracao xml:lang="pt-BR">Substituir por sequência de imagens descritas, desenho em etapas ou demonstração narrada.</mado:alternativaDaConfiguracao>
    <mado:condicaoDaConfiguracao xml:lang="pt-BR">Selecionar vídeo apenas se ele acrescentar processo, mudança, contraste ou perspectiva ao objetivo.</mado:condicaoDaConfiguracao>
    <mado:configuraModalidade rdf:resource="https://w3id.org/mado#MOD-VIDEO"/>
    <mado:configuraRecurso rdf:resource="https://w3id.org/mado#REC-AUDIODESCRICAO"/>
    <mado:configuraRecurso rdf:resource="https://w3id.org/mado#REC-LEGENDAS"/>
    <mado:configuraRecurso rdf:resource="https://w3id.org/mado#REC-REPRODUTOR-VIDEO"/>
    <mado:configuracaoAplicaCriterio rdf:resource="https://w3id.org/mado#CA05"/>
    <mado:configuracaoAplicaCriterio rdf:resource="https://w3id.org/mado#CA17"/>
    <mado:configuracaoAplicaCriterio rdf:resource="https://w3id.org/mado#CA88"/>
    <mado:configuracaoConsideraCondicao rdf:resource="https://w3id.org/mado#NEC-ESTRUTURAR-RELACOES-HISTORICAS"/>
    <mado:configuracaoConsideraCondicao rdf:resource="https://w3id.org/mado#NEC-FUNCAO-EXPLICITA-POR-MODALIDADE"/>
    <mado:configuracaoDeDecisao rdf:resource="https://w3id.org/mado#D-TESTE-RC4-TRANSFERENCIA"/>
    <mado:configuracaoMobilizaArticulacao rdf:resource="https://w3id.org/mado#ART-REF-03"/>
