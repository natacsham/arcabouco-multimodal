    <mado:categoriaDaCaracteristica>COMUNICACAO_E_EXPRESSAO</mado:categoriaDaCaracteristica>
    <mado:condicaoDeUsoDaCaracteristica xml:lang="pt-BR">Cada forma deve cumprir função explícita e admitir revisão.</mado:condicaoDeUsoDaCaracteristica>
    <mado:contraindicacao xml:lang="pt-BR">Não multiplicar formatos sem estrutura ou alternativa.</mado:contraindicacao>
    <mado:efeitoPossivelNaTarefa xml:lang="pt-BR">A entrada apenas textual pode reduzir autoria e detalhe.</mado:efeitoPossivelNaTarefa>
    <mado:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CAR-EXPRESSAO-VISUAL-AUTORAL</mado:identificador>
