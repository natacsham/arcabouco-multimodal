    <mado:configuracaoSustentadaPorConhecimento rdf:resource="https://w3id.org/mado#K45"/>
    <mado:configuracaoUsaOrigemDoCriterio rdf:resource="https://w3id.org/mado#ORI-0012"/>
    <mado:configuracaoUsaOrigemDoCriterio rdf:resource="https://w3id.org/mado#ORI-0013"/>
    <mado:configuracaoUsaOrigemDoCriterio rdf:resource="https://w3id.org/mado#ORI-0014"/>
