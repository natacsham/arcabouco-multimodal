<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
<ns5:inScheme rdf:resource="https://w3id.org/mado/scheme/MODALIDADE" />
<ns5:prefLabel xml:lang="pt-BR">Áudio</ns5:prefLabel>
<ns4:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MOD-AUDIO</ns4:identificador>
<ns4:statusDoRegistro>CONTROLADO_RC3</ns4:statusDoRegistro>
</rdf:Description>
