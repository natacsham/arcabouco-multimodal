<ns4:temRecursoProposto rdf:resource="https://w3id.org/mado#REC-FEEDBACK-ACESSIVEL" />
<ns4:temTarefa rdf:resource="https://w3id.org/mado#TAR-ACESSAR-COMPREENDER-CONTEUDO-DIGITAL" />
<ns4:temTarefa rdf:resource="https://w3id.org/mado#TAR-ACESSAR-CONTEUDO-WEB-E80BA3E" />
<ns4:temTarefa rdf:resource="https://w3id.org/mado#TAR-ORGANIZAR-CONTEUDO-DIGITAL" />
<ns4:temTarefa rdf:resource="https://w3id.org/mado#TAR-REVISAR-E-CONFIRMAR" />
</rdf:Description>
<rdf:Description rdf:about="https://w3id.org/mado#CTX-ELICITACAO-01">
<rdf:type rdf:resource="https://w3id.org/mado#ContextoDeInteracaoDigital" />
<ns1:label xml:lang="pt-BR">CTX-ELICITACAO-01</ns1:label>
<ns4:apresentaBarreira rdf:resource="https://w3id.org/mado#BAR-CONTRIBUICAO-EXTENSA-SEM-SEQUENCIA" />
<ns4:apresentaNecessidade rdf:resource="https://w3id.org/mado#NEC-APOIAR-COMPREENSAO-TURMA" />
<ns4:apresentaNecessidade rdf:resource="https://w3id.org/mado#NEC-ORGANIZAR-DELIMITAR-PARTICIPACAO" />
<ns4:apresentaNecessidade rdf:resource="https://w3id.org/mado#NEC-PRESERVAR-PROTAGONISMO" />
<ns4:apresentaNecessidade rdf:resource="https://w3id.org/mado#NEC-RELACIONAR-OBJETIVO-CURRICULAR" />
<ns4:consideraCaracteristicaRelevanteDaPessoa rdf:resource="https://w3id.org/mado#CAR-INTERESSE-HISTORIA" />
<ns4:consideraCaracteristicaRelevanteDaPessoa rdf:resource="https://w3id.org/mado#CAR-SETIMO-ANO" />
<ns4:descricaoDoContexto xml:lang="pt-BR">Exemplo didático adaptado: um estudante tem interesse intenso e conhecimento aprofundado sobre um tema. Expressa suas ideias por fala, imagens e desenho. É necessário preservar sua autoria e organizar os momentos de participação com a professora e a turma. Este texto público não é a transcrição da entrevista.</ns4:descricaoDoContexto>
<ns4:descritoSobPerspectiva rdf:resource="https://w3id.org/mado#P02" />
<ns4:descritoSobPerspectiva rdf:resource="https://w3id.org/mado#P03" />
<ns4:envolveRecursoDigital rdf:resource="https://w3id.org/mado#RED-SEQUENCIA-MULTIMODAL-DIGITAL" />
<ns4:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CTX-ELICITACAO-01</ns4:identificador>
<ns4:informacaoAusente xml:lang="pt-BR">Forma de transição que o estudante e a professora consideram respeitosa e viável.</ns4:informacaoAusente>
<ns4:informacaoAusente xml:lang="pt-BR">Indicadores de compreensão e participação que a especialista considera adequados.</ns4:informacaoAusente>
<ns4:informacaoAusente xml:lang="pt-BR">Objetivo curricular e recorte temático exatos da nova atividade.</ns4:informacaoAusente>
<ns4:informacaoAusente xml:lang="pt-BR">Recursos digitais efetivamente disponíveis e condições de acessibilidade da turma.</ns4:informacaoAusente>
<ns4:informacaoAusente xml:lang="pt-BR">Tempo disponível e número adequado de blocos da explicação.</ns4:informacaoAusente>
<ns4:natureza>CENARIO_MISTO_HISTORICO_PRESERVADO</ns4:natureza>
<ns4:objetivo xml:lang="pt-BR">Transformar o conhecimento e o interesse do estudante em participação curricular compreensível e delimitada, relacionando sua contribuição a um objetivo de aprendizagem e envolvendo a turma.</ns4:objetivo>
<ns4:ocorreEmAmbiente rdf:resource="https://w3id.org/mado#AMB-SALA-DE-AULA" />
<ns4:restricao xml:lang="pt-BR">Não misturar este caso com relatos referentes a outros estudantes.</ns4:restricao>
<ns4:restricao xml:lang="pt-BR">Não presumir diagnóstico, equipamento, conexão, recurso digital disponível ou eficácia.</ns4:restricao>
<ns4:restricao xml:lang="pt-BR">Não transformar o interesse do estudante em prescrição rígida ou limitar seu protagonismo.</ns4:restricao>
<ns4:restricao xml:lang="pt-BR">Tratar a atividade digital como reconstrução proposta pela pesquisadora e não como prática originalmente relatada.</ns4:restricao>
<ns4:statusDoRegistro>ADAPTACAO_PUBLICA</ns4:statusDoRegistro>
<ns4:temModalidadeDisponivel rdf:resource="https://w3id.org/mado#MOD-FALA" />
<ns4:temModalidadeDisponivel rdf:resource="https://w3id.org/mado#MOD-IMAGEM" />
<ns4:temModalidadeDisponivel rdf:resource="https://w3id.org/mado#MOD-TEXTO" />
<ns4:temTarefa rdf:resource="https://w3id.org/mado#TAR-MICROEXPLICACAO-CURRICULAR" />
</rdf:Description>
