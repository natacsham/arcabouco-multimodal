<rdf:Description rdf:about="https://w3id.org/mado#CFG-RC4-01">
<rdf:type rdf:resource="https://w3id.org/mado#ConfiguracaoModalDaDecisao" />
<ns4:acompanhamentoDaConfiguracao xml:lang="pt-BR">Pedir a outro participante que retome a sequência e identifique a ideia central de cada bloco.</ns4:acompanhamentoDaConfiguracao>
<ns4:alternativaDaConfiguracao xml:lang="pt-BR">Usar cartões, quadro ou folha com a mesma sequência e digitalizar somente após a revisão.</ns4:alternativaDaConfiguracao>
<ns4:condicaoDaConfiguracao xml:lang="pt-BR">Confirmar objetivo e papéis antes de estruturar os blocos.</ns4:condicaoDaConfiguracao>
<ns4:configuraModalidade rdf:resource="https://w3id.org/mado#MOD-TEXTO" />
<ns4:configuraRecurso rdf:resource="https://w3id.org/mado#REC-EDITOR-MULTIMIDIA" />
<ns4:configuraRecurso rdf:resource="https://w3id.org/mado#REC-ROTEIRO-COLABORATIVO" />
<ns4:configuracaoAplicaCriterio rdf:resource="https://w3id.org/mado#CA02" />
