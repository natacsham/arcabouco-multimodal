  <rdf:Description rdf:about="https://w3id.org/mado#CA17">
    <rdf:type rdf:resource="https://w3id.org/mado#CriterioDeDecisaoMultimodal"/>
    <rdfs:label xml:lang="pt-BR">Vídeos com áudio devem oferecer legendas sincronizadas.</rdfs:label>
    <mado:criterioAplicavelABarreira rdf:resource="https://w3id.org/mado#BAR-CONTEUDO-AUDIOVISUAL-OU-VISUAL-SEM-ALTERNATIVA-7F52587"/>
    <mado:criterioAplicavelAModalidade rdf:resource="https://w3id.org/mado#MOD-VIDEO"/>
    <mado:criterioAplicavelARecurso rdf:resource="https://w3id.org/mado#RED-VIDEO-CURTO-HISTORIA"/>
    <mado:criterioAplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-CONSTRUIR-RECURSO-DIGITAL-HISTORIA"/>
    <mado:criterioAplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-CONSUMIR-MIDIA-MATERIAL-A2D1D3F"/>
    <mado:criterioAplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-EXPLICAR-CONTEUDO-HISTORIA"/>
    <mado:criterioAplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-REVISAR-PUBLICAR-RECURSO"/>
    <mado:enunciado xml:lang="pt-BR">Vídeos com áudio devem oferecer legendas sincronizadas.</mado:enunciado>
    <mado:funcaoDecisoria xml:lang="pt-BR">introduzir ou confirmar uma relação que fala e imagem estática não expressem adequadamente</mado:funcaoDecisoria>
    <mado:funcaoDecisoria xml:lang="pt-BR">preservar conteúdo audiovisual por modalidades equivalentes</mado:funcaoDecisoria>
    <mado:fundamentadoPor rdf:resource="https://w3id.org/mado#K10"/>
    <mado:fundamentadoPor rdf:resource="https://w3id.org/mado#K17"/>
    <mado:fundamentadoPor rdf:resource="https://w3id.org/mado#K19"/>
    <mado:fundamentadoPor rdf:resource="https://w3id.org/mado#K26"/>
    <mado:fundamentadoPor rdf:resource="https://w3id.org/mado#K29"/>
    <mado:fundamentadoPor rdf:resource="https://w3id.org/mado#K31"/>
    <mado:fundamentadoPor rdf:resource="https://w3id.org/mado#K34"/>
    <mado:fundamentadoPor rdf:resource="https://w3id.org/mado#K36"/>
    <mado:fundamentadoPor rdf:resource="https://w3id.org/mado#K38"/>
    <mado:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CA17</mado:identificador>
    <mado:justificativaDeFundamentacao xml:lang="pt-BR">Em versão anterior, a ligação foi reconstruída analiticamente porque o critério participa de uma configuração modalidade–função–recurso–responsável fundamentada por esses conhecimentos; não se atribui essa formalização retrospectiva às publicações originais. Na RC2, a ligação ao conhecimento articulado foi conferida para o cenário de transferência e permanece limitada às condições registradas.</mado:justificativaDeFundamentacao>
    <mado:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0148"/>
    <mado:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0149"/>
    <mado:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0150"/>
    <mado:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0151"/>
    <mado:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0152"/>
    <mado:statusDaRelacao>JUSTIFICATIVA_DOCUMENTADA</mado:statusDaRelacao>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mado#K43">
    <rdf:type rdf:resource="https://w3id.org/mado#ConhecimentoMultimodalArticulado"/>
    <rdfs:label xml:lang="pt-BR">Combinar mais modalidades não é suficiente: os modos devem ter papéis distintos, ordem compreensível e controle para evitar competição, sobrecarga e perda de continuidade.</rdfs:label>
    <mado:aplicavelABarreira rdf:resource="https://w3id.org/mado#BAR-CONTEUDO-SEM-ESTRUTURA-PERSISTENTE"/>
    <mado:aplicavelABarreira rdf:resource="https://w3id.org/mado#BAR-FORMATOS-COMPETEM-PELA-ATENCAO"/>
    <mado:aplicavelACaracteristicaRelevanteDaPessoa rdf:resource="https://w3id.org/mado#CAR-NECESSITA-ESTRUTURA-TRANSICAO"/>
    <mado:aplicavelANecessidade rdf:resource="https://w3id.org/mado#NEC-FUNCAO-EXPLICITA-POR-MODALIDADE"/>
    <mado:aplicavelANecessidade rdf:resource="https://w3id.org/mado#NEC-REVISAO-E-CONFIRMACAO"/>
    <mado:aplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-ORGANIZAR-CONTEUDO-DIGITAL"/>
    <mado:aplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-PRODUZIR-CONTEUDO-MULTIMODAL"/>
    <mado:articulacao xml:lang="pt-BR">Resultados das personas e dos estudos educacionais mostram que disponibilidade de formatos pode coexistir com confusão; a contextualização funcional e a validação das personas exigem tarefa, tecnologia assistiva e critérios explícitos.</mado:articulacao>
    <mado:articuladoSobPerspectiva rdf:resource="https://w3id.org/mado#P02"/>
    <mado:classificacaoOperacional>OPERACIONALIZAVEL</mado:classificacaoOperacional>
    <mado:contribuiParaFuncaoDecisoria rdf:resource="https://w3id.org/mado#FUN-ORGANIZAR-CONTEUDO"/>
    <mado:contribuiParaFuncaoDecisoria rdf:resource="https://w3id.org/mado#FUN-PERMITIR-REVISAO"/>
    <mado:contribuiParaFuncaoDecisoria rdf:resource="https://w3id.org/mado#FUN-REDUZIR-SOBRECARGA"/>
    <mado:derivadoDe rdf:resource="https://w3id.org/mado#F06"/>
    <mado:derivadoDe rdf:resource="https://w3id.org/mado#F07"/>
    <mado:derivadoDe rdf:resource="https://w3id.org/mado#F08"/>
    <mado:enunciado xml:lang="pt-BR">Combinar mais modalidades não é suficiente: os modos devem ter papéis distintos, ordem compreensível e controle para evitar competição, sobrecarga e perda de continuidade.</mado:enunciado>
    <mado:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">K43</mado:identificador>
    <mado:limite xml:lang="pt-BR">A organização reduz uma barreira possível, mas não demonstra resultado pedagógico sem observação da tarefa.</mado:limite>
    <mado:natureza>RECONSTRUCAO_ANALITICA_RASTREAVEL</mado:natureza>
    <mado:origemDaEstruturacaoSemantica xml:lang="pt-BR">Relação reconstruída pela autora entre trechos do corpus, condições funcionais, tarefa e função decisória; não é atribuída como formulação original às publicações.</mado:origemDaEstruturacaoSemantica>
    <mado:restricao xml:lang="pt-BR">BAR-CONTEUDO-SEM-ESTRUTURA-PERSISTENTE</mado:restricao>
    <mado:restricao xml:lang="pt-BR">BAR-FORMATOS-COMPETEM-PELA-ATENCAO</mado:restricao>
    <mado:restricao xml:lang="pt-BR">CAR-NECESSITA-ESTRUTURA-TRANSICAO</mado:restricao>
    <mado:restricao xml:lang="pt-BR">NEC-FUNCAO-EXPLICITA-POR-MODALIDADE</mado:restricao>
    <mado:restricao xml:lang="pt-BR">NEC-REVISAO-E-CONFIRMACAO</mado:restricao>
    <mado:restricao xml:lang="pt-BR">TAR-ORGANIZAR-CONTEUDO-DIGITAL</mado:restricao>
    <mado:restricao xml:lang="pt-BR">TAR-PRODUZIR-CONTEUDO-MULTIMODAL</mado:restricao>
    <mado:statusDaRelacao>PRODUTO_DE_ARTICULACAO_RC3</mado:statusDaRelacao>
    <mado:sustentadoPorTrecho rdf:resource="https://w3id.org/mado#TD-EV34"/>
    <mado:sustentadoPorTrecho rdf:resource="https://w3id.org/mado#TD-EV36"/>
    <mado:sustentadoPorTrecho rdf:resource="https://w3id.org/mado#TD-RC3-REF-09"/>
    <mado:sustentadoPorTrecho rdf:resource="https://w3id.org/mado#TD-RC3-REF-10"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mado#operacaoDoRecurso">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/mado#ContextoDeInteracaoDigital"/>
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mado#K31">
    <rdf:type rdf:resource="https://w3id.org/mado#ConhecimentoMultimodalArticulado"/>
    <rdfs:label xml:lang="pt-BR">Um recurso digital ou multimodal favorece o engajamento quando sua função está ligada ao interesse da pessoa, à faixa etária e ao objetivo de aprendizagem, e não apenas à disponibilidade ou novidade da tecnologia.</rdfs:label>
    <mado:aplicavelAAmbiente rdf:resource="https://w3id.org/mado#AMB-AUDITORIO"/>
    <mado:aplicavelAAmbiente rdf:resource="https://w3id.org/mado#AMB-LABORATORIO-INFORMATICA"/>
    <mado:aplicavelACaracteristicaRelevanteDaPessoa rdf:resource="https://w3id.org/mado#CAR-CONHECIMENTO-PREVIO-HISTORIA"/>
    <mado:aplicavelACaracteristicaRelevanteDaPessoa rdf:resource="https://w3id.org/mado#CAR-ENSINO-FUNDAMENTAL-II"/>
    <mado:aplicavelACaracteristicaRelevanteDaPessoa rdf:resource="https://w3id.org/mado#CAR-INTERESSE-GEOGRAFIA-MAPAS"/>
    <mado:aplicavelACaracteristicaRelevanteDaPessoa rdf:resource="https://w3id.org/mado#CAR-INTERESSE-HISTORIA"/>
    <mado:aplicavelACaracteristicaRelevanteDaPessoa rdf:resource="https://w3id.org/mado#CAR-SETIMO-ANO"/>
    <mado:aplicavelARecursoDigital rdf:resource="https://w3id.org/mado#RED-MAPA-DIGITAL"/>
    <mado:aplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-COMUNICAR-CONTEUDO-1545B38"/>
    <mado:aplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-MICROEXPLICACAO-CURRICULAR"/>
    <mado:articulacao xml:lang="pt-BR">A especialista relaciona significado, prazer e adequação à idade com aprendizagem e engajamento; no caso do estudante do sétimo ano, o forte interesse por História foi convertido em espaço de expressão e participação. A articulação une o raciocínio profissional geral ao caso concreto.</mado:articulacao>
    <mado:articuladoSobPerspectiva rdf:resource="https://w3id.org/mado#P03"/>
    <mado:classificacaoOperacional>OPERACIONALIZAVEL</mado:classificacaoOperacional>
    <mado:contribuiParaFuncaoDecisoria rdf:resource="https://w3id.org/mado#FUN-EXPRESSAR-CONHECIMENTO"/>
    <mado:contribuiParaFuncaoDecisoria rdf:resource="https://w3id.org/mado#FUN-PRESERVAR-PROTAGONISMO"/>
    <mado:derivadoDe rdf:resource="https://w3id.org/mado#F12"/>
    <mado:enunciado xml:lang="pt-BR">Um recurso digital ou multimodal favorece o engajamento quando sua função está ligada ao interesse da pessoa, à faixa etária e ao objetivo de aprendizagem, e não apenas à disponibilidade ou novidade da tecnologia.</mado:enunciado>
    <mado:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">K31</mado:identificador>
    <mado:limite xml:lang="pt-BR">Não permite inferir que um tema de interesse produzirá engajamento em qualquer tarefa; depende de objetivo, forma de participação e acompanhamento.</mado:limite>
    <mado:natureza>CONHECIMENTO_ARTICULADO_A_PARTIR_DA_ELICITACAO</mado:natureza>
    <mado:origemDaEstruturacaoSemantica xml:lang="pt-BR">Relações derivadas de contextos e decisões documentados; complementações RC3 foram estabelecidas somente quando o enunciado, a articulação e os trechos sustentavam a aplicabilidade.</mado:origemDaEstruturacaoSemantica>
    <mado:restricao xml:lang="pt-BR">conteúdo educacional</mado:restricao>
    <mado:restricao xml:lang="pt-BR">engajamento</mado:restricao>
    <mado:restricao xml:lang="pt-BR">estudante do sétimo ano</mado:restricao>
    <mado:restricao xml:lang="pt-BR">faixa etária</mado:restricao>
    <mado:restricao xml:lang="pt-BR">interesse da pessoa</mado:restricao>
    <mado:restricao xml:lang="pt-BR">objetivo de aprendizagem</mado:restricao>
    <mado:restricao xml:lang="pt-BR">recurso digital</mado:restricao>
    <mado:statusDaRelacao>APOIO_ELICITADO_A_CARACTERIZACAO_NAO_FUNDAMENTO_INDEPENDENTE</mado:statusDaRelacao>
    <mado:sustentadoPorTrecho rdf:resource="https://w3id.org/mado#TD-EL02"/>
    <mado:sustentadoPorTrecho rdf:resource="https://w3id.org/mado#TD-EL04"/>
    <mado:sustentadoPorTrecho rdf:resource="https://w3id.org/mado#TD-EL05"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mado#CA08">
    <rdf:type rdf:resource="https://w3id.org/mado#CriterioDeDecisaoMultimodal"/>
    <rdfs:label xml:lang="pt-BR">Instruções não devem depender apenas de características sensoriais (forma, cor, tamanho, posição, orientação ou som).</rdfs:label>
    <mado:enunciado xml:lang="pt-BR">Instruções não devem depender apenas de características sensoriais (forma, cor, tamanho, posição, orientação ou som).</mado:enunciado>
    <mado:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CA08</mado:identificador>
    <mado:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0110"/>
    <mado:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0111"/>
    <mado:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0112"/>
