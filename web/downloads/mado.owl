  <rdf:Description rdf:about="https://w3id.org/mado#K45">
    <rdf:type rdf:resource="https://w3id.org/mado#ConhecimentoMultimodalArticulado"/>
    <rdfs:label xml:lang="pt-BR">Interesse e conhecimento aprofundado podem sustentar autoria e engajamento quando são ligados a uma tarefa com objetivo explícito, papéis negociados, transições previsíveis e possibilidade de revisão.</rdfs:label>
    <mado:aplicavelACaracteristicaRelevanteDaPessoa rdf:resource="https://w3id.org/mado#CAR-EXPRESSAO-ORAL-AUTORAL"/>
