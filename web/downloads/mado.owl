<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0007" />
<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0008" />
<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0009" />
<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0010" />
<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0011" />
<ns4:statusDaRelacao>JUSTIFICATIVA_DOCUMENTADA</ns4:statusDaRelacao>
</rdf:Description>
