    <mado:articulacaoAcrescentaFuncao rdf:resource="https://w3id.org/mado#FUN-MANTER-INFORMACAO-RECUPERAVEL"/>
    <mado:articulacaoDerivadaDe rdf:resource="https://w3id.org/mado#F01"/>
    <mado:articulacaoDerivadaDe rdf:resource="https://w3id.org/mado#FN-ABNT-MOBILE"/>
