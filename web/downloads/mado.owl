  <rdf:Description rdf:about="https://w3id.org/mado#K33">
    <rdf:type rdf:resource="https://w3id.org/mado#ConhecimentoMultimodalArticulado"/>
    <rdfs:label xml:lang="pt-BR">Uma decisão útil à especialista deve explicitar orientação principal, motivos, alternativas, condições, limitações, histórico de aplicação e informações ausentes, admitindo suspender a decisão quando não houver sustentação suficiente.</rdfs:label>
    <mado:articulacao xml:lang="pt-BR">As respostas sobre confiança, utilidade, apresentação e ausência de informações convergem para uma saída curta, explicável e adaptável. Isso não cria uma classe Recomendação; define requisitos de expressão e rastreabilidade da Decisão.</mado:articulacao>
    <mado:articuladoSobPerspectiva rdf:resource="https://w3id.org/mado#P03"/>
    <mado:classificacaoOperacional>REQUISITO_DE_EXPRESSAO</mado:classificacaoOperacional>
    <mado:contribuiParaFuncaoDecisoria rdf:resource="https://w3id.org/mado#FUN-ACOMPANHAR-RESULTADO"/>
    <mado:derivadoDe rdf:resource="https://w3id.org/mado#F11"/>
    <mado:enunciado xml:lang="pt-BR">Uma decisão útil à especialista deve explicitar orientação principal, motivos, alternativas, condições, limitações, histórico de aplicação e informações ausentes, admitindo suspender a decisão quando não houver sustentação suficiente.</mado:enunciado>
    <mado:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">K33</mado:identificador>
    <mado:limite xml:lang="pt-BR">Define expectativas da especialista; a utilidade da decisão produzida ainda depende da validação no segundo encontro.</mado:limite>
    <mado:natureza>CONHECIMENTO_ARTICULADO_A_PARTIR_DA_ELICITACAO</mado:natureza>
    <mado:origemDaEstruturacaoSemantica xml:lang="pt-BR">Relações derivadas de contextos e decisões documentados; complementações RC3 foram estabelecidas somente quando o enunciado, a articulação e os trechos sustentavam a aplicabilidade.</mado:origemDaEstruturacaoSemantica>
    <mado:restricao xml:lang="pt-BR">alternativas</mado:restricao>
    <mado:restricao xml:lang="pt-BR">decisão explicável</mado:restricao>
    <mado:restricao xml:lang="pt-BR">histórico de aplicação</mado:restricao>
    <mado:restricao xml:lang="pt-BR">informações ausentes</mado:restricao>
    <mado:restricao xml:lang="pt-BR">limitações</mado:restricao>
    <mado:restricao xml:lang="pt-BR">objetividade</mado:restricao>
    <mado:statusDaRelacao>REQUISITO_ELICITADO_DE_EXPRESSAO</mado:statusDaRelacao>
    <mado:sustentadoPorTrecho rdf:resource="https://w3id.org/mado#TD-EL07"/>
    <mado:sustentadoPorTrecho rdf:resource="https://w3id.org/mado#TD-EL08"/>
    <mado:sustentadoPorTrecho rdf:resource="https://w3id.org/mado#TD-EL09"/>
    <mado:sustentadoPorTrecho rdf:resource="https://w3id.org/mado#TD-EL10"/>
  </rdf:Description>
