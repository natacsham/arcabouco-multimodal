<rdf:Description rdf:about="https://w3id.org/mado#CA84">
<rdf:type rdf:resource="https://w3id.org/mado#CriterioDeDecisaoMultimodal" />
<ns1:label xml:lang="pt-BR">Ajuda relevante ao contexto da tarefa atual deve estar disponível para o usuário.</ns1:label>
<ns4:criterioAplicavelAModalidade rdf:resource="https://w3id.org/mado#MOD-DESENHO" />
<ns4:criterioAplicavelAModalidade rdf:resource="https://w3id.org/mado#MOD-FALA" />
<ns4:criterioAplicavelAModalidade rdf:resource="https://w3id.org/mado#MOD-IMAGEM" />
<ns4:criterioAplicavelAModalidade rdf:resource="https://w3id.org/mado#MOD-JOGO-INTERATIVO" />
<ns4:criterioAplicavelAModalidade rdf:resource="https://w3id.org/mado#MOD-TEXTO" />
<ns4:criterioAplicavelARecurso rdf:resource="https://w3id.org/mado#REC-COMPUTADOR-DATASHOW" />
<ns4:criterioAplicavelARecurso rdf:resource="https://w3id.org/mado#REC-DESENHO-QUADRO-PAPEL" />
<ns4:criterioAplicavelARecurso rdf:resource="https://w3id.org/mado#REC-PALAVRAS-CHAVE-LINHA-DO-TEMPO" />
<ns4:criterioAplicavelARecurso rdf:resource="https://w3id.org/mado#RED-JOGO-HISTORIA" />
<ns4:criterioAplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-COMUNICAR-CONTEUDO-1545B38" />
<ns4:criterioAplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-CONSTRUIR-RECURSO-DIGITAL-HISTORIA" />
<ns4:criterioAplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-EXPLICAR-CONTEUDO-HISTORIA" />
<ns4:criterioAplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-MICROEXPLICACAO-CURRICULAR" />
<ns4:criterioAplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-ORGANIZAR-PARTICIPACAO-MULTIMODAL" />
<ns4:criterioAplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-REVISAR-PUBLICAR-RECURSO" />
<ns4:enunciado xml:lang="pt-BR">Ajuda relevante ao contexto da tarefa atual deve estar disponível para o usuário.</ns4:enunciado>
<ns4:funcaoDecisoria xml:lang="pt-BR">ancorar relações cronológicas ou conceituais mencionadas na fala</ns4:funcaoDecisoria>
<ns4:funcaoDecisoria xml:lang="pt-BR">expressar o conhecimento prévio e relacioná-lo ao objetivo curricular</ns4:funcaoDecisoria>
<ns4:funcaoDecisoria xml:lang="pt-BR">externalizar relações e apoiar a preparação ou continuidade da explicação</ns4:funcaoDecisoria>
<ns4:funcaoDecisoria xml:lang="pt-BR">marcar a sequência, o objetivo e as transições sem substituir a explicação</ns4:funcaoDecisoria>
<ns4:funcaoDecisoria xml:lang="pt-BR">mobilizar o interesse para uma tarefa curricular verificável</ns4:funcaoDecisoria>
<ns4:funcaoDecisoria xml:lang="pt-BR">orientar sequência, objetivo e transições sem substituir a fala</ns4:funcaoDecisoria>
<ns4:funcaoDecisoria xml:lang="pt-BR">representar relações espaciais, cronológicas ou conceituais</ns4:funcaoDecisoria>
<ns4:fundamentadoPor rdf:resource="https://w3id.org/mado#K07" />
<ns4:fundamentadoPor rdf:resource="https://w3id.org/mado#K10" />
<ns4:fundamentadoPor rdf:resource="https://w3id.org/mado#K17" />
<ns4:fundamentadoPor rdf:resource="https://w3id.org/mado#K19" />
<ns4:fundamentadoPor rdf:resource="https://w3id.org/mado#K27" />
<ns4:fundamentadoPor rdf:resource="https://w3id.org/mado#K30" />
<ns4:fundamentadoPor rdf:resource="https://w3id.org/mado#K31" />
<ns4:fundamentadoPor rdf:resource="https://w3id.org/mado#K32" />
<ns4:fundamentadoPor rdf:resource="https://w3id.org/mado#K33" />
<ns4:fundamentadoPor rdf:resource="https://w3id.org/mado#K34" />
<ns4:fundamentadoPor rdf:resource="https://w3id.org/mado#K35" />
<ns4:fundamentadoPor rdf:resource="https://w3id.org/mado#K37" />
<ns4:fundamentadoPor rdf:resource="https://w3id.org/mado#K38" />
<ns4:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CA84</ns4:identificador>
<ns4:justificativaDeFundamentacao xml:lang="pt-BR">Oferecer ajuda vinculada à tarefa e ao contexto corrente. Em versão anterior, a ligação foi reconstruída analiticamente porque o critério participa de uma configuração modalidade–função–recurso–responsável fundamentada por esses conhecimentos; não se atribui essa formalização retrospectiva às publicações originais. Na RC2, a ligação ao conhecimento articulado foi conferida para o cenário de transferência e permanece limitada às condições registradas.</ns4:justificativaDeFundamentacao>
<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0398" />
<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0399" />
<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0400" />
<ns4:statusDaRelacao>RELACAO_SEM_JUSTIFICATIVA_EXPLICITA</ns4:statusDaRelacao>
</rdf:Description>
<rdf:Description rdf:about="https://w3id.org/mado#CA85">
<rdf:type rdf:resource="https://w3id.org/mado#CriterioDeDecisaoMultimodal" />
<ns1:label xml:lang="pt-BR">Informações que já foram fornecidas pelo usuário em um mesmo processo devem ser preenchidas automaticamente ou oferecidas para seleção, evitando a redigitação.</ns1:label>
<ns4:enunciado xml:lang="pt-BR">Informações que já foram fornecidas pelo usuário em um mesmo processo devem ser preenchidas automaticamente ou oferecidas para seleção, evitando a redigitação.</ns4:enunciado>
<ns4:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CA85</ns4:identificador>
