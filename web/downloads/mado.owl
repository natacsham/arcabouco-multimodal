<ns4:temParticipacao rdf:resource="https://w3id.org/mado#PART-CTX-DEMO-WEB-LEITOR-TELA-PESSOA" />
<ns4:temRecursoDisponivel rdf:resource="https://w3id.org/mado#REC-COMPUTADOR" />
<ns4:temRecursoDisponivel rdf:resource="https://w3id.org/mado#REC-EDITOR-MULTIMIDIA" />
<ns4:temRecursoDisponivel rdf:resource="https://w3id.org/mado#REC-LEITOR-DE-TELA" />
<ns4:temRecursoDisponivel rdf:resource="https://w3id.org/mado#REC-SAIDA-AUDIO" />
<ns4:temRecursoDisponivel rdf:resource="https://w3id.org/mado#REC-TECLADO" />
