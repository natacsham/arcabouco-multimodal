  <rdf:Description rdf:about="https://w3id.org/mado#D13">
    <rdf:type rdf:resource="https://w3id.org/mado#DecisaoDeAcessibilidadeMultimodal"/>
    <rdfs:label xml:lang="pt-BR">Para que mídias educacionais não dependam de um único canal, disponibilizar alternativas de percepção adequadas ao conteúdo, como legendas, audiodescrição e descrições/etiquetas sonoras.</rdfs:label>
    <mado:aplicaCriterio rdf:resource="https://w3id.org/mado#CA01"/>
    <mado:aplicaCriterio rdf:resource="https://w3id.org/mado#CA05"/>
    <mado:aplicaCriterio rdf:resource="https://w3id.org/mado#CA17"/>
    <mado:aplicaCriterio rdf:resource="https://w3id.org/mado#CA88"/>
    <mado:condicaoDeAplicacao xml:lang="pt-BR">Cada mídia alternativa também precisa ser acessível</mado:condicaoDeAplicacao>
    <mado:enunciado xml:lang="pt-BR">Para que mídias educacionais não dependam de um único canal, disponibilizar alternativas de percepção adequadas ao conteúdo, como legendas, audiodescrição e descrições/etiquetas sonoras.</mado:enunciado>
    <mado:expressaoOperacional xml:lang="pt-BR">Para mídias educacionais, oferecer alternativas perceptivas adequadas ao conteúdo, como legendas, audiodescrição e descrições de materiais, conforme as barreiras e critérios aplicáveis.</mado:expressaoOperacional>
    <mado:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D13</mado:identificador>
    <mado:natureza>RECONSTRUÇÃO ANALÍTICA FORTEMENTE SUSTENTADA</mado:natureza>
    <mado:rationale xml:lang="pt-BR">Por quê: mídia inacessível aparece entre as barreiras do cenário. Para quê: manter acesso à informação audiovisual. Como: o redesign associa recursos alternativos a critérios específicos e a diferentes perfis perceptivos.</mado:rationale>
    <mado:respondeA rdf:resource="https://w3id.org/mado#CTX-D13"/>
    <mado:statusDecisao>DECISAO_HISTORICA_RECONSTRUIDA</mado:statusDecisao>
    <mado:statusDoRegistro>DECISAO_HISTORICA_RECONSTRUIDA</mado:statusDoRegistro>
    <mado:sustentadaPor rdf:resource="https://w3id.org/mado#K26"/>
  </rdf:Description>
