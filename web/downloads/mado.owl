    <mado:configuracaoConsideraCondicao rdf:resource="https://w3id.org/mado#NEC-REVISAO-E-CONFIRMACAO"/>
    <mado:configuracaoDeDecisao rdf:resource="https://w3id.org/mado#D-TESTE-RC4-TRANSFERENCIA"/>
    <mado:configuracaoMobilizaArticulacao rdf:resource="https://w3id.org/mado#ART-REF-01"/>
    <mado:configuracaoMobilizaArticulacao rdf:resource="https://w3id.org/mado#ART-REF-03"/>
    <mado:configuracaoMobilizaArticulacao rdf:resource="https://w3id.org/mado#ART-REF-04"/>
