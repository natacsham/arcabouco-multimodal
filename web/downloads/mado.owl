    <mado:configuracaoUsaOrigemDoCriterio rdf:resource="https://w3id.org/mado#ORI-0150"/>
    <mado:configuracaoUsaOrigemDoCriterio rdf:resource="https://w3id.org/mado#ORI-0414"/>
    <mado:configuracaoUsaOrigemDoCriterio rdf:resource="https://w3id.org/mado#ORI-0415"/>
    <mado:configuracaoUsaOrigemDoCriterio rdf:resource="https://w3id.org/mado#ORI-0416"/>
    <mado:cumpreFuncaoDecisoria rdf:resource="https://w3id.org/mado#FUN-CONTEXTUALIZAR-MUDANCA"/>
    <mado:cumpreFuncaoDecisoria rdf:resource="https://w3id.org/mado#FUN-PRESERVAR-SIGNIFICADO-ENTRE-MODOS"/>
    <mado:estadoDeDisponibilidadeDaConfiguracao>CONDICIONAL_A_CONFIRMACAO</mado:estadoDeDisponibilidadeDaConfiguracao>
    <mado:executadaPorPapel rdf:resource="https://w3id.org/mado#PAPEL-PROFESSORA"/>
    <mado:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CFG-RC4-04</mado:identificador>
    <mado:limiteDaConfiguracao xml:lang="pt-BR">Se o vídeo repetir o conteúdo, competir pela atenção ou não tiver alternativas, ele deve ser retirado.</mado:limiteDaConfiguracao>
    <mado:origemDoRegistro>CONFIGURACAO_MATURA_RC4</mado:origemDoRegistro>
    <mado:significadoFuncional xml:lang="pt-BR">Movimento ou contraste temporal precisa ser mostrado sem tornar o vídeo a única fonte.</mado:significadoFuncional>
    <mado:temAcaoOperacional xml:lang="pt-BR">usar um trecho curto de vídeo somente para a relação previamente escolhida, com pausa para explicação, legendas, descrição do conteúdo visual e retomada em texto ou fala</mado:temAcaoOperacional>
    <mado:temFuncaoModal xml:lang="pt-BR">mostrar uma mudança, processo ou contraste difícil de expressar apenas por fala e imagem estática</mado:temFuncaoModal>
    <mado:temPapelModal rdf:resource="https://w3id.org/mado#PAPEL-COMPLEMENTAR"/>
