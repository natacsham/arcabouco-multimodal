  <rdf:Description rdf:about="https://w3id.org/mado#K24">
    <rdf:type rdf:resource="https://w3id.org/mado#ConhecimentoMultimodalArticulado"/>
    <rdfs:label xml:lang="pt-BR">Critérios técnicos tornam-se mais úteis para decisões de acessibilidade quando são relacionados a persona/perfil, tecnologias assistivas, objetivos, tarefas e requisitos funcionais concretos do sistema.</rdfs:label>
    <mado:aplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-COMUNICAR-CONTEUDO-1545B38"/>
    <mado:aplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-EXECUTAR-TAREFAS-NO-AVA-7BEF3BD"/>
    <mado:articulacao xml:lang="pt-BR">A validação das personas identificou falta de tecnologias assistivas, cenários de AVA, ligação com os 88 critérios e objetivos de aprendizagem. Esses achados foram usados no refinamento humano de Camila e na criação de um cenário ligado aos requisitos RF01–RF05 do SIGAA, antes do redesign.</mado:articulacao>
    <mado:articuladoSobPerspectiva rdf:resource="https://w3id.org/mado#P02"/>
    <mado:classificacaoOperacional>OPERACIONALIZAVEL</mado:classificacaoOperacional>
    <mado:contribuiParaFuncaoDecisoria rdf:resource="https://w3id.org/mado#FUN-CARACTERIZAR-CONDICOES"/>
    <mado:derivadoDe rdf:resource="https://w3id.org/mado#F08"/>
    <mado:enunciado xml:lang="pt-BR">Critérios técnicos tornam-se mais úteis para decisões de acessibilidade quando são relacionados a persona/perfil, tecnologias assistivas, objetivos, tarefas e requisitos funcionais concretos do sistema.</mado:enunciado>
    <mado:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">K24</mado:identificador>
    <mado:natureza>RECONSTRUÇÃO ANALÍTICA FORTEMENTE SUSTENTADA</mado:natureza>
    <mado:origemDaEstruturacaoSemantica xml:lang="pt-BR">Relações derivadas de contextos e decisões documentados; complementações RC3 foram estabelecidas somente quando o enunciado, a articulação e os trechos sustentavam a aplicabilidade.</mado:origemDaEstruturacaoSemantica>
    <mado:restricao xml:lang="pt-BR">Persona</mado:restricao>
    <mado:restricao xml:lang="pt-BR">RF01–RF05</mado:restricao>
    <mado:restricao xml:lang="pt-BR">SIGAA</mado:restricao>
    <mado:restricao xml:lang="pt-BR">critérios</mado:restricao>
    <mado:restricao xml:lang="pt-BR">objetivos</mado:restricao>
    <mado:restricao xml:lang="pt-BR">tarefas</mado:restricao>
    <mado:restricao xml:lang="pt-BR">tecnologias assistivas</mado:restricao>
    <mado:statusDaRelacao>CONHECIMENTO_CANDIDATO_RC2</mado:statusDaRelacao>
    <mado:sustentadoPorTrecho rdf:resource="https://w3id.org/mado#TD-EV40"/>
    <mado:sustentadoPorTrecho rdf:resource="https://w3id.org/mado#TD-EV41"/>
    <mado:sustentadoPorTrecho rdf:resource="https://w3id.org/mado#TD-EV42"/>
  </rdf:Description>
