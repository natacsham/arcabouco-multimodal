  <rdf:Description rdf:about="https://w3id.org/mado#K05">
    <rdf:type rdf:resource="https://w3id.org/mado#ConhecimentoMultimodalArticulado"/>
    <rdfs:label xml:lang="pt-BR">Quando diferentes fontes de feedback operam simultaneamente, a acessibilidade depende da coordenação e da prioridade entre mensagens para evitar sobreposição e perda de significado.</rdfs:label>
    <mado:aplicavelAAmbiente rdf:resource="https://w3id.org/mado#AMB-USO-CONJUNTO-DE-APP-TALKBACK-4E44DB8"/>
    <mado:aplicavelABarreira rdf:resource="https://w3id.org/mado#BAR-MENSAGENS-CONCORRENTES-472A703"/>
    <mado:aplicavelACaracteristicaRelevanteDaPessoa rdf:resource="https://w3id.org/mado#CAR-INTERACAO-NAO-VISUAL"/>
    <mado:aplicavelACaracteristicaRelevanteDaPessoa rdf:resource="https://w3id.org/mado#CAR-USA-LEITOR-TELA"/>
    <mado:aplicavelARecursoDisponivel rdf:resource="https://w3id.org/mado#REC-COORDENACAO-TEMPORAL-DE-SAIDAS-AUDITIVAS-DD53EA8"/>
    <mado:aplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-REGISTRAR-INFORMACAO-E898AEA"/>
    <mado:articulacao xml:lang="pt-BR">No registro de informação georreferenciada, o sistema podia emitir simultaneamente confirmação, orientação e mensagens do TalkBack porque não havia priorização. A evidência transforma um problema de implementação em conhecimento sobre coordenação temporal de saídas multimodais.</mado:articulacao>
    <mado:articuladoSobPerspectiva rdf:resource="https://w3id.org/mado#P02"/>
    <mado:classificacaoOperacional>OPERACIONALIZAVEL</mado:classificacaoOperacional>
    <mado:derivadoDe rdf:resource="https://w3id.org/mado#F01"/>
    <mado:enunciado xml:lang="pt-BR">Quando diferentes fontes de feedback operam simultaneamente, a acessibilidade depende da coordenação e da prioridade entre mensagens para evitar sobreposição e perda de significado.</mado:enunciado>
    <mado:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">K05</mado:identificador>
    <mado:natureza>RECONSTRUÇÃO ANALÍTICA FORTEMENTE SUSTENTADA</mado:natureza>
    <mado:origemDaEstruturacaoSemantica xml:lang="pt-BR">Relações derivadas de contextos e decisões documentados; complementações RC3 foram estabelecidas somente quando o enunciado, a articulação e os trechos sustentavam a aplicabilidade.</mado:origemDaEstruturacaoSemantica>
    <mado:restricao xml:lang="pt-BR">Notificações</mado:restricao>
    <mado:restricao xml:lang="pt-BR">TalkBack</mado:restricao>
    <mado:restricao xml:lang="pt-BR">confirmação</mado:restricao>
    <mado:restricao xml:lang="pt-BR">orientação</mado:restricao>
    <mado:restricao xml:lang="pt-BR">prioridade temporal</mado:restricao>
    <mado:statusDaRelacao>CONHECIMENTO_CANDIDATO</mado:statusDaRelacao>
    <mado:sustentadoPorTrecho rdf:resource="https://w3id.org/mado#TD-EV32"/>
  </rdf:Description>
