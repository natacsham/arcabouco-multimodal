  <rdf:Description rdf:about="https://w3id.org/mado#D03">
    <rdf:type rdf:resource="https://w3id.org/mado#DecisaoDeAcessibilidadeMultimodal"/>
    <rdfs:label xml:lang="pt-BR">Para reduzir a dependência de digitação ou seleção convencional em tarefas móveis críticas, oferecer entrada por voz como alternativa quando pertinente.</rdfs:label>
    <mado:condicaoDeAplicacao xml:lang="pt-BR">Não foi comparada experimentalmente com outras entradas</mado:condicaoDeAplicacao>
    <mado:enunciado xml:lang="pt-BR">Para reduzir a dependência de digitação ou seleção convencional em tarefas móveis críticas, oferecer entrada por voz como alternativa quando pertinente.</mado:enunciado>
    <mado:expressaoOperacional xml:lang="pt-BR">Oferecer entrada por voz como alternativa à digitação ou seleção convencional quando essas formas dificultarem a tarefa móvel.</mado:expressaoOperacional>
    <mado:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D03</mado:identificador>
    <mado:limite xml:lang="pt-BR">Decisão reconstruída a partir de proposta pós-avaliação; não houve teste comparativo da voz.</mado:limite>
    <mado:natureza>RECONSTRUÇÃO ANALÍTICA FORTEMENTE SUSTENTADA</mado:natureza>
    <mado:rationale xml:lang="pt-BR">Por quê: login e seleção de destino foram tarefas problemáticas. Para quê: permitir entrada compatível com a interação não visual e com o contexto móvel. Como: as sugestões dos participantes e da análise propõem voz para login e destino.</mado:rationale>
    <mado:respondeA rdf:resource="https://w3id.org/mado#CTX-D03"/>
    <mado:statusDecisao>DECISAO_HISTORICA_RECONSTRUIDA</mado:statusDecisao>
    <mado:statusDoRegistro>DECISAO_HISTORICA_RECONSTRUIDA</mado:statusDoRegistro>
    <mado:sustentadaPor rdf:resource="https://w3id.org/mado#K03"/>
  </rdf:Description>
