    <mado:criterioAplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-REVISAR-PUBLICAR-RECURSO"/>
    <mado:enunciado xml:lang="pt-BR">Elementos visuais devem ter texto alternativo que descreve conteúdo ou ação</mado:enunciado>
    <mado:funcaoDecisoria xml:lang="pt-BR">ancorar relações cronológicas ou conceituais mencionadas na fala</mado:funcaoDecisoria>
    <mado:funcaoDecisoria xml:lang="pt-BR">preservar o significado visual em estrutura e descrição processáveis</mado:funcaoDecisoria>
    <mado:funcaoDecisoria xml:lang="pt-BR">representar relações espaciais, cronológicas ou conceituais</mado:funcaoDecisoria>
