<rdf:type rdf:resource="https://w3id.org/mado#CriterioDeDecisaoMultimodal" />
<ns1:label xml:lang="pt-BR">Para ações com consequências sérias (financeiras, legais, exclusão de dados), deve haver um mecanismo para reverter, verificar ou confirmar os dados antes da submissão final.</ns1:label>
<ns4:enunciado xml:lang="pt-BR">Para ações com consequências sérias (financeiras, legais, exclusão de dados), deve haver um mecanismo para reverter, verificar ou confirmar os dados antes da submissão final.</ns4:enunciado>
<ns4:fundamentadoPor rdf:resource="https://w3id.org/mado#K28" />
