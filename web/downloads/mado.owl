<ns4:executadaPorPapel rdf:resource="https://w3id.org/mado#PAPEL-ESTUDANTE" />
<ns4:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CFG-RC4-07</ns4:identificador>
<ns4:limiteDaConfiguracao xml:lang="pt-BR">Confirmação de conteúdo no caso não prova eficácia ou acessibilidade universal do recurso.</ns4:limiteDaConfiguracao>
<ns4:origemDoRegistro>CONFIGURACAO_MATURA_RC4</ns4:origemDoRegistro>
<ns4:possuiAplicacaoDeCriterio rdf:resource="https://w3id.org/mado#APL-CFG-RC4-07-01" />
