<ns1:label xml:lang="pt-BR">CTX-TRANSFERENCIA-RECURSO-DIGITAL-01</ns1:label>
<ns4:apresentaBarreira rdf:resource="https://w3id.org/mado#BAR-AUTORIA-SEM-COORDENACAO" />
<ns4:apresentaBarreira rdf:resource="https://w3id.org/mado#BAR-CONTEUDO-SEM-ESTRUTURA-PERSISTENTE" />
