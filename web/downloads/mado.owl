  <rdf:Description rdf:about="https://w3id.org/mado#CAR-OPERACAO-NAO-CONVENCIONAL">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://w3id.org/mado/scheme/CARACTERISTICA_PESSOA"/>
    <skos:prefLabel xml:lang="pt-BR">A forma convencional de operação não é compatível com o movimento disponível</skos:prefLabel>
    <mado:caracteristicaDerivadaDeFonte rdf:resource="https://w3id.org/mado#F01"/>
    <mado:caracteristicaDerivadaDeFonte rdf:resource="https://w3id.org/mado#F05"/>
    <mado:caracteristicaSustentadaPorTrecho rdf:resource="https://w3id.org/mado#TD-RC3-REF-04"/>
    <mado:caracteristicaSustentadaPorTrecho rdf:resource="https://w3id.org/mado#TD-RC3-REF-07"/>
    <mado:categoriaDaCaracteristica>OPERACAO_E_CONTROLE</mado:categoriaDaCaracteristica>
    <mado:condicaoDeUsoDaCaracteristica xml:lang="pt-BR">Testar movimento, precisão, esforço, compatibilidade e feedback.</mado:condicaoDeUsoDaCaracteristica>
    <mado:contraindicacao xml:lang="pt-BR">Não recomendar um controle apenas por ser alternativo.</mado:contraindicacao>
    <mado:efeitoPossivelNaTarefa xml:lang="pt-BR">Pode impedir entrada, navegação ou confirmação.</mado:efeitoPossivelNaTarefa>
    <mado:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CAR-OPERACAO-NAO-CONVENCIONAL</mado:identificador>
    <mado:statusDoRegistro>CONTROLADO_1_2_RC3</mado:statusDoRegistro>
  </rdf:Description>
