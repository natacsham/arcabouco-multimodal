  <rdf:Description rdf:about="https://w3id.org/mado#CA84">
    <rdf:type rdf:resource="https://w3id.org/mado#CriterioDeDecisaoMultimodal"/>
    <rdfs:label xml:lang="pt-BR">Ajuda relevante ao contexto da tarefa atual deve estar disponível para o usuário.</rdfs:label>
    <mado:criterioAplicavelAModalidade rdf:resource="https://w3id.org/mado#MOD-DESENHO"/>
    <mado:criterioAplicavelAModalidade rdf:resource="https://w3id.org/mado#MOD-FALA"/>
    <mado:criterioAplicavelAModalidade rdf:resource="https://w3id.org/mado#MOD-IMAGEM"/>
    <mado:criterioAplicavelAModalidade rdf:resource="https://w3id.org/mado#MOD-JOGO-INTERATIVO"/>
    <mado:criterioAplicavelAModalidade rdf:resource="https://w3id.org/mado#MOD-TEXTO"/>
    <mado:criterioAplicavelARecurso rdf:resource="https://w3id.org/mado#REC-COMPUTADOR-DATASHOW"/>
    <mado:criterioAplicavelARecurso rdf:resource="https://w3id.org/mado#REC-DESENHO-QUADRO-PAPEL"/>
    <mado:criterioAplicavelARecurso rdf:resource="https://w3id.org/mado#REC-PALAVRAS-CHAVE-LINHA-DO-TEMPO"/>
    <mado:criterioAplicavelARecurso rdf:resource="https://w3id.org/mado#RED-JOGO-HISTORIA"/>
    <mado:criterioAplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-COMUNICAR-CONTEUDO-1545B38"/>
    <mado:criterioAplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-CONSTRUIR-RECURSO-DIGITAL-HISTORIA"/>
    <mado:criterioAplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-EXPLICAR-CONTEUDO-HISTORIA"/>
    <mado:criterioAplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-MICROEXPLICACAO-CURRICULAR"/>
    <mado:criterioAplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-ORGANIZAR-PARTICIPACAO-MULTIMODAL"/>
    <mado:criterioAplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-REVISAR-PUBLICAR-RECURSO"/>
    <mado:enunciado xml:lang="pt-BR">Ajuda relevante ao contexto da tarefa atual deve estar disponível para o usuário.</mado:enunciado>
    <mado:funcaoDecisoria xml:lang="pt-BR">ancorar relações cronológicas ou conceituais mencionadas na fala</mado:funcaoDecisoria>
    <mado:funcaoDecisoria xml:lang="pt-BR">expressar o conhecimento prévio e relacioná-lo ao objetivo curricular</mado:funcaoDecisoria>
    <mado:funcaoDecisoria xml:lang="pt-BR">externalizar relações e apoiar a preparação ou continuidade da explicação</mado:funcaoDecisoria>
    <mado:funcaoDecisoria xml:lang="pt-BR">marcar a sequência, o objetivo e as transições sem substituir a explicação</mado:funcaoDecisoria>
    <mado:funcaoDecisoria xml:lang="pt-BR">mobilizar o interesse para uma tarefa curricular verificável</mado:funcaoDecisoria>
    <mado:funcaoDecisoria xml:lang="pt-BR">orientar sequência, objetivo e transições sem substituir a fala</mado:funcaoDecisoria>
    <mado:funcaoDecisoria xml:lang="pt-BR">representar relações espaciais, cronológicas ou conceituais</mado:funcaoDecisoria>
    <mado:fundamentadoPor rdf:resource="https://w3id.org/mado#K07"/>
    <mado:fundamentadoPor rdf:resource="https://w3id.org/mado#K10"/>
    <mado:fundamentadoPor rdf:resource="https://w3id.org/mado#K17"/>
    <mado:fundamentadoPor rdf:resource="https://w3id.org/mado#K19"/>
    <mado:fundamentadoPor rdf:resource="https://w3id.org/mado#K27"/>
    <mado:fundamentadoPor rdf:resource="https://w3id.org/mado#K30"/>
    <mado:fundamentadoPor rdf:resource="https://w3id.org/mado#K31"/>
    <mado:fundamentadoPor rdf:resource="https://w3id.org/mado#K32"/>
    <mado:fundamentadoPor rdf:resource="https://w3id.org/mado#K33"/>
    <mado:fundamentadoPor rdf:resource="https://w3id.org/mado#K34"/>
    <mado:fundamentadoPor rdf:resource="https://w3id.org/mado#K35"/>
    <mado:fundamentadoPor rdf:resource="https://w3id.org/mado#K37"/>
    <mado:fundamentadoPor rdf:resource="https://w3id.org/mado#K38"/>
    <mado:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CA84</mado:identificador>
    <mado:justificativaDeFundamentacao xml:lang="pt-BR">Oferecer ajuda vinculada à tarefa e ao contexto corrente. Em versão anterior, a ligação foi reconstruída analiticamente porque o critério participa de uma configuração modalidade–função–recurso–responsável fundamentada por esses conhecimentos; não se atribui essa formalização retrospectiva às publicações originais. Na RC2, a ligação ao conhecimento articulado foi conferida para o cenário de transferência e permanece limitada às condições registradas.</mado:justificativaDeFundamentacao>
    <mado:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0398"/>
    <mado:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0399"/>
    <mado:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0400"/>
    <mado:statusDaRelacao>RELACAO_SEM_JUSTIFICATIVA_EXPLICITA</mado:statusDaRelacao>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mado#K06">
    <rdf:type rdf:resource="https://w3id.org/mado#ConhecimentoMultimodalArticulado"/>
    <rdfs:label xml:lang="pt-BR">Recursos físicos de controle podem reduzir a necessidade de manipulação direta do smartphone durante mobilidade, desde que sejam compatíveis com a tarefa e o contexto.</rdfs:label>
    <mado:aplicavelAAmbiente rdf:resource="https://w3id.org/mado#AMB-MOBILIDADE-5371144"/>
    <mado:aplicavelABarreira rdf:resource="https://w3id.org/mado#BAR-MANIPULACAO-DIRETA-DO-TELEFONE-COMPETE-COM-A-TAR-8274878"/>
    <mado:aplicavelACaracteristicaRelevanteDaPessoa rdf:resource="https://w3id.org/mado#CAR-INTERACAO-NAO-VISUAL"/>
    <mado:aplicavelARecursoDisponivel rdf:resource="https://w3id.org/mado#REC-BOTOES-DO-HEADSET-ENTRADA-FISICA-F145DE4"/>
    <mado:aplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-INTERAGIR-DURANTE-DESLOCAMENTO-D591CDF"/>
    <mado:articulacao xml:lang="pt-BR">Entre as melhorias propostas após a avaliação está o uso dos botões do fone de ouvido para permitir que o telefone permaneça no bolso durante a rota. A proposta deriva do contexto de mobilidade e segurança, articulando forma de entrada, postura física e continuidade da tarefa.</mado:articulacao>
    <mado:articuladoSobPerspectiva rdf:resource="https://w3id.org/mado#P02"/>
    <mado:classificacaoOperacional>OPERACIONALIZAVEL</mado:classificacaoOperacional>
    <mado:derivadoDe rdf:resource="https://w3id.org/mado#F01"/>
    <mado:enunciado xml:lang="pt-BR">Recursos físicos de controle podem reduzir a necessidade de manipulação direta do smartphone durante mobilidade, desde que sejam compatíveis com a tarefa e o contexto.</mado:enunciado>
    <mado:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">K06</mado:identificador>
    <mado:limite xml:lang="pt-BR">O estudo propõe a solução, mas não apresenta avaliação posterior dessa alternativa.</mado:limite>
    <mado:natureza>RECONSTRUÇÃO ANALÍTICA FORTEMENTE SUSTENTADA</mado:natureza>
    <mado:origemDaEstruturacaoSemantica xml:lang="pt-BR">Relações derivadas de contextos e decisões documentados; complementações RC3 foram estabelecidas somente quando o enunciado, a articulação e os trechos sustentavam a aplicabilidade.</mado:origemDaEstruturacaoSemantica>
    <mado:restricao xml:lang="pt-BR">Mobilidade</mado:restricao>
    <mado:restricao xml:lang="pt-BR">controle físico</mado:restricao>
    <mado:restricao xml:lang="pt-BR">fone de ouvido</mado:restricao>
    <mado:restricao xml:lang="pt-BR">segurança/continuidade</mado:restricao>
    <mado:restricao xml:lang="pt-BR">smartphone</mado:restricao>
    <mado:statusDaRelacao>CONHECIMENTO_CANDIDATO</mado:statusDaRelacao>
    <mado:sustentadoPorTrecho rdf:resource="https://w3id.org/mado#TD-EV06"/>
  </rdf:Description>
