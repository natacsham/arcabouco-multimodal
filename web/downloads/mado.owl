    <mado:articulacaoSustentadaPorTrecho rdf:resource="https://w3id.org/mado#TD-ORI-0416"/>
    <mado:articulacaoSustentadaPorTrecho rdf:resource="https://w3id.org/mado#TD-RC3-REF-05"/>
