  <rdf:Description rdf:about="https://w3id.org/mado#CAR-INTERACAO-NAO-VISUAL">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://w3id.org/mado/scheme/CARACTERISTICA_PESSOA"/>
    <skos:prefLabel xml:lang="pt-BR">Interação predominantemente não visual</skos:prefLabel>
    <mado:caracteristicaDerivadaDeFonte rdf:resource="https://w3id.org/mado#F01"/>
    <mado:caracteristicaDerivadaDeFonte rdf:resource="https://w3id.org/mado#F03"/>
    <mado:caracteristicaDerivadaDeFonte rdf:resource="https://w3id.org/mado#FN-WCAG"/>
    <mado:caracteristicaSustentadaPorTrecho rdf:resource="https://w3id.org/mado#TD-EV01"/>
    <mado:caracteristicaSustentadaPorTrecho rdf:resource="https://w3id.org/mado#TD-EV12"/>
    <mado:caracteristicaSustentadaPorTrecho rdf:resource="https://w3id.org/mado#TD-ORI-0001"/>
    <mado:categoriaDaCaracteristica>CARACTERISTICA_FUNCIONAL</mado:categoriaDaCaracteristica>
    <mado:condicaoDeUsoDaCaracteristica xml:lang="pt-BR">A alternativa deve preservar o significado necessário à tarefa.</mado:condicaoDeUsoDaCaracteristica>
    <mado:contraindicacao xml:lang="pt-BR">Não tratar áudio ou vibração como equivalentes automáticos a qualquer conteúdo visual.</mado:contraindicacao>
    <mado:efeitoPossivelNaTarefa xml:lang="pt-BR">Pode impedir reconhecer conteúdo, estrutura, posição e estado.</mado:efeitoPossivelNaTarefa>
    <mado:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CAR-INTERACAO-NAO-VISUAL</mado:identificador>
    <mado:statusDoRegistro>CONTROLADO_RC4</mado:statusDoRegistro>
  </rdf:Description>
