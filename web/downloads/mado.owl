  <rdf:Description rdf:about="https://w3id.org/mado#CA68">
    <rdf:type rdf:resource="https://w3id.org/mado#CriterioDeDecisaoMultimodal"/>
    <rdfs:label xml:lang="pt-BR">A interface não deve restringir ou desabilitar modalidades de entrada disponíveis na plataforma (como teclado, mouse, toque ou voz), a menos que a restrição seja essencial para a segurança ou funcionamento da aplicação.</rdfs:label>
    <mado:criterioAplicavelABarreira rdf:resource="https://w3id.org/mado#BAR-AUDIO-PODE-PERDER-EFETIVIDADE-COM-RUIDO-04E2CCE"/>
    <mado:criterioAplicavelABarreira rdf:resource="https://w3id.org/mado#BAR-DIGITACAO-SELECAO-CONVENCIONAL-DIFICIL-30CB86A"/>
    <mado:criterioAplicavelAModalidade rdf:resource="https://w3id.org/mado#MOD-AUDIO"/>
    <mado:criterioAplicavelAModalidade rdf:resource="https://w3id.org/mado#MOD-HAPTICO"/>
    <mado:criterioAplicavelAModalidade rdf:resource="https://w3id.org/mado#MOD-VOZ"/>
    <mado:criterioAplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-AUTENTICAR-SELECIONAR-DESTINO-A098E60"/>
    <mado:criterioAplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-ENVIAR-LER-MENSAGEM-INTERAGIR-COM-MENSAGENS-4C0CACA"/>
    <mado:criterioAplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-SEGUIR-ROTA-3D861F4"/>
    <mado:criterioAplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-SELECIONAR-DESTINO-2780D83"/>
    <mado:enunciado xml:lang="pt-BR">A interface não deve restringir ou desabilitar modalidades de entrada disponíveis na plataforma (como teclado, mouse, toque ou voz), a menos que a restrição seja essencial para a segurança ou funcionamento da aplicação.</mado:enunciado>
    <mado:funcaoDecisoria xml:lang="pt-BR">manter orientação perceptível quando o áudio é afetado pelo ambiente</mado:funcaoDecisoria>
    <mado:funcaoDecisoria xml:lang="pt-BR">oferecer alternativa à digitação ou seleção visual</mado:funcaoDecisoria>
    <mado:funcaoDecisoria xml:lang="pt-BR">oferecer expressão e acesso alternativos ao texto digitado</mado:funcaoDecisoria>
    <mado:fundamentadoPor rdf:resource="https://w3id.org/mado#K01"/>
    <mado:fundamentadoPor rdf:resource="https://w3id.org/mado#K03"/>
    <mado:fundamentadoPor rdf:resource="https://w3id.org/mado#K07"/>
    <mado:fundamentadoPor rdf:resource="https://w3id.org/mado#K18"/>
    <mado:fundamentadoPor rdf:resource="https://w3id.org/mado#K21"/>
    <mado:fundamentadoPor rdf:resource="https://w3id.org/mado#K29"/>
    <mado:fundamentadoPor rdf:resource="https://w3id.org/mado#K32"/>
    <mado:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CA68</mado:identificador>
    <mado:justificativaDeFundamentacao xml:lang="pt-BR">Não bloquear modalidades de entrada disponíveis quando elas constituem alternativa situada. Em versão anterior, a ligação foi reconstruída analiticamente porque o critério participa de uma configuração modalidade–função–recurso–responsável fundamentada por esses conhecimentos; não se atribui essa formalização retrospectiva às publicações originais.</mado:justificativaDeFundamentacao>
    <mado:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0346"/>
    <mado:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0347"/>
    <mado:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0348"/>
    <mado:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0349"/>
    <mado:statusDaRelacao>RELACAO_SEM_JUSTIFICATIVA_EXPLICITA</mado:statusDaRelacao>
  </rdf:Description>
