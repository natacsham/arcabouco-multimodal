  <rdf:Description rdf:about="https://w3id.org/mado#D15">
    <rdf:type rdf:resource="https://w3id.org/mado#DecisaoDeAcessibilidadeMultimodal"/>
    <rdfs:label xml:lang="pt-BR">Para permitir preenchimento e envio de mensagens de forma previsível, estruturar o formulário com rótulos/instruções, teclado/foco, tratamento de erros, confirmação e feedback de status.</rdfs:label>
    <mado:aplicaCriterio rdf:resource="https://w3id.org/mado#CA38"/>
    <mado:aplicaCriterio rdf:resource="https://w3id.org/mado#CA52"/>
    <mado:aplicaCriterio rdf:resource="https://w3id.org/mado#CA55"/>
    <mado:aplicaCriterio rdf:resource="https://w3id.org/mado#CA64"/>
    <mado:aplicaCriterio rdf:resource="https://w3id.org/mado#CA80"/>
    <mado:aplicaCriterio rdf:resource="https://w3id.org/mado#CA81"/>
    <mado:aplicaCriterio rdf:resource="https://w3id.org/mado#CA83"/>
    <mado:aplicaCriterio rdf:resource="https://w3id.org/mado#CA88"/>
    <mado:condicaoDeAplicacao xml:lang="pt-BR">Compatibilidade com TA e lógica do fluxo</mado:condicaoDeAplicacao>
    <mado:enunciado xml:lang="pt-BR">Para permitir preenchimento e envio de mensagens de forma previsível, estruturar o formulário com rótulos/instruções, teclado/foco, tratamento de erros, confirmação e feedback de status.</mado:enunciado>
    <mado:expressaoOperacional xml:lang="pt-BR">Estruturar formulários com rótulos e instruções, ordem/foco operável, identificação de erros, confirmação e feedback de status acessível ao longo da tarefa.</mado:expressaoOperacional>
    <mado:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D15</mado:identificador>
    <mado:natureza>RECONSTRUÇÃO ANALÍTICA FORTEMENTE SUSTENTADA</mado:natureza>
    <mado:rationale xml:lang="pt-BR">Por quê: a análise identifica violações essenciais no fluxo do formulário. Para quê: permitir concluir a tarefa com compreensão e controle. Como: o redesign coordena entrada, foco, validação, confirmação e saída de status segundo critérios específicos.</mado:rationale>
    <mado:respondeA rdf:resource="https://w3id.org/mado#CTX-D15"/>
    <mado:statusDecisao>DECISAO_HISTORICA_RECONSTRUIDA</mado:statusDecisao>
    <mado:statusDoRegistro>DECISAO_HISTORICA_RECONSTRUIDA</mado:statusDoRegistro>
    <mado:sustentadaPor rdf:resource="https://w3id.org/mado#K28"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mado#TD-ORI-0174">
    <rdf:type rdf:resource="https://w3id.org/mado#TrechoDocumental"/>
