  <rdf:Description rdf:about="https://w3id.org/mado#D-TESTE-RC2-SUSPENSA">
    <rdf:type rdf:resource="https://w3id.org/mado#DecisaoDeAcessibilidadeMultimodal"/>
    <rdfs:label xml:lang="pt-BR">Decisão suspensa porque diagnóstico isolado não caracteriza a interação.</rdfs:label>
    <mado:atendeRequisitoDeExpressao rdf:resource="https://w3id.org/mado#K33"/>
    <mado:condicaoDeAplicacao xml:lang="pt-BR">Caracterizar a tarefa e as condições funcionais antes de decidir.</mado:condicaoDeAplicacao>
    <mado:enunciado xml:lang="pt-BR">Decisão suspensa porque diagnóstico isolado não caracteriza a interação.</mado:enunciado>
    <mado:expressaoOperacional xml:lang="pt-BR">A MADO deve perguntar ou suspender.</mado:expressaoOperacional>
    <mado:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D-TESTE-RC2-SUSPENSA</mado:identificador>
    <mado:limite xml:lang="pt-BR">Registro técnico; não é orientação à especialista.</mado:limite>
    <mado:natureza>CASO_NEGATIVO_DE_REGRESSAO</mado:natureza>
    <mado:rationale xml:lang="pt-BR">Não há tarefa, barreira, necessidade, capacidade observada, modalidade ou recurso suficiente.</mado:rationale>
    <mado:respondeA rdf:resource="https://w3id.org/mado#CTX-TESTE-RC2-DIAGNOSTICO-ISOLADO"/>
    <mado:statusDecisao>SUSPENSA_POR_CARACTERIZACAO_INSUFICIENTE</mado:statusDecisao>
    <mado:statusDoRegistro>CASO_DE_TESTE</mado:statusDoRegistro>
    <mado:sustentadaPor rdf:resource="https://w3id.org/mado#K33"/>
    <mado:sustentadaPor rdf:resource="https://w3id.org/mado#K34"/>
  </rdf:Description>
