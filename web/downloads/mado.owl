<ns4:consideraCaracteristicaRelevanteDaPessoa rdf:resource="https://w3id.org/mado#CAR-FALA-ESPONTANEA-EXTENSA" />
<ns4:consideraCaracteristicaRelevanteDaPessoa rdf:resource="https://w3id.org/mado#CAR-FALA-PERSISTENTE-REPETITIVA" />
