  <rdf:Description rdf:about="https://w3id.org/mado">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label xml:lang="pt-BR">MADO — Ontologia do Arcabouço Multimodal para Acessibilidade Digital</rdfs:label>
    <rdfs:comment xml:lang="pt-BR">Representa a articulação rastreável entre fontes, conhecimento multimodal articulado, critérios, características situadas da pessoa, contextos, decisões e resultados. Não possui classe de deficiência e não automatiza julgamento situado.</rdfs:comment>
    <owl:versionIRI rdf:resource="https://w3id.org/mado/1.3.0-rc1"/>
    <owl:versionInfo>1.3.0-rc1</owl:versionInfo>
    <prov:wasDerivedFrom rdf:resource="https://w3id.org/mado/1.2.0-RC4"/>
    <owl:priorVersion rdf:resource="https://w3id.org/mado/1.2.0-RC4"/>
    <dcterms:creator>Natacsha Ordones Raposo de Melo</dcterms:creator>
  </rdf:Description>
