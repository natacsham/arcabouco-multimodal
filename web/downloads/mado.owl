<ns4:apresentaBarreira rdf:resource="https://w3id.org/mado#BAR-FORMATOS-COMPETEM-PELA-ATENCAO" />
<ns4:apresentaBarreira rdf:resource="https://w3id.org/mado#BAR-INFORMACAO-EM-UM-SO-MODO" />
<ns4:apresentaBarreira rdf:resource="https://w3id.org/mado#BAR-TRANSICAO-E-CONTRADICAO-DIFICIL" />
