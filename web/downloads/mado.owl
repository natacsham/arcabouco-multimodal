<rdf:Description rdf:about="https://w3id.org/mado#CA50">
<rdf:type rdf:resource="https://w3id.org/mado#CriterioDeDecisaoMultimodal" />
<ns1:label xml:lang="pt-BR">Disponibilizar mecanismo para pular blocos repetidos (ex.: navegação, banners) e ir direto ao conteúdo</ns1:label>
<ns4:enunciado xml:lang="pt-BR">Disponibilizar mecanismo para pular blocos repetidos (ex.: navegação, banners) e ir direto ao conteúdo</ns4:enunciado>
<ns4:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CA50</ns4:identificador>
<ns4:observacao xml:lang="pt-BR">[DADO AUSENTE] Justificativa de mesclagem não localizada; não preencher por inferência.</ns4:observacao>
<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0277" />
<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0278" />
<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0279" />
<ns4:statusDaRelacao>RELACAO_SEM_JUSTIFICATIVA_EXPLICITA</ns4:statusDaRelacao>
</rdf:Description>
<rdf:Description rdf:about="https://w3id.org/mado#CA51">
<rdf:type rdf:resource="https://w3id.org/mado#CriterioDeDecisaoMultimodal" />
<ns1:label xml:lang="pt-BR">Toda página, tela ou componente interativo possui um título ou rótulo que descreve seu tópico, propósito ou função de forma clara e precisa.</ns1:label>
<ns4:enunciado xml:lang="pt-BR">Toda página, tela ou componente interativo possui um título ou rótulo que descreve seu tópico, propósito ou função de forma clara e precisa.</ns4:enunciado>
<ns4:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CA51</ns4:identificador>
<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0280" />
<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0281" />
<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0282" />
<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0283" />
<ns4:statusDaRelacao>RELACAO_SEM_JUSTIFICATIVA_EXPLICITA</ns4:statusDaRelacao>
</rdf:Description>
<rdf:Description rdf:about="https://w3id.org/mado#CA52">
<rdf:type rdf:resource="https://w3id.org/mado#CriterioDeDecisaoMultimodal" />
<ns1:label xml:lang="pt-BR">A ordem de navegação por foco deve ser lógica, sequencial e preservar o significado e a operacionalidade da interface.</ns1:label>
<ns4:criterioAplicavelAModalidade rdf:resource="https://w3id.org/mado#MOD-TECLADO" />
<ns4:criterioAplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-EXECUTAR-TAREFAS-NO-AVA-7BEF3BD" />
<ns4:criterioAplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-PREENCHER-ENVIAR-MENSAGEM-0C1FB87" />
<ns4:enunciado xml:lang="pt-BR">A ordem de navegação por foco deve ser lógica, sequencial e preservar o significado e a operacionalidade da interface.</ns4:enunciado>
<ns4:funcaoDecisoria xml:lang="pt-BR">preservar operação, foco, correção e confirmação</ns4:funcaoDecisoria>
<ns4:fundamentadoPor rdf:resource="https://w3id.org/mado#K28" />
<ns4:fundamentadoPor rdf:resource="https://w3id.org/mado#K29" />
<ns4:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CA52</ns4:identificador>
<ns4:justificativaDeFundamentacao xml:lang="pt-BR">Em versão anterior, a ligação foi reconstruída analiticamente porque o critério participa de uma configuração modalidade–função–recurso–responsável fundamentada por esses conhecimentos; não se atribui essa formalização retrospectiva às publicações originais.</ns4:justificativaDeFundamentacao>
<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0284" />
<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0285" />
<ns4:statusDaRelacao>RELACAO_SEM_JUSTIFICATIVA_EXPLICITA</ns4:statusDaRelacao>
</rdf:Description>
<rdf:Description rdf:about="https://w3id.org/mado#CA53">
<rdf:type rdf:resource="https://w3id.org/mado#CriterioDeDecisaoMultimodal" />
<ns1:label xml:lang="pt-BR">O propósito de cada componente interativo (como links e botões) deve ser claro e compreensível a partir de seu rótulo, nome acessível ou contexto imediato.</ns1:label>
<ns4:enunciado xml:lang="pt-BR">O propósito de cada componente interativo (como links e botões) deve ser claro e compreensível a partir de seu rótulo, nome acessível ou contexto imediato.</ns4:enunciado>
<ns4:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CA53</ns4:identificador>
<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0286" />
<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0287" />
<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0288" />
<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0289" />
<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0290" />
<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0291" />
<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0292" />
<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0293" />
<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0294" />
<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0295" />
<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0296" />
<ns4:statusDaRelacao>RELACAO_SEM_JUSTIFICATIVA_EXPLICITA</ns4:statusDaRelacao>
</rdf:Description>
<rdf:Description rdf:about="https://w3id.org/mado#CA54">
<rdf:type rdf:resource="https://w3id.org/mado#CriterioDeDecisaoMultimodal" />
<ns1:label xml:lang="pt-BR">Devem existir múltiplos caminhos para localizar conteúdo ou páginas dentro de um sistema (ex: menu de navegação, busca, mapa do site), a menos que a página seja parte de um processo sequencial.</ns1:label>
<ns4:enunciado xml:lang="pt-BR">Devem existir múltiplos caminhos para localizar conteúdo ou páginas dentro de um sistema (ex: menu de navegação, busca, mapa do site), a menos que a página seja parte de um processo sequencial.</ns4:enunciado>
<ns4:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CA54</ns4:identificador>
<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0297" />
<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0298" />
<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0299" />
<ns4:statusDaRelacao>RELACAO_SEM_JUSTIFICATIVA_EXPLICITA</ns4:statusDaRelacao>
</rdf:Description>
<rdf:Description rdf:about="https://w3id.org/mado#CA55">
<rdf:type rdf:resource="https://w3id.org/mado#CriterioDeDecisaoMultimodal" />
<ns1:label xml:lang="pt-BR">Cabeçalhos e rótulos devem ser utilizados para descrever e organizar o conteúdo, seguindo uma estrutura lógica e hierárquica.</ns1:label>
<ns4:enunciado xml:lang="pt-BR">Cabeçalhos e rótulos devem ser utilizados para descrever e organizar o conteúdo, seguindo uma estrutura lógica e hierárquica.</ns4:enunciado>
<ns4:fundamentadoPor rdf:resource="https://w3id.org/mado#K28" />
<ns4:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CA55</ns4:identificador>
<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0300" />
<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0301" />
<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0302" />
<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0303" />
<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0304" />
<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0305" />
<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0306" />
<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0307" />
<ns4:statusDaRelacao>RELACAO_SEM_JUSTIFICATIVA_EXPLICITA</ns4:statusDaRelacao>
</rdf:Description>
<rdf:Description rdf:about="https://w3id.org/mado#CA56">
<rdf:type rdf:resource="https://w3id.org/mado#CriterioDeDecisaoMultimodal" />
<ns1:label xml:lang="pt-BR">Todo componente interativo que recebe foco deve apresentar um indicador de foco claramente visível.</ns1:label>
<ns4:enunciado xml:lang="pt-BR">Todo componente interativo que recebe foco deve apresentar um indicador de foco claramente visível.</ns4:enunciado>
<ns4:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CA56</ns4:identificador>
<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0308" />
<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0309" />
<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0310" />
<ns4:statusDaRelacao>RELACAO_SEM_JUSTIFICATIVA_EXPLICITA</ns4:statusDaRelacao>
</rdf:Description>
<rdf:Description rdf:about="https://w3id.org/mado#CA57">
<rdf:type rdf:resource="https://w3id.org/mado#CriterioDeDecisaoMultimodal" />
<ns1:label xml:lang="pt-BR">A localização atual do usuário dentro da estrutura de um site ou aplicação deve estar disponível e ser identificável.&#13;
&#13;
</ns1:label>
<ns4:enunciado xml:lang="pt-BR">A localização atual do usuário dentro da estrutura de um site ou aplicação deve estar disponível e ser identificável.</ns4:enunciado>
<ns4:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CA57</ns4:identificador>
<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0311" />
<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0312" />
<ns4:statusDaRelacao>RELACAO_SEM_JUSTIFICATIVA_EXPLICITA</ns4:statusDaRelacao>
</rdf:Description>
<rdf:Description rdf:about="https://w3id.org/mado#CA58">
<rdf:type rdf:resource="https://w3id.org/mado#CriterioDeDecisaoMultimodal" />
<ns1:label xml:lang="pt-BR">O propósito de cada link deve ser unívoco e compreensível a partir de seu texto, mesmo quando lido isoladamente, informando sobre destinos, ações ou tipos de arquivo.</ns1:label>
<ns4:enunciado xml:lang="pt-BR">O propósito de cada link deve ser unívoco e compreensível a partir de seu texto, mesmo quando lido isoladamente, informando sobre destinos, ações ou tipos de arquivo.</ns4:enunciado>
<ns4:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CA58</ns4:identificador>
<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0313" />
<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0314" />
<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0315" />
<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0316" />
<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0317" />
<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0318" />
<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0319" />
<ns4:statusDaRelacao>RELACAO_SEM_JUSTIFICATIVA_EXPLICITA</ns4:statusDaRelacao>
</rdf:Description>
<rdf:Description rdf:about="https://w3id.org/mado#CA59">
<rdf:type rdf:resource="https://w3id.org/mado#CriterioDeDecisaoMultimodal" />
<ns1:label xml:lang="pt-BR">O conteúdo deve ser organizado em seções lógicas utilizando cabeçalhos com uma estrutura hierárquica correta.</ns1:label>
<ns4:enunciado xml:lang="pt-BR">O conteúdo deve ser organizado em seções lógicas utilizando cabeçalhos com uma estrutura hierárquica correta.</ns4:enunciado>
<ns4:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CA59</ns4:identificador>
<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0320" />
<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0321" />
<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0322" />
<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0323" />
<ns4:statusDaRelacao>RELACAO_SEM_JUSTIFICATIVA_EXPLICITA</ns4:statusDaRelacao>
</rdf:Description>
<rdf:Description rdf:about="https://w3id.org/mado#CA60">
<rdf:type rdf:resource="https://w3id.org/mado#CriterioDeDecisaoMultimodal" />
<ns1:label xml:lang="pt-BR">Quando um componente recebe foco, ele não deve ser total ou parcialmente ocultado por outro conteúdo da interface, como banners, menus fixos ou modais.</ns1:label>
<ns4:enunciado xml:lang="pt-BR">Quando um componente recebe foco, ele não deve ser total ou parcialmente ocultado por outro conteúdo da interface, como banners, menus fixos ou modais.</ns4:enunciado>
<ns4:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CA60</ns4:identificador>
<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0324" />
<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0325" />
<ns4:statusDaRelacao>RELACAO_SEM_JUSTIFICATIVA_EXPLICITA</ns4:statusDaRelacao>
</rdf:Description>
<rdf:Description rdf:about="https://w3id.org/mado#CA61">
<rdf:type rdf:resource="https://w3id.org/mado#CriterioDeDecisaoMultimodal" />
<ns1:label xml:lang="pt-BR">Quando um componente de interface recebe foco, ele deve estar completamente visível, sem ser obscurecido por outro conteúdo.</ns1:label>
<ns4:enunciado xml:lang="pt-BR">Quando um componente de interface recebe foco, ele deve estar completamente visível, sem ser obscurecido por outro conteúdo.</ns4:enunciado>
<ns4:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CA61</ns4:identificador>
<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0326" />
<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0327" />
<ns4:statusDaRelacao>RELACAO_SEM_JUSTIFICATIVA_EXPLICITA</ns4:statusDaRelacao>
</rdf:Description>
<rdf:Description rdf:about="https://w3id.org/mado#CA62">
<rdf:type rdf:resource="https://w3id.org/mado#CriterioDeDecisaoMultimodal" />
<ns1:label xml:lang="pt-BR">O indicador de foco deve ter tamanho e contraste suficientes para ser claramente perceptível, com uma área mínima e um contraste de pelo menos 3:1 em relação aos estados adjacentes.</ns1:label>
<ns4:enunciado xml:lang="pt-BR">O indicador de foco deve ter tamanho e contraste suficientes para ser claramente perceptível, com uma área mínima e um contraste de pelo menos 3:1 em relação aos estados adjacentes.</ns4:enunciado>
<ns4:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CA62</ns4:identificador>
<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0328" />
<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0329" />
<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0330" />
<ns4:statusDaRelacao>RELACAO_SEM_JUSTIFICATIVA_EXPLICITA</ns4:statusDaRelacao>
</rdf:Description>
<rdf:Description rdf:about="https://w3id.org/mado#CA63">
<rdf:type rdf:resource="https://w3id.org/mado#CriterioDeDecisaoMultimodal" />
<ns1:label xml:lang="pt-BR">Toda funcionalidade que requer gestos complexos (multiponto ou baseados em caminho) deve possuir uma alternativa operável por ponteiro único (toque ou clique simples), a menos que o gesto seja essencial.</ns1:label>
<ns4:enunciado xml:lang="pt-BR">Toda funcionalidade que requer gestos complexos (multiponto ou baseados em caminho) deve possuir uma alternativa operável por ponteiro único (toque ou clique simples), a menos que o gesto seja essencial.</ns4:enunciado>
<ns4:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CA63</ns4:identificador>
<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0331" />
<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0332" />
<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0333" />
<ns4:statusDaRelacao>RELACAO_SEM_JUSTIFICATIVA_EXPLICITA</ns4:statusDaRelacao>
</rdf:Description>
<rdf:Description rdf:about="https://w3id.org/mado#CA64">
<rdf:type rdf:resource="https://w3id.org/mado#CriterioDeDecisaoMultimodal" />
<ns1:label xml:lang="pt-BR"> A ativação de uma função não deve ocorrer no evento de pressionar o ponteiro (down-event), mas sim ao soltá-lo (up-event), ou deve haver um mecanismo para cancelar ou reverter a ação.</ns1:label>
<ns4:enunciado xml:lang="pt-BR">A ativação de uma função não deve ocorrer no evento de pressionar o ponteiro (down-event), mas sim ao soltá-lo (up-event), ou deve haver um mecanismo para cancelar ou reverter a ação.</ns4:enunciado>
<ns4:fundamentadoPor rdf:resource="https://w3id.org/mado#K28" />
<ns4:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CA64</ns4:identificador>
<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0334" />
<ns4:statusDaRelacao>RELACAO_SEM_JUSTIFICATIVA_EXPLICITA</ns4:statusDaRelacao>
</rdf:Description>
<rdf:Description rdf:about="https://w3id.org/mado#CA65">
<rdf:type rdf:resource="https://w3id.org/mado#CriterioDeDecisaoMultimodal" />
<ns1:label xml:lang="pt-BR">O nome acessível de um componente de interface deve conter o texto que é apresentado visualmente em seu rótulo.</ns1:label>
<ns4:enunciado xml:lang="pt-BR">O nome acessível de um componente de interface deve conter o texto que é apresentado visualmente em seu rótulo.</ns4:enunciado>
<ns4:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CA65</ns4:identificador>
<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0335" />
<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0336" />
<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0337" />
<ns4:statusDaRelacao>RELACAO_SEM_JUSTIFICATIVA_EXPLICITA</ns4:statusDaRelacao>
</rdf:Description>
<rdf:Description rdf:about="https://w3id.org/mado#CA66">
<rdf:type rdf:resource="https://w3id.org/mado#CriterioDeDecisaoMultimodal" />
<ns1:label xml:lang="pt-BR">Funcionalidades ativadas por movimento do dispositivo ou do usuário devem ter uma alternativa operável por componentes de interface padrão, e a resposta ao movimento deve poder ser desativada.</ns1:label>
<ns4:enunciado xml:lang="pt-BR">Funcionalidades ativadas por movimento do dispositivo ou do usuário devem ter uma alternativa operável por componentes de interface padrão, e a resposta ao movimento deve poder ser desativada.</ns4:enunciado>
<ns4:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CA66</ns4:identificador>
<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0338" />
<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0339" />
<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0340" />
<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0341" />
<ns4:statusDaRelacao>RELACAO_SEM_JUSTIFICATIVA_EXPLICITA</ns4:statusDaRelacao>
</rdf:Description>
<rdf:Description rdf:about="https://w3id.org/mado#CA67">
<rdf:type rdf:resource="https://w3id.org/mado#CriterioDeDecisaoMultimodal" />
<ns1:label xml:lang="pt-BR">Elementos interativos devem ter uma área de alvo para ponteiro de pelo menos 44 por 44 pixels CSS, a menos que haja exceções específicas (como links no meio de um texto).</ns1:label>
<ns4:enunciado xml:lang="pt-BR">Elementos interativos devem ter uma área de alvo para ponteiro de pelo menos 44 por 44 pixels CSS, a menos que haja exceções específicas (como links no meio de um texto).</ns4:enunciado>
<ns4:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CA67</ns4:identificador>
<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0342" />
<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0343" />
<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0344" />
<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0345" />
<ns4:statusDaRelacao>RELACAO_SEM_JUSTIFICATIVA_EXPLICITA</ns4:statusDaRelacao>
</rdf:Description>
<rdf:Description rdf:about="https://w3id.org/mado#CA68">
<rdf:type rdf:resource="https://w3id.org/mado#CriterioDeDecisaoMultimodal" />
<ns1:label xml:lang="pt-BR">A interface não deve restringir ou desabilitar modalidades de entrada disponíveis na plataforma (como teclado, mouse, toque ou voz), a menos que a restrição seja essencial para a segurança ou funcionamento da aplicação.</ns1:label>
<ns4:criterioAplicavelABarreira rdf:resource="https://w3id.org/mado#BAR-AUDIO-PODE-PERDER-EFETIVIDADE-COM-RUIDO-04E2CCE" />
<ns4:criterioAplicavelABarreira rdf:resource="https://w3id.org/mado#BAR-DIGITACAO-SELECAO-CONVENCIONAL-DIFICIL-30CB86A" />
<ns4:criterioAplicavelAModalidade rdf:resource="https://w3id.org/mado#MOD-AUDIO" />
<ns4:criterioAplicavelAModalidade rdf:resource="https://w3id.org/mado#MOD-HAPTICO" />
<ns4:criterioAplicavelAModalidade rdf:resource="https://w3id.org/mado#MOD-VOZ" />
<ns4:criterioAplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-AUTENTICAR-SELECIONAR-DESTINO-A098E60" />
<ns4:criterioAplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-ENVIAR-LER-MENSAGEM-INTERAGIR-COM-MENSAGENS-4C0CACA" />
<ns4:criterioAplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-SEGUIR-ROTA-3D861F4" />
<ns4:criterioAplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-SELECIONAR-DESTINO-2780D83" />
<ns4:enunciado xml:lang="pt-BR">A interface não deve restringir ou desabilitar modalidades de entrada disponíveis na plataforma (como teclado, mouse, toque ou voz), a menos que a restrição seja essencial para a segurança ou funcionamento da aplicação.</ns4:enunciado>
<ns4:funcaoDecisoria xml:lang="pt-BR">manter orientação perceptível quando o áudio é afetado pelo ambiente</ns4:funcaoDecisoria>
<ns4:funcaoDecisoria xml:lang="pt-BR">oferecer alternativa à digitação ou seleção visual</ns4:funcaoDecisoria>
<ns4:funcaoDecisoria xml:lang="pt-BR">oferecer expressão e acesso alternativos ao texto digitado</ns4:funcaoDecisoria>
<ns4:fundamentadoPor rdf:resource="https://w3id.org/mado#K01" />
<ns4:fundamentadoPor rdf:resource="https://w3id.org/mado#K03" />
<ns4:fundamentadoPor rdf:resource="https://w3id.org/mado#K07" />
<ns4:fundamentadoPor rdf:resource="https://w3id.org/mado#K18" />
<ns4:fundamentadoPor rdf:resource="https://w3id.org/mado#K21" />
<ns4:fundamentadoPor rdf:resource="https://w3id.org/mado#K29" />
<ns4:fundamentadoPor rdf:resource="https://w3id.org/mado#K32" />
<ns4:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CA68</ns4:identificador>
<ns4:justificativaDeFundamentacao xml:lang="pt-BR">Não bloquear modalidades de entrada disponíveis quando elas constituem alternativa situada. Em versão anterior, a ligação foi reconstruída analiticamente porque o critério participa de uma configuração modalidade–função–recurso–responsável fundamentada por esses conhecimentos; não se atribui essa formalização retrospectiva às publicações originais.</ns4:justificativaDeFundamentacao>
<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0346" />
<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0347" />
<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0348" />
<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0349" />
<ns4:statusDaRelacao>RELACAO_SEM_JUSTIFICATIVA_EXPLICITA</ns4:statusDaRelacao>
</rdf:Description>
<rdf:Description rdf:about="https://w3id.org/mado#CA69">
<rdf:type rdf:resource="https://w3id.org/mado#CriterioDeDecisaoMultimodal" />
<ns1:label xml:lang="pt-BR">Toda funcionalidade que utiliza um movimento de arrastar (drag-and-drop) deve ter uma alternativa que possa ser operada por ponteiro único sem a necessidade de arrastar (ex: cliques sequenciais).</ns1:label>
<ns4:enunciado xml:lang="pt-BR">Toda funcionalidade que utiliza um movimento de arrastar (drag-and-drop) deve ter uma alternativa que possa ser operada por ponteiro único sem a necessidade de arrastar (ex: cliques sequenciais).</ns4:enunciado>
<ns4:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CA69</ns4:identificador>
<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0350" />
