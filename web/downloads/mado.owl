  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mado#K17">
    <rdf:type rdf:resource="https://w3id.org/mado#ConhecimentoMultimodalArticulado"/>
    <rdfs:label xml:lang="pt-BR">Na preparação de conteúdo educacional, multimodalidade útil exige organizar a função de texto, imagem, vídeo, banners e elementos interativos para apoiar foco, compreensão e mediação pedagógica, e não apenas multiplicar formatos.</rdfs:label>
    <mado:aplicavelABarreira rdf:resource="https://w3id.org/mado#BAR-REPETICAO-PREJUDICA-VINCULO"/>
    <mado:aplicavelABarreira rdf:resource="https://w3id.org/mado#BAR-TRANSICAO-E-CONTRADICAO-DIFICIL"/>
    <mado:aplicavelACaracteristicaRelevanteDaPessoa rdf:resource="https://w3id.org/mado#CAR-FALA-PERSISTENTE-REPETITIVA"/>
    <mado:aplicavelACaracteristicaRelevanteDaPessoa rdf:resource="https://w3id.org/mado#CAR-NECESSITA-ORGANIZACAO-COGNITIVA"/>
    <mado:aplicavelACaracteristicaRelevanteDaPessoa rdf:resource="https://w3id.org/mado#CAR-REAGE-DEFENSIVAMENTE-A-CONTRADICAO"/>
    <mado:aplicavelANecessidade rdf:resource="https://w3id.org/mado#NEC-ALINHAR-IMAGENS-PREVIAMENTE"/>
    <mado:aplicavelANecessidade rdf:resource="https://w3id.org/mado#NEC-APOIAR-COMPREENSAO-TURMA"/>
    <mado:aplicavelANecessidade rdf:resource="https://w3id.org/mado#NEC-NEGOCIAR-TURNOS-TRANSICOES"/>
    <mado:aplicavelANecessidade rdf:resource="https://w3id.org/mado#NEC-ORGANIZAR-DELIMITAR-PARTICIPACAO"/>
    <mado:aplicavelANecessidade rdf:resource="https://w3id.org/mado#NEC-PRESERVAR-VINCULO-SOCIAL"/>
    <mado:aplicavelANecessidade rdf:resource="https://w3id.org/mado#NEC-SINALIZAR-AUSENCIA-IMAGEM"/>
    <mado:aplicavelARecursoDigital rdf:resource="https://w3id.org/mado#RED-APRESENTACAO-DIGITAL"/>
    <mado:aplicavelARecursoDigital rdf:resource="https://w3id.org/mado#RED-IMAGEM-DIGITAL"/>
    <mado:aplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-APRESENTAR-CONTEUDO-DIFERENTES-ESPACOS"/>
    <mado:aplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-COMUNICAR-CONTEUDO-1545B38"/>
    <mado:aplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-MICROEXPLICACAO-CURRICULAR"/>
    <mado:articulacao xml:lang="pt-BR">A persona Marcia é fundamentada no experimento da WABlind com docentes que marcavam conteúdo de páginas educacionais. A persona reorganiza esse resultado como padrão de curadoria: reconhecer o que é principal, periférico e tecnicamente relevante para a adaptação do material.</mado:articulacao>
    <mado:articuladoSobPerspectiva rdf:resource="https://w3id.org/mado#P02"/>
    <mado:classificacaoOperacional>PRINCIPIO_GERAL</mado:classificacaoOperacional>
    <mado:contribuiParaFuncaoDecisoria rdf:resource="https://w3id.org/mado#FUN-COORDENAR-AUTORIA"/>
    <mado:contribuiParaFuncaoDecisoria rdf:resource="https://w3id.org/mado#FUN-ORGANIZAR-CONTEUDO"/>
    <mado:derivadoDe rdf:resource="https://w3id.org/mado#F06"/>
    <mado:enunciado xml:lang="pt-BR">Na preparação de conteúdo educacional, multimodalidade útil exige organizar a função de texto, imagem, vídeo, banners e elementos interativos para apoiar foco, compreensão e mediação pedagógica, e não apenas multiplicar formatos.</mado:enunciado>
    <mado:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">K17</mado:identificador>
    <mado:natureza>RECONSTRUÇÃO ANALÍTICA FORTEMENTE SUSTENTADA</mado:natureza>
    <mado:origemDaEstruturacaoSemantica xml:lang="pt-BR">Relações derivadas de contextos e decisões documentados; complementações RC3 foram estabelecidas somente quando o enunciado, a articulação e os trechos sustentavam a aplicabilidade.</mado:origemDaEstruturacaoSemantica>
    <mado:statusDaRelacao>CONHECIMENTO_CANDIDATO_RC2</mado:statusDaRelacao>
    <mado:sustentadoPorTrecho rdf:resource="https://w3id.org/mado#TD-EV34"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mado#K21">
    <rdf:type rdf:resource="https://w3id.org/mado#ConhecimentoMultimodalArticulado"/>
    <rdfs:label xml:lang="pt-BR">Em interação assistiva, modalidade, ambiente físico, desempenho do dispositivo e tarefa são interdependentes; voz pode ampliar autonomia e, ao mesmo tempo, perder eficiência em ruído ou sob sobrecarga técnica.</rdfs:label>
    <mado:aplicavelACaracteristicaRelevanteDaPessoa rdf:resource="https://w3id.org/mado#CAR-ENTRADA-CONVENCIONAL-DIFICIL"/>
    <mado:aplicavelACaracteristicaRelevanteDaPessoa rdf:resource="https://w3id.org/mado#CAR-MOVIMENTO-RESIDUAL-DEDOS"/>
    <mado:aplicavelAModalidade rdf:resource="https://w3id.org/mado#MOD-AUDIO"/>
    <mado:aplicavelAModalidade rdf:resource="https://w3id.org/mado#MOD-VOZ"/>
    <mado:aplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-AUTENTICAR-SELECIONAR-DESTINO-A098E60"/>
    <mado:aplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-SEGUIR-ROTA-3D861F4"/>
    <mado:articulacao xml:lang="pt-BR">João é fundamentado no ACAT/MPD e no RotaColab. O perfil reorganiza resultados sobre voz, sensores/atuadores, mobilidade, arquitetura e desempenho como um padrão situado de decisão, em que nenhuma modalidade é adequada isoladamente de contexto e viabilidade.</mado:articulacao>
    <mado:articuladoSobPerspectiva rdf:resource="https://w3id.org/mado#P02"/>
    <mado:classificacaoOperacional>OPERACIONALIZAVEL</mado:classificacaoOperacional>
    <mado:derivadoDe rdf:resource="https://w3id.org/mado#F06"/>
    <mado:enunciado xml:lang="pt-BR">Em interação assistiva, modalidade, ambiente físico, desempenho do dispositivo e tarefa são interdependentes; voz pode ampliar autonomia e, ao mesmo tempo, perder eficiência em ruído ou sob sobrecarga técnica.</mado:enunciado>
    <mado:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">K21</mado:identificador>
    <mado:natureza>RECONSTRUÇÃO ANALÍTICA FORTEMENTE SUSTENTADA</mado:natureza>
    <mado:origemDaEstruturacaoSemantica xml:lang="pt-BR">Relações derivadas de contextos e decisões documentados; complementações RC3 foram estabelecidas somente quando o enunciado, a articulação e os trechos sustentavam a aplicabilidade.</mado:origemDaEstruturacaoSemantica>
    <mado:statusDaRelacao>CONHECIMENTO_CANDIDATO</mado:statusDaRelacao>
    <mado:sustentadoPorTrecho rdf:resource="https://w3id.org/mado#TD-EV38"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mado#E03-F30">
    <rdf:type rdf:resource="https://w3id.org/mado#ReferenciaBibliografica"/>
    <rdfs:label xml:lang="pt-BR">E03-F30</rdfs:label>
    <mado:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E03-F30</mado:identificador>
