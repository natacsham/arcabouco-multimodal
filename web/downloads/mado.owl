  <rdf:Description rdf:about="https://w3id.org/mado#K36">
    <rdf:type rdf:resource="https://w3id.org/mado#ConhecimentoMultimodalArticulado"/>
    <rdfs:label xml:lang="pt-BR">Vídeo acrescenta valor a um recurso de aprendizagem quando representa mudança, processo, contraste temporal ou perspectiva que fala e imagem estática não expressem suficientemente; deve ser curto, introduzido por uma pergunta e acompanhado de controles, legendas, audiodescrição ou alternativa textual conforme o conteúdo.</rdfs:label>
    <mado:aplicavelAModalidade rdf:resource="https://w3id.org/mado#MOD-VIDEO"/>
    <mado:aplicavelANecessidade rdf:resource="https://w3id.org/mado#NEC-ALTERNATIVAS-DE-ACESSO-AO-RECURSO"/>
    <mado:aplicavelANecessidade rdf:resource="https://w3id.org/mado#NEC-ESTRUTURAR-RELACOES-HISTORICAS"/>
    <mado:aplicavelARecursoDigital rdf:resource="https://w3id.org/mado#RED-VIDEO-HISTORICO"/>
    <mado:aplicavelARecursoDisponivel rdf:resource="https://w3id.org/mado#REC-REPRODUTOR-VIDEO"/>
    <mado:aplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-CONSTRUIR-RECURSO-DIGITAL-HISTORIA"/>
    <mado:articulacao xml:lang="pt-BR">Combina a organização funcional de formatos das Personas, os conhecimentos sobre representação acessível e alternativas audiovisuais e o critério situado de relacionar recurso, interesse e objetivo. A modalidade é selecionada por função, não por novidade.</mado:articulacao>
    <mado:articuladoSobPerspectiva rdf:resource="https://w3id.org/mado#P02"/>
    <mado:articuladoSobPerspectiva rdf:resource="https://w3id.org/mado#P03"/>
    <mado:classificacaoOperacional>CONDICIONAL</mado:classificacaoOperacional>
    <mado:contribuiParaFuncaoDecisoria rdf:resource="https://w3id.org/mado#FUN-CONTEXTUALIZAR-MUDANCA"/>
    <mado:contribuiParaFuncaoDecisoria rdf:resource="https://w3id.org/mado#FUN-PRESERVAR-ACESSO"/>
    <mado:derivadoDe rdf:resource="https://w3id.org/mado#F03"/>
    <mado:derivadoDe rdf:resource="https://w3id.org/mado#F06"/>
    <mado:derivadoDe rdf:resource="https://w3id.org/mado#F08"/>
    <mado:derivadoDe rdf:resource="https://w3id.org/mado#F12"/>
    <mado:enunciado xml:lang="pt-BR">Vídeo acrescenta valor a um recurso de aprendizagem quando representa mudança, processo, contraste temporal ou perspectiva que fala e imagem estática não expressem suficientemente; deve ser curto, introduzido por uma pergunta e acompanhado de controles, legendas, audiodescrição ou alternativa textual conforme o conteúdo.</mado:enunciado>
    <mado:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">K36</mado:identificador>
    <mado:limite xml:lang="pt-BR">Não usar vídeo apenas para variar formato; a adequação do trecho e das alternativas precisa ser verificada no recurso final.</mado:limite>
    <mado:natureza>CONHECIMENTO_ARTICULADO_RC2</mado:natureza>
    <mado:origemDaEstruturacaoSemantica xml:lang="pt-BR">Produzido por ART-TRF-02 pela complementação entre conhecimentos de conteúdo, acessibilidade audiovisual e elicitação.</mado:origemDaEstruturacaoSemantica>
    <mado:requerElementoDoContexto rdf:resource="https://w3id.org/mado#REC-REPRODUTOR-VIDEO"/>
    <mado:restricao xml:lang="pt-BR">alternativas acessíveis</mado:restricao>
    <mado:restricao xml:lang="pt-BR">controle de reprodução</mado:restricao>
    <mado:restricao xml:lang="pt-BR">função temporal ou comparativa</mado:restricao>
    <mado:restricao xml:lang="pt-BR">pergunta de observação</mado:restricao>
    <mado:restricao xml:lang="pt-BR">vídeo curto</mado:restricao>
    <mado:statusDaRelacao>PRODUTO_DE_ARTICULACAO_RC2</mado:statusDaRelacao>
    <mado:sustentadoPorTrecho rdf:resource="https://w3id.org/mado#TD-EL02"/>
