  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mado#K29">
    <rdf:type rdf:resource="https://w3id.org/mado#ConhecimentoMultimodalArticulado"/>
    <rdfs:label xml:lang="pt-BR">Comunicação em contextos digitais de aprendizagem pode ser ampliada quando a interface admite múltiplas formas de entrada, percepção e expressão, incluindo voz, leitura, LIBRAS e anexos de áudio/vídeo, desde que cada alternativa mantenha acessibilidade própria.</rdfs:label>
    <mado:aplicavelAAmbiente rdf:resource="https://w3id.org/mado#AMB-CONTEXTO-DIGITAL-DE-APRENDIZAGEM-42D27F5"/>
    <mado:aplicavelABarreira rdf:resource="https://w3id.org/mado#BAR-CANAL-EXCLUSIVAMENTE-TEXTUAL-587ACB3"/>
    <mado:aplicavelABarreira rdf:resource="https://w3id.org/mado#BAR-DEPENDENCIA-DE-UMA-FORMA-UNICA-DE-INTERACAO-RECU-2416DFC"/>
    <mado:aplicavelACaracteristicaRelevanteDaPessoa rdf:resource="https://w3id.org/mado#CAR-PERFIS-FUNCIONAIS-DIVERSOS"/>
    <mado:aplicavelAModalidade rdf:resource="https://w3id.org/mado#MOD-AUDIO"/>
    <mado:aplicavelAModalidade rdf:resource="https://w3id.org/mado#MOD-TECLADO"/>
    <mado:aplicavelAModalidade rdf:resource="https://w3id.org/mado#MOD-TEXTO"/>
    <mado:aplicavelAModalidade rdf:resource="https://w3id.org/mado#MOD-VOZ"/>
    <mado:aplicavelANecessidade rdf:resource="https://w3id.org/mado#NEC-COMUNICACAO-MULTIFORMATO"/>
    <mado:aplicavelANecessidade rdf:resource="https://w3id.org/mado#NEC-ENTRADA-ALTERNATIVA"/>
    <mado:aplicavelARecursoDisponivel rdf:resource="https://w3id.org/mado#REC-TEXTO-AUDIO-VIDEO-LIBRAS-84F838D"/>
    <mado:aplicavelARecursoDisponivel rdf:resource="https://w3id.org/mado#REC-TTS-VOZ-VISUAL-LIBRAS-TECNOLOGIAS-ASSISTIVAS-INT-910BEF5"/>
    <mado:aplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-COMUNICAR-CONTEUDO-1545B38"/>
    <mado:aplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-ENVIAR-LER-MENSAGEM-INTERAGIR-COM-MENSAGENS-4C0CACA"/>
    <mado:articulacao xml:lang="pt-BR">A tela de mensagens combina barra multimodal, anexos em diferentes mídias e compatibilidade com tecnologias assistivas. O estudo explicita benefícios para perfis visuais, auditivos, motores e cognitivos e preserva a necessidade de compatibilidade e critérios para cada recurso.</mado:articulacao>
    <mado:articuladoSobPerspectiva rdf:resource="https://w3id.org/mado#P02"/>
    <mado:classificacaoOperacional>OPERACIONALIZAVEL</mado:classificacaoOperacional>
    <mado:contribuiParaFuncaoDecisoria rdf:resource="https://w3id.org/mado#FUN-EXPRESSAR-CONHECIMENTO"/>
    <mado:contribuiParaFuncaoDecisoria rdf:resource="https://w3id.org/mado#FUN-PRESERVAR-ACESSO"/>
    <mado:derivadoDe rdf:resource="https://w3id.org/mado#F08"/>
    <mado:enunciado xml:lang="pt-BR">Comunicação em contextos digitais de aprendizagem pode ser ampliada quando a interface admite múltiplas formas de entrada, percepção e expressão, incluindo voz, leitura, LIBRAS e anexos de áudio/vídeo, desde que cada alternativa mantenha acessibilidade própria.</mado:enunciado>
    <mado:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">K29</mado:identificador>
    <mado:natureza>RECONSTRUÇÃO ANALÍTICA FORTEMENTE SUSTENTADA</mado:natureza>
    <mado:origemDaEstruturacaoSemantica xml:lang="pt-BR">Relações derivadas de contextos e decisões documentados; complementações RC3 foram estabelecidas somente quando o enunciado, a articulação e os trechos sustentavam a aplicabilidade.</mado:origemDaEstruturacaoSemantica>
    <mado:restricao xml:lang="pt-BR">Comunicação</mado:restricao>
    <mado:restricao xml:lang="pt-BR">LIBRAS</mado:restricao>
    <mado:restricao xml:lang="pt-BR">Mensagens</mado:restricao>
    <mado:restricao xml:lang="pt-BR">TTS</mado:restricao>
    <mado:restricao xml:lang="pt-BR">anexos</mado:restricao>
    <mado:restricao xml:lang="pt-BR">aparência</mado:restricao>
    <mado:restricao xml:lang="pt-BR">critérios</mado:restricao>
    <mado:restricao xml:lang="pt-BR">tecnologias assistivas</mado:restricao>
    <mado:restricao xml:lang="pt-BR">texto</mado:restricao>
    <mado:restricao xml:lang="pt-BR">voz</mado:restricao>
    <mado:restricao xml:lang="pt-BR">vídeo</mado:restricao>
    <mado:restricao xml:lang="pt-BR">áudio</mado:restricao>
    <mado:statusDaRelacao>CONHECIMENTO_CANDIDATO</mado:statusDaRelacao>
    <mado:sustentadoPorTrecho rdf:resource="https://w3id.org/mado#TD-EV29"/>
