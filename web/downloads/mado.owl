</rdf:Description>
<rdf:Description rdf:about="https://w3id.org/mado#CA76">
<rdf:type rdf:resource="https://w3id.org/mado#CriterioDeDecisaoMultimodal" />
<ns1:label xml:lang="pt-BR">Um componente de interface não deve iniciar uma mudança de contexto (ex: carregar uma nova página ou mover o foco para outro lugar) simplesmente ao receber foco.</ns1:label>
<ns4:enunciado xml:lang="pt-BR">Um componente de interface não deve iniciar uma mudança de contexto (ex: carregar uma nova página ou mover o foco para outro lugar) simplesmente ao receber foco.</ns4:enunciado>
<ns4:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CA76</ns4:identificador>
<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0368" />
