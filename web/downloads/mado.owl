  <rdf:Description rdf:about="https://w3id.org/mado#D12">
    <rdf:type rdf:resource="https://w3id.org/mado#DecisaoDeAcessibilidadeMultimodal"/>
    <rdfs:label xml:lang="pt-BR">Para enfrentar simultaneamente barreiras de percepção visual e de controle na tela de conteúdo, combinar TTS, entrada por voz e ajustes de fonte/contraste conforme os critérios violados.</rdfs:label>
    <mado:aplicaCriterio rdf:resource="https://w3id.org/mado#CA10"/>
    <mado:aplicaCriterio rdf:resource="https://w3id.org/mado#CA28"/>
    <mado:aplicaCriterio rdf:resource="https://w3id.org/mado#CA38"/>
    <mado:aplicaCriterio rdf:resource="https://w3id.org/mado#CA88"/>
    <mado:condicaoDeAplicacao xml:lang="pt-BR">Composição deve ser selecionada conforme necessidade</mado:condicaoDeAplicacao>
    <mado:enunciado xml:lang="pt-BR">Para enfrentar simultaneamente barreiras de percepção visual e de controle na tela de conteúdo, combinar TTS, entrada por voz e ajustes de fonte/contraste conforme os critérios violados.</mado:enunciado>
    <mado:expressaoOperacional xml:lang="pt-BR">Na tela de conteúdo, disponibilizar recursos de percepção e controle como TTS, voz e ajustes visuais quando correspondam às barreiras e critérios identificados no cenário.</mado:expressaoOperacional>
    <mado:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D12</mado:identificador>
    <mado:natureza>RECONSTRUÇÃO ANALÍTICA FORTEMENTE SUSTENTADA</mado:natureza>
    <mado:rationale xml:lang="pt-BR">Por quê: o cenário apresenta zoom quebrado, contraste insuficiente e barreiras de navegação/controle. Para quê: ampliar percepção e operação. Como: cada recurso do redesign é ligado a critérios e a uma função diferente na tarefa.</mado:rationale>
    <mado:respondeA rdf:resource="https://w3id.org/mado#CTX-D12"/>
    <mado:statusDecisao>DECISAO_HISTORICA_RECONSTRUIDA</mado:statusDecisao>
    <mado:statusDoRegistro>DECISAO_HISTORICA_RECONSTRUIDA</mado:statusDoRegistro>
    <mado:sustentadaPor rdf:resource="https://w3id.org/mado#K25"/>
  </rdf:Description>
