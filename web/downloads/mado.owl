<rdf:type rdf:resource="https://w3id.org/mado#CriterioDeDecisaoMultimodal" />
<ns1:label xml:lang="pt-BR">O idioma principal do conteúdo e de quaisquer trechos em idiomas diferentes devem ser declarados de forma programática.</ns1:label>
<ns4:enunciado xml:lang="pt-BR">O idioma principal do conteúdo e de quaisquer trechos em idiomas diferentes devem ser declarados de forma programática.</ns4:enunciado>
