    <rdfs:label xml:lang="pt-BR">Rupturas de áudio, ambiente e feedback operacionalizam recuperabilidade</rdfs:label>
    <mado:articulaConhecimentoDeEntrada rdf:resource="https://w3id.org/mado#K01"/>
    <mado:articulaConhecimentoDeEntrada rdf:resource="https://w3id.org/mado#K02"/>
    <mado:articulaConhecimentoDeEntrada rdf:resource="https://w3id.org/mado#K04"/>
    <mado:articulaConhecimentoDeEntrada rdf:resource="https://w3id.org/mado#K05"/>
    <mado:articulaEntrada rdf:resource="https://w3id.org/mado#F01"/>
    <mado:articulaEntrada rdf:resource="https://w3id.org/mado#FN-ABNT-MOBILE"/>
