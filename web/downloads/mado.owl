  <rdf:Description rdf:about="https://w3id.org/mado#K28">
    <rdf:type rdf:resource="https://w3id.org/mado#ConhecimentoMultimodalArticulado"/>
    <rdfs:label xml:lang="pt-BR">Em formulários e comunicação digital, acessibilidade depende de uma sequência operacional compreensível: rótulos/instruções, foco e teclado, identificação de erros, confirmação e feedback de status precisam funcionar de forma coordenada.</rdfs:label>
    <mado:aplicavelAAmbiente rdf:resource="https://w3id.org/mado#AMB-CONTEXTO-DIGITAL-DE-APRENDIZAGEM-42D27F5"/>
    <mado:aplicavelABarreira rdf:resource="https://w3id.org/mado#BAR-ROTULOS-FOCO-ERRO-STATUS-INADEQUADOS-219BE43"/>
    <mado:aplicavelACaracteristicaRelevanteDaPessoa rdf:resource="https://w3id.org/mado#CAR-PERFIS-FUNCIONAIS-DIVERSOS"/>
    <mado:aplicavelAModalidade rdf:resource="https://w3id.org/mado#MOD-TECLADO"/>
    <mado:aplicavelARecursoDisponivel rdf:resource="https://w3id.org/mado#REC-TEXTO-TECLADO-FOCO-FEEDBACK-STATUS-97D641F"/>
    <mado:aplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-EXECUTAR-TAREFAS-NO-AVA-7BEF3BD"/>
    <mado:aplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-PREENCHER-ENVIAR-MENSAGEM-0C1FB87"/>
    <mado:articulacao xml:lang="pt-BR">A análise da tela de mensagens parte de critérios essenciais violados e estrutura o formulário redesenhado com rótulos, navegação lógica, foco visível, erros, confirmação e status acessível. A decisão não é um item isolado, mas a coordenação de estados e respostas ao longo da tarefa.</mado:articulacao>
    <mado:articuladoSobPerspectiva rdf:resource="https://w3id.org/mado#P02"/>
    <mado:classificacaoOperacional>OPERACIONALIZAVEL</mado:classificacaoOperacional>
    <mado:contribuiParaFuncaoDecisoria rdf:resource="https://w3id.org/mado#FUN-ACOMPANHAR-RESULTADO"/>
    <mado:contribuiParaFuncaoDecisoria rdf:resource="https://w3id.org/mado#FUN-CONSOLIDAR-COM-FEEDBACK"/>
    <mado:derivadoDe rdf:resource="https://w3id.org/mado#F08"/>
    <mado:enunciado xml:lang="pt-BR">Em formulários e comunicação digital, acessibilidade depende de uma sequência operacional compreensível: rótulos/instruções, foco e teclado, identificação de erros, confirmação e feedback de status precisam funcionar de forma coordenada.</mado:enunciado>
    <mado:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">K28</mado:identificador>
    <mado:natureza>RECONSTRUÇÃO ANALÍTICA FORTEMENTE SUSTENTADA</mado:natureza>
    <mado:origemDaEstruturacaoSemantica xml:lang="pt-BR">Relações derivadas de contextos e decisões documentados; complementações RC3 foram estabelecidas somente quando o enunciado, a articulação e os trechos sustentavam a aplicabilidade.</mado:origemDaEstruturacaoSemantica>
    <mado:restricao xml:lang="pt-BR">Formulário</mado:restricao>
    <mado:restricao xml:lang="pt-BR">confirmação</mado:restricao>
    <mado:restricao xml:lang="pt-BR">critérios</mado:restricao>
    <mado:restricao xml:lang="pt-BR">erros</mado:restricao>
    <mado:restricao xml:lang="pt-BR">foco</mado:restricao>
    <mado:restricao xml:lang="pt-BR">rótulos</mado:restricao>
    <mado:restricao xml:lang="pt-BR">status</mado:restricao>
    <mado:restricao xml:lang="pt-BR">teclado</mado:restricao>
    <mado:statusDaRelacao>CONHECIMENTO_CANDIDATO</mado:statusDaRelacao>
    <mado:sustentadoPorTrecho rdf:resource="https://w3id.org/mado#TD-EV29"/>
    <mado:sustentadoPorTrecho rdf:resource="https://w3id.org/mado#TD-EV30"/>
  </rdf:Description>
