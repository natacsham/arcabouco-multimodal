  <rdf:Description rdf:about="https://w3id.org/mado#D17">
    <rdf:type rdf:resource="https://w3id.org/mado#DecisaoDeAcessibilidadeMultimodal"/>
    <rdfs:label xml:lang="pt-BR">Para permitir expressão além do texto escrito, admitir anexos multimodais como áudio e vídeo quando pertinentes à tarefa de comunicação.</rdfs:label>
    <mado:aplicaCriterio rdf:resource="https://w3id.org/mado#CA01"/>
    <mado:aplicaCriterio rdf:resource="https://w3id.org/mado#CA17"/>
    <mado:condicaoDeAplicacao xml:lang="pt-BR">Anexos precisam de requisitos próprios de acessibilidade</mado:condicaoDeAplicacao>
    <mado:enunciado xml:lang="pt-BR">Para permitir expressão além do texto escrito, admitir anexos multimodais como áudio e vídeo quando pertinentes à tarefa de comunicação.</mado:enunciado>
    <mado:expressaoOperacional xml:lang="pt-BR">Permitir anexos multimodais como alternativa ou complemento ao texto quando forem pertinentes à tarefa de comunicação, mantendo requisitos de acessibilidade para cada mídia.</mado:expressaoOperacional>
    <mado:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D17</mado:identificador>
    <mado:natureza>RECONSTRUÇÃO ANALÍTICA FORTEMENTE SUSTENTADA</mado:natureza>
    <mado:rationale xml:lang="pt-BR">Por quê: canal textual exclusivo pode limitar expressão e participação. Para quê: oferecer formas alternativas/complementares de comunicação. Como: o redesign inclui anexos multimodais e os relaciona a critérios de acessibilidade.</mado:rationale>
    <mado:respondeA rdf:resource="https://w3id.org/mado#CTX-D17"/>
    <mado:statusDecisao>DECISAO_HISTORICA_RECONSTRUIDA</mado:statusDecisao>
    <mado:statusDoRegistro>DECISAO_HISTORICA_RECONSTRUIDA</mado:statusDoRegistro>
    <mado:sustentadaPor rdf:resource="https://w3id.org/mado#K29"/>
  </rdf:Description>
