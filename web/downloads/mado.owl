  <rdf:Description rdf:about="https://w3id.org/mado#K42">
    <rdf:type rdf:resource="https://w3id.org/mado#ConhecimentoMultimodalArticulado"/>
    <rdfs:label xml:lang="pt-BR">Imagem, desenho e vídeo somente ampliam o acesso quando cada modo tem função explícita e o significado essencial permanece disponível por estrutura, descrição, legenda, audiodescrição ou alternativa equivalente.</rdfs:label>
    <mado:aplicavelABarreira rdf:resource="https://w3id.org/mado#BAR-CANAL-EXCLUSIVAMENTE-TEXTUAL-587ACB3"/>
