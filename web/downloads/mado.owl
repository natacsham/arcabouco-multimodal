<rdf:Description rdf:about="https://w3id.org/mado#CA16">
<rdf:type rdf:resource="https://w3id.org/mado#CriterioDeDecisaoMultimodal" />
<ns1:label xml:lang="pt-BR">Áudio-apenas e vídeo-apenas pré-gravados devem ter alternativa em texto e, para vídeo, audiodescrição.</ns1:label>
<ns4:criterioAplicavelABarreira rdf:resource="https://w3id.org/mado#BAR-CONTEUDO-AUDIOVISUAL-OU-VISUAL-SEM-ALTERNATIVA-7F52587" />
<ns4:criterioAplicavelAModalidade rdf:resource="https://w3id.org/mado#MOD-VIDEO" />
<ns4:criterioAplicavelARecurso rdf:resource="https://w3id.org/mado#RED-VIDEO-CURTO-HISTORIA" />
<ns4:criterioAplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-CONSTRUIR-RECURSO-DIGITAL-HISTORIA" />
<ns4:criterioAplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-CONSUMIR-MIDIA-MATERIAL-A2D1D3F" />
<ns4:criterioAplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-EXPLICAR-CONTEUDO-HISTORIA" />
<ns4:criterioAplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-REVISAR-PUBLICAR-RECURSO" />
<ns4:enunciado xml:lang="pt-BR">Áudio-apenas e vídeo-apenas pré-gravados devem ter alternativa em texto e, para vídeo, audiodescrição.</ns4:enunciado>
<ns4:funcaoDecisoria xml:lang="pt-BR">introduzir ou confirmar uma relação que fala e imagem estática não expressem adequadamente</ns4:funcaoDecisoria>
<ns4:funcaoDecisoria xml:lang="pt-BR">preservar conteúdo audiovisual por modalidades equivalentes</ns4:funcaoDecisoria>
<ns4:fundamentadoPor rdf:resource="https://w3id.org/mado#K10" />
<ns4:fundamentadoPor rdf:resource="https://w3id.org/mado#K17" />
<ns4:fundamentadoPor rdf:resource="https://w3id.org/mado#K19" />
<ns4:fundamentadoPor rdf:resource="https://w3id.org/mado#K26" />
<ns4:fundamentadoPor rdf:resource="https://w3id.org/mado#K31" />
<ns4:fundamentadoPor rdf:resource="https://w3id.org/mado#K34" />
<ns4:fundamentadoPor rdf:resource="https://w3id.org/mado#K36" />
<ns4:fundamentadoPor rdf:resource="https://w3id.org/mado#K38" />
<ns4:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CA16</ns4:identificador>
<ns4:justificativaDeFundamentacao xml:lang="pt-BR">Oferecer alternativa equivalente para conteúdo somente em áudio ou vídeo. Em versão anterior, a ligação foi reconstruída analiticamente porque o critério participa de uma configuração modalidade–função–recurso–responsável fundamentada por esses conhecimentos; não se atribui essa formalização retrospectiva às publicações originais. Na RC2, a ligação ao conhecimento articulado foi conferida para o cenário de transferência e permanece limitada às condições registradas.</ns4:justificativaDeFundamentacao>
<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0142" />
<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0143" />
<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0144" />
<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0145" />
<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0146" />
<ns4:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0147" />
<ns4:statusDaRelacao>JUSTIFICATIVA_DOCUMENTADA</ns4:statusDaRelacao>
</rdf:Description>
<rdf:Description rdf:about="https://w3id.org/mado#CA17">
<rdf:type rdf:resource="https://w3id.org/mado#CriterioDeDecisaoMultimodal" />
<ns1:label xml:lang="pt-BR">Vídeos com áudio devem oferecer legendas sincronizadas.</ns1:label>
<ns4:criterioAplicavelABarreira rdf:resource="https://w3id.org/mado#BAR-CONTEUDO-AUDIOVISUAL-OU-VISUAL-SEM-ALTERNATIVA-7F52587" />
