  <rdf:Description rdf:about="https://w3id.org/mado#CA16">
    <rdf:type rdf:resource="https://w3id.org/mado#CriterioDeDecisaoMultimodal"/>
    <rdfs:label xml:lang="pt-BR">Áudio-apenas e vídeo-apenas pré-gravados devem ter alternativa em texto e, para vídeo, audiodescrição.</rdfs:label>
    <mado:criterioAplicavelABarreira rdf:resource="https://w3id.org/mado#BAR-CONTEUDO-AUDIOVISUAL-OU-VISUAL-SEM-ALTERNATIVA-7F52587"/>
    <mado:criterioAplicavelAModalidade rdf:resource="https://w3id.org/mado#MOD-VIDEO"/>
    <mado:criterioAplicavelARecurso rdf:resource="https://w3id.org/mado#RED-VIDEO-CURTO-HISTORIA"/>
    <mado:criterioAplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-CONSTRUIR-RECURSO-DIGITAL-HISTORIA"/>
    <mado:criterioAplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-CONSUMIR-MIDIA-MATERIAL-A2D1D3F"/>
    <mado:criterioAplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-EXPLICAR-CONTEUDO-HISTORIA"/>
    <mado:criterioAplicavelATarefa rdf:resource="https://w3id.org/mado#TAR-REVISAR-PUBLICAR-RECURSO"/>
    <mado:enunciado xml:lang="pt-BR">Áudio-apenas e vídeo-apenas pré-gravados devem ter alternativa em texto e, para vídeo, audiodescrição.</mado:enunciado>
    <mado:funcaoDecisoria xml:lang="pt-BR">introduzir ou confirmar uma relação que fala e imagem estática não expressem adequadamente</mado:funcaoDecisoria>
    <mado:funcaoDecisoria xml:lang="pt-BR">preservar conteúdo audiovisual por modalidades equivalentes</mado:funcaoDecisoria>
    <mado:fundamentadoPor rdf:resource="https://w3id.org/mado#K10"/>
    <mado:fundamentadoPor rdf:resource="https://w3id.org/mado#K17"/>
    <mado:fundamentadoPor rdf:resource="https://w3id.org/mado#K19"/>
    <mado:fundamentadoPor rdf:resource="https://w3id.org/mado#K26"/>
    <mado:fundamentadoPor rdf:resource="https://w3id.org/mado#K31"/>
    <mado:fundamentadoPor rdf:resource="https://w3id.org/mado#K34"/>
    <mado:fundamentadoPor rdf:resource="https://w3id.org/mado#K36"/>
    <mado:fundamentadoPor rdf:resource="https://w3id.org/mado#K38"/>
    <mado:identificador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CA16</mado:identificador>
    <mado:justificativaDeFundamentacao xml:lang="pt-BR">Oferecer alternativa equivalente para conteúdo somente em áudio ou vídeo. Em versão anterior, a ligação foi reconstruída analiticamente porque o critério participa de uma configuração modalidade–função–recurso–responsável fundamentada por esses conhecimentos; não se atribui essa formalização retrospectiva às publicações originais. Na RC2, a ligação ao conhecimento articulado foi conferida para o cenário de transferência e permanece limitada às condições registradas.</mado:justificativaDeFundamentacao>
    <mado:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0142"/>
    <mado:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0143"/>
    <mado:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0144"/>
    <mado:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0145"/>
    <mado:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0146"/>
    <mado:possuiOrigem rdf:resource="https://w3id.org/mado#ORI-0147"/>
    <mado:statusDaRelacao>JUSTIFICATIVA_DOCUMENTADA</mado:statusDaRelacao>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mado#CA80">
    <rdf:type rdf:resource="https://w3id.org/mado#CriterioDeDecisaoMultimodal"/>
    <rdfs:label xml:lang="pt-BR">Quando um erro de entrada de dados é detectado, ele deve ser identificado em texto, descrevendo claramente qual é o problema e qual campo o contém.</rdfs:label>
    <mado:criterioAplicavelAModalidade rdf:resource="https://w3id.org/mado#MOD-TECLADO"/>
