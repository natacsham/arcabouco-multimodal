@prefix ex: <https://w3id.org/mado/execution#> .
@prefix mado: <https://w3id.org/mado#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix cat: <https://w3id.org/mado/catalogue#> .

# Proveniência migrada do piloto: suas próprias parcelas e estados documentais
# são verificados, sem inventar revisão/revisor/data do protocolo MADO anterior.
@prefix v2: <https://w3id.org/mado/experimental/v2#> .
@prefix mado: <https://w3id.org/mado#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

v2:TaskShape a sh:NodeShape ; sh:targetClass v2:Task ;
  sh:property [ sh:path v2:requiresFunction ; sh:minCount 1 ; sh:class v2:Function ] ;
  sh:property [ sh:path v2:inputType ; sh:minCount 1 ; sh:maxCount 1 ; sh:class v2:Representation ] ;
  sh:property [ sh:path v2:outputType ; sh:minCount 1 ; sh:maxCount 1 ; sh:class v2:Representation ] ;
  sh:sparql [ sh:message "Funções da tarefa precisam ter ordens distintas." ; sh:select """
    PREFIX v2: <https://w3id.org/mado/experimental/v2#>
    SELECT $this WHERE { $this v2:requiresFunction ?a, ?b .
      ?a v2:order ?n . ?b v2:order ?n . FILTER (?a != ?b) }
  """ ] .
v2:FunctionShape a sh:NodeShape ; sh:targetClass v2:Function ;
  sh:property [ sh:path v2:order ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] .

# An ungrounded capability is a documented candidate, not a malformed graph.
# The compositor must exclude it; the extension test relies on that boundary.
v2:CapabilityShape a sh:NodeShape ; sh:targetClass v2:Capability ;
  sh:property [ sh:path rdfs:label ; sh:minCount 1 ] ;
  sh:property [ sh:path v2:provides ; sh:minCount 1 ; sh:maxCount 1 ; sh:class v2:Function ] ;
  sh:property [ sh:path v2:mode ; sh:minCount 1 ; sh:maxCount 1 ; sh:class v2:Mode ] ;
  sh:property [ sh:path v2:inputType ; sh:minCount 1 ; sh:maxCount 1 ; sh:class v2:Representation ] ;
  sh:property [ sh:path v2:outputType ; sh:minCount 1 ; sh:maxCount 1 ; sh:class v2:Representation ] ;
  sh:property [ sh:path v2:requiresResource ; sh:minCount 1 ; sh:class v2:Resource ] ;
  sh:property [ sh:path v2:requiresFact ; sh:minCount 1 ; sh:class v2:ContextFact ] ;
  sh:property [ sh:path v2:action ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ;
  sh:property [ sh:path v2:limitation ; sh:minCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] .

v2:SourceShape a sh:NodeShape ; sh:targetSubjectsOf v2:url ;
  sh:property [ sh:path rdfs:label ; sh:minCount 1 ] ;
  sh:property [ sh:path v2:url ; sh:minCount 1 ; sh:datatype xsd:string ; sh:pattern "^https://" ] .
v2:ExcerptShape a sh:NodeShape ; sh:targetObjectsOf v2:excerpt ;
  sh:property [ sh:path mado:trechoDeFonte ; sh:minCount 1 ; sh:maxCount 1 ; sh:class mado:Fonte ] ;
  sh:property [ sh:path mado:localizacaoDocumental ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] .
v2:ContributionShape a sh:NodeShape ; sh:targetClass v2:Contribution ;
  sh:property [ sh:path v2:inArticulation ; sh:minCount 1 ; sh:maxCount 1 ; sh:class v2:ArticulationSupport ] ;
  sh:property [ sh:path v2:excerpt ; sh:minCount 1 ; sh:maxCount 1 ; sh:class mado:TrechoDocumental ] ;
  sh:property [ sh:path v2:statement ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ;
  sh:property [ sh:path v2:status ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ("PRIMARY_CHECKED" "LEGACY_RECORD_ONLY" "PENDING") ] .
cat:ConhecimentoDoPilotoShape a sh:NodeShape ; sh:targetObjectsOf v2:knowledge ;
  sh:property [ sh:path rdfs:label ; sh:minCount 1 ] ;
  sh:property [ sh:path v2:epistemicStatus ; sh:minCount 1 ; sh:maxCount 1 ;
    sh:in ("DESIGN_SYNTHESIS_NOT_EMPIRICAL" "PARTIAL_LEGACY" "PENDING") ] ;
  sh:sparql [ sh:message "A síntese do piloto precisa de articulação, contribuição, trecho e fonte localizados; não substitui a curadoria documental nativa."@pt-BR ;
    sh:select """
      PREFIX v2: <https://w3id.org/mado/experimental/v2#>
      PREFIX mado: <https://w3id.org/mado#>
      SELECT $this WHERE {
        FILTER NOT EXISTS {
          ?art a v2:ArticulationSupport ; v2:produces $this .
          ?c a v2:Contribution ; v2:inArticulation ?art ; v2:excerpt ?td .
          ?td mado:trechoDeFonte ?source ; mado:localizacaoDocumental ?location .
        }
      }
    """
  ] .
v2:ArticulationShape a sh:NodeShape ; sh:targetClass v2:ArticulationSupport ;
  sh:property [ sh:path v2:produces ; sh:minCount 1 ; sh:maxCount 1 ; sh:class mado:ConhecimentoMultimodalArticulado ] ;
  sh:property [ sh:path v2:status ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ("CURATED_FOR_PILOT" "PENDING") ] ;
  sh:property [ sh:path v2:operation ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ;
  sh:property [ sh:path v2:addedUnderstanding ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ;
  sh:sparql [ sh:message "Articulação habilitada precisa de contribuição primária conferida, não só registro legado." ; sh:select """
    PREFIX v2: <https://w3id.org/mado/experimental/v2#>
    SELECT $this WHERE {
      $this v2:status "CURATED_FOR_PILOT" .
      FILTER NOT EXISTS { ?c a v2:Contribution ; v2:inArticulation $this ; v2:status "PRIMARY_CHECKED" }
    }
  """ ] .
v2:CriterionShape a sh:NodeShape ; sh:targetObjectsOf v2:criterion ;
  sh:property [ sh:path rdfs:label ; sh:minCount 1 ] ;
  sh:property [ sh:path v2:source ; sh:minCount 1 ; sh:maxCount 1 ; sh:class mado:Fonte ] ;
  sh:property [ sh:path v2:locator ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ;
  sh:property [ sh:path v2:justification ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] .

v2:SupportShape a sh:NodeShape ; sh:targetClass v2:GroundingApplication, v2:RelationRule ;
  sh:property [ sh:path v2:knowledge ; sh:minCount 1 ; sh:maxCount 1 ; sh:class mado:ConhecimentoMultimodalArticulado ] ;
  sh:property [ sh:path v2:criterion ; sh:minCount 1 ; sh:maxCount 1 ; sh:class mado:CriterioDeDecisaoMultimodal ] ;
  sh:property [ sh:path v2:articulation ; sh:minCount 1 ; sh:maxCount 1 ; sh:class v2:ArticulationSupport ] ;
  sh:property [ sh:path v2:status ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ("CURATED_FOR_PILOT" "PENDING") ] ;
  sh:sparql [ sh:message "O conhecimento do vínculo deve ser o produzido pela articulação indicada." ; sh:select """
    PREFIX v2: <https://w3id.org/mado/experimental/v2#>
    SELECT $this WHERE { $this v2:knowledge ?k ; v2:articulation ?a .
      FILTER NOT EXISTS { ?a v2:produces ?k } }
  """ ] .
v2:GroundingShape a sh:NodeShape ; sh:targetClass v2:GroundingApplication ;
  sh:property [ sh:path v2:capability ; sh:minCount 1 ; sh:maxCount 1 ; sh:class v2:Capability ] ;
  sh:property [ sh:path v2:justification ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] .
v2:RelationShape a sh:NodeShape ; sh:targetClass v2:RelationRule ;
  sh:property [ sh:path v2:fromFunction ; sh:minCount 1 ; sh:maxCount 1 ; sh:class v2:Function ] ;
  sh:property [ sh:path v2:toFunction ; sh:minCount 1 ; sh:maxCount 1 ; sh:class v2:Function ] ;
  sh:property [ sh:path v2:sharedType ; sh:minCount 1 ; sh:maxCount 1 ; sh:class v2:Representation ] ;
  sh:property [ sh:path v2:relationKind ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path v2:requiresFact ; sh:minCount 1 ; sh:class v2:ContextFact ] ;
  sh:property [ sh:path v2:explanation ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] .

# 1.6: the executable catalogue is inspected through actual semantic edges.
# Conditions and supports may be pending; syntax cannot approve their content.
mado:OperacaoDoCatalogoShape a sh:NodeShape ;
  sh:targetClass mado:OperacaoDeInteracao ;
  sh:or (
    [ sh:property [ sh:path mado:funcoesDoContrato ; sh:minCount 1 ] ;
      sh:property [ sh:path mado:suportesDoContrato ; sh:minCount 1 ] ]
    [ sh:property [ sh:path mado:operacaoBaseDaVariante ; sh:minCount 1 ; sh:maxCount 1 ; sh:class mado:OperacaoDeInteracao ] ]
  ) ;
  sh:property [ sh:path mado:relacoesDoContrato ; sh:class mado:RelacaoOperacional ] ;
  sh:property [ sh:path mado:suportesDoContrato ; sh:class mado:SuporteOperacional ] ;
  sh:sparql [
    sh:message "A aplicação indicada deve autorizar esta operação, sem autorização herdada de outro alvo."@pt-BR ;
    sh:select """
      PREFIX mado: <https://w3id.org/mado#>
      SELECT $this WHERE {
        $this mado:aplicacoesAutorizadorasDoContrato ?app .
        FILTER NOT EXISTS { ?app mado:autorizaOperacao $this }
      }
    """
  ] .

mado:PremissasDoCatalogoShape a sh:NodeShape ;
  sh:targetSubjectsOf mado:premissasEstruturadasDaAplicacao ;
  sh:sparql [
    sh:message "As premissas cumulativas estruturadas e as arestas premissaOperacional devem coincidir; retirar uma não reduz silenciosamente a obrigação."@pt-BR ;
    sh:select """
      PREFIX mado: <https://w3id.org/mado#>
      SELECT $this WHERE {
        { $this mado:premissasEstruturadasDaAplicacao ?p . ?p mado:parcelaDoSuporteOperacional ?claim .
          FILTER NOT EXISTS { $this mado:premissaOperacional ?claim } }
        UNION
        { $this mado:premissaOperacional ?claim .
          FILTER NOT EXISTS { $this mado:premissasEstruturadasDaAplicacao/mado:parcelaDoSuporteOperacional ?claim } }
      }
    """
  ] .

mado:SuporteDoCatalogoShape a sh:NodeShape ;
  sh:targetClass mado:SuporteOperacional ;
  sh:or (
    [ sh:property [ sh:path mado:conhecimentoDoSuporteOperacional ; sh:minCount 1 ; sh:maxCount 1 ] ;
      sh:property [ sh:path mado:parcelaDoSuporteOperacional ; sh:minCount 1 ; sh:maxCount 1 ] ]
    [ sh:property [ sh:path mado:fundamentoRdfDoContrato ; sh:minCount 1 ; sh:maxCount 1 ] ]
  ) ;
  sh:sparql [
    sh:message "O suporte deve preservar a ligação exata entre parcela e conhecimento, sem produto cartesiano entre critérios e fontes."@pt-BR ;
    sh:select """
      PREFIX mado: <https://w3id.org/mado#>
      SELECT $this WHERE {
        $this mado:conhecimentoDoSuporteOperacional ?k ; mado:parcelaDoSuporteOperacional ?claim .
        FILTER NOT EXISTS { ?claim mado:afirmacaoDoConhecimento ?k }
      }
    """
  ] ;
  sh:sparql [
    sh:message "Uma origem usada pelo suporte deve pertencer ao critério indicado e possuir trecho documental."@pt-BR ;
    sh:select """
      PREFIX mado: <https://w3id.org/mado#>
      SELECT $this WHERE {
        $this mado:criterioDoSuporteOperacional ?criterion .
        FILTER(NOT EXISTS { $this mado:origensDoSuporteOperacional ?origin }
          || EXISTS { $this mado:origensDoSuporteOperacional ?o .
              FILTER NOT EXISTS { ?criterion mado:possuiOrigem ?o . ?o mado:origemSustentadaPorTrecho ?t } })
      }
    """
  ] .

mado:RelacaoDoCatalogoShape a sh:NodeShape ;
  sh:targetClass mado:RelacaoOperacional ;
  sh:property [ sh:path cat:field-kind ; sh:minCount 1 ; sh:maxCount 1 ;
    sh:in ("SEQUENTIAL" "SEQUENTIAL_REVIEW" "ALTERNATIVE" "COMPLEMENTARITY" "REDUNDANCY") ] ;
  sh:property [ sh:path (mado:escopoEstruturadoDoContrato cat:literal) ; sh:minCount 1 ; sh:maxCount 1 ;
    sh:in ("WITHIN_OPERATION" "BETWEEN_OPERATIONS") ] ;
  sh:property [ sh:path mado:funcoesDeOrigemDaRelacao ; sh:minCount 1 ] ;
  sh:property [ sh:path mado:funcoesDeDestinoDaRelacao ; sh:minCount 1 ] ;
  sh:or (
    [ sh:property [ sh:path mado:suportesDoContrato ; sh:minCount 1 ] ]
    [ sh:property [ sh:path mado:aplicacoesAutorizadorasDoContrato ; sh:minCount 1 ] ]
  ) ;
  sh:sparql [
    sh:message "A aplicação indicada deve autorizar esta relação operacional específica."@pt-BR ;
    sh:select """
      PREFIX mado: <https://w3id.org/mado#>
      SELECT $this WHERE {
        $this mado:aplicacoesAutorizadorasDoContrato ?app .
        FILTER NOT EXISTS { ?app mado:autorizaRelacaoOperacional $this }
      }
    """
  ] .

mado:PapelInformacionalDoCatalogoShape a sh:NodeShape ;
  sh:targetClass mado:PapelInformacionalNaRelacao ;
  sh:property [ sh:path mado:representacaoDoRequisito ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path mado:funcaoDoPapelInformacional ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path mado:parcelaInformacionalDoPapel ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:or (
    [ sh:property [ sh:path (mado:suficienciaIsoladaParaObjetivo cat:literal) ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ] ]
    [ sh:property [ sh:path cat:order-alone_sufficient_for_goal ; sh:hasValue cat:NullValue ] ;
      sh:property [ sh:path mado:suficienciaIsoladaParaObjetivo ; sh:maxCount 0 ] ]
  ) ;
  sh:property [ sh:path mado:parcelasDaDerivacao ; sh:minCount 1 ] .

# PENDING and PROPOSED are legitimate documentary states, never implicit support.
mado:AfirmacaoOperacionalShape a sh:NodeShape ;
  sh:targetClass mado:AfirmacaoOperacionalDocumentada ;
  sh:property [ sh:path mado:identificador ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path mado:enunciado ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path mado:elegibilidadeOperacional ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path mado:estadoDaAfirmacao ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:or (
    [ sh:property [ sh:path mado:afirmacaoDoConhecimento ; sh:minCount 1 ; sh:maxCount 1 ; sh:class mado:ConhecimentoMultimodalArticulado ] ;
      sh:property [ sh:path mado:elegibilidadeOperacional ; sh:in ( "DOCUMENTED_OPERATIONAL_CLAIM" "PROPOSED_OPERATIONALIZATION" "NOT_ELIGIBLE" ) ] ;
      sh:property [ sh:path mado:estadoDaAfirmacao ; sh:in ( "SUPPORTED_IN_RECORDED_SCOPE" "PROPOSED_OPERATIONALIZATION" "PENDING" ) ] ]
    [ sh:property [ sh:path mado:aplicacaoDaArticulacao ; sh:minCount 1 ; sh:maxCount 1 ; sh:class mado:ArticulacaoDocumentada ] ;
      sh:property [ sh:path mado:elegibilidadeOperacional ; sh:hasValue "GROUNDED_ANALYTICAL_APPLICATION" ] ;
      sh:property [ sh:path mado:estadoDaAfirmacao ; sh:hasValue "SCOPED_ANALYTICAL_SYNTHESIS" ] ]
  ) ;
  sh:property [ sh:path mado:limiteDaAfirmacao ; sh:minCount 1 ] ;
  sh:sparql [
    sh:message "Afirmação operacional elegível exige estado compatível e suporte localizado no conhecimento exato."@pt-BR ;
    sh:select """
      PREFIX mado: <https://w3id.org/mado#>
      SELECT $this WHERE {
        $this mado:elegibilidadeOperacional "DOCUMENTED_OPERATIONAL_CLAIM" ; mado:afirmacaoDoConhecimento ?k .
        FILTER ( NOT EXISTS { $this mado:estadoDaAfirmacao "SUPPORTED_IN_RECORDED_SCOPE" } ||
                 NOT EXISTS { $this mado:trechoDaAfirmacao ?t ; mado:fonteDaAfirmacao ?f .
                              ?k mado:sustentadoPorTrecho ?t ; mado:derivadoDe ?f .
                              ?t mado:trechoDeFonte ?f . } )
      }
    """
  ] ;
  sh:sparql [
    sh:message "Cada trecho da afirmação deve pertencer ao conhecimento e a uma fonte da própria afirmação."@pt-BR ;
    sh:select """
      PREFIX mado: <https://w3id.org/mado#>
      SELECT $this ?t WHERE {
        $this mado:elegibilidadeOperacional "DOCUMENTED_OPERATIONAL_CLAIM" ;
              mado:afirmacaoDoConhecimento ?k ; mado:trechoDaAfirmacao ?t .
        FILTER NOT EXISTS { ?k mado:sustentadoPorTrecho ?t ; mado:derivadoDe ?f .
                            ?t mado:trechoDeFonte ?f . $this mado:fonteDaAfirmacao ?f . }
      }
    """
  ] .

mado:FuncaoRequeridaSituadaShape a sh:NodeShape ;
  sh:targetClass mado:FuncaoRequeridaSituada ;
  sh:or (
    [ sh:not [ sh:property [ sh:path ex:forExecution ; sh:minCount 1 ] ] ; sh:node mado:FuncaoRequeridaSituadaShapeLegacy ]
    [ sh:property [ sh:path ex:forExecution ; sh:minCount 1 ; sh:maxCount 1 ; sh:class ex:Execution ;
        sh:node [ sh:property [ sh:path ex:contractVersion ; sh:hasValue "MADO_EXECUTION_GRAPH_1" ] ] ] ;
      sh:node ex:RequirementContractShape ]
  ) .

mado:FuncaoRequeridaSituadaShapeLegacy a sh:NodeShape ;
  sh:property [ sh:path mado:noContexto ; sh:minCount 1 ; sh:maxCount 1 ; sh:class mado:ContextoDeInteracaoDigital ] ;
  sh:property [ sh:path mado:paraTarefa ; sh:minCount 1 ] ;
  sh:property [ sh:path mado:requerFuncao ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path mado:paraParticipacao ; sh:class mado:ParticipacaoNoContexto ] ;
  sh:sparql [
    sh:message "A participação do requisito deve pertencer ao contexto ou ao seu contexto pai."@pt-BR ;
    sh:select """
      PREFIX mado: <https://w3id.org/mado#>
      SELECT $this ?p WHERE {
        $this mado:noContexto ?ctx ; mado:paraParticipacao ?p .
        FILTER NOT EXISTS { ?p mado:participacaoEmContexto ?ctx }
        FILTER NOT EXISTS { ?ctx mado:episodioDoContexto ?parent . ?p mado:participacaoEmContexto ?parent }
      }
    """
  ] .

mado:ConhecimentoShape a sh:NodeShape ;
  sh:targetClass mado:ConhecimentoMultimodalArticulado ;
  sh:or ( [ sh:node mado:ConhecimentoCuradoShape ] [ sh:node cat:ConhecimentoDoPilotoShape ] ) .

mado:ConhecimentoCuradoShape a sh:NodeShape ;
  sh:property [ sh:path mado:identificador ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path mado:enunciado ; sh:minCount 1 ] ;
  sh:property [ sh:path mado:derivadoDe ; sh:minCount 1 ; sh:class mado:Fonte ] ;
  sh:property [ sh:path mado:sustentadoPorTrecho ; sh:minCount 1 ; sh:class mado:TrechoDocumental ] ;
  sh:property [ sh:path mado:articuladoSobPerspectiva ; sh:minCount 1 ; sh:class mado:Perspectiva ] ;
  sh:property [ sh:path mado:classificacaoOperacional ; sh:minCount 1 ; sh:maxCount 1 ] .

mado:ContextoShape a sh:NodeShape ;
  sh:targetClass mado:ContextoDeInteracaoDigital ;
  sh:or (
    [ sh:not [ sh:property [ sh:path ex:forExecution ; sh:minCount 1 ] ] ; sh:node mado:ContextoShapeLegacy ]
    [ sh:property [ sh:path ex:forExecution ; sh:minCount 1 ; sh:maxCount 1 ; sh:class ex:Execution ;
        sh:node [ sh:property [ sh:path ex:contractVersion ; sh:hasValue "MADO_EXECUTION_GRAPH_1" ] ] ] ;
      sh:node ex:ContextContractShape ]
  ) .

mado:ContextoShapeLegacy a sh:NodeShape ;
  sh:property [ sh:path mado:identificador ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path mado:descricaoDoContexto ; sh:minCount 1 ] ;
  sh:property [ sh:path mado:descritoSobPerspectiva ; sh:minCount 1 ; sh:class mado:Perspectiva ] ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "Um recurso não pode estar simultaneamente disponível e explicitamente impedido no mesmo contexto."@pt-BR ;
    sh:select """
      PREFIX mado: <https://w3id.org/mado#>
      SELECT $this ?recurso WHERE {
        $this mado:temRecursoDisponivel ?recurso ; mado:temRecursoImpedido ?recurso .
      }
    """
  ] .

mado:ContextoNovoShape a sh:NodeShape ;
  sh:targetSubjectsOf mado:statusConfirmacao ;
  sh:property [ sh:path mado:temTarefa ; sh:minCount 1 ] ;
  sh:property [ sh:path mado:temParticipacao ; sh:minCount 1 ; sh:class mado:ParticipacaoNoContexto ] ;
  sh:or (
    [ sh:property [ sh:path mado:apresentaBarreira ; sh:minCount 1 ] ]
    [ sh:property [ sh:path mado:apresentaNecessidade ; sh:minCount 1 ] ]
  ) .

mado:ParticipacaoNoContextoShape a sh:NodeShape ;
  sh:targetClass mado:ParticipacaoNoContexto ;
  sh:or (
    [ sh:not [ sh:property [ sh:path ex:forExecution ; sh:minCount 1 ] ] ; sh:node mado:ParticipacaoNoContextoShapeLegacy ]
    [ sh:property [ sh:path ex:forExecution ; sh:minCount 1 ; sh:maxCount 1 ; sh:class ex:Execution ;
        sh:node [ sh:property [ sh:path ex:contractVersion ; sh:hasValue "MADO_EXECUTION_GRAPH_1" ] ] ] ;
      sh:node ex:ParticipationContractShape ]
  ) .

mado:ParticipacaoNoContextoShapeLegacy a sh:NodeShape ;
  sh:property [ sh:path mado:identificador ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path mado:participacaoEmContexto ; sh:minCount 1 ; sh:maxCount 1 ; sh:class mado:ContextoDeInteracaoDigital ] ;
  sh:property [ sh:path mado:temPapelNoContexto ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path mado:origemDoRegistro ; sh:minCount 1 ; sh:maxCount 1 ] .

mado:DecisaoMinimaShape a sh:NodeShape ;
  sh:targetClass mado:DecisaoDeAcessibilidadeMultimodal ;
  sh:targetSubjectsOf mado:statusDecisao ;
  sh:or (
    [ sh:not [ sh:property [ sh:path ex:forExecution ; sh:minCount 1 ] ] ; sh:node mado:DecisaoMinimaShapeLegacy ]
    [ sh:property [ sh:path ex:forExecution ; sh:minCount 1 ; sh:maxCount 1 ; sh:class ex:Execution ;
        sh:node [ sh:property [ sh:path ex:contractVersion ; sh:hasValue "MADO_EXECUTION_GRAPH_1" ] ] ] ;
      sh:node ex:DecisionContractShape ]
  ) .

mado:DecisaoMinimaShapeLegacy a sh:NodeShape ;
  sh:class mado:DecisaoDeAcessibilidadeMultimodal ;
  sh:property [ sh:path mado:identificador ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path mado:enunciado ; sh:minCount 1 ] ;
  sh:property [ sh:path mado:rationale ; sh:minCount 1 ] ;
  sh:property [ sh:path mado:statusDecisao ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path mado:respondeA ; sh:minCount 1 ; sh:maxCount 1 ; sh:class mado:ContextoDeInteracaoDigital ] ;
  sh:property [ sh:path mado:sustentadaPor ; sh:class mado:ConhecimentoMultimodalArticulado ] ;
  sh:sparql [
    sh:message "Uma decisão não suspensa, inclusive histórica, precisa de conhecimento de sustentação."@pt-BR ;
    sh:select """
      PREFIX mado: <https://w3id.org/mado#>
      SELECT $this WHERE {
        $this mado:statusDecisao ?status .
        FILTER(!STRSTARTS(STR(?status), "SUSPENSA"))
        FILTER NOT EXISTS { $this mado:sustentadaPor ?conhecimento }
      }
    """
  ] .

mado:DecisaoCandidataShape a sh:NodeShape ;
  sh:targetClass mado:DecisaoDeAcessibilidadeMultimodal ;
  sh:targetSubjectsOf mado:statusDecisao ;
  sh:or (
    [ sh:not [ sh:property [ sh:path ex:forExecution ; sh:minCount 1 ] ] ; sh:node mado:DecisaoCandidataShapeLegacy ]
    [ sh:property [ sh:path ex:forExecution ; sh:minCount 1 ; sh:maxCount 1 ; sh:class ex:Execution ;
        sh:node [ sh:property [ sh:path ex:contractVersion ; sh:hasValue "MADO_EXECUTION_GRAPH_1" ] ] ] ;
      sh:node ex:DecisionContractShape ]
  ) .

mado:DecisaoCandidataShapeLegacy a sh:NodeShape ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "Decisão candidata deve aplicar ao menos um critério principal; decisões históricas reconstruídas são exceção documentada."@pt-BR ;
    sh:select """
      PREFIX mado: <https://w3id.org/mado#>
      SELECT $this WHERE {
        $this mado:statusDecisao ?status .
        FILTER(?status != "DECISAO_HISTORICA_RECONSTRUIDA" && !STRSTARTS(?status, "SUSPENSA"))
        FILTER NOT EXISTS {
          $this mado:aplicaCriterio ?criterio .
          FILTER NOT EXISTS { $this mado:aplicaCriterioCondicional ?criterio }
        }
      }
    """
  ] ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "Decisão candidata deve explicitar alternativa, condição, limite, acompanhamento e resultado esperado."@pt-BR ;
    sh:select """
      PREFIX mado: <https://w3id.org/mado#>
      SELECT $this WHERE {
        $this mado:statusDecisao ?status .
        FILTER(?status != "DECISAO_HISTORICA_RECONSTRUIDA" && !STRSTARTS(?status, "SUSPENSA"))
        FILTER(
          NOT EXISTS { $this mado:alternativa ?a } ||
          NOT EXISTS { $this mado:condicaoDeAplicacao ?c } ||
          NOT EXISTS { $this mado:limite ?l } ||
          NOT EXISTS { $this mado:indicadorDeAcompanhamento ?i } ||
          NOT EXISTS { $this mado:resultadoEsperado ?e } ||
          NOT EXISTS { $this mado:estatutoDoResultadoEsperado ?s }
        )
      }
    """
  ] ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "Quando K33 é empregado, a decisão deve explicitar que atende a esse requisito de expressão. K33 não é obrigatório em outros contextos."@pt-BR ;
    sh:select """
      PREFIX mado: <https://w3id.org/mado#>
      SELECT $this WHERE {
        $this mado:statusDecisao ?status ; mado:sustentadaPor mado:K33 .
        FILTER(?status != "DECISAO_HISTORICA_RECONSTRUIDA" && !STRSTARTS(STR(?status), "SUSPENSA"))
        FILTER NOT EXISTS { $this mado:atendeRequisitoDeExpressao mado:K33 }
      }
    """
  ] ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "Uma decisão não histórica e não suspensa deve ter ao menos uma configuração; retirar todas não pode evitar a validação."@pt-BR ;
    sh:select """
      PREFIX mado: <https://w3id.org/mado#>
      SELECT $this WHERE {
        $this mado:statusDecisao ?status .
        FILTER(?status != "DECISAO_HISTORICA_RECONSTRUIDA" && !STRSTARTS(STR(?status), "SUSPENSA"))
        FILTER NOT EXISTS { $this mado:possuiConfiguracaoModal ?configuracao }
      }
    """
  ] .

mado:DecisaoSuspensaShape a sh:NodeShape ;
  sh:targetClass mado:DecisaoDeAcessibilidadeMultimodal ;
  sh:or (
    [ sh:not [ sh:property [ sh:path ex:forExecution ; sh:minCount 1 ] ] ; sh:node mado:DecisaoSuspensaShapeLegacy ]
    [ sh:property [ sh:path ex:forExecution ; sh:minCount 1 ; sh:maxCount 1 ; sh:class ex:Execution ;
        sh:node [ sh:property [ sh:path ex:contractVersion ; sh:hasValue "MADO_EXECUTION_GRAPH_1" ] ] ] ;
      sh:node ex:DecisionContractShape ]
  ) .

mado:DecisaoSuspensaShapeLegacy a sh:NodeShape ;
  sh:sparql [
    sh:message "A suspensão deve explicar a insuficiência e não apresentar configurações como orientação autorizada."@pt-BR ;
    sh:select """
      PREFIX mado: <https://w3id.org/mado#>
      SELECT $this WHERE {
        $this mado:statusDecisao ?status .
        FILTER(STRSTARTS(STR(?status), "SUSPENSA"))
        FILTER(EXISTS { $this mado:possuiConfiguracaoModal ?cfg }
          || NOT EXISTS { $this mado:rationale ?motivo . FILTER(STRLEN(STR(?motivo)) > 0) })
      }
    """
  ] .

mado:ResultadoShape a sh:NodeShape ;
  sh:targetClass mado:Resultado ;
  sh:property [ sh:path mado:identificador ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:xone (
    [ sh:property [ sh:path mado:enunciado ; sh:minCount 1 ; sh:minLength 1 ; sh:pattern "\\S" ] ;
      sh:not [ sh:property [ sh:path mado:estadoDePublicacaoDoRegistro ; sh:hasValue "TEXTO_NAO_REDISTRIBUIDO" ] ] ]
    [ sh:property [ sh:path mado:estadoDePublicacaoDoRegistro ; sh:hasValue "TEXTO_NAO_REDISTRIBUIDO" ; sh:maxCount 1 ] ;
      sh:property [ sh:path mado:enunciado ; sh:maxCount 0 ] ;
      sh:property [ sh:path mado:localizacaoDocumental ; sh:minCount 1 ; sh:minLength 1 ; sh:pattern "\\S" ] ]
  ) ;
  sh:property [ sh:path mado:registradoEm ; sh:minCount 1 ; sh:class mado:Fonte ] .

mado:TrechoDocumentalShape a sh:NodeShape ;
  sh:targetClass mado:TrechoDocumental ;
  sh:property [ sh:path mado:identificador ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:xone (
    [ sh:property [ sh:path mado:conteudoDoTrecho ; sh:minCount 1 ; sh:minLength 1 ; sh:pattern "\\S" ] ;
      sh:not [ sh:or (
        [ sh:property [ sh:path mado:estadoDePublicacaoDoTrecho ; sh:hasValue "TEXTO_NAO_REDISTRIBUIDO" ] ]
        [ sh:property [ sh:path mado:estadoDePublicacaoDoTrecho ; sh:hasValue "PARAFRASE_PROPRIA_SEM_TRECHO_LITERAL" ] ]
      ) ] ]
    [ sh:property [ sh:path mado:estadoDePublicacaoDoTrecho ; sh:hasValue "TEXTO_NAO_REDISTRIBUIDO" ; sh:maxCount 1 ] ;
      sh:property [ sh:path mado:conteudoDoTrecho ; sh:maxCount 0 ] ;
      sh:property [ sh:path mado:localizacaoDocumental ; sh:minCount 1 ; sh:minLength 1 ; sh:pattern "\\S" ] ]
    [ sh:property [ sh:path mado:estadoDePublicacaoDoTrecho ; sh:hasValue "PARAFRASE_PROPRIA_SEM_TRECHO_LITERAL" ; sh:maxCount 1 ] ;
      sh:property [ sh:path mado:conteudoDoTrecho ; sh:maxCount 0 ] ;
      sh:property [ sh:path mado:parafraseDocumental ; sh:minCount 1 ; sh:minLength 1 ; sh:pattern "\\S" ] ;
      sh:property [ sh:path mado:localizacaoDocumental ; sh:minCount 1 ; sh:minLength 1 ; sh:pattern "\\S" ] ]
  ) ;
  sh:property [ sh:path mado:trechoDeFonte ; sh:minCount 1 ; sh:maxCount 1 ; sh:class mado:Fonte ] .

mado:MetadadosDePublicacaoShape a sh:NodeShape ;
  sh:targetSubjectsOf mado:estadoDePublicacaoDoTrecho, mado:estadoDePublicacaoDoRegistro, mado:localizacaoDocumental ;
  sh:property [ sh:path mado:estadoDePublicacaoDoTrecho ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path mado:estadoDePublicacaoDoRegistro ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path mado:localizacaoDocumental ; sh:datatype xsd:string ; sh:minLength 1 ; sh:pattern "\\S" ] .

mado:QualidadeCriterioShape a sh:NodeShape ;
  sh:targetClass mado:CriterioDeDecisaoMultimodal ;
  sh:severity sh:Warning ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:severity sh:Warning ;
    sh:message "Critério possui relação indicada sem justificativa explícita; a lacuna deve permanecer visível."@pt-BR ;
    sh:select """
      PREFIX mado: <https://w3id.org/mado#>
      SELECT $this WHERE { $this mado:statusDaRelacao "RELACAO_SEM_JUSTIFICATIVA_EXPLICITA" . }
    """
  ] .

mado:ConfiguracaoModalShape a sh:NodeShape ;
  sh:targetClass mado:ConfiguracaoModalDaDecisao ;
  sh:targetObjectsOf mado:possuiConfiguracaoModal ;
  sh:or (
    [ sh:not [ sh:property [ sh:path ex:forExecution ; sh:minCount 1 ] ] ; sh:node mado:ConfiguracaoModalShapeLegacy ]
    [ sh:property [ sh:path ex:forExecution ; sh:minCount 1 ; sh:maxCount 1 ; sh:class ex:Execution ;
        sh:node [ sh:property [ sh:path ex:contractVersion ; sh:hasValue "MADO_EXECUTION_GRAPH_1" ] ] ] ;
      sh:node ex:ConfigurationShape ]
  ) .

mado:ConfiguracaoModalShapeLegacy a sh:NodeShape ;
  sh:class mado:ConfiguracaoModalDaDecisao ;
  sh:property [ sh:path mado:identificador ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path mado:configuracaoDeDecisao ; sh:minCount 1 ; sh:maxCount 1 ; sh:class mado:DecisaoDeAcessibilidadeMultimodal ] ;
  sh:property [ sh:path mado:configuraModalidade ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path mado:executadaPorPapel ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path mado:temPapelModal ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path mado:temFuncaoModal ; sh:minCount 1 ] ;
  sh:property [ sh:path mado:temAcaoOperacional ; sh:minCount 1 ] .

mado:ConfiguracaoMaduraShape a sh:NodeShape ;
  sh:targetClass mado:ConfiguracaoModalDaDecisao ;
  sh:targetObjectsOf mado:possuiConfiguracaoModal ;
  sh:or (
    [ sh:not [ sh:property [ sh:path ex:forExecution ; sh:minCount 1 ] ] ; sh:node mado:ConfiguracaoMaduraShapeLegacy ]
    [ sh:property [ sh:path ex:forExecution ; sh:minCount 1 ; sh:maxCount 1 ; sh:class ex:Execution ;
        sh:node [ sh:property [ sh:path ex:contractVersion ; sh:hasValue "MADO_EXECUTION_GRAPH_1" ] ] ] ;
      sh:node ex:ConfigurationShape ]
  ) .

mado:ConfiguracaoMaduraShapeLegacy a sh:NodeShape ;
  sh:property [ sh:path mado:configuracaoConsideraCondicao ; sh:minCount 1 ] ;
  sh:property [ sh:path mado:configuracaoSustentadaPorConhecimento ; sh:minCount 1 ; sh:class mado:ConhecimentoMultimodalArticulado ] ;
  sh:property [ sh:path mado:configuracaoAplicaCriterio ; sh:minCount 1 ; sh:class mado:CriterioDeDecisaoMultimodal ] ;
  sh:property [ sh:path mado:configuracaoUsaOrigemDoCriterio ; sh:minCount 1 ; sh:class mado:RelacaoDeOrigemDoCriterio ] ;
  sh:property [ sh:path mado:possuiAplicacaoDeCriterio ; sh:minCount 1 ; sh:class mado:AplicacaoDeCriterio ] ;
  sh:property [ sh:path mado:cumpreFuncaoDecisoria ; sh:minCount 1 ] ;
  sh:property [ sh:path mado:condicaoDaConfiguracao ; sh:minCount 1 ] ;
  sh:property [ sh:path mado:alternativaDaConfiguracao ; sh:minCount 1 ] ;
  sh:property [ sh:path mado:acompanhamentoDaConfiguracao ; sh:minCount 1 ] ;
  sh:property [ sh:path mado:limiteDaConfiguracao ; sh:minCount 1 ] ;
  sh:property [ sh:path mado:significadoFuncional ; sh:minCount 1 ] ;
  sh:property [ sh:path mado:estadoDeDisponibilidadeDaConfiguracao ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ("CONFIRMADO_DISPONIVEL" "CONDICIONAL_A_CONFIRMACAO" "REQUER_PREPARACAO") ] ;
  sh:or (
    [ sh:property [ sh:path mado:configuraRecurso ; sh:minCount 1 ] ]
    [ sh:property [ sh:path mado:alternativaDaConfiguracao ; sh:minCount 1 ] ]
  ) ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "Cada critério e origem projetados na configuração precisam de aplicação situada nessa configuração, não em outra."@pt-BR ;
    sh:select """
      PREFIX mado: <https://w3id.org/mado#>
      SELECT $this ?value WHERE {
        {
          $this mado:configuracaoAplicaCriterio ?value .
          FILTER NOT EXISTS {
            $this mado:possuiAplicacaoDeCriterio ?app .
            ?app mado:aplicacaoNaConfiguracao $this ; mado:criterioAplicado ?value .
          }
        } UNION {
          $this mado:configuracaoUsaOrigemDoCriterio ?value .
          FILTER NOT EXISTS {
            $this mado:possuiAplicacaoDeCriterio ?app .
            ?app mado:aplicacaoNaConfiguracao $this ; mado:origemDaAplicacao ?value .
          }
        }
      }
    """
  ] ;
  sh:sparql [
    sh:message "Configuração e decisão devem manter as duas direções de sua relação."@pt-BR ;
    sh:select """
      PREFIX mado: <https://w3id.org/mado#>
      SELECT $this ?decisao WHERE {
        $this mado:configuracaoDeDecisao ?decisao .
        FILTER NOT EXISTS { ?decisao mado:possuiConfiguracaoModal $this }
      }
    """
  ] ;
  sh:sparql [
    sh:message "A aplicação deve indicar a mesma configuração que a contém."@pt-BR ;
    sh:select """
      PREFIX mado: <https://w3id.org/mado#>
      SELECT $this ?app WHERE {
        $this mado:possuiAplicacaoDeCriterio ?app .
        FILTER NOT EXISTS { ?app mado:aplicacaoNaConfiguracao $this }
      }
    """
  ] .

mado:AplicacaoDeCriterioShape a sh:NodeShape ;
  sh:targetClass mado:AplicacaoDeCriterio ;
  sh:targetObjectsOf mado:possuiAplicacaoDeCriterio ;
  sh:targetSubjectsOf mado:aplicacaoNaConfiguracao, mado:criterioAplicado, mado:conhecimentoDaAplicacao, mado:origemDaAplicacao, mado:justificativaDaAplicacao ;
  sh:or (
    [ sh:not [ sh:property [ sh:path ex:forExecution ; sh:minCount 1 ] ] ; sh:node mado:AplicacaoDeCriterioShapeLegacy ]
    [ sh:property [ sh:path ex:forExecution ; sh:minCount 1 ; sh:maxCount 1 ; sh:class ex:Execution ;
        sh:node [ sh:property [ sh:path ex:contractVersion ; sh:hasValue "MADO_EXECUTION_GRAPH_1" ] ] ] ;
      sh:node ex:CriterionApplicationShape ]
  ) .

mado:AplicacaoDeCriterioShapeLegacy a sh:NodeShape ;
  sh:class mado:AplicacaoDeCriterio ;
  sh:property [ sh:path mado:aplicacaoNaConfiguracao ; sh:minCount 1 ; sh:maxCount 1 ; sh:class mado:ConfiguracaoModalDaDecisao ] ;
  sh:property [ sh:path mado:criterioAplicado ; sh:minCount 1 ; sh:maxCount 1 ; sh:class mado:CriterioDeDecisaoMultimodal ] ;
  sh:property [ sh:path mado:conhecimentoDaAplicacao ; sh:minCount 1 ; sh:class mado:ConhecimentoMultimodalArticulado ] ;
  sh:property [ sh:path mado:origemDaAplicacao ; sh:minCount 1 ; sh:class mado:RelacaoDeOrigemDoCriterio ] ;
  sh:property [ sh:path mado:justificativaDaAplicacao ; sh:minCount 1 ; sh:minLength 1 ; sh:pattern "\\S" ] ;
  sh:sparql [
    sh:message "Toda origem da aplicação deve pertencer ao seu critério e ter um trecho verificável."@pt-BR ;
    sh:select """
      PREFIX mado: <https://w3id.org/mado#>
      SELECT $this ?origem WHERE {
        $this mado:criterioAplicado ?criterio ; mado:origemDaAplicacao ?origem .
        FILTER NOT EXISTS { ?criterio mado:possuiOrigem ?origem . ?origem mado:origemSustentadaPorTrecho ?trecho }
      }
    """
  ] ;
  sh:sparql [
    sh:message "A aplicação pertence a uma única configuração, que deve conter a relação inversa."@pt-BR ;
    sh:select """
      PREFIX mado: <https://w3id.org/mado#>
      SELECT $this ?cfg WHERE {
        $this mado:aplicacaoNaConfiguracao ?cfg .
        FILTER NOT EXISTS { ?cfg mado:possuiAplicacaoDeCriterio $this }
      }
    """
  ] ;
  sh:sparql [
    sh:message "Conhecimento, critério e origem da aplicação precisam estar projetados na sua própria configuração."@pt-BR ;
    sh:select """
      PREFIX mado: <https://w3id.org/mado#>
      SELECT $this ?value WHERE {
        $this mado:aplicacaoNaConfiguracao ?cfg .
        { $this mado:conhecimentoDaAplicacao ?value . FILTER NOT EXISTS { ?cfg mado:configuracaoSustentadaPorConhecimento ?value } }
        UNION
        { $this mado:criterioAplicado ?value . FILTER NOT EXISTS { ?cfg mado:configuracaoAplicaCriterio ?value } }
        UNION
        { $this mado:origemDaAplicacao ?value . FILTER NOT EXISTS { ?cfg mado:configuracaoUsaOrigemDoCriterio ?value } }
      }
    """
  ] .

mado:OrigemDoCriterioShape a sh:NodeShape ;
  sh:targetClass mado:RelacaoDeOrigemDoCriterio ;
  sh:property [ sh:path mado:origemEmFonte ; sh:minCount 1 ; sh:maxCount 1 ; sh:class mado:Fonte ] ;
  sh:property [ sh:path mado:origemSustentadaPorTrecho ; sh:minCount 1 ; sh:maxCount 1 ; sh:class mado:TrechoDocumental ] .

mado:ArticulacaoDocumentadaShape a sh:NodeShape ;
  sh:targetClass mado:ArticulacaoDocumentada ;
  sh:property [ sh:path mado:identificador ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path mado:tipoDeArticulacao ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path mado:articulaConhecimentoDeEntrada ; sh:minCount 1 ; sh:class mado:ConhecimentoMultimodalArticulado ] ;
  sh:property [ sh:path mado:produzConhecimento ; sh:minCount 1 ; sh:class mado:ConhecimentoMultimodalArticulado ] ;
  sh:property [ sh:path mado:articulacaoDerivadaDe ; sh:minCount 1 ; sh:class mado:Fonte ] ;
  sh:property [ sh:path mado:articulacaoSustentadaPorTrecho ; sh:minCount 1 ; sh:class mado:TrechoDocumental ] ;
  sh:property [ sh:path mado:origemDaRelacao ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path mado:nivelDeConfirmacao ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path mado:estadoDeCuradoria ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path mado:habilitadaParaDecisao ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path mado:condicaoDaArticulacao ; sh:minCount 1 ] ;
  sh:property [ sh:path mado:limiteDaArticulacao ; sh:minCount 1 ] ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "Articulação habilitada exige nível de confirmação e estado de curadoria explicitamente admitidos; desconhecido não equivale a confirmado."@pt-BR ;
    sh:select """
      PREFIX mado: <https://w3id.org/mado#>
      PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
      SELECT $this WHERE {
        $this mado:habilitadaParaDecisao true ;
              mado:nivelDeConfirmacao ?nivel ;
              mado:estadoDeCuradoria ?estado .
        FILTER(?nivel NOT IN ("DOCUMENTADA_DIRETAMENTE", "DOCUMENTADA_E_INFORMADA_PELA_AUTORA", "DOCUMENTADA_E_RECONSTRUIDA", "INFORMADA_PELA_AUTORA", "RECONSTRUIDA_A_PARTIR_DAS_PUBLICACOES")
          || ?estado NOT IN ("APROVADA_PARA_CONSULTA", "APROVADA_PARA_CONSULTA_RC3", "APROVADA_PARA_O_CASO_RC3", "APROVADA_PARA_TESTE_RC2"))
      }
    """
  ] .

mado:DecisaoComArticulacaoShape a sh:NodeShape ;
  sh:targetSubjectsOf mado:mobilizaArticulacao ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "Decisão não pode mobilizar articulação desabilitada ou não confirmada."@pt-BR ;
    sh:select """
      PREFIX mado: <https://w3id.org/mado#>
      SELECT $this ?articulacao WHERE {
        $this mado:mobilizaArticulacao ?articulacao .
        FILTER NOT EXISTS { ?articulacao mado:habilitadaParaDecisao true }
      }
    """
  ] .

# A contribuição qualifica uma ligação já documentada; não cria uma prova de suficiência.
mado:ContribuicaoNaArticulacaoShape a sh:NodeShape ;
  sh:targetClass mado:ContribuicaoNaArticulacao ;
  sh:targetObjectsOf mado:possuiContribuicao ;
  sh:targetObjectsOf mado:aplicacaoMobilizaContribuicao ;
  sh:class mado:ContribuicaoNaArticulacao ;
  sh:property [ sh:path mado:identificador ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path mado:contribuicaoNaArticulacao ; sh:minCount 1 ; sh:maxCount 1 ; sh:class mado:ArticulacaoDocumentada ] ;
  sh:property [ sh:path mado:contribuicaoParaConhecimento ; sh:minCount 1 ; sh:maxCount 1 ; sh:class mado:ConhecimentoMultimodalArticulado ] ;
  sh:property [ sh:path mado:contribuicaoDoTrecho ; sh:minCount 1 ; sh:maxCount 1 ; sh:class mado:TrechoDocumental ] ;
  sh:property [ sh:path (mado:contribuicaoDoTrecho mado:trechoDeFonte) ; sh:minCount 1 ; sh:maxCount 1 ; sh:class mado:Fonte ] ;
  sh:property [ sh:path mado:afirmacaoDaContribuicao ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "\\S" ] ;
  sh:property [ sh:path mado:papelDaContribuicao ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "\\S" ] ;
  sh:property [ sh:path mado:naturezaDaContribuicao ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "\\S" ] ;
  sh:property [ sh:path mado:justificativaDaContribuicao ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "\\S" ] ;
  sh:property [ sh:path mado:estadoDeConferenciaDaContribuicao ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ("CONFERIDA_NO_DOCUMENTO" "CONFERIDA_NO_REGISTRO" "PENDENTE") ] ;
  sh:property [ sh:path mado:responsavelPelaConferencia ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "\\S" ] ;
  sh:property [ sh:path mado:dataDaConferencia ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" ] ;
  sh:sparql [
    sh:message "A contribuição deve preservar o produto da articulação, o trecho registrado e sua fonte, sem atribuição global indiscriminada."@pt-BR ;
    sh:select """
      PREFIX mado: <https://w3id.org/mado#>
      SELECT $this WHERE {
        $this mado:contribuicaoNaArticulacao ?art ; mado:contribuicaoParaConhecimento ?k ; mado:contribuicaoDoTrecho ?t .
        ?t mado:trechoDeFonte ?f .
        FILTER(NOT EXISTS { ?art mado:produzConhecimento ?k ; mado:possuiContribuicao $this ; mado:articulacaoSustentadaPorTrecho ?t }
          || NOT EXISTS { ?k mado:sustentadoPorTrecho ?t ; mado:derivadoDe ?f })
      }
    """
  ] .

mado:ArticulacaoComContribuicoesShape a sh:NodeShape ;
  sh:targetSubjectsOf mado:possuiContribuicao ;
  sh:property [ sh:path mado:explicacaoDaOperacaoAnalitica ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "\\S" ] ;
  sh:property [ sh:path mado:compreensaoAcrescentada ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "\\S" ] ;
  sh:property [ sh:path mado:autoriaDaArticulacao ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "\\S" ] ;
  sh:property [ sh:path mado:origemDaReconstrucao ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "\\S" ] .

mado:AplicacaoComContribuicaoShape a sh:NodeShape ;
  sh:targetSubjectsOf mado:aplicacaoMobilizaContribuicao ;
  sh:class mado:AplicacaoDeCriterio ;
  sh:sparql [
    sh:message "Uma aplicação só pode mobilizar contribuição conferida de seu próprio conhecimento e de articulação efetivamente mobilizada na configuração."@pt-BR ;
    sh:select """
      PREFIX mado: <https://w3id.org/mado#>
      SELECT $this ?contribuicao WHERE {
        $this mado:aplicacaoMobilizaContribuicao ?contribuicao ; mado:aplicacaoNaConfiguracao ?cfg .
        ?contribuicao mado:contribuicaoParaConhecimento ?k ; mado:contribuicaoNaArticulacao ?art ; mado:estadoDeConferenciaDaContribuicao ?estado .
        FILTER(?estado NOT IN ("CONFERIDA_NO_DOCUMENTO", "CONFERIDA_NO_REGISTRO")
          || NOT EXISTS { $this mado:conhecimentoDaAplicacao ?k }
          || NOT EXISTS { ?cfg mado:configuracaoMobilizaArticulacao ?art . ?art mado:habilitadaParaDecisao true })
      }
    """
  ] .

# Apenas aplicações analíticas explícitas são alvo: relações históricas não
# passam a autorizações operacionais por compartilharem uma fonte ou função.
mado:AplicacaoAnaliticaOperacionalShape a sh:NodeShape ;
  sh:targetSubjectsOf mado:aplicacaoDaArticulacao ;
  sh:class mado:AfirmacaoOperacionalDocumentada ;
  sh:property [ sh:path mado:identificador ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path mado:aplicacaoDaArticulacao ; sh:minCount 1 ; sh:maxCount 1 ; sh:class mado:ArticulacaoDocumentada ] ;
  sh:property [ sh:path mado:elegibilidadeOperacional ; sh:hasValue "GROUNDED_ANALYTICAL_APPLICATION" ; sh:maxCount 1 ] ;
  sh:property [ sh:path mado:premissaOperacional ; sh:minCount 1 ; sh:class mado:AfirmacaoOperacionalDocumentada ] ;
  sh:property [ sh:path mado:operacaoDaAplicacaoAnalitica ; sh:minCount 1 ; sh:maxCount 1 ; sh:minLength 1 ] ;
  sh:property [ sh:path mado:enunciado ; sh:minCount 1 ; sh:maxCount 1 ; sh:minLength 1 ] ;
  sh:or (
    [ sh:property [ sh:path mado:autorizaOperacao ; sh:minCount 1 ] ]
    [ sh:property [ sh:path mado:autorizaRelacaoOperacional ; sh:minCount 1 ] ]
    [ sh:property [ sh:path mado:autorizaDerivacaoDeRequisito ; sh:minCount 1 ] ]
  ) ;
  sh:property [ sh:path mado:condicaoDaAplicacaoAnalitica ; sh:minCount 1 ] ;
  sh:property [ sh:path mado:limiteDaAfirmacao ; sh:minCount 1 ] ;
  sh:property [ sh:path mado:efeitoEmpiricoAutorizado ; sh:hasValue false ; sh:maxCount 1 ] ;
  sh:sparql [
    sh:message "Aplicação analítica exige premissas documentalmente elegíveis, sem usar candidatos como autorização."@pt-BR ;
    sh:select """
      PREFIX mado: <https://w3id.org/mado#>
      SELECT $this ?premissa WHERE {
        $this mado:premissaOperacional ?premissa .
        FILTER NOT EXISTS { ?premissa mado:elegibilidadeOperacional "DOCUMENTED_OPERATIONAL_CLAIM" }
      }
    """
  ] ;
  sh:sparql [
    sh:message "Origem do critério da aplicação deve apontar a um trecho de suas premissas exatas."@pt-BR ;
    sh:select """
      PREFIX mado: <https://w3id.org/mado#>
      SELECT $this ?origem WHERE {
        $this mado:origemDaAplicacaoAnalitica ?origem .
        FILTER NOT EXISTS {
          $this mado:premissaOperacional ?premissa .
          ?premissa mado:trechoDaAfirmacao ?trecho .
          ?origem mado:origemSustentadaPorTrecho ?trecho .
        }
      }
    """
  ] ;
  sh:sparql [
    sh:message "Aplicações analíticas não podem se autorizar por dependência circular."@pt-BR ;
    sh:select """
      PREFIX mado: <https://w3id.org/mado#>
      SELECT $this WHERE { $this mado:dependeDeAplicacaoAnalitica+ $this . }
    """
  ] .

mado:DerivacaoAnaliticaDeRequisitoShape a sh:NodeShape ;
  sh:targetObjectsOf mado:autorizaDerivacaoDeRequisito ;
  sh:class skos:Concept ;
  sh:property [ sh:path mado:identificador ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path mado:contratoOperacionalSerializado ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:sparql [
    sh:message "O requisito derivado deve conservar seu vínculo à aplicação analítica que o autoriza."@pt-BR ;
    sh:select """
      PREFIX mado: <https://w3id.org/mado#>
      SELECT $this ?aplicacao WHERE {
        ?aplicacao mado:autorizaDerivacaoDeRequisito $this .
        FILTER NOT EXISTS { $this mado:fundamentadaPorAplicacaoAnalitica ?aplicacao }
      }
    """
  ] .

# O contrato continua sendo projetado integralmente em JSON. Esta qualificação
# delimita qual informação precisa de alternativa, sem inferir capacidade.
mado:ComponenteInformacionalDoRequisitoShape a sh:NodeShape ;
  sh:targetClass skos:Concept ;
  sh:or (
    [ sh:not [ sh:in (mado:MF-01 mado:MF-11) ] ]
    [ sh:property [
      sh:path mado:contratoOperacionalSerializado ;
      sh:minCount 1 ; sh:maxCount 1 ;
      sh:pattern '"required_information_components"\\s*:\\s*\\[\\s*"(VISUAL|SONORO)"' ;
      sh:message "O requisito de acesso visual ou sonoro deve conservar o componente informacional delimitado no contrato."@pt-BR
    ] ]
  ) .
